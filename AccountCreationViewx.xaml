<UserControl x:Class="ConceptJewelleryPro.WPF.Views.AccountCreationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
             xmlns:vm="clr-namespace:ConceptJewelleryPro.WPF.ViewModels"
             xmlns:controls="clr-namespace:ConceptJewelleryPro.WPF.Controls"
             FontFamily="Segoe UI"
             TextOptions.TextFormattingMode="Display">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Clean Card Section Style -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="20,16" />
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>

        <!-- Standardized Input Control Dimensions -->
        <Style TargetType="{x:Type telerik:RadComboBox}" BasedOn="{StaticResource RadComboBoxStyle}">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,4"/>
        </Style>

        <Style TargetType="{x:Type telerik:RadWatermarkTextBox}" BasedOn="{StaticResource RadWatermarkTextBoxStyle}">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,4,8,4" />
        </Style>

        <Style TargetType="{x:Type telerik:RadNumericUpDown}" BasedOn="{StaticResource RadNumericUpDownStyle}">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="0,4,8,4" />
        </Style>

        <Style x:Key="ToolbarButtonStyle" TargetType="telerik:RadButton" BasedOn="{StaticResource RadButtonStyle}">
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="80" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource WindowBackgroundBrush}" KeyboardNavigation.TabNavigation="Cycle">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!-- Header -->
            <RowDefinition Height="*" />
            <!-- Form Body -->
            <RowDefinition Height="Auto" />
            <!-- Sticky Bottom Action Bar -->
        </Grid.RowDefinitions>

        <!-- Toast Notifications Container -->
<controls:ToastNotification x:Name="ToastNotification"
                                      Grid.Row="0"
                                      Grid.RowSpan="3"
                                      Panel.ZIndex="99"
                                      Message="{Binding ToastMessage, FallbackValue=''}"
                                      ToastType="{Binding ToastType, FallbackValue=Info}"
                                      AutoCloseDelay="8000"
                                      FontSize="14"
                                      Height="60" />

        <!-- Page Header -->
        <Border Grid.Row="0"
                Background="{DynamicResource HeaderBackgroundBrush}"
                BorderBrush="{DynamicResource HeaderBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="20,12">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="36" Height="36" CornerRadius="8" Background="{DynamicResource PanelBrush}">
                        <TextBlock Text="&#xE77B;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="16"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Account Creation" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                        <TextBlock Text="Create and manage ledger accounts" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" />
                    </StackPanel>
                </StackPanel>

                <!-- Search & Actions Bar -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <telerik:RadButton x:Name="AddButton" Content="Add New" Style="{StaticResource ToolbarButtonStyle}" Command="{Binding AddNewCommand}" Click="AddButton_Click" IsTabStop="False" />
                    <telerik:RadButton Content="Add From GSTN" Style="{StaticResource ToolbarButtonStyle}" Command="{Binding AddNewFromGstnCommand}" IsTabStop="False" />
                    <telerik:RadButton Content="Modify" Style="{StaticResource ToolbarButtonStyle}" Command="{Binding ModifyCommand}" IsTabStop="False" />
                    <telerik:RadButton Content="Delete" Style="{StaticResource ToolbarButtonStyle}" Command="{Binding DeleteCommand}" IsTabStop="False" />
                    <Border Width="1" Background="{DynamicResource SeparatorBrush}" Margin="4,4,12,4" />

                    <StackPanel VerticalAlignment="Center">
                        <telerik:RadComboBox Width="220"
                                             ItemsSource="{Binding Accounts}"
                                             SelectedItem="{Binding SelectedAccount, Mode=TwoWay}"
                                             DisplayMemberPath="AccountName"
                                             IsEditable="True"
                                             IsFilteringEnabled="True"
                                             Height="32"
                                             FontSize="12"
                                             IsTabStop="False" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Form Body -->
        <telerik:RadBusyIndicator Grid.Row="1" IsBusy="{Binding IsBusy, Mode=OneWay}" BusyContent="Saving...">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,16">
                <StackPanel>
                    <!-- Single Panel with 2-Column (Label & Value) Layout -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Account Entry Details" Style="{StaticResource SectionTitleStyle}" />
<Grid>
    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="150" /> <!-- Label -->
        <ColumnDefinition Width="*" />   <!-- Value -->
        <ColumnDefinition Width="20" /> <!-- Gap -->
        <ColumnDefinition Width="150" /> <!-- Label -->
        <ColumnDefinition Width="*" />   <!-- Value -->
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
        <RowDefinition Height="Auto" /> <!-- Row 0 -->
        <RowDefinition Height="Auto" /> <!-- Row 1 -->
        <RowDefinition Height="Auto" /> <!-- Row 2 -->
        <RowDefinition Height="Auto" /> <!-- Row 3 -->
        <RowDefinition Height="Auto" /> <!-- Row 4 -->
        <RowDefinition Height="Auto" /> <!-- Row 5 -->
        <RowDefinition Height="Auto" /> <!-- Row 6 -->
        <RowDefinition Height="Auto" /> <!-- Row 7 -->
        <RowDefinition Height="Auto" /> <!-- Row 8 -->
        <RowDefinition Height="Auto" /> <!-- Row 9 -->
        <RowDefinition Height="Auto" /> <!-- Row 10 -->
        <RowDefinition Height="Auto" /> <!-- Row 11 -->
<RowDefinition Height="Auto" /><!-- Row 11 -->
                                </Grid.RowDefinitions>

    <!-- Left column fields (traverse first) -->
    <TextBlock Grid.Row="0" Grid.Column="0" Text="Head Category" Style="{StaticResource FieldLabelStyle}" Margin="0,0,12,0" />
    <telerik:RadComboBox Grid.Row="0" Grid.Column="1" x:Name="HeadCategoryBox" IsEditable="True" ItemsSource="{Binding HeadCategories}" SelectedItem="{Binding HeadCategory, Mode=TwoWay}" Text="{Binding HeadCategory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TabIndex="1" Margin="0,4,0,4" />

    <TextBlock Grid.Row="1" Grid.Column="0" Text="Sub Category" Style="{StaticResource FieldLabelStyle}" Margin="0,0,12,0" />
    <telerik:RadWatermarkTextBox Grid.Row="1" Grid.Column="1" Text="{Binding SubCategory, UpdateSourceTrigger=PropertyChanged}" TabIndex="2" Margin="0,4,0,4" />

    <TextBlock Grid.Row="2" Grid.Column="0" Text="Account Name *" Style="{StaticResource FieldLabelStyle}" Margin="0,0,12,0" />
    <telerik:RadWatermarkTextBox Grid.Row="2" Grid.Column="1" Text="{Binding AccountName, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" TabIndex="3" Margin="0,4,0,4" />

    <TextBlock Grid.Row="3" Grid.Column="0" Text="Party Code *" Style="{StaticResource FieldLabelStyle}" Margin="0,0,12,0" />
    <telerik:RadWatermarkTextBox Grid.Row="3" Grid.Column="1" Text="{Binding PartyCode, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" TabIndex="4" Margin="0,4,0,4" />

    <TextBlock Grid.Row="4" Grid.Column="0" Text="Ref Name" Style="{StaticResource FieldLabelStyle}" Margin="0,0,12,0" />
    <telerik:RadWatermarkTextBox Grid.Row="4" Grid.Column="1" Text="{Binding RefName, UpdateSourceTrigger=PropertyChanged}" TabIndex="5" Margin="0,4,0,4" />

    <TextBlock Grid.Row="5" Grid.Column="0" Text="Address" Style="{StaticResource FieldLabelStyle}" Margin="0,0,12,0" />
    <telerik:RadWatermarkTextBox Grid.Row="5" Grid.Column="1" Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" TabIndex="6" Margin="0,4,0,4" />

    <TextBlock Grid.Row="6" Grid.Column="0" Text="Address 2" Style="{StaticResource FieldLabelStyle}" Margin="0,0,12,0" />
    <telerik:RadWatermarkTextBox Grid.Row="6" Grid.Column="1" Text="{Binding Address2, UpdateSourceTrigger=PropertyChanged}" TabIndex="7" Margin="0,4,0,4" />

    <TextBlock Grid.Row="7" Grid.Column="0" Text="City" Style="{StaticResource FieldLabelStyle}" Margin="0,0,12,0" />
    <telerik:RadWatermarkTextBox Grid.Row="7" Grid.Column="1" Text="{Binding City, UpdateSourceTrigger=PropertyChanged}" TabIndex="8" Margin="0,4,0,4" />

    <TextBlock Grid.Row="8" Grid.Column="0" Text="Pin Code" Style="{StaticResource FieldLabelStyle}" Margin="0,0,12,0" />
    <telerik:RadWatermarkTextBox Grid.Row="8" Grid.Column="1" Text="{Binding PinCode, UpdateSourceTrigger=PropertyChanged}" TabIndex="9" Margin="0,4,0,4" />

    <TextBlock Grid.Row="9" Grid.Column="0" Text="State" Style="{StaticResource FieldLabelStyle}" Margin="0,0,12,0" />
    <telerik:RadWatermarkTextBox Grid.Row="9" Grid.Column="1" Text="{Binding State, UpdateSourceTrigger=PropertyChanged}" TabIndex="10" Margin="0,4,0,4" />


    <TextBlock Grid.Row="10" Grid.Column="0" Text="STD Code" Style="{StaticResource FieldLabelStyle}" Margin="0,0,12,0" />
    <telerik:RadWatermarkTextBox Grid.Row="10" Grid.Column="1" Text="{Binding StdCode, UpdateSourceTrigger=PropertyChanged}" TabIndex="11" Margin="0,4,0,4" />


    <TextBlock Grid.Row="11" Grid.Column="0" Text="Phone No" Style="{StaticResource FieldLabelStyle}" Margin="0,0,12,0" />
    <telerik:RadWatermarkTextBox Grid.Row="11" Grid.Column="1" Text="{Binding PhoneNo, UpdateSourceTrigger=PropertyChanged}" TabIndex="12" Margin="0,4,0,4" />

    <TextBlock Grid.Row="12" Grid.Column="0" Text="Mobile" Style="{StaticResource FieldLabelStyle}" Margin="0,0,12,0" />
    <telerik:RadWatermarkTextBox Grid.Row="12" Grid.Column="1" Text="{Binding Mobile, UpdateSourceTrigger=PropertyChanged}" TabIndex="13" Margin="0,4,0,4" />


                                <!-- Right column fields (traverse after left) -->


                                <TextBlock Grid.Row="0" Grid.Column="3" Text="GST Type" Style="{StaticResource FieldLabelStyle}" Margin="0,0,12,0" />
    <telerik:RadComboBox Grid.Row="0" Grid.Column="4" ItemsSource="{Binding VatTypes}" SelectedItem="{Binding VatType}" TabIndex="14" Margin="0,4,0,4" />

                                <TextBlock Grid.Row="1" Grid.Column="3" Text="GSTIN No" Style="{StaticResource FieldLabelStyle}" Margin="0,0,12,0" />
                                <telerik:RadWatermarkTextBox Grid.Row="1" Grid.Column="4" Text="{Binding VatNo, UpdateSourceTrigger=PropertyChanged}" TabIndex="15" Margin="0,4,0,4" />

                                <TextBlock Grid.Row="2" Grid.Column="3" Text="In/Out" Style="{StaticResource FieldLabelStyle}" Margin="0,0,12,0" />
                                <telerik:RadComboBox Grid.Row="2" Grid.Column="4" IsEditable="True" ItemsSource="{Binding InOutOptions}" SelectedItem="{Binding InOut, Mode=TwoWay}" Text="{Binding InOut, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TabIndex="16" Margin="0,4,0,4" />


                                <TextBlock Grid.Row="3" Grid.Column="3" Text="Opening Amt 1" Style="{StaticResource FieldLabelStyle}" Margin="0,0,12,0" />
                                <telerik:RadWatermarkTextBox Grid.Row="3" Grid.Column="4" Text="{Binding OpAmt1, Mode=TwoWay, TargetNullValue='', UpdateSourceTrigger=LostFocus, StringFormat=N2}" WatermarkContent="0.00" TabIndex="17" Margin="0,4,0,4" />


                                <TextBlock Grid.Row="4" Grid.Column="3" Text="Opening Gold Wt." Style="{StaticResource FieldLabelStyle}" Margin="0,0,12,0" />
                                <telerik:RadWatermarkTextBox Grid.Row="4" Grid.Column="4" Text="{Binding OpGoldWeight, Mode=TwoWay, TargetNullValue='', UpdateSourceTrigger=LostFocus, StringFormat=N3}" WatermarkContent="0.000" TabIndex="18" Margin="0,4,0,4" />

                                <TextBlock Grid.Row="5" Grid.Column="3" Text="Credit Limit" Style="{StaticResource FieldLabelStyle}" Margin="0,0,12,0" />
                                <telerik:RadWatermarkTextBox Grid.Row="5" Grid.Column="4" Text="{Binding CreditLimit, Mode=TwoWay, TargetNullValue='', UpdateSourceTrigger=LostFocus, StringFormat=N2}" WatermarkContent="Credit Limit" TabIndex="19" Margin="0,4,0,4" />

                                <TextBlock Grid.Row="6" Grid.Column="3" Text="Credit Days" Style="{StaticResource FieldLabelStyle}" Margin="0,0,12,0" />
                                <telerik:RadWatermarkTextBox Grid.Row="6" Grid.Column="4" Text="{Binding CreditDays, Mode=TwoWay, TargetNullValue='', UpdateSourceTrigger=LostFocus, StringFormat=N0}" WatermarkContent="Credit Days" TabIndex="20" Margin="0,4,0,4" />


                                <TextBlock Grid.Row="7" Grid.Column="3" Text="Interest (%)" Style="{StaticResource FieldLabelStyle}" Margin="0,0,12,0" />
                                <telerik:RadWatermarkTextBox Grid.Row="7" Grid.Column="4" Text="{Binding Interest, Mode=TwoWay, TargetNullValue='', UpdateSourceTrigger=LostFocus, StringFormat=N2}" WatermarkContent="Interest (%)" TabIndex="21" Margin="0,4,0,4" />


                                <TextBlock Grid.Row="8" Grid.Column="3" Text="Email" Style="{StaticResource FieldLabelStyle}" Margin="0,0,12,0" />
                                <telerik:RadWatermarkTextBox Grid.Row="8" Grid.Column="4" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" TabIndex="22" Margin="0,4,0,4" />


                                <TextBlock Grid.Row="9" Grid.Column="3" Text="Bank A/c" Style="{StaticResource FieldLabelStyle}" Margin="0,0,12,0" />
                                <telerik:RadWatermarkTextBox Grid.Row="9" Grid.Column="4" Text="{Binding BankAc, UpdateSourceTrigger=PropertyChanged}" TabIndex="23" Margin="0,4,0,4" />

    

                         
                                
                                <StackPanel Grid.Row="11" Grid.Column="3" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,8,0,0" />
</Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </telerik:RadBusyIndicator>

        <!-- Sticky Bottom Action Footer -->
        <Border Grid.Row="2"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource HeaderBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="20,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <telerik:RadButton Content="Cancel"
                                   Width="100"
                                   Height="36"
                                   Margin="0,0,10,0"
                                   Command="{Binding CancelCommand}"
                                   IsTabStop="False" />
                <telerik:RadButton Content="Save Account (F10)"
                                   Width="160"
                                   Height="36"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   Background="CadetBlue"
                                   Command="{Binding SaveCommand}"
                                   TabIndex="31"
                                   IsTabStop="True" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>