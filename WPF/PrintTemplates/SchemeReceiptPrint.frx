<?xml version="1.0" encoding="utf-8"?>
<Report ScriptLanguage="CSharp" ReportInfo.Created="2026-11-19" ReportInfo.Modified="2026-11-19" ReportInfo.CreatorVersion="2027.1.0.0">
  <Dictionary>
    <BusinessObjectDataSource Name="SchemeReceipt" ReferenceName="SchemeReceipt" DataType="System.Int32" Enabled="true">
      <Column Name="CompanyName" DataType="System.String"/>
      <Column Name="CompanyAddress" DataType="System.String"/>
      <Column Name="CompanyPhone" DataType="System.String"/>
      <Column Name="CompanyGstin" DataType="System.String"/>
      <Column Name="VouNo" DataType="System.String"/>
      <Column Name="VouDate" DataType="System.String"/>
      <Column Name="Scode" DataType="System.String"/>
      <Column Name="PaymentMode" DataType="System.String"/>
      <Column Name="CustomerName" DataType="System.String"/>
      <Column Name="ReceivedByAccount" DataType="System.String"/>
      <Column Name="InstallmentNo" DataType="System.Int32"/>
      <Column Name="PaidInstallmentsCount" DataType="System.Int32"/>
      <Column Name="InstallmentSummary" DataType="System.String"/>
      <Column Name="Amount" DataType="System.Decimal"/>
      <Column Name="AmountFormatted" DataType="System.String"/>
      <Column Name="AmountInWords" DataType="System.String"/>
      <Column Name="ChequeNo" DataType="System.String"/>
      <Column Name="ChqDate" DataType="System.String"/>
      <Column Name="BankName" DataType="System.String"/>
      <Column Name="CardType" DataType="System.String"/>
      <Column Name="ReferenceSummary" DataType="System.String"/>
      <Column Name="SchemeTotalValue" DataType="System.String"/>
      <Column Name="SchemeDurationMonths" DataType="System.String"/>
      <Column Name="SchemeMaturityDate" DataType="System.String"/>
      <Column Name="SchemeDetailsSummary" DataType="System.String"/>
      <Column Name="Narration" DataType="System.String"/>
      <Column Name="PreparedBy" DataType="System.String"/>
    </BusinessObjectDataSource>
  </Dictionary>
  <ReportPage Name="Page1" PaperWidth="210" PaperHeight="148" Landscape="true" LeftMargin="10" TopMargin="10" RightMargin="10" BottomMargin="10" Watermark.Font="Arial, 60pt">
    <DataBand Name="Data1" Width="718" Height="465" DataSource="SchemeReceipt">
      <!-- Outer Frame -->
      <TextObject Name="OuterFrame" Left="0" Top="0" Width="718" Height="460" Border.Lines="All" Border.Color="#0F4C5C" Border.Width="1.2" Fill.Color="White"/>

      <!-- Header Banner -->
      <TextObject Name="HeaderBg" Left="1" Top="1" Width="716" Height="64" Fill.Color="#F0F9FF" Border.Lines="Bottom" Border.Color="#BAE6FD" Border.Width="1"/>
      <TextObject Name="txtCompanyName" Left="12" Top="6" Width="440" Height="24" Text="[SchemeReceipt.CompanyName]" Font="Segoe UI, 14pt, style=Bold" TextFill.Color="#003B46" VertAlign="Center"/>
      <TextObject Name="txtCompanyAddress" Left="12" Top="30" Width="440" Height="16" Text="[SchemeReceipt.CompanyAddress]" Font="Segoe UI, 8.5pt" TextFill.Color="#334155" VertAlign="Center"/>
      <TextObject Name="txtCompanyGstin" Left="12" Top="46" Width="440" Height="14" Text="GSTIN: [SchemeReceipt.CompanyGstin]   Ph: [SchemeReceipt.CompanyPhone]" Font="Segoe UI, 8pt" TextFill.Color="#475569" VertAlign="Center"/>

      <!-- Title Badge -->
      <TextObject Name="txtBadge" Left="468" Top="14" Width="236" Height="36" Text="SAVINGS SCHEME RECEIPT" Font="Segoe UI, 11.5pt, style=Bold" TextFill.Color="White" Fill.Color="#003B46" HorzAlign="Center" VertAlign="Center" Border.Lines="All" Border.Color="#0F4C5C"/>

      <!-- Meta Strip -->
      <TextObject Name="MetaBg" Left="1" Top="65" Width="716" Height="32" Fill.Color="#E0F2FE" Border.Lines="Bottom" Border.Color="#BAE6FD" Border.Width="1"/>
      <TextObject Name="txtVouNo" Left="12" Top="69" Width="220" Height="24" Text="Receipt No: [SchemeReceipt.VouNo]" Font="Segoe UI, 10pt, style=Bold" TextFill.Color="#0F172A" VertAlign="Center"/>
      <TextObject Name="txtScode" Left="240" Top="69" Width="240" Height="24" Text="Scheme Code: [SchemeReceipt.Scode]" Font="Segoe UI, 10pt, style=Bold" TextFill.Color="#003B46" HorzAlign="Center" VertAlign="Center"/>
      <TextObject Name="txtDate" Left="490" Top="69" Width="214" Height="24" Text="Date: [SchemeReceipt.VouDate]" Font="Segoe UI, 10pt, style=Bold" TextFill.Color="#0F172A" HorzAlign="Right" VertAlign="Center"/>

      <!-- Customer & Installment -->
      <TextObject Name="lblCustomer" Left="16" Top="108" Width="180" Height="24" Text="Received From (Customer):" Font="Segoe UI, 9.5pt, style=Bold" TextFill.Color="#475569" VertAlign="Center"/>
      <TextObject Name="txtCustomer" Left="200" Top="108" Width="502" Height="24" Text="[SchemeReceipt.CustomerName]" Font="Segoe UI, 10.5pt, style=Bold" TextFill.Color="#0F172A" VertAlign="Center" Border.Lines="Bottom" Border.Color="#E2E8F0" Border.Style="Dot"/>

      <TextObject Name="lblInst" Left="16" Top="138" Width="180" Height="22" Text="Installment Details:" Font="Segoe UI, 9.5pt, style=Bold" TextFill.Color="#475569" VertAlign="Center"/>
      <TextObject Name="txtInst" Left="200" Top="138" Width="502" Height="22" Text="[SchemeReceipt.InstallmentSummary]" Font="Segoe UI, 10pt, style=Bold" TextFill.Color="#0F4C5C" VertAlign="Center" Border.Lines="Bottom" Border.Color="#E2E8F0" Border.Style="Dot"/>

      <!-- Amount Highlight Box -->
      <TextObject Name="AmountBoxBg" Left="16" Top="170" Width="686" Height="52" Fill.Color="#F0FDF4" Border.Lines="All" Border.Color="#86EFAC" Border.Width="1"/>
      <TextObject Name="lblAmount" Left="26" Top="176" Width="160" Height="22" Text="Amount Received:" Font="Segoe UI, 10pt, style=Bold" TextFill.Color="#166534" VertAlign="Center"/>
      <TextObject Name="txtAmount" Left="200" Top="174" Width="260" Height="26" Text="[SchemeReceipt.AmountFormatted]" Font="Segoe UI, 13pt, style=Bold" TextFill.Color="#003B46" VertAlign="Center"/>
      <TextObject Name="txtMode" Left="470" Top="176" Width="220" Height="22" Text="Mode: [SchemeReceipt.PaymentMode]" Font="Segoe UI, 9.5pt, style=Bold" TextFill.Color="#0F4C5C" HorzAlign="Right" VertAlign="Center"/>
      <TextObject Name="txtAmountWords" Left="26" Top="198" Width="664" Height="20" Text="In Words: [SchemeReceipt.AmountInWords]" Font="Segoe UI, 8.5pt, style=Italic" TextFill.Color="#334155" VertAlign="Center"/>

      <!-- Account, Scheme Info & Ref -->
      <TextObject Name="lblRecvBy" Left="16" Top="232" Width="180" Height="20" Text="Received In (Account):" Font="Segoe UI, 9pt, style=Bold" TextFill.Color="#475569" VertAlign="Center"/>
      <TextObject Name="txtRecvBy" Left="200" Top="232" Width="502" Height="20" Text="[SchemeReceipt.ReceivedByAccount]" Font="Segoe UI, 9.5pt" TextFill.Color="#0F172A" VertAlign="Center"/>

      <TextObject Name="lblSchemeInfo" Left="16" Top="256" Width="180" Height="20" Text="Scheme Summary:" Font="Segoe UI, 9pt, style=Bold" TextFill.Color="#475569" VertAlign="Center"/>
      <TextObject Name="txtSchemeInfo" Left="200" Top="256" Width="502" Height="20" Text="[SchemeReceipt.SchemeDetailsSummary]" Font="Segoe UI, 9pt" TextFill.Color="#0F172A" VertAlign="Center"/>

      <TextObject Name="lblRef" Left="16" Top="280" Width="180" Height="20" Text="Bank / Cheque / Card Ref:" Font="Segoe UI, 9pt, style=Bold" TextFill.Color="#475569" VertAlign="Top"/>
      <TextObject Name="txtRef" Left="200" Top="280" Width="502" Height="24" Text="[SchemeReceipt.ReferenceSummary]" Font="Segoe UI, 9pt" TextFill.Color="#0F172A" VertAlign="Top" CanGrow="true"/>

      <TextObject Name="lblNarration" Left="16" Top="310" Width="180" Height="20" Text="Narration:" Font="Segoe UI, 9pt, style=Bold" TextFill.Color="#475569" VertAlign="Top"/>
      <TextObject Name="txtNarration" Left="200" Top="310" Width="502" Height="38" Text="[SchemeReceipt.Narration]" Font="Segoe UI, 9pt" TextFill.Color="#0F172A" VertAlign="Top" CanGrow="true" Border.Lines="Bottom" Border.Color="#E2E8F0"/>

      <!-- Signature Footer -->
      <TextObject Name="txtPrepSign" Left="16" Top="414" Width="210" Height="34" Text="Prepared By: [SchemeReceipt.PreparedBy]" Font="Segoe UI, 9pt" TextFill.Color="#334155" HorzAlign="Left" VertAlign="Bottom" Border.Lines="Top" Border.Color="#64748B"/>
      <TextObject Name="txtCustSign" Left="254" Top="414" Width="210" Height="34" Text="Customer Signature" Font="Segoe UI, 9pt, style=Bold" TextFill.Color="#334155" HorzAlign="Center" VertAlign="Bottom" Border.Lines="Top" Border.Color="#64748B"/>
      <TextObject Name="txtAuthSign" Left="492" Top="414" Width="210" Height="34" Text="For [SchemeReceipt.CompanyName]" Font="Segoe UI, 9pt, style=Bold" TextFill.Color="#334155" HorzAlign="Right" VertAlign="Bottom" Border.Lines="Top" Border.Color="#64748B"/>
    </DataBand>
  </ReportPage>
</Report>
