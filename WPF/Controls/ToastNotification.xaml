<UserControl x:Class="ConceptJewelleryPro.WPF.Controls.ToastNotification"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
             x:Name="ToastControl"
             Visibility="Collapsed"
             HorizontalAlignment="Right"
             VerticalAlignment="Bottom"
             Margin="0,0,24,24"
             MinWidth="320"
             MaxWidth="640"
             MinHeight="48"
             Panel.ZIndex="9999"
             IsTabStop="False"
             Focusable="False">
    <UserControl.Resources>
        <Storyboard x:Key="ShowToastStoryboard">
            <DoubleAnimation Storyboard.TargetName="ToastBorder"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1"
                             Duration="0:0:0.3">
                <DoubleAnimation.EasingFunction>
                    <QuadraticEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="ToastBorder"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                             From="30" To="0"
                             Duration="0:0:0.3">
                <DoubleAnimation.EasingFunction>
                    <QuadraticEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Storyboard x:Key="HideToastStoryboard">
            <DoubleAnimation Storyboard.TargetName="ToastBorder"
                             Storyboard.TargetProperty="Opacity"
                             From="1" To="0"
                             Duration="0:0:0.25">
                <DoubleAnimation.EasingFunction>
                    <QuadraticEase EasingMode="EaseIn" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="ToastBorder"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                             From="0" To="30"
                             Duration="0:0:0.25">
                <DoubleAnimation.EasingFunction>
                    <QuadraticEase EasingMode="EaseIn" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </UserControl.Resources>

    <Border x:Name="ToastBorder"
            Background="{DynamicResource CardBackgroundBrush}"
            BorderBrush="{Binding ToastBorderBrush, ElementName=ToastControl}"
            BorderThickness="1.5"
            CornerRadius="10"
            Padding="14,12"
            RenderTransformOrigin="0.5,0.5">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24"
                              ShadowDepth="6"
                              Direction="270"
                              Opacity="0.25"
                              Color="#1A202C" />
        </Border.Effect>
        <Border.RenderTransform>
            <TranslateTransform Y="0" />
        </Border.RenderTransform>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border x:Name="IconBorder"
                    Width="32"
                    Height="32"
                    CornerRadius="16"
                    Background="{Binding IconBackground, ElementName=ToastControl}"
                    VerticalAlignment="Center"
                    Margin="0,0,0,0">
                <TextBlock x:Name="IconText"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="17"
                           Foreground="{Binding IconForeground, ElementName=ToastControl}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Border>

            <TextBlock x:Name="MessageText"
                       Grid.Column="1"
                       Text="{Binding Message, ElementName=ToastControl}"
                       FontSize="13.5"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource PrimaryTextBrush}"
                       TextWrapping="Wrap"
                       Margin="12,2,12,2"
                       VerticalAlignment="Center"
                       LineHeight="20"
                       ToolTip="{Binding Message, ElementName=ToastControl}" />

            <telerik:RadButton x:Name="CloseButton"
                               Grid.Column="2"
                               Content="&#xE711;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="14"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Background="Transparent"
                               BorderThickness="0"
                               Width="28"
                               Height="28"
                               Padding="0"
                               VerticalAlignment="Center"
                               Click="CloseButton_Click"
                               IsTabStop="False"
                               Focusable="False"
                               Style="{StaticResource RadButtonStyle}"
                               helpers:ThemeHelper.MouseOverBackgroundBrush="{DynamicResource HoverBrush}"
                               xmlns:helpers="clr-namespace:Telerik.Windows.Controls.Theming.Helpers;assembly=Telerik.Windows.Controls">
                <telerik:RadButton.ToolTip>
                    <ToolTip Content="Dismiss" />
                </telerik:RadButton.ToolTip>
            </telerik:RadButton>
        </Grid>
    </Border>
</UserControl>