<Window x:Class="ConceptJewelleryPro.WPF.Views.OrderEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
        xmlns:vm="clr-namespace:ConceptJewelleryPro.WPF.ViewModels"
        xmlns:converters="clr-namespace:ConceptJewelleryPro.WPF.Converters"
        Title="{Binding Title}"
        Width="1080"
        Height="780"
        MinWidth="800"
        MinHeight="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display">

    <Window.InputBindings>
        <KeyBinding Modifiers="Alt" Key="S" Command="{Binding SaveCommand}" />
        <KeyBinding Key="F10" Command="{Binding SaveCommand}" />
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />

        <Style x:Key="FormCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <Style x:Key="CardHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <Style TargetType="{x:Type telerik:RadWatermarkTextBox}" BasedOn="{StaticResource RadWatermarkTextBoxStyle}">
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
        </Style>


        <Style TargetType="{x:Type telerik:RadDatePicker}">
            <Setter Property="Height" Value="40" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style TargetType="{x:Type telerik:RadComboBox}" BasedOn="{StaticResource RadComboBoxStyle}">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="8,0,4,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. Header Bar -->
        <Border Grid.Row="0"
                Background="{DynamicResource HeaderBackgroundBrush}"
                BorderBrush="{DynamicResource HeaderBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="18,12">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34" Height="34" Background="{DynamicResource PanelBrush}" CornerRadius="6" VerticalAlignment="Center">
                        <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource PrimaryTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" />
                        <TextBlock Text="Record customer jewellery design requirements, weights, making, advance &amp; photos" FontSize="11.5" Foreground="{DynamicResource SecondaryTextBrush}" />
                    </StackPanel>
                </StackPanel>

                <!-- Order Status Badge in Header -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="Status:" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" />
                    <telerik:RadComboBox Width="130"
                                         ItemsSource="{Binding AvailableStatuses}"
                                         SelectedItem="{Binding Status, Mode=TwoWay}"
                                         FontSize="14" />
                    <CheckBox Content="Closed / Delivered"
                              IsChecked="{Binding Closed, Mode=TwoWay}"
                              Margin="14,0,0,0"
                              VerticalAlignment="Center"
                              FontWeight="SemiBold"
                              Foreground="{DynamicResource PrimaryTextBrush}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. Scrollable Body Form -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="18,14">
            <StackPanel>

                <!-- Error Message Banner -->
                <Border Background="#FEE2E2" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="4" Padding="12,8" Margin="0,0,0,12"
                        Visibility="{Binding HasErrorMessage, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#B91C1C" FontWeight="SemiBold" FontSize="12.5" TextWrapping="Wrap" />
                </Border>

                <!-- SECTION 1: Order Meta & Customer Info -->
                <Border Style="{StaticResource FormCardStyle}">
                    <StackPanel>
                        <TextBlock Text="1. ORDER &amp; CUSTOMER DETAILS" Style="{StaticResource CardHeaderStyle}" />

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.1*" />
                                <ColumnDefinition Width="1.1*" />
                                <ColumnDefinition Width="1.1*" />
                                <ColumnDefinition Width="1.1*" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="1.2*" />
                            </Grid.ColumnDefinitions>

                            <!-- Order No -->
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="Order No *" Style="{StaticResource FieldLabelStyle}" />
                                <telerik:RadWatermarkTextBox Text="{Binding OrderNo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             FontWeight="Bold"
                                                             IsReadOnly="{Binding IsOrderNoReadOnly}" />
                            </StackPanel>

                            <!-- Order Category (Order / Requirement) -->
                            <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                <TextBlock Text="Category *" Style="{StaticResource FieldLabelStyle}" />
                                <telerik:RadComboBox ItemsSource="{Binding OrderCategoryOptions}"
                                                     SelectedItem="{Binding OrderCategory, Mode=TwoWay}"
                                                     FontSize="13" />
                            </StackPanel>

                            <!-- Order Date -->
                            <StackPanel Grid.Column="2" Margin="0,0,10,0">
                                <TextBlock Text="Order Date *" Style="{StaticResource FieldLabelStyle}" />
                                <telerik:RadDateTimePicker InputMode="DatePicker" SelectedDate="{Binding OrderDate, Mode=TwoWay}" />
                            </StackPanel>

                            <!-- Delivery Date -->
                            <StackPanel Grid.Column="3" Margin="0,0,10,0">
                                <TextBlock Text="Delivery Due Date" Style="{StaticResource FieldLabelStyle}" />
                                <telerik:RadDateTimePicker InputMode="DatePicker" SelectedDate="{Binding DeliveryDate, Mode=TwoWay}" />
                            </StackPanel>

                            <!-- Customer Name -->
                            <StackPanel Grid.Column="4" Margin="0,0,10,0">
                                <TextBlock Text="Customer Name *" Style="{StaticResource FieldLabelStyle}" />
                                <telerik:RadComboBox ItemsSource="{Binding AvailableCustomers}"
                                                     Text="{Binding CustomerName, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                     IsEditable="True"
                                                     IsFilteringEnabled="True"
                                                     TextSearchMode="Contains" />
                            </StackPanel>

                            <!-- Phone -->
                            <StackPanel Grid.Column="5">
                                <TextBlock Text="Mobile / Phone" Style="{StaticResource FieldLabelStyle}" />
                                <telerik:RadWatermarkTextBox Text="{Binding Phone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             WatermarkContent="Customer phone" />
                            </StackPanel>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>

                            <!-- Address -->
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="Address Line 1" Style="{StaticResource FieldLabelStyle}" />
                                <telerik:RadWatermarkTextBox Text="{Binding Address, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             WatermarkContent="Street / Landmark" />
                            </StackPanel>

                            <!-- Address 2 -->
                            <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                <TextBlock Text="Address Line 2" Style="{StaticResource FieldLabelStyle}" />
                                <telerik:RadWatermarkTextBox Text="{Binding Address2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             WatermarkContent="Area / Location" />
                            </StackPanel>

                            <!-- City -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="City" Style="{StaticResource FieldLabelStyle}" />
                                <telerik:RadWatermarkTextBox Text="{Binding City, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             WatermarkContent="City" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- SECTION 2: Jewellery Specification & Financials & Photo -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.2*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Item Specifications & Calculations -->
                    <Border Grid.Column="0" Style="{StaticResource FormCardStyle}" Margin="0,0,12,14">
                        <StackPanel>
                            <TextBlock Text="2. JEWELLERY SPECIFICATIONS &amp; VALUATION" Style="{StaticResource CardHeaderStyle}" />

                            <!-- Row 1: Item, Purity, Qty, Size -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="0.8*" />
                                    <ColumnDefinition Width="1*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="Item Name *" Style="{StaticResource FieldLabelStyle}" />
                                    <telerik:RadComboBox ItemsSource="{Binding AvailableItemNames}"
                                                         Text="{Binding ItemName, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                         IsEditable="True"
                                                         IsFilteringEnabled="True"
                                                         TextSearchMode="Contains" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                    <TextBlock Text="Purity *" Style="{StaticResource FieldLabelStyle}" />
                                    <telerik:RadComboBox ItemsSource="{Binding AvailablePurityNames}"
                                                         SelectedItem="{Binding Purity, Mode=TwoWay}"
                                                         IsEditable="True" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" Margin="0,0,10,0">
                                    <TextBlock Text="Qty" Style="{StaticResource FieldLabelStyle}" />
                                    <telerik:RadWatermarkTextBox Text="{Binding Qty, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                 TextAlignment="Right" />
                                </StackPanel>

                                <StackPanel Grid.Column="3">
                                    <TextBlock Text="Size" Style="{StaticResource FieldLabelStyle}" />
                                    <telerik:RadWatermarkTextBox Text="{Binding Size, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                 WatermarkContent="e.g. 2.4, 14" />
                                </StackPanel>
                            </Grid>

                            <!-- Row 2: Weight, Metal Rate, Making per gr, Total Making -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="1.2*" />
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="1.2*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="Approx Wt (g) *" Style="{StaticResource FieldLabelStyle}" />
                                    <telerik:RadWatermarkTextBox Text="{Binding AppWeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=N3}"
                                                                 FontWeight="SemiBold"
                                                                 TextAlignment="Right" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                    <TextBlock Text="Metal Rate (₹/g)" Style="{StaticResource FieldLabelStyle}" />
                                    <telerik:RadWatermarkTextBox Text="{Binding MetalRate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"
                                                                 TextAlignment="Right" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" Margin="0,0,10,0">
                                    <TextBlock Text="Making / g (₹)" Style="{StaticResource FieldLabelStyle}" />
                                    <telerik:RadWatermarkTextBox Text="{Binding MakPerGr, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"
                                                                 TextAlignment="Right" />
                                </StackPanel>

                                <StackPanel Grid.Column="3">
                                    <TextBlock Text="Total Making (₹)" Style="{StaticResource FieldLabelStyle}" />
                                    <telerik:RadWatermarkTextBox Text="{Binding Making, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"
                                                                 TextAlignment="Right" />
                                </StackPanel>
                            </Grid>

                            <!-- Row 3: Stone Details -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.5*" />
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="1.2*" />
                                    <ColumnDefinition Width="1.5*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="Stone / Diamond Type" Style="{StaticResource FieldLabelStyle}" />
                                    <telerik:RadWatermarkTextBox Text="{Binding StoneName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                 WatermarkContent="e.g. CZ, Ruby, VVS" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                    <TextBlock Text="Stone Wt (g/ct)" Style="{StaticResource FieldLabelStyle}" />
                                    <telerik:RadWatermarkTextBox Text="{Binding StoneWt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=N3}"
                                                                 TextAlignment="Right" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" Margin="0,0,10,0">
                                    <TextBlock Text="Stone Value (₹)" Style="{StaticResource FieldLabelStyle}" />
                                    <telerik:RadWatermarkTextBox Text="{Binding StoneValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"
                                                                 TextAlignment="Right" />
                                </StackPanel>

                                <StackPanel Grid.Column="3">
                                    <TextBlock Text="Assigned Karigar / Studio" Style="{StaticResource FieldLabelStyle}" />
                                    <telerik:RadWatermarkTextBox Text="{Binding KarigarName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                 WatermarkContent="Karigar / Artisan" />
                                </StackPanel>
                            </Grid>

                            <!-- Row 4: Valuation & Advance Paid Summary Box -->
                            <Border Background="{DynamicResource PanelBrush}" CornerRadius="4" Padding="12,10" Margin="0,4,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.2*" />
                                        <ColumnDefinition Width="1.2*" />
                                        <ColumnDefinition Width="1.2*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Approx Total Value -->
                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Text="Approx Total Value (₹)" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" />
                                        <telerik:RadWatermarkTextBox Text="{Binding AppValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"
                                                                     FontSize="15"
                                                                     FontWeight="Bold"
                                                                     Foreground="{DynamicResource AccentBrush}"
                                                                     TextAlignment="Right" />
                                    </StackPanel>

                                    <!-- Advance Paid -->
                                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                        <TextBlock Text="Advance Paid (₹)" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" />
                                        <telerik:RadWatermarkTextBox Text="{Binding AdvancePaid, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"
                                                                     FontSize="15"
                                                                     FontWeight="Bold"
                                                                     Foreground="#16A34A"
                                                                     TextAlignment="Right" />
                                    </StackPanel>

                                    <!-- Balance Due -->
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Balance Due (₹)" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" />
                                        <Border Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" Height="36" CornerRadius="2" Padding="8,0">
                                            <TextBlock Text="{Binding BalanceDue, StringFormat=N2}"
                                                       FontSize="15"
                                                       FontWeight="Bold"
                                                       Foreground="#DC2626"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Description / Requirement Remarks -->
                            <StackPanel Margin="0,4,0,0">
                                <TextBlock Text="Requirement Description / Special Instructions" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox Text="{Binding Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Height="65"
                                         MinHeight="65"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         FontSize="13"
                                         Padding="8,6"
                                         Background="{DynamicResource InputBackgroundBrush}"
                                         Foreground="{DynamicResource PrimaryTextBrush}"
                                         BorderBrush="{DynamicResource InputBorderBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Right: Design Photo Upload & Preview Card -->
                    <Border Grid.Column="1" Style="{StaticResource FormCardStyle}">
                        <StackPanel>
                            <TextBlock Text="3. DESIGN PHOTO" Style="{StaticResource CardHeaderStyle}" />

                            <!-- Photo Image Box -->
                            <Border BorderBrush="{DynamicResource CardBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Height="230"
                                    MinHeight="200"
                                    Background="{DynamicResource PanelBrush}"
                                    Margin="0,0,0,10">
                                <Grid>
                                    <!-- Placeholder if No Image -->
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                                Visibility="{Binding HasPhoto, Converter={StaticResource InverseBoolToVis}}">
                                        <TextBlock Text="&#xEB9F;" FontFamily="Segoe MDL2 Assets" FontSize="42" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center" />
                                        <TextBlock Text="No Image Uploaded" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,6,0,0" HorizontalAlignment="Center" />
                                    </StackPanel>

                                    <!-- Actual Image Preview -->
                                    <Image Source="{Binding PhotoPreviewPath}"
                                           Stretch="Uniform"
                                           Margin="4"
                                           Visibility="{Binding HasPhoto, Converter={StaticResource BoolToVis}}" />
                                </Grid>
                            </Border>

                            <!-- Image Action Buttons -->
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <telerik:RadButton Grid.Column="0"
                                                   Content="📁 Browse..."
                                                   Command="{Binding BrowseImageCommand}"
                                                   Margin="0,0,4,0"
                                                   FontWeight="SemiBold"
                                                   ToolTip="Upload image from computer" />

                                <telerik:RadButton Grid.Column="1"
                                                   Content="📋 Paste"
                                                   Command="{Binding PasteImageCommand}"
                                                   Margin="4,0,0,0"
                                                   FontWeight="SemiBold"
                                                   ToolTip="Paste image from clipboard" />
                            </Grid>

                            <telerik:RadButton Content="✕ Clear Image"
                                               Command="{Binding ClearImageCommand}"
                                               Foreground="{DynamicResource ErrorBrush}"
                                               Visibility="{Binding HasPhoto, Converter={StaticResource BoolToVis}}"
                                               Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- 3. Footer Bar with Action Buttons -->
        <Border Grid.Row="2"
                Background="{DynamicResource HeaderBackgroundBrush}"
                BorderBrush="{DynamicResource HeaderBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="18,12">
            <Grid>
                <TextBlock Text="* Required fields" FontSize="11.5" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <telerik:RadButton Content="Save Order (Alt+S)"
                                       Style="{StaticResource PrimaryToolbarButtonStyle}"
                                       Command="{Binding SaveCommand}"
                                       MinWidth="140"

                                       FontSize="13"
                                       FontWeight="Bold"
                                       Margin="0,0,8,0" />

                    <telerik:RadButton Content="Cancel (Esc)"
                                       Style="{StaticResource ToolbarButtonStyle}"
                                       Command="{Binding CancelCommand}"
                                       MinWidth="100"
                                       FontSize="13" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
