<Window x:Class="ConceptJewelleryPro.WPF.Views.Gstr1ExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
        Title="Generate GSTR-1 JSON - Concept Jewellery Pro"
        Width="820" Height="680" MinWidth="700" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="Segoe UI">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14,12"/>
        </Style>

        <Style x:Key="MiniMetricStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10,8"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 0: Header -->
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/> <!-- 2: Configuration & Parameters -->
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/> <!-- 4: Summary Cards -->
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>    <!-- 6: JSON Preview -->
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/> <!-- 8: Action Buttons -->
        </Grid.RowDefinitions>

        <!-- 0: Header -->
        <Border Grid.Row="0" Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="40" Height="40" CornerRadius="8" Background="#047857" Margin="0,0,12,0" VerticalAlignment="Center">
                    <TextBlock Text="&#xE825;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="20"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Generate GSTR-1 JSON (Outward Supplies)" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <TextBlock Text="{Binding CompanyName}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="12"/>
                        <TextBlock Text="  •  " Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12"/>
                        <TextBlock Text="{Binding GstSourceInfo}" Foreground="#16A34A" FontWeight="Medium" FontSize="11.5"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2: Configuration & Parameters -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="1.4*"/>
                    </Grid.ColumnDefinitions>

                    <!-- GSTIN -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Taxpayer GSTIN *" FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding Gstin, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 MaxLength="15"
                                 FontSize="13"
                                 FontWeight="Bold"
                                 Height="32"
                                 Padding="6,4"
                                 VerticalContentAlignment="Center"
                                 ToolTip="15-character Goods and Services Tax Identification Number (Auto-loaded from DateRange table)"/>
                        <TextBlock Text="Loaded from DateRange" FontSize="10" Foreground="#16A34A" Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- Return Period -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Return Period (MMYYYY) *" FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding ReturnPeriod, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 MaxLength="6"
                                 FontSize="13"
                                 FontWeight="Bold"
                                 Height="32"
                                 Padding="6,4"
                                 VerticalContentAlignment="Center"
                                 ToolTip="Month and Year format: MMYYYY (e.g. 092026 for Sep 2026)"/>
                        <TextBlock Text="Matches Portal Period" FontSize="10" Foreground="#2563EB" Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- Return Period Details -->
                    <StackPanel Grid.Column="4" VerticalAlignment="Center">
                        <TextBlock Text="Report Date Range" FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding PeriodDisplay}"
                                   FontSize="12.5"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- Validation Error Message -->
                <TextBlock Text="{Binding ValidationMessage}"
                           Foreground="#DC2626"
                           FontSize="11.5"
                           FontWeight="SemiBold"
                           Margin="0,8,0,0"
                           TextWrapping="Wrap"
                           Visibility="{Binding HasErrors, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
        </Border>

        <!-- 4: Summary Cards -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Card 1: B2B Invoices -->
            <Border Grid.Column="0" Style="{StaticResource MiniMetricStyle}" BorderBrush="#2563EB" BorderThickness="1.5">
                <StackPanel>
                    <TextBlock Text="4A - B2B INVOICES" FontSize="10.5" FontWeight="Bold" Foreground="#2563EB"/>
                    <TextBlock Text="{Binding B2BInvoiceCount, StringFormat='{}{0} Invoices'}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,3,0,0"/>
                    <TextBlock Text="Registered B2B sales" FontSize="10.5" Foreground="{DynamicResource SecondaryTextBrush}"/>
                </StackPanel>
            </Border>

            <!-- Card 2: B2C Small Summaries -->
            <Border Grid.Column="2" Style="{StaticResource MiniMetricStyle}" BorderBrush="#059669" BorderThickness="1.5">
                <StackPanel>
                    <TextBlock Text="7 - B2C (SMALL) RETAIL" FontSize="10.5" FontWeight="Bold" Foreground="#059669"/>
                    <TextBlock Text="{Binding B2CSCount, StringFormat='{}{0} Rate Groups'}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,3,0,0"/>
                    <TextBlock Text="Retail consumers sales" FontSize="10.5" Foreground="{DynamicResource SecondaryTextBrush}"/>
                </StackPanel>
            </Border>

            <!-- Card 3: Total Taxable & Tax -->
            <Border Grid.Column="4" Style="{StaticResource MiniMetricStyle}" BorderBrush="#7C3AED" BorderThickness="1.5">
                <StackPanel>
                    <TextBlock Text="TOTAL TAXABLE &amp; TAX" FontSize="10.5" FontWeight="Bold" Foreground="#7C3AED"/>
                    <TextBlock Text="{Binding TotalTaxableSales, StringFormat='₹{0:N2}'}" FontSize="15" FontWeight="Bold" Foreground="#7C3AED" Margin="0,3,0,0"/>
                    <TextBlock Text="{Binding TotalTax, StringFormat='Tax: ₹{0:N2}'}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 6: JSON Preview -->
        <Border Grid.Row="6" Style="{StaticResource CardStyle}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{DynamicResource HeaderBackgroundBrush}" Padding="12,8" CornerRadius="8,8,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{}{ } GSTR-1 JSON Payload Preview" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock Text="{Binding CopyStatus}" Foreground="#16A34A" FontWeight="Medium" FontSize="11" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>

                        <telerik:RadButton Grid.Column="1"
                                           Content="📋 Copy JSON"
                                           Command="{Binding CopyJsonCommand}"
                                           Height="26" Padding="10,2"
                                           FontSize="11"/>
                    </Grid>
                </Border>

                <TextBox Grid.Row="1"
                         Text="{Binding JsonPreview, Mode=OneWay}"
                         IsReadOnly="True"
                         FontFamily="Consolas, Cascadia Code, Courier New"
                         FontSize="12"
                         Foreground="{DynamicResource PrimaryTextBrush}"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="12,10"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         AcceptsReturn="True"
                         TextWrapping="NoWrap"/>
            </Grid>
        </Border>

        <!-- 8: Action Buttons -->
        <Grid Grid.Row="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="Compatible with GST Portal (gst.gov.in) Returns Dashboard &amp; Offline Tool."
                       FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"
                       VerticalAlignment="Center"/>

            <telerik:RadButton Grid.Column="1"
                               Content="Cancel"
                               Command="{Binding CloseCommand}"
                               Width="80" Height="34" Margin="0,0,10,0"/>

            <telerik:RadButton Grid.Column="2"
                               Content="📗 Export GSTR-1 Excel"
                               Command="{Binding ExportExcelCommand}"
                               Width="180" Height="34" Margin="0,0,10,0"
                               Style="{DynamicResource ToolbarButtonStyle}"
                               FontWeight="SemiBold"
                               ToolTip="Export official GSTR-1 offline utility Excel workbook with b2b, b2cl, b2cs, cdnr, hsn, docs sheets"/>

            <telerik:RadButton Grid.Column="3"
                               Content="💾 Save GSTR-1 JSON File"
                               Command="{Binding SaveJsonCommand}"
                               Width="190" Height="34"
                               Style="{DynamicResource PrimaryToolbarButtonStyle}"
                               FontWeight="Bold"/>
        </Grid>
    </Grid>
</Window>
