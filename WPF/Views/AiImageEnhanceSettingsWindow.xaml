<Window x:Class="ConceptJewelleryPro.WPF.Views.AiImageEnhanceSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
        xmlns:conv="clr-namespace:ConceptJewelleryPro.WPF.Converters"
        mc:Ignorable="d"
        Title="AI Image Enhancement &amp; Background Studio"
        Width="1200" Height="780"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        FontFamily="Segoe UI">

    <Window.Resources>
        <conv:EqualityToBoolConverter x:Key="EqualityToBoolConverter" />
        <conv:EqualityToBoolMultiConverter x:Key="EqualityToBoolMultiConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="SettingCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <Style x:Key="SliderHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="SliderValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto" />
            <!-- Main Content (Preview + Settings) -->
            <RowDefinition Height="*" />
            <!-- Footer Action Bar -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="36" Height="36" CornerRadius="8" Background="{DynamicResource AccentGradient}" Margin="0,0,10,0">
                    <TextBlock Text="&#xE706;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel>
                    <TextBlock Text="AI Image Enhancement &amp; Background Studio" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" />
                    <TextBlock Text="Google Gemini &amp; Neural models for showroom-grade jewellery photography" FontSize="11.5" Foreground="{DynamicResource SecondaryTextBrush}" />
                </StackPanel>
            </StackPanel>

            <!-- Preset Dropdown -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Preset: " FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,6,0" />
                <telerik:RadComboBox ItemsSource="{Binding StylePresets}"
                                     SelectedItem="{Binding SelectedPreset, Mode=TwoWay}"
                                     Width="220" Height="34" />
            </StackPanel>
        </Grid>

        <!-- MAIN CONTENT (2 COLUMNS: PREVIEW | CONTROLS) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Image Comparison Preview (55%) -->
                <ColumnDefinition Width="1.2*" />
                <!-- Sliders & Color Presets (45%) -->
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <!-- ================= LEFT COLUMN: BEFORE / AFTER PREVIEW ================= -->
            <Border Grid.Column="0" Style="{StaticResource SettingCard}" Margin="0,0,8,0" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Live Real-Time Comparison" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource PrimaryTextBrush}" Margin="4,0,0,8" />

                    <!-- Side-by-side or stacked preview -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Before (Raw Original) -->
                        <Border Grid.Column="0" Background="#18181B" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Margin="0,0,4,0">
                            <Grid>
                                <Image Source="{Binding OriginalImage}" Stretch="Uniform" Margin="6" />
                                <!-- Badge -->
                                <Border Background="#90000000" CornerRadius="4" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" Padding="6,2">
                                    <TextBlock Text="Original (Raw)" FontSize="10.5" FontWeight="SemiBold" Foreground="#E0E0E0" />
                                </Border>
                            </Grid>
                        </Border>

                        <!-- After (AI Enhanced Preview) -->
                        <Border Grid.Column="1" Background="#18181B" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1.5" CornerRadius="6" Margin="4,0,0,0">
                            <Grid>
                                <Image Source="{Binding EnhancedPreview}" Stretch="Uniform" Margin="6" />

                                <!-- Badge -->
                                <Border Background="{DynamicResource AccentGradient}" CornerRadius="4" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" Padding="6,2">
                                    <TextBlock Text="✨ AI Enhanced" FontSize="10.5" FontWeight="Bold" Foreground="White" />
                                </Border>

                                <!-- Loading overlay -->
                                <Border Background="#B0000000" CornerRadius="6" Visibility="{Binding IsGeneratingPreview, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="28" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" />
                                        <TextBlock Text="Rendering AI..." FontSize="12" FontWeight="SemiBold" Foreground="White" Margin="0,6,0,0" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Status Notification / Helper -->
                    <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="4,8,4,0" TextTrimming="CharacterEllipsis" />
                </Grid>
            </Border>

            <!-- ================= RIGHT COLUMN: FINE-TUNE CONTROLS ================= -->
            <ScrollViewer Grid.Column="1" Margin="8,0,0,0" VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <!-- 0. AI Engine & Connectivity -->
                    <Border Style="{StaticResource SettingCard}">
                        <StackPanel>
                            <TextBlock Text="AI Engine Mode" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,6" />
                            <telerik:RadComboBox ItemsSource="{Binding EngineModeOptions}"
                                                 SelectedItem="{Binding SelectedEngineModeString, Mode=TwoWay}"
                                                 Width="400"
                                                 Margin="0,0,0,8" />

                            <!-- Google AI Studio API Key & Custom Prompt (Visible when Google Engine selected) -->
                            <StackPanel Visibility="{Binding IsGoogleEngine, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="Google AI Studio API Key (Free)" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,3" />
                                <telerik:RadWatermarkTextBox Text="{Binding GoogleAiApiKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             WatermarkContent="Paste free Google AI Studio API Key (AIzaSy...)"
                                                             
                                                             Width="400"
                                                             Margin="0,0,0,8" />

                                <!-- Custom AI Prompt -->
                                <Grid Margin="0,0,0,3">
                                    <TextBlock Text="Custom AI Prompt" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" />
                                    <Button Command="{Binding ResetPromptCommand}" Background="Transparent" BorderBrush="Transparent" HorizontalAlignment="Right" Cursor="Hand">
                                        <TextBlock Text="↺ Reset Prompt" FontSize="10.5" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" />
                                    </Button>
                                </Grid>
                                <TextBox Text="{Binding CustomPrompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         Height="60"
                                         Width="400"
                                         FontSize="11"
                                         VerticalScrollBarVisibility="Auto"
                                         Padding="6,4"
                                         Margin="0,0,0,4" />
                            </StackPanel>

                            <!-- Hugging Face API Key Box (Active when HF selected) -->
                            <StackPanel Visibility="{Binding IsHuggingFaceEngine, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="Hugging Face API Token (Free Optional)" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,3" />
                                <telerik:RadWatermarkTextBox Text="{Binding HuggingFaceApiKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             WatermarkContent="Paste hf_... token (optional for higher rate limits)"
                                                             Height="32" />
                                <TextBlock Text="Using BRIA RMBG-1.4 state-of-the-art neural cutout for pristine silver &amp; diamonds." FontSize="10.5" Foreground="{DynamicResource AccentBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 1. Background Isolation & Color Presets -->
                    <Border Style="{StaticResource SettingCard}">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="1. Background Canvas" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" />
                                <CheckBox Content="Neutralize Background"
                                          IsChecked="{Binding NeutralizeBackground, Mode=TwoWay}"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Center"
                                          FontWeight="SemiBold"
                                          Foreground="{DynamicResource AccentBrush}" />
                            </Grid>

                            <!-- Color Palette Chips -->
                            <ItemsControl ItemsSource="{Binding BackgroundPresets}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <RadioButton GroupName="BgColorGroup"
                                                     Command="{Binding DataContext.SelectBackgroundPresetCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                     CommandParameter="{Binding HexColor}"
                                                     Margin="0,0,6,6"
                                                     Cursor="Hand">
                                            <RadioButton.IsChecked>
                                                <MultiBinding Converter="{StaticResource EqualityToBoolMultiConverter}" Mode="OneWay">
                                                    <Binding Path="HexColor" />
                                                    <Binding Path="DataContext.SelectedBackgroundColor" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                </MultiBinding>
                                            </RadioButton.IsChecked>
                                            <RadioButton.Template>
                                                <ControlTemplate TargetType="RadioButton">
                                                    <Border x:Name="ChipBorder"
                                                            Background="{DynamicResource PanelBrush}"
                                                            BorderBrush="{DynamicResource CardBorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="6"
                                                            Padding="8,5">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <!-- Color Dot -->
                                                            <Border Width="14" Height="14" CornerRadius="7" Background="{Binding DisplayColor}" BorderBrush="#808080" BorderThickness="1" Margin="0,0,6,0" />
                                                            <TextBlock Text="{Binding Name}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                                                        </StackPanel>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsChecked" Value="True">
                                                            <Setter TargetName="ChipBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                            <Setter TargetName="ChipBorder" Property="Background" Value="{DynamicResource AccentHoverBrush}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </RadioButton.Template>
                                        </RadioButton>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- 2. Lighting & Polish Sliders -->
                    <Border Style="{StaticResource SettingCard}">
                        <StackPanel>
                            <TextBlock Text="2. Lighting &amp; Metallic Polish" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,10" />

                            <!-- Brightness -->
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="☀️ Brightness / Exposure" Style="{StaticResource SliderHeader}" />
                                <TextBlock Text="{Binding Brightness, StringFormat='{}{0:+0;-0;0}'}" Style="{StaticResource SliderValue}" />
                            </Grid>
                            <Slider Minimum="-50" Maximum="50" Value="{Binding Brightness, Mode=TwoWay}" Margin="0,0,0,10" />

                            <!-- Contrast -->
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="🌓 Contrast" Style="{StaticResource SliderHeader}" />
                                <TextBlock Text="{Binding Contrast, StringFormat='{}{0:+0;-0;0}'}" Style="{StaticResource SliderValue}" />
                            </Grid>
                            <Slider Minimum="-50" Maximum="50" Value="{Binding Contrast, Mode=TwoWay}" Margin="0,0,0,10" />

                            <!-- Warmth (Gold Tone) -->
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="🎨 Warmth (Rich Yellow Gold Tone)" Style="{StaticResource SliderHeader}" />
                                <TextBlock Text="{Binding Warmth, StringFormat='{}{0:+0;-0;0}'}" Style="{StaticResource SliderValue}" />
                            </Grid>
                            <Slider Minimum="-50" Maximum="50" Value="{Binding Warmth, Mode=TwoWay}" Margin="0,0,0,10" />

                            <!-- Vibrance -->
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="🌈 Color Vibrance" Style="{StaticResource SliderHeader}" />
                                <TextBlock Text="{Binding Vibrance, StringFormat='{}{0:+0;-0;0}'}" Style="{StaticResource SliderValue}" />
                            </Grid>
                            <Slider Minimum="-50" Maximum="50" Value="{Binding Vibrance, Mode=TwoWay}" Margin="0,0,0,10" />

                            <!-- Diamond Sharpness -->
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="💎 Diamond Facet &amp; Filigree Sharpness" Style="{StaticResource SliderHeader}" />
                                <TextBlock Text="{Binding Sharpness, StringFormat='{}{0}%'}" Style="{StaticResource SliderValue}" />
                            </Grid>
                            <Slider Minimum="0" Maximum="100" Value="{Binding Sharpness, Mode=TwoWay}" Margin="0,0,0,4" />
                        </StackPanel>
                    </Border>

                    <!-- 3. Shadow & Framing -->
                    <Border Style="{StaticResource SettingCard}">
                        <StackPanel>
                            <TextBlock Text="3. Contact Shadow &amp; Auto-Framing" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,10" />

                            <!-- Shadow Toggle & Intensity -->
                            <Grid Margin="0,0,0,8">
                                <CheckBox Content="Ground Contact Drop Shadow"
                                          IsChecked="{Binding EnableContactShadow, Mode=TwoWay}"
                                          FontWeight="SemiBold"
                                          Foreground="{DynamicResource PrimaryTextBrush}"
                                          VerticalAlignment="Center" />
                                <TextBlock Text="{Binding ShadowIntensity, StringFormat='{}{0}%'}" Style="{StaticResource SliderValue}" />
                            </Grid>
                            <Slider Minimum="0" Maximum="100" Value="{Binding ShadowIntensity, Mode=TwoWay}" IsEnabled="{Binding EnableContactShadow}" Margin="0,0,0,10" />

                            <!-- Margin Padding -->
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="🔲 Auto-Center &amp; Margin Padding" Style="{StaticResource SliderHeader}" />
                                <TextBlock Text="{Binding AutoCenterPadding, StringFormat='{}{0}%'}" Style="{StaticResource SliderValue}" />
                            </Grid>
                            <Slider Minimum="0" Maximum="25" Value="{Binding AutoCenterPadding, Mode=TwoWay}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- FOOTER ACTION BAR -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Reset / Defaults buttons -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Command="{Binding SaveAsDefaultCommand}"
                        Background="{DynamicResource PanelBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1"
                        Padding="12,6"
                        Cursor="Hand"
                        Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                        <TextBlock Text=" Save as Default" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Command="{Binding ResetDefaultsCommand}"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        Padding="8,6"
                        Cursor="Hand">
                    <TextBlock Text="Reset Defaults" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" TextDecorations="Underline" />
                </Button>
            </StackPanel>

            <!-- Apply & Cancel -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Command="{Binding CancelCommand}"
                        Background="{DynamicResource PanelBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1"
                        Padding="16,7"
                        Cursor="Hand"
                        Margin="0,0,8,0">
                    <TextBlock Text="Cancel" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                </Button>

                <Button Command="{Binding ApplyCommand}"
                        Background="{DynamicResource AccentGradient}"
                        BorderThickness="0"
                        Padding="20,7"
                        Cursor="Hand">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE706;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="White" VerticalAlignment="Center" />
                        <TextBlock Text=" Apply &amp; Enhance Image" FontSize="12.5" FontWeight="Bold" Foreground="White" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
