<UserControl x:Class="ConceptJewelleryPro.WPF.Views.BoxMasterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
             xmlns:controls="clr-namespace:ConceptJewelleryPro.WPF.Controls"
             FontFamily="Segoe UI"
             TextOptions.TextFormattingMode="Display">

    <UserControl.Resources>
        <Style x:Key="ToolbarButtonStyle" TargetType="telerik:RadButton" BasedOn="{StaticResource RadButtonStyle}">
            
            <Setter Property="MinWidth" Value="80" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>

        <Style x:Key="AccentToolbarButtonStyle" TargetType="telerik:RadButton" BasedOn="{StaticResource ToolbarButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Toast Notifications Container -->
        <controls:ToastNotification Grid.Row="0"
                                    Grid.RowSpan="2"
                                    Panel.ZIndex="99"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    Margin="0,0,24,24"
                                    Message="{Binding ToastMessage}"
                                    ToastType="{Binding ToastType}" />

        <!-- Page Header & Action Bar -->
        <Border Grid.Row="0"
                Background="{DynamicResource HeaderBackgroundBrush}"
                BorderBrush="{DynamicResource HeaderBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="36" Height="36" CornerRadius="8" Background="{DynamicResource AccentBrush}">
                        <TextBlock Text="&#xE8F1;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="16"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Box Master" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                        <TextBlock Text="Manage physical stock boxes, rack storage positions and serial indexing" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" />
                    </StackPanel>
                </StackPanel>

                <!-- Search & Actions Bar -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <telerik:RadButton Content="+ Add New Box"
                                       Style="{StaticResource AccentToolbarButtonStyle}"
                                       Command="{Binding AddCommand}" />

                    <telerik:RadButton Content="Edit"
                                       Style="{StaticResource ToolbarButtonStyle}"
                                       Command="{Binding EditCommand}" />

                    <telerik:RadButton Content="Delete"
                                       Style="{StaticResource ToolbarButtonStyle}"
                                       Command="{Binding DeleteCommand}" />

                    <telerik:RadButton Content="Refresh"
                                       Style="{StaticResource ToolbarButtonStyle}"
                                       Command="{Binding RefreshCommand}" />

                    <telerik:RadButton Style="{StaticResource ToolbarButtonStyle}"
                                       Command="{Binding PrintCommand}"
                                       ToolTip="Print Selected Box Labels (A4 FlowDocument)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE749;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       Margin="0,0,5,0" />
                            <TextBlock Text="Print" VerticalAlignment="Center" />
                        </StackPanel>
                    </telerik:RadButton>

                    <Border Width="1" Background="{DynamicResource SeparatorBrush}" Margin="4,4,12,4" />

                    <!-- Rack Filter -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock Text="Rack:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <telerik:RadComboBox ItemsSource="{Binding Racks}"
                                             SelectedItem="{Binding SelectedRack, Mode=TwoWay}"
                                             
                                             Width="100"
                                             IsEditable="False" />
                    </StackPanel>

                    <!-- Search Filter Box -->
                    <Border Width="220"
                            Height="32"
                            CornerRadius="6"
                            Background="{DynamicResource InputBackgroundBrush}"
                            BorderBrush="{DynamicResource InputBorderBrush}"
                            BorderThickness="1">
                        <Grid Margin="8,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE721;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="12"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       VerticalAlignment="Center" />
                            <telerik:RadWatermarkTextBox Grid.Column="1"
                                                         Margin="6,0,0,0"
                                                         Height="28"
                                                         VerticalAlignment="Center"
                                                         Padding="0"
                                                         Background="Transparent"
                                                         BorderThickness="0"
                                                         FontSize="12"
                                                         WatermarkContent="Search Box No, Name, Rack..."
                                                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content: RadGridView -->
        <telerik:RadBusyIndicator Grid.Row="1" IsBusy="{Binding IsBusy, Mode=OneWay}" BusyContent="Loading boxes...">
            <Grid Margin="20,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="0">
                    <telerik:RadGridView x:Name="BoxesGrid"
                                         ItemsSource="{Binding Boxes}"
                                         SelectedItem="{Binding SelectedBox, Mode=TwoWay}"
                                         AutoGenerateColumns="False"
                                         IsReadOnly="False"
                                         SelectionMode="Single"
                                         CanUserInsertRows="False"
                                         CanUserDeleteRows="False"
                                         CanUserSortColumns="True"
                                         ShowGroupPanel="False"
                                         RowIndicatorVisibility="Collapsed"
                                         RowHeight="36"
                                         FontSize="13"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         MouseDoubleClick="BoxesGrid_MouseDoubleClick">
                        <telerik:RadGridView.Columns>
                            <!-- Selection CheckBox Column -->
                            <telerik:GridViewColumn Width="45" TextAlignment="Center" IsResizable="False">
                                <telerik:GridViewColumn.Header>
                                    <CheckBox HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              IsChecked="{Binding DataContext.IsAllSelected, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"
                                              ToolTip="Select All / Deselect All" />
                                </telerik:GridViewColumn.Header>
                                <telerik:GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </DataTemplate>
                                </telerik:GridViewColumn.CellTemplate>
                            </telerik:GridViewColumn>

                            <telerik:GridViewDataColumn Header="Serial"
                                                        DataMemberBinding="{Binding Serial}"
                                                        TextAlignment="Center"
                                                        IsReadOnly="True"
                                                        Width="80" />

                            <telerik:GridViewDataColumn Header="BOX NO"
                                                        DataMemberBinding="{Binding BoxNo}"
                                                        IsReadOnly="True"
                                                        Width="140" />

                            <telerik:GridViewDataColumn Header="BOX NAME"
                                                        DataMemberBinding="{Binding BoxName}"
                                                        IsReadOnly="True"
                                                        Width="220" />

                            <telerik:GridViewDataColumn Header="RACK"
                                                        DataMemberBinding="{Binding Rack}"
                                                        TextAlignment="Center"
                                                        IsReadOnly="True"
                                                        Width="110" />

                            <telerik:GridViewDataColumn Header="NO OF BOXES"
                                                        DataMemberBinding="{Binding NumberOfBoxes}"
                                                        TextAlignment="Right"
                                                        IsReadOnly="True"
                                                        Width="110" />

                            <telerik:GridViewDataColumn Header="BOX WT (g)"
                                                        DataMemberBinding="{Binding BoxWt, StringFormat='{}{0:N3}'}"
                                                        TextAlignment="Right"
                                                        IsReadOnly="True"
                                                        Width="110" />

                            <telerik:GridViewDataColumn Header="Status" Width="100" IsReadOnly="True">
                                <telerik:GridViewDataColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="4"
                                                Padding="8,2"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#E8F5E9" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Inactive">
                                                             <Setter Property="Background" Value="#FFEBEE" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#2E7D32" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Inactive">
                                                                <Setter Property="Foreground" Value="#C62828" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </telerik:GridViewDataColumn.CellTemplate>
                            </telerik:GridViewDataColumn>

                            <telerik:GridViewDataColumn Header="Remarks"
                                                        DataMemberBinding="{Binding Remarks}"
                                                        IsReadOnly="True"
                                                        Width="*" />
                        </telerik:RadGridView.Columns>
                    </telerik:RadGridView>
                </Border>

                <!-- Bottom Status / Count Bar -->
                <Border Grid.Row="1"
                        Background="{DynamicResource PanelBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="12,6"
                        Margin="0,8,0,0">
                    <Grid>
                        <TextBlock Text="{Binding StatusMessage}"
                                   FontSize="11.5"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   VerticalAlignment="Center" />

                        <TextBlock HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   FontSize="11.5"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}">
                            <Run Text="Total Boxes: " />
                            <Run Text="{Binding TotalBoxesCount, Mode=OneWay}" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                            <Run Text="   |   Selected: " />
                            <Run Text="{Binding SelectedBoxesCount, Mode=OneWay}" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                        </TextBlock>
                    </Grid>
                </Border>

            </Grid>
        </telerik:RadBusyIndicator>
    </Grid>
</UserControl>
