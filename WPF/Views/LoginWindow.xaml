<Window x:Class="ConceptJewelleryPro.WPF.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
        xmlns:helpers="clr-namespace:Telerik.Windows.Controls.Theming.Helpers;assembly=Telerik.Windows.Controls"
        Title="Concept Jewellery Pro - Login"
        Width="480"
        Height="780"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <LinearGradientBrush x:Key="BackgroundBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0A0F1F" Offset="0" />
            <GradientStop Color="#1A1B45" Offset="0.55" />
            <GradientStop Color="#0E1E33" Offset="1" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="CardBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#2EFFFFFF" Offset="0" />
            <GradientStop Color="#12FFFFFF" Offset="0.55" />
            <GradientStop Color="#08FFFFFF" Offset="1" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="GoldGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#F5BB4A" Offset="0" />
            <GradientStop Color="#D98E1B" Offset="1" />
        </LinearGradientBrush>

        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F1F5F9" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#9AA7BC" />
        <SolidColorBrush x:Key="LabelBrush" Color="#C9D4E3" />
        <SolidColorBrush x:Key="InputBrush" Color="#1B2438" />
        <SolidColorBrush x:Key="InputBorderBrush" Color="#40FFFFFF" />
        <SolidColorBrush x:Key="GlassLineBrush" Color="#30FFFFFF" />

        <Style TargetType="telerik:RadWatermarkTextBox"
               BasedOn="{StaticResource RadWatermarkTextBoxStyle}">
            <Setter Property="helpers:ThemeHelper.MouseOverBackgroundBrush" Value="{StaticResource InputBrush}" />
            <Setter Property="helpers:ThemeHelper.FocusBackgroundBrush" Value="{StaticResource InputBrush}" />
            <Setter Property="helpers:ThemeHelper.ReadOnlyBackgroundBrush" Value="{StaticResource InputBrush}" />
            <Setter Property="helpers:ThemeHelper.DisabledBackgroundBrush" Value="{StaticResource InputBrush}" />
            <Setter Property="helpers:ThemeHelper.MouseOverBrush" Value="{StaticResource InputBorderBrush}" />
            <Setter Property="helpers:ThemeHelper.FocusBrush" Value="{StaticResource InputBorderBrush}" />
            <Setter Property="CaretBrush" Value="#B7C6DC" />
            <Setter Property="WatermarkTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}"
                                   Foreground="#8494AB"
                                   VerticalAlignment="Center"
                                   Margin="2,0,0,0" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="telerik:RadPasswordBox"
               BasedOn="{StaticResource RadPasswordBoxStyle}">
            <Setter Property="helpers:ThemeHelper.MouseOverBackgroundBrush" Value="{StaticResource InputBrush}" />
            <Setter Property="helpers:ThemeHelper.FocusBackgroundBrush" Value="{StaticResource InputBrush}" />
            <Setter Property="helpers:ThemeHelper.ReadOnlyBackgroundBrush" Value="{StaticResource InputBrush}" />
            <Setter Property="helpers:ThemeHelper.DisabledBackgroundBrush" Value="{StaticResource InputBrush}" />
            <Setter Property="helpers:ThemeHelper.MouseOverBrush" Value="{StaticResource InputBorderBrush}" />
            <Setter Property="helpers:ThemeHelper.FocusBrush" Value="{StaticResource InputBorderBrush}" />
            <Setter Property="CaretBrush" Value="#B7C6DC" />
            <Setter Property="WatermarkTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}"
                                   Foreground="#8494AB"
                                   VerticalAlignment="Center"
                                   Margin="2,0,0,0" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource LabelBrush}" />
        </Style>

        <Style x:Key="GlassIconButtonStyle" TargetType="telerik:RadButton">
            <Setter Property="Foreground" Value="#B9C6D8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="telerik:RadButton">
                        <Border x:Name="B"
                                Background="Transparent"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#22FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#30FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="telerik:RadButton">
            <Setter Property="Foreground" Value="#2A1B06" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="telerik:RadButton">
                        <Border x:Name="Btn"
                                CornerRadius="11"
                                Background="{StaticResource GoldGradient}">
                            <Border.Effect>
                                <DropShadowEffect Color="#C98A12"
                                                  BlurRadius="22"
                                                  ShadowDepth="0"
                                                  Opacity="0.5" />
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Btn" Property="Opacity" Value="0.92" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Btn" Property="Opacity" Value="0.82" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Btn" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="26"
            ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="32"
                              ShadowDepth="0"
                              Opacity="0.45"
                              Color="#000000" />
        </Border.Effect>

        <Grid>
            <Border CornerRadius="26" Background="{StaticResource BackgroundBrush}" />

            <Ellipse Width="280"
                     Height="280"
                     HorizontalAlignment="Left"
                     VerticalAlignment="Top"
                     Margin="-90,-110,0,0">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#8A7C3AED" Offset="0" />
                        <GradientStop Color="#007C3AED" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.Effect>
                    <BlurEffect Radius="70" />
                </Ellipse.Effect>
            </Ellipse>

            <Ellipse Width="320"
                     Height="320"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Top"
                     Margin="0,60,0,0">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#7A4F46E5" Offset="0" />
                        <GradientStop Color="#004F46E5" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.Effect>
                    <BlurEffect Radius="78" />
                </Ellipse.Effect>
            </Ellipse>

            <Ellipse Width="300"
                     Height="300"
                     HorizontalAlignment="Right"
                     VerticalAlignment="Bottom"
                     Margin="0,0,-80,-100">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#7A14B8A6" Offset="0" />
                        <GradientStop Color="#0014B8A6" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.Effect>
                    <BlurEffect Radius="72" />
                </Ellipse.Effect>
            </Ellipse>

            <Ellipse Width="150"
                     Height="150"
                     HorizontalAlignment="Right"
                     VerticalAlignment="Center"
                     Margin="0,180,-50,0">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#5EF5B940" Offset="0" />
                        <GradientStop Color="#00F5B940" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.Effect>
                    <BlurEffect Radius="48" />
                </Ellipse.Effect>
            </Ellipse>

            <!-- Frosted card -->
            <Border Margin="26"
                    CornerRadius="22"
                    Background="{StaticResource CardBrush}"
                    BorderBrush="#3CFFFFFF"
                    BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="28"
                                      ShadowDepth="8"
                                      Direction="270"
                                      Opacity="0.35"
                                      Color="#05060F" />
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Rectangle Grid.RowSpan="3"
                               IsHitTestVisible="False"
                               VerticalAlignment="Top"
                               Height="120"
                               Opacity="0.45">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#26FFFFFF" Offset="0" />
                                <GradientStop Color="#00FFFFFF" Offset="1" />
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>

                    <!-- Header -->
                    <Grid Grid.Row="0"
                          Margin="26,22,16,14"
                          MouseLeftButtonDown="Header_MouseLeftButtonDown">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="46"
                                    Height="46"
                                    CornerRadius="15"
                                    Background="{StaticResource GoldGradient}">
                                <Border.Effect>
                                    <DropShadowEffect Color="#F0B040"
                                                      BlurRadius="20"
                                                      ShadowDepth="0"
                                                      Opacity="0.6" />
                                </Border.Effect>
                                <TextBlock Text="&#xE8E4;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="20"
                                           Foreground="#2A1B06"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Concept Jewellery Pro"
                                           Foreground="White"
                                           FontSize="17"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="Jewellery Management System"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="12"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                        </StackPanel>

                        <telerik:RadButton x:Name="CloseButton"
                                           Style="{StaticResource GlassIconButtonStyle}"
                                           Width="30"
                                           Height="30"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           Content="&#x2715;"
                                           FontSize="12"
                                           ToolTip="Close"
                                           Click="CloseButton_Click" />
                    </Grid>

                    <Rectangle Grid.Row="1"
                               Height="1"
                               Fill="{StaticResource GlassLineBrush}"
                               Margin="26,0" />

                    <!-- Body -->
                    <telerik:RadBusyIndicator Grid.Row="2"
                                              IsBusy="{Binding IsBusy, Mode=OneWay}"
                                              BusyContent="Signing in...">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      VerticalContentAlignment="Center">
                            <StackPanel Margin="32,24,32,26">
                                <TextBlock Text="Welcome Back"
                                           FontSize="27"
                                           FontWeight="SemiBold"
                                           Foreground="White" />
                                <TextBlock Text="Enter your credentials to access the system."
                                           FontSize="13"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Margin="0,5,0,0" />
                                <Rectangle Width="44"
                                           Height="3"
                                           RadiusX="1.5"
                                           RadiusY="1.5"
                                           Fill="#F5B940"
                                           HorizontalAlignment="Left"
                                           Margin="0,14,0,0" />

                                <StackPanel Margin="0,24,0,0">
                                    <TextBlock Text="Username"
                                               Style="{StaticResource FieldLabelStyle}" />
                                    <telerik:RadWatermarkTextBox x:Name="UsernameBox"
                                                                 Height="42"
                                                               
                                                                 Margin="0,7,0,0"
                                                                 FontSize="14"
                                                                 Background="{StaticResource InputBrush}"
                                                                 BorderBrush="{StaticResource InputBorderBrush}"
                                                                 BorderThickness="1"
                                                                 Foreground="White"
                                                                 VerticalContentAlignment="Center"
                                                                
                                                                 Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>

                                <StackPanel Margin="0,16,0,0">
                                    <TextBlock Text="Password"
                                               Style="{StaticResource FieldLabelStyle}" />
                                    <telerik:RadPasswordBox x:Name="PasswordBox"
                                                            Height="42"
                                                            Margin="0,7,0,0"
                                                            FontSize="14"
                                                            Background="{StaticResource InputBrush}"
                                                            BorderBrush="{StaticResource InputBorderBrush}"
                                                            BorderThickness="1"
                                                            Foreground="White"
                                                            VerticalContentAlignment="Center"
                                                           
                                                            PasswordChanged="PasswordBox_PasswordChanged" />
                                </StackPanel>

                                <TextBlock Text="{Binding ErrorMessage}"
                                           Foreground="#FCA5A5"
                                           FontSize="13"
                                           Margin="0,14,0,0"
                                           TextWrapping="Wrap" />

                                <telerik:RadButton Height="46"
                                                   Margin="0,20,0,0"
                                                   Style="{StaticResource PrimaryButtonStyle}"
                                                   Content="Sign In"
                                                   IsDefault="True"
                                                   Command="{Binding LoginCommand}" />

                                <Border Margin="0,20,0,0"
                                        CornerRadius="12"
                                        Background="#12FFFFFF"
                                        BorderBrush="#2AFFFFFF"
                                        BorderThickness="1">
                                    <StackPanel>
                                        <ToggleButton x:Name="ConnectionToggle"
                                                      IsChecked="{Binding ConnectionSettings.IsExpanded}"
                                                      AutomationProperties.Name="Connection Settings"
                                                      Cursor="Hand">
                                            <ToggleButton.Template>
                                                <ControlTemplate TargetType="ToggleButton">
                                                    <Border x:Name="HeaderBorder"
                                                            Background="Transparent"
                                                            Padding="12,9">
                                                        <Grid>
                                                            <StackPanel Orientation="Horizontal"
                                                                        VerticalAlignment="Center">
                                                                <TextBlock Text="&#xE713;"
                                                                           FontFamily="Segoe MDL2 Assets"
                                                                           FontSize="13"
                                                                           Foreground="#D6E0EF"
                                                                           VerticalAlignment="Center" />
                                                                <TextBlock Text="Connection Settings"
                                                                           FontSize="12"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="#E2E8F2"
                                                                           Margin="8,0,0,0"
                                                                           VerticalAlignment="Center" />
                                                            </StackPanel>
                                                            <TextBlock x:Name="Chevron"
                                                                       Text="&#xE70D;"
                                                                       FontFamily="Segoe MDL2 Assets"
                                                                       FontSize="11"
                                                                       Foreground="#A5B4C8"
                                                                       HorizontalAlignment="Right"
                                                                       VerticalAlignment="Center" />
                                                        </Grid>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsChecked" Value="True">
                                                            <Setter Property="Text"
                                                                    TargetName="Chevron"
                                                                    Value="&#xE70E;" />
                                                        </Trigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background"
                                                                    TargetName="HeaderBorder"
                                                                    Value="#16FFFFFF" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </ToggleButton.Template>
                                        </ToggleButton>

                                        <StackPanel Margin="12,2,12,12"
                                                    Visibility="{Binding ConnectionSettings.IsExpanded, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="Database Type"
                                                       Style="{StaticResource FieldLabelStyle}" />
                                            <telerik:RadComboBox Height="34"
                                                                 Margin="0,6,0,0"
                                                                 FontSize="13"
                                                                 Background="#F1F5F9"
                                                                 SelectedIndex="{Binding ConnectionSettings.SelectedProviderIndex}">
                                                <telerik:RadComboBoxItem Content="Microsoft Access" />
                                                <telerik:RadComboBoxItem Content="SQL Server" />
                                            </telerik:RadComboBox>

                                            <StackPanel Margin="0,12,0,0"
                                                        Visibility="{Binding ConnectionSettings.IsAccessSelected, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="Current Database File"
                                                           Style="{StaticResource FieldLabelStyle}" />
                                                <Grid Margin="0,6,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <telerik:RadWatermarkTextBox Height="34"
                                                                                 FontSize="13"
                                                                                 Background="{StaticResource InputBrush}"
                                                                                 BorderBrush="{StaticResource InputBorderBrush}"
                                                                                 BorderThickness="1"
                                                                                 Foreground="White"
                                                                                 VerticalContentAlignment="Center"
                                                                                 Text="{Binding ConnectionSettings.AccessDatabasePath, UpdateSourceTrigger=PropertyChanged}" />
                                                    <telerik:RadButton Grid.Column="1"
                                                                       Content="..."
                                                                       Margin="6,0,0,0"
                                                                       Height="34"
                                                                       Width="36"
                                                                       FontSize="15"
                                                                       Background="{StaticResource InputBrush}"
                                                                       BorderBrush="{StaticResource InputBorderBrush}"
                                                                       BorderThickness="1"
                                                                       Foreground="White"
                                                                       ToolTip="Browse Current Database"
                                                                       Click="BrowseDatabaseFile_Click" />
                                                </Grid>

                                                <!-- Attached Previous Years (MDB) -->
                                                <TextBlock Text="Previous Financial Years (MDB Files)"
                                                           Style="{StaticResource FieldLabelStyle}"
                                                           Margin="0,14,0,0" />
                                                <TextBlock Text="Attach previous years' databases for multi-year analytics"
                                                           FontSize="10.5"
                                                           Foreground="#A5B4C8"
                                                           Margin="0,2,0,6" />

                                                <ItemsControl ItemsSource="{Binding ConnectionSettings.PreviousYearsAccess}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,0,0,6">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="80" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <telerik:RadWatermarkTextBox Grid.Column="0"
                                                                                             Height="30"
                                                                                             FontSize="11.5"
                                                                                             WatermarkContent="FY (24-25)"
                                                                                             Background="{StaticResource InputBrush}"
                                                                                             BorderBrush="{StaticResource InputBorderBrush}"
                                                                                             BorderThickness="1"
                                                                                             Foreground="White"
                                                                                             VerticalContentAlignment="Center"
                                                                                             Text="{Binding FinancialYear, UpdateSourceTrigger=PropertyChanged}" />
                                                                <telerik:RadWatermarkTextBox Grid.Column="1"
                                                                                             Height="30"
                                                                                             Margin="4,0,0,0"
                                                                                             FontSize="11.5"
                                                                                             WatermarkContent="MDB database path..."
                                                                                             Background="{StaticResource InputBrush}"
                                                                                             BorderBrush="{StaticResource InputBorderBrush}"
                                                                                             BorderThickness="1"
                                                                                             Foreground="White"
                                                                                             VerticalContentAlignment="Center"
                                                                                             Text="{Binding FilePath, UpdateSourceTrigger=PropertyChanged}" />
                                                                <telerik:RadButton Grid.Column="2"
                                                                                   Content="..."
                                                                                   Margin="4,0,0,0"
                                                                                   Height="30"
                                                                                   Width="30"
                                                                                   FontSize="13"
                                                                                   Background="{StaticResource InputBrush}"
                                                                                   BorderBrush="{StaticResource InputBorderBrush}"
                                                                                   BorderThickness="1"
                                                                                   Foreground="White"
                                                                                   ToolTip="Browse Previous Year MDB"
                                                                                   Command="{Binding DataContext.ConnectionSettings.BrowsePreviousYearAccessCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                   CommandParameter="{Binding}" />
                                                                <telerik:RadButton Grid.Column="3"
                                                                                   Content="✕"
                                                                                   Margin="4,0,0,0"
                                                                                   Height="30"
                                                                                   Width="30"
                                                                                   FontSize="11"
                                                                                   Background="#3B1C1C"
                                                                                   BorderBrush="#7F3333"
                                                                                   BorderThickness="1"
                                                                                   Foreground="#FF9494"
                                                                                   ToolTip="Remove Year"
                                                                                   Command="{Binding DataContext.ConnectionSettings.RemovePreviousYearAccessCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                   CommandParameter="{Binding}" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <telerik:RadButton Content="+ Attach Previous Year MDB"
                                                                   Height="28"
                                                                   Margin="0,2,0,0"
                                                                   FontSize="11"
                                                                   Background="{StaticResource InputBrush}"
                                                                   BorderBrush="{StaticResource InputBorderBrush}"
                                                                   BorderThickness="1"
                                                                   Foreground="#D6E0EF"
                                                                   HorizontalAlignment="Left"
                                                                   Padding="10,0"
                                                                   Command="{Binding ConnectionSettings.AddPreviousYearAccessCommand}" />
                                            </StackPanel>

                                            <StackPanel Margin="0,12,0,0"
                                                        Visibility="{Binding ConnectionSettings.IsSqlSelected, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="Server"
                                                           Style="{StaticResource FieldLabelStyle}" />
                                                <telerik:RadWatermarkTextBox Height="34"
                                                                             Margin="0,6,0,0"
                                                                             FontSize="13"
                                                                             Background="{StaticResource InputBrush}"
                                                                             BorderBrush="{StaticResource InputBorderBrush}"
                                                                             BorderThickness="1"
                                                                             Foreground="White"
                                                                             VerticalContentAlignment="Center"
                                                                             Text="{Binding ConnectionSettings.SqlServerName, UpdateSourceTrigger=PropertyChanged}" />

                                                <TextBlock Text="Current Database Name"
                                                           Style="{StaticResource FieldLabelStyle}"
                                                           Margin="0,10,0,0" />
                                                <telerik:RadWatermarkTextBox Height="34"
                                                                             Margin="0,6,0,0"
                                                                             FontSize="13"
                                                                             Background="{StaticResource InputBrush}"
                                                                             BorderBrush="{StaticResource InputBorderBrush}"
                                                                             BorderThickness="1"
                                                                             Foreground="White"
                                                                             VerticalContentAlignment="Center"
                                                                             WatermarkContent="e.g. ConceptJewelleryPro"
                                                                             Text="{Binding ConnectionSettings.SqlDatabaseName, UpdateSourceTrigger=PropertyChanged}" />

                                                <TextBlock Text="Login"
                                                           Style="{StaticResource FieldLabelStyle}"
                                                           Margin="0,10,0,0" />
                                                <telerik:RadWatermarkTextBox Height="34"
                                                                             Margin="0,6,0,0"
                                                                             FontSize="13"
                                                                             Background="{StaticResource InputBrush}"
                                                                             BorderBrush="{StaticResource InputBorderBrush}"
                                                                             BorderThickness="1"
                                                                             Foreground="White"
                                                                             VerticalContentAlignment="Center"
                                                                             Text="{Binding ConnectionSettings.SqlUsername, UpdateSourceTrigger=PropertyChanged}" />
                                                <TextBlock Text="Password"
                                                           Style="{StaticResource FieldLabelStyle}"
                                                           Margin="0,10,0,0" />
                                                <telerik:RadPasswordBox x:Name="SqlPasswordBox"
                                                                        Height="34"
                                                                        Margin="0,6,0,0"
                                                                        FontSize="13"
                                                                        Background="{StaticResource InputBrush}"
                                                                        BorderBrush="{StaticResource InputBorderBrush}"
                                                                        BorderThickness="1"
                                                                        Foreground="White"
                                                                        VerticalContentAlignment="Center"
                                                                        PasswordChanged="SqlPasswordBox_PasswordChanged" />

                                                <!-- Attached Previous Years (SQL Server) -->
                                                <TextBlock Text="Previous Financial Years (SQL Databases)"
                                                           Style="{StaticResource FieldLabelStyle}"
                                                           Margin="0,14,0,0" />
                                                <TextBlock Text="Attach previous years' SQL databases for multi-year analytics"
                                                           FontSize="10.5"
                                                           Foreground="#A5B4C8"
                                                           Margin="0,2,0,6" />

                                                <ItemsControl ItemsSource="{Binding ConnectionSettings.PreviousYearsSql}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,0,0,6">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="80" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <telerik:RadWatermarkTextBox Grid.Column="0"
                                                                                             Height="30"
                                                                                             FontSize="11.5"
                                                                                             WatermarkContent="FY (24-25)"
                                                                                             Background="{StaticResource InputBrush}"
                                                                                             BorderBrush="{StaticResource InputBorderBrush}"
                                                                                             BorderThickness="1"
                                                                                             Foreground="White"
                                                                                             VerticalContentAlignment="Center"
                                                                                             Text="{Binding FinancialYear, UpdateSourceTrigger=PropertyChanged}" />
                                                                <telerik:RadWatermarkTextBox Grid.Column="1"
                                                                                             Height="30"
                                                                                             Margin="4,0,0,0"
                                                                                             FontSize="11.5"
                                                                                             WatermarkContent="SQL Database name (e.g. RGRG2425)..."
                                                                                             Background="{StaticResource InputBrush}"
                                                                                             BorderBrush="{StaticResource InputBorderBrush}"
                                                                                             BorderThickness="1"
                                                                                             Foreground="White"
                                                                                             VerticalContentAlignment="Center"
                                                                                             Text="{Binding DatabaseName, UpdateSourceTrigger=PropertyChanged}" />
                                                                <telerik:RadButton Grid.Column="2"
                                                                                   Content="✕"
                                                                                   Margin="4,0,0,0"
                                                                                   Height="30"
                                                                                   Width="30"
                                                                                   FontSize="11"
                                                                                   Background="#3B1C1C"
                                                                                   BorderBrush="#7F3333"
                                                                                   BorderThickness="1"
                                                                                   Foreground="#FF9494"
                                                                                   ToolTip="Remove Year"
                                                                                   Command="{Binding DataContext.ConnectionSettings.RemovePreviousYearSqlCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                   CommandParameter="{Binding}" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <telerik:RadButton Content="+ Attach Previous Year SQL Database"
                                                                   Height="28"
                                                                   Margin="0,2,0,0"
                                                                   FontSize="11"
                                                                   Background="{StaticResource InputBrush}"
                                                                   BorderBrush="{StaticResource InputBorderBrush}"
                                                                   BorderThickness="1"
                                                                   Foreground="#D6E0EF"
                                                                   HorizontalAlignment="Left"
                                                                   Padding="10,0"
                                                                   Command="{Binding ConnectionSettings.AddPreviousYearSqlCommand}" />
                                            </StackPanel>

                                            <Grid Margin="0,14,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <telerik:RadButton Content="Save Settings"
                                                                   Style="{StaticResource PrimaryButtonStyle}"
                                                                   Height="34"
                                                                   Padding="18,0"
                                                                   Command="{Binding ConnectionSettings.SaveCommand}" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding ConnectionSettings.SaveStatusMessage}"
                                                           Foreground="#7FE9A8"
                                                           FontSize="12"
                                                           VerticalAlignment="Center"
                                                           Margin="12,0,0,0"
                                                           TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </telerik:RadBusyIndicator>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
