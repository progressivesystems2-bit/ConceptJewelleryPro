<UserControl x:Class="ConceptJewelleryPro.WPF.Views.ItemCreationView"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
              xmlns:controls="clr-namespace:ConceptJewelleryPro.WPF.Controls"
              FontFamily="Segoe UI"
              TextOptions.TextFormattingMode="Display">

    <UserControl.InputBindings>
        <KeyBinding Key="A" Modifiers="Alt" Command="{Binding AddNewCommand}" />
        <KeyBinding Key="M" Modifiers="Alt" Command="{Binding ModifyCommand}" />
        <KeyBinding Key="D" Modifiers="Alt" Command="{Binding DeleteCommand}" />
    </UserControl.InputBindings>

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
        </Style>

        <Style x:Key="ToolbarButtonStyle" TargetType="telerik:RadButton" BasedOn="{StaticResource RadButtonStyle}">
            <Setter Property="Height" Value="40" />
            <Setter Property="MinWidth" Value="85" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Header & Toolbar -->
            <RowDefinition Height="*" />    <!-- Items DataGrid -->
        </Grid.RowDefinitions>

        <!-- Toast Notifications Container -->
        <controls:ToastNotification x:Name="ToastNotification"
                                     Grid.Row="0"
                                     Grid.RowSpan="2"
                                     Panel.ZIndex="99"
                                     Message="{Binding ToastMessage, FallbackValue=''}"
                                     ToastType="{Binding ToastType, FallbackValue=Info}"
                                     AutoCloseDelay="6000"
                                     FontSize="14" />

        <!-- Header & Top Action Toolbar -->
        <Border Grid.Row="0"
                Background="{DynamicResource HeaderBackgroundBrush}"
                BorderBrush="{DynamicResource HeaderBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Page Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <Border Width="34" Height="34" CornerRadius="6" Background="{DynamicResource PanelBrush}">
                        <TextBlock Text="&#xE74C;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="15"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Item Master Directory" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                        <TextBlock Text="Manage inventory master item directory" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" />
                    </StackPanel>
                </StackPanel>

                <!-- Toolbar Action Buttons & Search Filter -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <telerik:RadButton Content="+ Add New (Alt+A)" Style="{StaticResource PrimaryToolbarButtonStyle}" Command="{Binding AddNewCommand}" ToolTip="Create new inventory item (Alt+A)" />
                    <telerik:RadButton Content="✏ Modify (Alt+M)" Style="{StaticResource ToolbarButtonStyle}" Command="{Binding ModifyCommand}" ToolTip="Modify selected item (Alt+M)" />
                    <telerik:RadButton Content="🗑 Delete (Alt+D)" Style="{StaticResource ToolbarButtonStyle}" Command="{Binding DeleteCommand}" ToolTip="Delete selected item (Alt+D)" />

                    <!-- Print Split DropDown Button -->
                    <telerik:RadDropDownButton Content="🖨 Print" Height="40" FontSize="12" FontWeight="SemiBold" Margin="0,0,6,0">
                        <telerik:RadDropDownButton.DropDownContent>
                            <Border Background="White" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="4" Padding="4">
                                <StackPanel MinWidth="170">
                                    <telerik:RadButton Content="All Items Summary" Height="28" Padding="8,0" HorizontalContentAlignment="Left" Command="{Binding PrintFormatCommand}" CommandParameter="All Items Summary" BorderThickness="0" Background="Transparent" />
                                    <telerik:RadButton Content="Gold Items Directory" Height="28" Padding="8,0" HorizontalContentAlignment="Left" Command="{Binding PrintFormatCommand}" CommandParameter="Gold Items Directory" BorderThickness="0" Background="Transparent" />
                                    <telerik:RadButton Content="Silver Items Directory" Height="28" Padding="8,0" HorizontalContentAlignment="Left" Command="{Binding PrintFormatCommand}" CommandParameter="Silver Items Directory" BorderThickness="0" Background="Transparent" />
                                    <telerik:RadButton Content="Diamond Items Directory" Height="28" Padding="8,0" HorizontalContentAlignment="Left" Command="{Binding PrintFormatCommand}" CommandParameter="Diamond Items Directory" BorderThickness="0" Background="Transparent" />
                                </StackPanel>
                            </Border>
                        </telerik:RadDropDownButton.DropDownContent>
                    </telerik:RadDropDownButton>

                    <telerik:RadButton Content="📊 Export To Excel" Style="{StaticResource ToolbarButtonStyle}" Command="{Binding ExportToExcelCommand}" ToolTip="Export current list to CSV/Excel" />

                    <!-- Column Chooser DropDown Button -->
                    <telerik:RadDropDownButton x:Name="ColumnChooserButton"
                                               Content="⚙ Columns"
                                               Height="40"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Margin="0,0,6,0"
                                               ToolTip="Choose visible columns and save grid layout"
                                               IsTabStop="False"
                                               DropDownOpened="ColumnChooserButton_DropDownOpened">
                        <telerik:RadDropDownButton.DropDownContent>
                            <Border Background="{DynamicResource CardBackgroundBrush}"
                                    BorderBrush="{DynamicResource CardBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    MinWidth="240"
                                    MaxWidth="290">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.25" Color="#000000" />
                                </Border.Effect>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Header / Title -->
                                    <Border Grid.Row="0"
                                            Background="{DynamicResource HeaderBackgroundBrush}"
                                            BorderBrush="{DynamicResource CardBorderBrush}"
                                            BorderThickness="0,0,0,1"
                                            CornerRadius="5,5,0,0"
                                            Padding="12,8">
                                        <Grid>
                                            <TextBlock Text="Column Chooser"
                                                       FontWeight="Bold"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Text="Reset Default"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AccentBrush}"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Center"
                                                       Cursor="Hand"
                                                       MouseLeftButtonUp="ResetColumns_Click"
                                                       ToolTip="Reset to default columns" />
                                        </Grid>
                                    </Border>

                                    <!-- Scrollable Checkboxes List -->
                                    <ScrollViewer Grid.Row="1"
                                                  MaxHeight="320"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  Padding="10,6">
                                        <ItemsControl x:Name="ColumnChooserList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <CheckBox Content="{Binding Header}"
                                                              IsChecked="{Binding IsVisible, Mode=TwoWay}"
                                                              Foreground="{DynamicResource PrimaryTextBrush}"
                                                              FontSize="12"
                                                              Margin="4,4"
                                                              Cursor="Hand" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>

                                    <!-- Actions Footer -->
                                    <Border Grid.Row="2"
                                            Background="{DynamicResource HeaderBackgroundBrush}"
                                            BorderBrush="{DynamicResource CardBorderBrush}"
                                            BorderThickness="0,1,0,0"
                                            CornerRadius="0,0,5,5"
                                            Padding="8,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <telerik:RadButton Content="Select All"
                                                               Grid.Column="0"
                                                               Height="28"
                                                               FontSize="11"
                                                               Margin="0,0,4,0"
                                                               Click="SelectAllColumns_Click"
                                                               Cursor="Hand" />
                                            <telerik:RadButton x:Name="SaveSettingsOptionButton"
                                                               Content="Save Layout"
                                                               Grid.Column="1"
                                                               Height="28"
                                                               FontWeight="SemiBold"
                                                               FontSize="11"
                                                               Background="{DynamicResource AccentBrush}"
                                                               Foreground="White"
                                                               BorderThickness="0"
                                                               Margin="4,0,0,0"
                                                               Click="SaveSettingsOption_Click"
                                                               ToolTip="Save current column visibility and layout"
                                                               Cursor="Hand" />
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>
                        </telerik:RadDropDownButton.DropDownContent>
                    </telerik:RadDropDownButton>

                    <Border Width="1" Background="{DynamicResource SeparatorBrush}" Margin="4,4,10,4" />

                    <!-- Contains Search Filter Box -->
                    <telerik:RadWatermarkTextBox x:Name="SearchBox"
                                                 Width="240"
                                                 Height="40"
                                                 WatermarkContent="Search items (contains)... Alt+X"
                                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                                 Padding="8,0"
                                                 FontSize="12"
                                                 VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Body DataGrid -->
        <telerik:RadBusyIndicator Grid.Row="1" IsBusy="{Binding IsBusy}" BusyContent="Loading items...">
            <Grid Margin="16">
                <Border Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Header Info & Item Count -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <TextBlock Text="Inventory Items Directory" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding FilteredItems.Count, StringFormat='Showing {0} Items (Double-click row to modify)'}"
                                       FontSize="11.5"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <!-- DataGrid with Contains Filtering -->
                        <telerik:RadGridView Grid.Row="1"
                                             x:Name="ItemsGrid"
                                             ItemsSource="{Binding FilteredItems}"
                                             SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                                             IsSynchronizedWithCurrentItem="False"
                                             AutoGenerateColumns="False"
                                             IsReadOnly="True"
                                             GridLinesVisibility="Horizontal"
                                             HorizontalGridLinesBrush="#E5E5E5"
                                             RowHeight="40"
                                             FontSize="14"
                                             BorderThickness="1"
                                             MouseDoubleClick="Grid_MouseDoubleClick">
                            <telerik:RadGridView.Columns>
                                <telerik:GridViewDataColumn Header="Item Code" DataMemberBinding="{Binding ItemCode}" Width="120" />
                                <telerik:GridViewDataColumn Header="Item Name" DataMemberBinding="{Binding ItemName}" Width="*" />
                                <telerik:GridViewDataColumn Header="Group" DataMemberBinding="{Binding Group}" Width="110" />
                                <telerik:GridViewDataColumn Header="Sub Group" DataMemberBinding="{Binding SubGroup}" Width="120" />
                                <telerik:GridViewDataColumn Header="Metal Type" DataMemberBinding="{Binding MetalType}" Width="110" />
                                <telerik:GridViewDataColumn Header="Purity" DataMemberBinding="{Binding PurityDisplay}" Width="100" />
                                <telerik:GridViewDataColumn Header="Standard Wt (g)" DataMemberBinding="{Binding StandardWeight, StringFormat=N3}" Width="110" />
                                <telerik:GridViewDataColumn Header="MRP" DataMemberBinding="{Binding MRP, StringFormat=N2}" Width="110" />
                                <telerik:GridViewDataColumn Header="Sale Rate" DataMemberBinding="{Binding SaleRate, StringFormat=N2}" Width="110" />
                                <telerik:GridViewDataColumn Header="Opening Stock" DataMemberBinding="{Binding OpeningStock, StringFormat=N2}" Width="110" />
                                <telerik:GridViewDataColumn Header="HSN Code" DataMemberBinding="{Binding HSNCode}" Width="110" />
                                <telerik:GridViewDataColumn Header="GST Rate (%)" DataMemberBinding="{Binding GSTRate, StringFormat=N2}" Width="95" />
                                <telerik:GridViewDataColumn Header="Status" DataMemberBinding="{Binding Status}" Width="90" />
                            </telerik:RadGridView.Columns>
                        </telerik:RadGridView>
                    </Grid>
                </Border>
            </Grid>
        </telerik:RadBusyIndicator>
    </Grid>
</UserControl>