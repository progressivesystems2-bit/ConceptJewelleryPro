<UserControl x:Class="ConceptJewelleryPro.WPF.Views.CouponEngineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
             xmlns:controls="clr-namespace:ConceptJewelleryPro.WPF.Controls"
             FontFamily="Segoe UI"
             TextOptions.TextFormattingMode="Display">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="ActionButtonStyle" TargetType="telerik:RadButton" BasedOn="{StaticResource RadButtonStyle}">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style x:Key="PrimaryButtonStyle" TargetType="telerik:RadButton" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <controls:ToastNotification Grid.Row="0"
                                     Grid.RowSpan="3"
                                     Panel.ZIndex="99"
                                     HorizontalAlignment="Right"
                                     VerticalAlignment="Bottom"
                                     Margin="0,0,24,24"
                                     Message="{Binding ToastMessage}"
                                     ToastType="{Binding ToastType}" />

        <!-- Header -->
        <Border Grid.Row="0"
                Background="{DynamicResource HeaderBackgroundBrush}"
                BorderBrush="{DynamicResource HeaderBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="40" Height="40" CornerRadius="8" Background="{DynamicResource PanelBrush}">
                        <TextBlock Text="&#xE8EC;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="18"
                                   Foreground="{DynamicResource AccentBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Coupon Engine" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                        <TextBlock Text="Campaigns, Customer Segmentation, Bulk WhatsApp Dispatch &amp; Redemption ROI" FontSize="11.5" Foreground="{DynamicResource SecondaryTextBrush}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <telerik:RadButton Content="Run Auto-Pilot Triggers"
                                       Style="{StaticResource PrimaryButtonStyle}"
                                       Command="{Binding RunAutoPilotTriggersCommand}" />
                    <telerik:RadButton Content="Reload"
                                       Style="{StaticResource ActionButtonStyle}"
                                       Margin="0"
                                       Command="{Binding LoadAllDataCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Tabs -->
        <telerik:RadBusyIndicator Grid.Row="1" IsBusy="{Binding IsBusy, Mode=OneWay}" BusyContent="Processing...">
            <TabControl SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}" Margin="16,12,16,8" Background="Transparent" BorderThickness="0">

                <!-- TAB 1: CAMPAIGNS -->
                <TabItem Header="Campaigns">
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.2*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>

                        <DockPanel Grid.Column="0">
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                                <telerik:RadButton Content="New Campaign" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding NewCampaignCommand}" />
                                <telerik:RadButton Content="Starter Templates" Style="{StaticResource ActionButtonStyle}" Command="{Binding SeedDefaultCampaignsCommand}" />
                                <telerik:RadButton Content="Delete" Style="{StaticResource ActionButtonStyle}" Command="{Binding DeleteCampaignCommand}" />
                            </StackPanel>

                            <telerik:RadGridView ItemsSource="{Binding Campaigns}"
                                                 SelectedItem="{Binding SelectedCampaign, Mode=TwoWay}"
                                                 AutoGenerateColumns="False"
                                                 IsReadOnly="True"
                                                 ShowGroupPanel="False"
                                                 RowIndicatorVisibility="Collapsed">
                                <telerik:RadGridView.Columns>
                                    <telerik:GridViewDataColumn Header="Campaign" DataMemberBinding="{Binding CampaignName}" Width="*" />
                                    <telerik:GridViewDataColumn Header="Prefix" DataMemberBinding="{Binding CodePrefix}" Width="65" />
                                    <telerik:GridViewDataColumn Header="Type" DataMemberBinding="{Binding CouponType}" Width="90" />
                                    <telerik:GridViewDataColumn Header="Value" DataMemberBinding="{Binding DiscountValue, StringFormat={}{0:N0}}" Width="75" />
                                    <telerik:GridViewDataColumn Header="Min Bill" DataMemberBinding="{Binding MinBillAmount, StringFormat={}{0:N0}}" Width="80" />
                                    <telerik:GridViewDataColumn Header="Valid To" DataMemberBinding="{Binding ValidTo, StringFormat={}{0:dd/MM/yy}}" Width="80" />
                                    <telerik:GridViewDataColumn Header="Issued" DataMemberBinding="{Binding TotalGenerated}" Width="60" />
                                    <telerik:GridViewDataColumn Header="Used" DataMemberBinding="{Binding TotalRedeemed}" Width="55" />
                                </telerik:RadGridView.Columns>
                            </telerik:RadGridView>
                        </DockPanel>

                        <!-- Campaign Editor -->
                        <Border Grid.Column="2"
                                Background="{DynamicResource CardBackgroundBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="Campaign Details" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,12" />

                                    <TextBlock Text="Campaign Name" FontSize="11.5" FontWeight="Medium" Margin="0,0,0,4" />
                                    <TextBox Height="32" Padding="8,4" Text="{Binding FormCampaignName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="90" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Coupon Type" FontSize="11.5" FontWeight="Medium" Margin="0,0,0,4" />
                                            <ComboBox Height="32" ItemsSource="{Binding CouponTypeOptions}" SelectedItem="{Binding FormCouponType, Mode=TwoWay}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Discount Value" FontSize="11.5" FontWeight="Medium" Margin="0,0,0,4" />
                                            <TextBox Height="32" Padding="8,4" Text="{Binding FormDiscountValue, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="Prefix" FontSize="11.5" FontWeight="Medium" Margin="0,0,0,4" />
                                            <TextBox Height="32" Padding="8,4" Text="{Binding FormCodePrefix, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Min Bill Amount (₹)" FontSize="11.5" FontWeight="Medium" Margin="0,0,0,4" />
                                            <TextBox Height="32" Padding="8,4" Text="{Binding FormMinBillAmount, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Max Discount Cap (₹)" FontSize="11.5" FontWeight="Medium" Margin="0,0,0,4" />
                                            <TextBox Height="32" Padding="8,4" Text="{Binding FormMaxDiscountAmount, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" />
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Valid From" FontSize="11.5" FontWeight="Medium" Margin="0,0,0,4" />
                                            <DatePicker Height="32" SelectedDate="{Binding FormValidFrom, Mode=TwoWay}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Valid To" FontSize="11.5" FontWeight="Medium" Margin="0,0,0,4" />
                                            <DatePicker Height="32" SelectedDate="{Binding FormValidTo, Mode=TwoWay}" />
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Auto Trigger" FontSize="11.5" FontWeight="Medium" Margin="0,0,0,4" />
                                            <ComboBox Height="32" ItemsSource="{Binding AutoTriggerOptions}" SelectedItem="{Binding FormAutoTriggerType, Mode=TwoWay}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Trigger Threshold (₹)" FontSize="11.5" FontWeight="Medium" Margin="0,0,0,4" />
                                            <TextBox Height="32" Padding="8,4" Text="{Binding FormTriggerThresholdAmount, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" />
                                        </StackPanel>
                                    </Grid>

                                    <CheckBox Content="Campaign is Active" IsChecked="{Binding FormIsActive, Mode=TwoWay}" FontWeight="SemiBold" Margin="0,0,0,10" />

                                    <TextBlock Text="WhatsApp Message Template ({CustomerName}, {CouponCode}, {DiscountText}, {MinBill}, {Store}, {ValidTo})" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,0,0,4" />
                                    <TextBox Height="72" TextWrapping="Wrap" AcceptsReturn="True" Padding="8,6" Text="{Binding FormWhatsAppTemplate, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

                                    <telerik:RadButton Content="Save Campaign" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Left" Command="{Binding SaveCampaignCommand}" />
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- TAB 2: TARGET & GENERATE -->
                <TabItem Header="Target &amp; Generate">
                    <DockPanel Margin="0,10,0,0">
                        <Border DockPanel.Dock="Top"
                                Background="{DynamicResource CardBackgroundBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14"
                                Margin="0,0,0,10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <WrapPanel Orientation="Horizontal" Grid.Row="0">
                                    <StackPanel Width="220" Margin="0,0,12,0">
                                        <TextBlock Text="Target Campaign" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,3" />
                                        <ComboBox Height="32" ItemsSource="{Binding Campaigns}" DisplayMemberPath="CampaignName" SelectedItem="{Binding TargetCampaign, Mode=TwoWay}" />
                                    </StackPanel>
                                    <StackPanel Width="130" Margin="0,0,12,0">
                                        <TextBlock Text="City" FontSize="11" Margin="0,0,0,3" />
                                        <TextBox Height="32" Padding="6,4" Text="{Binding FilterCity, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Width="130" Margin="0,0,12,0">
                                        <TextBlock Text="Customer Group" FontSize="11" Margin="0,0,0,3" />
                                        <TextBox Height="32" Padding="6,4" Text="{Binding FilterGroup, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Width="120" Margin="0,0,12,0">
                                        <TextBlock Text="Min Spend (₹)" FontSize="11" Margin="0,0,0,3" />
                                        <TextBox Height="32" Padding="6,4" Text="{Binding FilterMinSpend, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" />
                                    </StackPanel>
                                    <StackPanel Width="100" Margin="0,0,12,0">
                                        <TextBlock Text="Min Visits" FontSize="11" Margin="0,0,0,3" />
                                        <TextBox Height="32" Padding="6,4" Text="{Binding FilterMinVisits, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" />
                                    </StackPanel>
                                    <StackPanel Width="110" Margin="0,0,12,0">
                                        <TextBlock Text="Inactive Days ≥" FontSize="11" Margin="0,0,0,3" />
                                        <TextBox Height="32" Padding="6,4" Text="{Binding FilterInactiveDays, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" />
                                    </StackPanel>
                                    <StackPanel Width="100">
                                        <TextBlock Text="Birth Month (1-12)" FontSize="11" Margin="0,0,0,3" />
                                        <TextBox Height="32" Padding="6,4" Text="{Binding FilterBirthMonth, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" />
                                    </StackPanel>
                                </WrapPanel>

                                <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <telerik:RadButton Content="Search Customers" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding SearchSegmentationCommand}" />
                                    <telerik:RadButton Content="Select All" Style="{StaticResource ActionButtonStyle}" Command="{Binding SelectAllCustomersCommand}" />
                                    <telerik:RadButton Content="Deselect All" Style="{StaticResource ActionButtonStyle}" Command="{Binding DeselectAllCustomersCommand}" />
                                    <CheckBox Content="Dispatch WhatsApp immediately" IsChecked="{Binding DispatchWhatsAppOnGenerate, Mode=TwoWay}" VerticalAlignment="Center" Margin="8,0,16,0" FontWeight="SemiBold" />
                                    <telerik:RadButton Content="Generate Coupons for Selected" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding GenerateBulkCouponsCommand}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <telerik:RadGridView ItemsSource="{Binding SegmentedCustomers}"
                                             AutoGenerateColumns="False"
                                             ShowGroupPanel="False"
                                             RowIndicatorVisibility="Collapsed">
                            <telerik:RadGridView.Columns>
                                <telerik:GridViewCheckBoxColumn Header="Select" DataMemberBinding="{Binding IsSelected, Mode=TwoWay}" Width="60" />
                                <telerik:GridViewDataColumn Header="Code" DataMemberBinding="{Binding Code}" Width="90" IsReadOnly="True" />
                                <telerik:GridViewDataColumn Header="Customer Name" DataMemberBinding="{Binding CompanyName}" Width="*" IsReadOnly="True" />
                                <telerik:GridViewDataColumn Header="Mobile" DataMemberBinding="{Binding Mobile}" Width="120" IsReadOnly="True" />
                                <telerik:GridViewDataColumn Header="City" DataMemberBinding="{Binding City}" Width="110" IsReadOnly="True" />
                                <telerik:GridViewDataColumn Header="Group" DataMemberBinding="{Binding Group}" Width="100" IsReadOnly="True" />
                                <telerik:GridViewDataColumn Header="Lifetime Spend" DataMemberBinding="{Binding LifetimeSpend, StringFormat={}{0:N0}}" Width="110" IsReadOnly="True" />
                                <telerik:GridViewDataColumn Header="Visits" DataMemberBinding="{Binding VisitCount}" Width="65" IsReadOnly="True" />
                                <telerik:GridViewDataColumn Header="Inactive Days" DataMemberBinding="{Binding DaysSinceLastVisit}" Width="95" IsReadOnly="True" />
                            </telerik:RadGridView.Columns>
                        </telerik:RadGridView>
                    </DockPanel>
                </TabItem>

                <!-- TAB 3: ISSUED COUPONS -->
                <TabItem Header="Issued Coupons">
                    <DockPanel Margin="0,10,0,0">
                        <!-- Quick Single Issue Bar -->
                        <Border DockPanel.Dock="Top"
                                Background="{DynamicResource CardBackgroundBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12"
                                Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Quick Single Coupon Issue" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,0,8" />
                                <WrapPanel Orientation="Horizontal">
                                    <StackPanel Width="130" Margin="0,0,10,0">
                                        <TextBlock Text="Code (Optional)" FontSize="10.5" Margin="0,0,0,2" />
                                        <TextBox Height="30" Padding="6,3" Text="{Binding SingleCouponCode, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Width="130" Margin="0,0,10,0">
                                        <TextBlock Text="Mobile (Optional)" FontSize="10.5" Margin="0,0,0,2" />
                                        <TextBox Height="30" Padding="6,3" Text="{Binding SingleCustomerMobile, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Width="150" Margin="0,0,10,0">
                                        <TextBlock Text="Customer Name" FontSize="10.5" Margin="0,0,0,2" />
                                        <TextBox Height="30" Padding="6,3" Text="{Binding SingleCustomerName, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Width="110" Margin="0,0,10,0">
                                        <TextBlock Text="Type" FontSize="10.5" Margin="0,0,0,2" />
                                        <ComboBox Height="30" ItemsSource="{Binding CouponTypeOptions}" SelectedItem="{Binding SingleCouponType, Mode=TwoWay}" />
                                    </StackPanel>
                                    <StackPanel Width="95" Margin="0,0,10,0">
                                        <TextBlock Text="Value" FontSize="10.5" Margin="0,0,0,2" />
                                        <TextBox Height="30" Padding="6,3" Text="{Binding SingleDiscountValue, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Width="105" Margin="0,0,10,0">
                                        <TextBlock Text="Min Bill (₹)" FontSize="10.5" Margin="0,0,0,2" />
                                        <TextBox Height="30" Padding="6,3" Text="{Binding SingleMinBillAmount, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" />
                                    </StackPanel>
                                    <StackPanel Width="125" Margin="0,0,12,0">
                                        <TextBlock Text="Valid To" FontSize="10.5" Margin="0,0,0,2" />
                                        <DatePicker Height="30" SelectedDate="{Binding SingleValidTo, Mode=TwoWay}" />
                                    </StackPanel>
                                    <telerik:RadButton Content="Issue Coupon" Style="{StaticResource PrimaryButtonStyle}" VerticalAlignment="Bottom" Command="{Binding GenerateSingleCouponCommand}" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- Filter & Actions Toolbar -->
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBox Width="210" Height="32" Padding="8,4" Text="{Binding CouponSearchText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />
                            <ComboBox Width="120" Height="32" ItemsSource="{Binding CouponStatusFilterOptions}" SelectedItem="{Binding CouponFilterStatus, Mode=TwoWay}" Margin="0,0,8,0" />
                            <telerik:RadButton Content="Filter" Style="{StaticResource ActionButtonStyle}" Command="{Binding LoadCouponsCommand}" />
                            <telerik:RadButton Content="Send WhatsApp (Selected)" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding DispatchSelectedCouponsCommand}" />
                            <telerik:RadButton Content="Sync Delivery Status" Style="{StaticResource ActionButtonStyle}" Command="{Binding SyncDeliveryStatusesCommand}" />
                            <telerik:RadButton Content="Revoke Selected" Style="{StaticResource ActionButtonStyle}" Command="{Binding RevokeSelectedCouponsCommand}" />
                        </StackPanel>

                        <telerik:RadGridView ItemsSource="{Binding IssuedCoupons}"
                                             AutoGenerateColumns="False"
                                             ShowGroupPanel="False"
                                             RowIndicatorVisibility="Collapsed">
                            <telerik:RadGridView.Columns>
                                <telerik:GridViewCheckBoxColumn Header="Sel" DataMemberBinding="{Binding IsSelected, Mode=TwoWay}" Width="48" />
                                <telerik:GridViewDataColumn Header="Coupon Code" DataMemberBinding="{Binding CouponCode}" Width="120" IsReadOnly="True" />
                                <telerik:GridViewDataColumn Header="Campaign" DataMemberBinding="{Binding CampaignName}" Width="150" IsReadOnly="True" />
                                <telerik:GridViewDataColumn Header="Customer" DataMemberBinding="{Binding CustomerName}" Width="140" IsReadOnly="True" />
                                <telerik:GridViewDataColumn Header="Mobile" DataMemberBinding="{Binding CustomerMobile}" Width="110" IsReadOnly="True" />
                                <telerik:GridViewDataColumn Header="Offer" DataMemberBinding="{Binding FormattedDiscount}" Width="120" IsReadOnly="True" />
                                <telerik:GridViewDataColumn Header="Min Bill" DataMemberBinding="{Binding MinBillAmount, StringFormat={}{0:N0}}" Width="80" IsReadOnly="True" />
                                <telerik:GridViewDataColumn Header="Valid To" DataMemberBinding="{Binding ValidTo, StringFormat={}{0:dd/MM/yyyy}}" Width="90" IsReadOnly="True" />
                                <telerik:GridViewDataColumn Header="Status" DataMemberBinding="{Binding Status}" Width="80" IsReadOnly="True" />
                                <telerik:GridViewDataColumn Header="Usage" DataMemberBinding="{Binding UsageCount}" Width="60" IsReadOnly="True" />
                                <telerik:GridViewDataColumn Header="WhatsApp" DataMemberBinding="{Binding DeliveryStatus}" Width="90" IsReadOnly="True" />
                            </telerik:RadGridView.Columns>
                        </telerik:RadGridView>
                    </DockPanel>
                </TabItem>

                <!-- TAB 4: ANALYTICS & REDEMPTIONS -->
                <TabItem Header="Analytics &amp; Redemptions">
                    <DockPanel Margin="0,10,0,0">
                        <UniformGrid DockPanel.Dock="Top" Columns="4" Margin="0,0,0,12">
                            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,8,8">
                                <StackPanel>
                                    <TextBlock Text="Coupons Generated" FontSize="11.5" Foreground="{DynamicResource SecondaryTextBrush}" />
                                    <TextBlock Text="{Binding Analytics.TotalCouponsGenerated}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" />
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,8,8">
                                <StackPanel>
                                    <TextBlock Text="Coupons Redeemed" FontSize="11.5" Foreground="{DynamicResource SecondaryTextBrush}" />
                                    <TextBlock Text="{Binding Analytics.TotalCouponsRedeemed}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,8,8">
                                <StackPanel>
                                    <TextBlock Text="Sales With Coupons" FontSize="11.5" Foreground="{DynamicResource SecondaryTextBrush}" />
                                    <TextBlock Text="{Binding Analytics.TotalSalesWithCoupons, StringFormat=₹ {0:N0}}" FontSize="22" FontWeight="Bold" Foreground="#065F46" />
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="ROI Ratio (Sales / Discount)" FontSize="11.5" Foreground="{DynamicResource SecondaryTextBrush}" />
                                    <TextBlock Text="{Binding Analytics.RoiRatio, StringFormat={}{0:N2}x}" FontSize="22" FontWeight="Bold" Foreground="#1E40AF" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <telerik:RadGridView ItemsSource="{Binding RecentRedemptions}"
                                             AutoGenerateColumns="False"
                                             IsReadOnly="True"
                                             ShowGroupPanel="False"
                                             RowIndicatorVisibility="Collapsed">
                            <telerik:RadGridView.Columns>
                                <telerik:GridViewDataColumn Header="Bill No" DataMemberBinding="{Binding BillNo}" Width="100" />
                                <telerik:GridViewDataColumn Header="Coupon Code" DataMemberBinding="{Binding CouponCode}" Width="120" />
                                <telerik:GridViewDataColumn Header="Customer" DataMemberBinding="{Binding CustomerName}" Width="*" />
                                <telerik:GridViewDataColumn Header="Mobile" DataMemberBinding="{Binding CustomerMobile}" Width="110" />
                                <telerik:GridViewDataColumn Header="Gross Amt" DataMemberBinding="{Binding BillGrossAmount, StringFormat={}{0:N2}}" Width="100" />
                                <telerik:GridViewDataColumn Header="Discount" DataMemberBinding="{Binding DiscountAmount, StringFormat={}{0:N2}}" Width="95" />
                                <telerik:GridViewDataColumn Header="Net Amt" DataMemberBinding="{Binding BillNetAmount, StringFormat={}{0:N2}}" Width="100" />
                                <telerik:GridViewDataColumn Header="Redeemed At" DataMemberBinding="{Binding RedeemedAt, StringFormat={}{0:dd/MM/yy HH:mm}}" Width="120" />
                                <telerik:GridViewDataColumn Header="Reverted" DataMemberBinding="{Binding IsReverted}" Width="75" />
                            </telerik:RadGridView.Columns>
                        </telerik:RadGridView>
                    </DockPanel>
                </TabItem>
            </TabControl>
        </telerik:RadBusyIndicator>

        <!-- Bottom Status Bar -->
        <Border Grid.Row="2" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,1,0,0" Padding="16,7">
            <TextBlock Text="{Binding StatusMessage}" FontSize="11.5" Foreground="{DynamicResource SecondaryTextBrush}" />
        </Border>
    </Grid>
</UserControl>
