<UserControl x:Class="ConceptJewelleryPro.WPF.Views.BalanceSheetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
             xmlns:controls="clr-namespace:ConceptJewelleryPro.WPF.Controls"
             xmlns:viewmodels="clr-namespace:ConceptJewelleryPro.WPF.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewmodels:BalanceSheetViewModel}"
             d:DesignHeight="800" d:DesignWidth="1200">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="FilterLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>

        <Style x:Key="FilterDatePickerStyle" TargetType="DatePicker">
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="KpiCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="MinHeight" Value="52"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <!-- Toast Notification Overlay -->
        <controls:ToastNotification x:Name="ToastNotification"
                                     Panel.ZIndex="99"
                                     Message="{Binding ToastMessage, FallbackValue=''}"
                                     ToastType="{Binding ToastType, FallbackValue=Info}"
                                     AutoCloseDelay="4000"
                                     FontSize="13"
                                     HorizontalAlignment="Right"
                                     VerticalAlignment="Bottom"
                                     Margin="0,0,24,24"/>

        <Grid Margin="12,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Filters & Action Bar -->
                <RowDefinition Height="Auto"/> <!-- KPI Metric Summary Cards -->
                <RowDefinition Height="*"/>    <!-- Main Balance Sheet Grids -->
            </Grid.RowDefinitions>

            <!-- ROW 0: Header Filters & Actions -->
            <Border Grid.Row="0"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12,10"
                    Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/> <!-- Date range -->
                        <ColumnDefinition Width="Auto"/> <!-- Quick Period Buttons -->
                        <ColumnDefinition Width="Auto"/> <!-- Closing Stock Input -->
                        <ColumnDefinition Width="Auto"/> <!-- Hide Zero Checkbox -->
                        <ColumnDefinition Width="*"/>    <!-- Action Buttons -->
                    </Grid.ColumnDefinitions>

                    <!-- Date Range -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                        <StackPanel Margin="0,0,6,0">
                            <TextBlock Text="From Date:" Style="{StaticResource FilterLabelStyle}"/>
                            <DatePicker SelectedDate="{Binding FromDate, Mode=TwoWay}"
                                        Width="110"
                                        Style="{StaticResource FilterDatePickerStyle}"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,6,0">
                            <TextBlock Text="As On Date:" Style="{StaticResource FilterLabelStyle}"/>
                            <DatePicker SelectedDate="{Binding ToDate, Mode=TwoWay}"
                                        Width="110"
                                        Style="{StaticResource FilterDatePickerStyle}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Quick Period Buttons -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,14,14,0">
                        <telerik:RadButton Content="This FY"
                                           Command="{Binding SetThisFYCommand}"
                                           Height="28"
                                           Padding="6,0"
                                           Margin="0,0,4,0"
                                           FontSize="11"/>
                        <telerik:RadButton Content="Last FY"
                                           Command="{Binding SetLastFYCommand}"
                                           Height="28"
                                           Padding="6,0"
                                           Margin="0,0,4,0"
                                           FontSize="11"/>
                        <telerik:RadButton Content="MTD"
                                           Command="{Binding SetTodayCommand}"
                                           Height="28"
                                           Padding="6,0"
                                           Margin="0,0,4,0"
                                           FontSize="11"/>
                    </StackPanel>

                    <!-- Closing Stock Valuation Input -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,14,0">
                        <TextBlock Text="Closing Stock (₹ Valuation):" Style="{StaticResource FilterLabelStyle}"/>
                        <telerik:RadNumericUpDown Value="{Binding ManualClosingStock, Mode=TwoWay}"
                                                  CustomUnit="₹ "
                                                  NumberDecimalDigits="2"
                                                  Width="175"
                                                  Height="28"
                                                  FontSize="12"/>
                    </StackPanel>

                    <!-- Hide Zero Balance Checkbox -->
                    <CheckBox Grid.Column="3"
                              IsChecked="{Binding HideZeroBalances, Mode=TwoWay}"
                              Content="Hide Zero Balances"
                              FontWeight="SemiBold"
                              FontSize="12"
                              VerticalAlignment="Center"
                              Margin="0,14,14,0"/>

                    <!-- Action Buttons -->
                    <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,10,0,0">
                        <!-- Refresh -->
                        <telerik:RadButton Command="{Binding RefreshCommand}"
                                           ToolTip="Recalculate &amp; Refresh"
                                           Height="36"
                                           Padding="10,0"
                                           Margin="0,0,6,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="11" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBlock Text="Refresh" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </telerik:RadButton>

                        <!-- Excel Export -->
                        <telerik:RadButton Command="{Binding ExportToExcelCommand}"
                                           ToolTip="Export Balance Sheet to CSV / Excel"
                                           Height="36"
                                           Padding="10,0"
                                           Margin="0,0,6,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xEDE1;" FontFamily="Segoe MDL2 Assets" FontSize="11" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBlock Text="Excel" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </telerik:RadButton>

                        <!-- Print -->
                        <telerik:RadButton Command="{Binding PrintCommand}"
                                           ToolTip="Print Balance Sheet Statement"
                                           Height="36"
                                           Padding="12,0"
                                           Background="{DynamicResource AccentBrush}"
                                           Foreground="{DynamicResource AccentTextBrush}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE749;" FontFamily="Segoe MDL2 Assets" FontSize="11" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBlock Text="Print" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </telerik:RadButton>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ROW 1: KPI Metrics Bar -->
            <Grid Grid.Row="1" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1.2*"/>
                </Grid.ColumnDefinitions>

                <!-- Total Liabilities -->
                <Border Grid.Column="0" Style="{StaticResource KpiCardStyle}">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="TOTAL LIABILITIES &amp; CAPITAL" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <TextBlock Text="{Binding Statement.FormattedTotalLiabilities, StringFormat='₹ {0}'}" FontSize="15" FontWeight="Bold" Foreground="#0F766E" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Total Assets -->
                <Border Grid.Column="1" Style="{StaticResource KpiCardStyle}">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="TOTAL ASSETS &amp; PROPERTIES" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <TextBlock Text="{Binding Statement.FormattedTotalAssets, StringFormat='₹ {0}'}" FontSize="15" FontWeight="Bold" Foreground="#0284C7" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Net Profit / Loss -->
                <Border Grid.Column="2" Style="{StaticResource KpiCardStyle}">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="CURRENT YEAR NET PROFIT" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <TextBlock Text="{Binding Statement.ProfitLoss.FormattedNetProfit, StringFormat='₹ {0}'}" FontSize="15" FontWeight="Bold" Foreground="#10B981" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Working Capital -->
                <Border Grid.Column="3" Style="{StaticResource KpiCardStyle}">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="NET WORKING CAPITAL" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <TextBlock Text="{Binding Statement.FormattedWorkingCapital, StringFormat='₹ {0}'}" FontSize="15" FontWeight="Bold" Foreground="#8B5CF6" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Equilibrium / Status Badge -->
                <Border Grid.Column="4" Style="{StaticResource KpiCardStyle}">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="ACCOUNTING STATUS" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <TextBlock Text="✓ Balance Sheet Tallied"
                                   FontSize="13.5"
                                   FontWeight="Bold"
                                   Foreground="#10B981"
                                   Margin="0,3,0,0"
                                   Visibility="{Binding Statement.IsBalanced, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="{Binding Statement.FormattedDifference, StringFormat='⚠ Discrepancy: ₹ {0}'}"
                                   FontSize="13.5"
                                   FontWeight="Bold"
                                   Foreground="#EF4444"
                                   Margin="0,3,0,0"
                                   Visibility="{Binding Statement.IsBalanced, Converter={StaticResource BoolToVis}, ConverterParameter=Inverse}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ROW 2: Balance Sheet Content (Tabs: T-Format / Schedule List / P&L Analysis) -->
            <telerik:RadTabControl Grid.Row="2" Background="Transparent" BorderThickness="0">

                <!-- TAB 1: Traditional Horizontal T-Format (Side-by-Side RadGridViews) -->
                <telerik:RadTabItem Header="Horizontal T-Format (Liabilities vs Assets)">
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- LEFT SIDE: Capital & Liabilities RadGridView -->
                        <Border Grid.Column="0"
                                Background="{DynamicResource CardBackgroundBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Header Bar -->
                                <Border Grid.Row="0" Background="#F1F5F9" Padding="10,8" CornerRadius="4,4,0,0" BorderBrush="#CBD5E1" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <TextBlock Text="CAPITAL &amp; LIABILITIES" FontWeight="Bold" FontSize="13" Foreground="#0F766E"/>
                                        <TextBlock Text="{Binding Statement.FormattedTotalLiabilities, StringFormat='Total: ₹ {0}'}" HorizontalAlignment="Right" FontWeight="Bold" FontSize="12.5" Foreground="#0F766E"/>
                                    </Grid>
                                </Border>

                                <!-- Liabilities RadGridView -->
                                <telerik:RadGridView Grid.Row="1"
                                                     ItemsSource="{Binding LiabilitiesItems}"
                                                     AutoGenerateColumns="False"
                                                     IsReadOnly="True"
                                                     CanUserReorderColumns="True"
                                                     ClipboardCopyMode="All"
                                                     CanUserResizeColumns="True"
                                                     SelectionMode="Extended"
                                                     ShowGroupPanel="False"
                                                     ShowGroupFooters="True"
                                                     ShowColumnFooters="True"
                                                     RowIndicatorVisibility="Collapsed"
                                                     GridLinesVisibility="Both"
                                                     FontSize="12">
                                    <telerik:RadGridView.GroupDescriptors>
                                        <telerik:GroupDescriptor Member="ScheduleName" SortDirection="Ascending"/>
                                    </telerik:RadGridView.GroupDescriptors>
                                    <telerik:RadGridView.Columns>
                                        <telerik:GridViewDataColumn Header="Schedule / Group"
                                                                    DataMemberBinding="{Binding ScheduleName}"
                                                                    IsVisible="False"/>

                                        <telerik:GridViewDataColumn Header="Account / Particulars"
                                                                    DataMemberBinding="{Binding AccountName}"
                                                                    Width="2*">
                                            <telerik:GridViewDataColumn.AggregateFunctions>
                                                <telerik:CountFunction Caption="Total: " ResultFormatString="{}{0} Accounts"/>
                                            </telerik:GridViewDataColumn.AggregateFunctions>
                                        </telerik:GridViewDataColumn>

                                        <telerik:GridViewDataColumn Header="Gold (g)"
                                                                    DataMemberBinding="{Binding GoldWeight}"
                                                                    DataFormatString="{}{0:N3}"
                                                                    TextAlignment="Right"
                                                                    Width="85">
                                            <telerik:GridViewDataColumn.AggregateFunctions>
                                                <telerik:SumFunction ResultFormatString="{}{0:N3} g"/>
                                            </telerik:GridViewDataColumn.AggregateFunctions>
                                        </telerik:GridViewDataColumn>

                                        <telerik:GridViewDataColumn Header="Silver (g)"
                                                                    DataMemberBinding="{Binding SilverWeight}"
                                                                    DataFormatString="{}{0:N3}"
                                                                    TextAlignment="Right"
                                                                    Width="85">
                                            <telerik:GridViewDataColumn.AggregateFunctions>
                                                <telerik:SumFunction ResultFormatString="{}{0:N3} g"/>
                                            </telerik:GridViewDataColumn.AggregateFunctions>
                                        </telerik:GridViewDataColumn>

                                        <telerik:GridViewDataColumn Header="Amount (₹)"
                                                                    DataMemberBinding="{Binding Amount}"
                                                                    DataFormatString="{}{0:N2}"
                                                                    TextAlignment="Right"
                                                                    Width="135">
                                            <telerik:GridViewDataColumn.AggregateFunctions>
                                                <telerik:SumFunction ResultFormatString="{}{0:N2}"/>
                                            </telerik:GridViewDataColumn.AggregateFunctions>
                                        </telerik:GridViewDataColumn>
                                    </telerik:RadGridView.Columns>
                                </telerik:RadGridView>
                            </Grid>
                        </Border>

                        <!-- Grid Splitter -->
                        <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent"/>

                        <!-- RIGHT SIDE: Property & Assets RadGridView -->
                        <Border Grid.Column="2"
                                Background="{DynamicResource CardBackgroundBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Header Bar -->
                                <Border Grid.Row="0" Background="#F1F5F9" Padding="10,8" CornerRadius="4,4,0,0" BorderBrush="#CBD5E1" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <TextBlock Text="PROPERTY &amp; ASSETS" FontWeight="Bold" FontSize="13" Foreground="#0284C7"/>
                                        <TextBlock Text="{Binding Statement.FormattedTotalAssets, StringFormat='Total: ₹ {0}'}" HorizontalAlignment="Right" FontWeight="Bold" FontSize="12.5" Foreground="#0284C7"/>
                                    </Grid>
                                </Border>

                                <!-- Assets RadGridView -->
                                <telerik:RadGridView Grid.Row="1"
                                                     ItemsSource="{Binding AssetsItems}"
                                                     AutoGenerateColumns="False"
                                                     IsReadOnly="True"
                                                     CanUserReorderColumns="True"
                                                     ClipboardCopyMode="All"
                                                     CanUserResizeColumns="True"
                                                     SelectionMode="Extended"
                                                     ShowGroupPanel="False"
                                                     ShowGroupFooters="True"
                                                     ShowColumnFooters="True"
                                                     RowIndicatorVisibility="Collapsed"
                                                     GridLinesVisibility="Both"
                                                     FontSize="12">
                                    <telerik:RadGridView.GroupDescriptors>
                                        <telerik:GroupDescriptor Member="ScheduleName" SortDirection="Ascending"/>
                                    </telerik:RadGridView.GroupDescriptors>
                                    <telerik:RadGridView.Columns>
                                        <telerik:GridViewDataColumn Header="Schedule / Group"
                                                                    DataMemberBinding="{Binding ScheduleName}"
                                                                    IsVisible="False"/>

                                        <telerik:GridViewDataColumn Header="Account / Particulars"
                                                                    DataMemberBinding="{Binding AccountName}"
                                                                    Width="2*">
                                            <telerik:GridViewDataColumn.AggregateFunctions>
                                                <telerik:CountFunction Caption="Total: " ResultFormatString="{}{0} Accounts"/>
                                            </telerik:GridViewDataColumn.AggregateFunctions>
                                        </telerik:GridViewDataColumn>

                                        <telerik:GridViewDataColumn Header="Gold (g)"
                                                                    DataMemberBinding="{Binding GoldWeight}"
                                                                    DataFormatString="{}{0:N3}"
                                                                    TextAlignment="Right"
                                                                    Width="85">
                                            <telerik:GridViewDataColumn.AggregateFunctions>
                                                <telerik:SumFunction ResultFormatString="{}{0:N3} g"/>
                                            </telerik:GridViewDataColumn.AggregateFunctions>
                                        </telerik:GridViewDataColumn>

                                        <telerik:GridViewDataColumn Header="Silver (g)"
                                                                    DataMemberBinding="{Binding SilverWeight}"
                                                                    DataFormatString="{}{0:N3}"
                                                                    TextAlignment="Right"
                                                                    Width="85">
                                            <telerik:GridViewDataColumn.AggregateFunctions>
                                                <telerik:SumFunction ResultFormatString="{}{0:N3} g"/>
                                            </telerik:GridViewDataColumn.AggregateFunctions>
                                        </telerik:GridViewDataColumn>

                                        <telerik:GridViewDataColumn Header="Amount (₹)"
                                                                    DataMemberBinding="{Binding Amount}"
                                                                    DataFormatString="{}{0:N2}"
                                                                    TextAlignment="Right"
                                                                    Width="135">
                                            <telerik:GridViewDataColumn.AggregateFunctions>
                                                <telerik:SumFunction ResultFormatString="{}{0:N2}"/>
                                            </telerik:GridViewDataColumn.AggregateFunctions>
                                        </telerik:GridViewDataColumn>
                                    </telerik:RadGridView.Columns>
                                </telerik:RadGridView>
                            </Grid>
                        </Border>
                    </Grid>
                </telerik:RadTabItem>

                <!-- TAB 2: Consolidated Schedule-Wise RadGridView (Full Width) -->
                <telerik:RadTabItem Header="Consolidated Statement (All Schedules)">
                    <Border Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Margin="0,4,0,0">
                        <telerik:RadGridView ItemsSource="{Binding AllItems}"
                                             AutoGenerateColumns="False"
                                             IsReadOnly="True"
                                             CanUserReorderColumns="True"
                                             ClipboardCopyMode="All"
                                             CanUserResizeColumns="True"
                                             SelectionMode="Extended"
                                             ShowGroupPanel="True"
                                             ShowGroupFooters="True"
                                             ShowColumnFooters="True"
                                             RowIndicatorVisibility="Collapsed"
                                             GridLinesVisibility="Both"
                                             FontSize="12">
                            <telerik:RadGridView.GroupDescriptors>
                                <telerik:GroupDescriptor Member="GroupType" SortDirection="Ascending"/>
                                <telerik:GroupDescriptor Member="ScheduleName" SortDirection="Ascending"/>
                            </telerik:RadGridView.GroupDescriptors>
                            <telerik:RadGridView.Columns>
                                <telerik:GridViewDataColumn Header="Group Type"
                                                            DataMemberBinding="{Binding GroupType}"
                                                            Width="130"/>

                                <telerik:GridViewDataColumn Header="Schedule Name"
                                                            DataMemberBinding="{Binding ScheduleName}"
                                                            Width="180"/>

                                <telerik:GridViewDataColumn Header="Account / Particulars"
                                                            DataMemberBinding="{Binding AccountName}"
                                                            Width="2.5*">
                                    <telerik:GridViewDataColumn.AggregateFunctions>
                                        <telerik:CountFunction Caption="Total: " ResultFormatString="{}{0} Accounts"/>
                                    </telerik:GridViewDataColumn.AggregateFunctions>
                                </telerik:GridViewDataColumn>

                                <telerik:GridViewDataColumn Header="Head Category"
                                                            DataMemberBinding="{Binding HeadCategory}"
                                                            Width="140"/>

                                <telerik:GridViewDataColumn Header="Gold (g)"
                                                            DataMemberBinding="{Binding GoldWeight}"
                                                            DataFormatString="{}{0:N3}"
                                                            TextAlignment="Right"
                                                            Width="100">
                                    <telerik:GridViewDataColumn.AggregateFunctions>
                                        <telerik:SumFunction ResultFormatString="{}{0:N3} g"/>
                                    </telerik:GridViewDataColumn.AggregateFunctions>
                                </telerik:GridViewDataColumn>

                                <telerik:GridViewDataColumn Header="Silver (g)"
                                                            DataMemberBinding="{Binding SilverWeight}"
                                                            DataFormatString="{}{0:N3}"
                                                            TextAlignment="Right"
                                                            Width="100">
                                    <telerik:GridViewDataColumn.AggregateFunctions>
                                        <telerik:SumFunction ResultFormatString="{}{0:N3} g"/>
                                    </telerik:GridViewDataColumn.AggregateFunctions>
                                </telerik:GridViewDataColumn>

                                <telerik:GridViewDataColumn Header="Amount (₹)"
                                                            DataMemberBinding="{Binding Amount}"
                                                            DataFormatString="{}{0:N2}"
                                                            TextAlignment="Right"
                                                            Width="150">
                                    <telerik:GridViewDataColumn.AggregateFunctions>
                                        <telerik:SumFunction ResultFormatString="{}{0:N2}"/>
                                    </telerik:GridViewDataColumn.AggregateFunctions>
                                </telerik:GridViewDataColumn>
                            </telerik:RadGridView.Columns>
                        </telerik:RadGridView>
                    </Border>
                </telerik:RadTabItem>

                <!-- TAB 3: Trading & Profit & Loss Statement Integration -->
                <telerik:RadTabItem Header="Trading &amp; Profit &amp; Loss Details">
                    <Border Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="16"
                            Margin="0,4,0,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel MaxWidth="850" HorizontalAlignment="Left">
                                <TextBlock Text="Trading and Profit &amp; Loss Statement" FontSize="16" FontWeight="Bold" Foreground="#0F766E" Margin="0,0,0,14"/>

                                <!-- TRADING ACCOUNT -->
                                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="1. TRADING ACCOUNT (GROSS PROFIT CALCULATION)" FontWeight="Bold" FontSize="12.5" Foreground="#334155" Margin="0,0,0,8"/>
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="(+) Net Sales Revenue" FontSize="12"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Statement.ProfitLoss.FormattedSales, StringFormat='₹ {0}'}" FontWeight="SemiBold" TextAlignment="Right"/>
                                        </Grid>
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="(+) Closing Stock Valuation" FontSize="12"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Statement.ProfitLoss.ClosingStockAmount, StringFormat='₹ {0:N2}'}" FontWeight="SemiBold" TextAlignment="Right"/>
                                        </Grid>
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="(-) Opening Stock" FontSize="12"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Statement.ProfitLoss.OpeningStockAmount, StringFormat='₹ {0:N2}'}" TextAlignment="Right"/>
                                        </Grid>
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="(-) Net Purchases" FontSize="12"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Statement.ProfitLoss.FormattedPurchases, StringFormat='₹ {0}'}" TextAlignment="Right"/>
                                        </Grid>
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="(-) Direct Expenses (Making Charges / Wages / Freight)" FontSize="12"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Statement.ProfitLoss.DirectExpenses, StringFormat='₹ {0:N2}'}" TextAlignment="Right"/>
                                        </Grid>
                                        <Separator Margin="0,6"/>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="= GROSS PROFIT" FontWeight="Bold" FontSize="13" Foreground="#0F766E"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Statement.ProfitLoss.FormattedGrossProfit, StringFormat='₹ {0}'}" FontWeight="Bold" FontSize="13" Foreground="#0F766E" TextAlignment="Right"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- PROFIT & LOSS ACCOUNT -->
                                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="2. PROFIT &amp; LOSS ACCOUNT (NET PROFIT CALCULATION)" FontWeight="Bold" FontSize="12.5" Foreground="#334155" Margin="0,0,0,8"/>
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="Gross Profit (b/f)" FontSize="12"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Statement.ProfitLoss.FormattedGrossProfit, StringFormat='₹ {0}'}" FontWeight="SemiBold" TextAlignment="Right"/>
                                        </Grid>
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="(+) Indirect Incomes (Discount / Interest / Incentives)" FontSize="12"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Statement.ProfitLoss.IndirectIncomes, StringFormat='₹ {0:N2}'}" TextAlignment="Right"/>
                                        </Grid>
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="(-) Indirect Expenses (Salaries, Rent, Power, Depr, Bank Charges)" FontSize="12"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Statement.ProfitLoss.IndirectExpenses, StringFormat='₹ {0:N2}'}" TextAlignment="Right"/>
                                        </Grid>
                                        <Separator Margin="0,6"/>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="= NET PROFIT / (LOSS) TRANSFERRED TO BALANCE SHEET" FontWeight="Bold" FontSize="13" Foreground="#10B981"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Statement.ProfitLoss.FormattedNetProfit, StringFormat='₹ {0}'}" FontWeight="Bold" FontSize="13" Foreground="#10B981" TextAlignment="Right"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </telerik:RadTabItem>
            </telerik:RadTabControl>
        </Grid>
    </Grid>
</UserControl>
