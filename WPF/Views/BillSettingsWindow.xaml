<Window x:Class="ConceptJewelleryPro.WPF.Views.BillSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
        Title="Bill &amp; Invoice Settings"
        Height="470" Width="650"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI">

    <Border Background="{DynamicResource WindowBackgroundBrush}"
            BorderBrush="{DynamicResource AccentBrush}"
            BorderThickness="2"
            CornerRadius="8"
            Padding="0">
        <Border.Effect>
            <DropShadowEffect BlurRadius="25" ShadowDepth="6" Opacity="0.4" Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52" />
                <RowDefinition Height="*" />
                <RowDefinition Height="60" />
            </Grid.RowDefinitions>

            <!-- Header (Theme-Aware & Draggable) -->
            <Border Grid.Row="0"
                    Background="{DynamicResource HeaderBackgroundBrush}"
                    CornerRadius="6,6,0,0"
                    BorderBrush="{DynamicResource HeaderBorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="18,0"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="32" Height="32" Background="{DynamicResource PanelBrush}" CornerRadius="6" VerticalAlignment="Center" Margin="0,0,10,0">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Bill &amp; Invoice Settings" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="15" FontWeight="Bold" />
                            <TextBlock Text="Configure invoice printing, WhatsApp auto-dispatch &amp; piece-rate display" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" />
                        </StackPanel>
                    </StackPanel>

                    <telerik:RadButton Content="✕"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       Background="Transparent"
                                       BorderThickness="0"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Right"
                                       Click="Cancel_Click"
                                       Cursor="Hand"
                                       Padding="6"
                                       Focusable="False" />
                </Grid>
            </Border>

            <!-- Form Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,16">
                <StackPanel>
                    <!-- SECTION 1: Default Bill Printer -->
                    <Border Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="14"
                            Margin="0,0,0,14">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="&#xE749;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="Bill Default Printer" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="Select the dedicated printer used for invoice printing and cash counter bills."
                                       FontSize="11.5"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Margin="0,0,0,10" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <telerik:RadComboBox x:Name="BillPrinterComboBox"
                                                     Grid.Column="0"
                                                     Height="38"
                                                     FontSize="13"
                                                     IsEditable="False"
                                                     Foreground="{DynamicResource PrimaryTextBrush}"
                                                     Background="{DynamicResource InputBackgroundBrush}"
                                                     BorderBrush="{DynamicResource InputBorderBrush}" />
                                <telerik:RadButton x:Name="RefreshPrintersButton"
                                                   Grid.Column="1"
                                                   Content="🔄 Refresh"
                                                   Height="38"
                                                   Padding="10,0"
                                                   Margin="8,0,0,0"
                                                   FontSize="12"
                                                   Click="RefreshPrintersButton_Click" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- SECTION 2: WhatsApp Auto Send Setting -->
                    <Border Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="14"
                            Margin="0,0,0,14">
                        <StackPanel>
                            <CheckBox x:Name="AutoSendWhatsAppCheckBox"
                                      FontSize="13.5"
                                      FontWeight="Bold"
                                      Foreground="{DynamicResource PrimaryTextBrush}"
                                      VerticalContentAlignment="Center">
                                <CheckBox.Content>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Auto Send WhatsApp" Margin="4,0,0,0" />
                                    </StackPanel>
                                </CheckBox.Content>
                            </CheckBox>
                            <TextBlock Text="Automatically send invoice details and WhatsApp message to the customer when saving a bill."
                                       FontSize="11.5"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Margin="24,4,0,0"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- SECTION 3: Hide Wt in PcItems -->
                    <Border Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="14"
                            Margin="0,0,0,14">
                        <StackPanel>
                            <CheckBox x:Name="HideWtInPcItemsCheckBox"
                                      FontSize="13.5"
                                      FontWeight="Bold"
                                      Foreground="{DynamicResource PrimaryTextBrush}"
                                      VerticalContentAlignment="Center">
                                <CheckBox.Content>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Hide Wt in PcItems" Margin="4,0,0,0" />
                                    </StackPanel>
                                </CheckBox.Content>
                            </CheckBox>
                            <TextBlock Text="When enabled, printed invoices will show '-' instead of weights for items marked as Piece Rate (PcRate)."
                                       FontSize="11.5"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Margin="24,4,0,0"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- SECTION 4: Allow NtWt Modification Up To -->
                    <Border Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="14">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="&#xE825;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="Allow NtWt Mod Up To (±g)" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="Maximum allowable weight difference in grams (±g) when modifying barcode Net Weight during billing (e.g. 0.010 allows a 2.320g barcode to change between 2.310g - 2.330g)."
                                       FontSize="11.5"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Margin="0,0,0,8"
                                       TextWrapping="Wrap" />
                            <telerik:RadWatermarkTextBox x:Name="AllowNtWtModUptoTextBox"
                                                         Height="38"
                                                         FontSize="13"
                                                         Foreground="{DynamicResource PrimaryTextBrush}"
                                                         Background="{DynamicResource InputBackgroundBrush}"
                                                         BorderBrush="{DynamicResource InputBorderBrush}"
                                                         VerticalContentAlignment="Center"
                                                         Padding="8,0"
                                                         WatermarkContent="0.000" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Bottom Action Buttons Bar -->
            <Border Grid.Row="2"
                    Background="{DynamicResource HeaderBackgroundBrush}"
                    CornerRadius="0,0,6,6"
                    BorderBrush="{DynamicResource HeaderBorderBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="18,0">
                <Grid VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <telerik:RadButton Content="Cancel"
                                           Height="40"
                                           MinWidth="85"
                                           Padding="14,0"
                                           Margin="0,0,10,0"
                                           Click="Cancel_Click" />
                        <telerik:RadButton x:Name="SaveSettingsButton"
                                           Content="Save Settings"
                                           Height="40"
                                           MinWidth="120"
                                           Padding="16,0"
                                           FontWeight="Bold"
                                           Background="{DynamicResource AccentBrush}"
                                           Foreground="{DynamicResource AccentTextBrush}"
                                           Click="SaveSettingsButton_Click" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
