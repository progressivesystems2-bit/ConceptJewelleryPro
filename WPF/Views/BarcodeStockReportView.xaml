<UserControl x:Class="ConceptJewelleryPro.WPF.Views.BarcodeStockReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
             xmlns:controls="clr-namespace:ConceptJewelleryPro.WPF.Controls"
             xmlns:conv="clr-namespace:ConceptJewelleryPro.WPF.Converters"
             xmlns:vm="clr-namespace:ConceptJewelleryPro.WPF.ViewModels"
             FontFamily="Segoe UI"
             TextOptions.TextFormattingMode="Display"
             PreviewKeyDown="BarcodeStockReportView_PreviewKeyDown">

    <UserControl.InputBindings>
        <KeyBinding Key="F9" Command="{Binding RefreshFiltersCommand}"/>
    </UserControl.InputBindings>

    <UserControl.Resources>
        <controls:BindingProxy x:Key="Proxy" Data="{Binding}"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:InverseBooleanToVisibilityConverter x:Key="InvBoolToVis"/>
        <conv:ImageThumbnailConverter x:Key="ThumbConverter" DecodePixelWidth="60"/>

        <Style x:Key="HeaderFilterLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
        </Style>

        <Style x:Key="FilterComboBoxStyle" TargetType="telerik:RadComboBox" BasedOn="{StaticResource RadComboBoxStyle}">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="IsEditable" Value="True"/>
            <Setter Property="IsFilteringEnabled" Value="True"/>
            <Setter Property="OpenDropDownOnFocus" Value="False"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>

        <Style x:Key="FilterDatePickerStyle" TargetType="DatePicker">
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>

        <Style x:Key="IconButtonTopStyle" TargetType="telerik:RadButton" BasedOn="{StaticResource RadButtonStyle}">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- Unified Single-Line Theme-Aware Tab Button Style -->
        <Style x:Key="MainTabButtonStyle" TargetType="telerik:RadButton" BasedOn="{StaticResource RadButtonStyle}">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Margin" Value="0,0,3,0"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1,1,1,1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Footer Total Box Style -->
        <Style x:Key="TotalBoxStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Height" Value="26"/>
        </Style>

        <Style x:Key="TotalTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <!-- Toast Notification Overlay -->
        <controls:ToastNotification x:Name="ToastNotification"
                                     Panel.ZIndex="99"
                                     Message="{Binding ToastMessage, FallbackValue=''}"
                                     ToastType="{Binding ToastType, FallbackValue=Info}"
                                     AutoCloseDelay="4000"
                                     FontSize="13"
                                     HorizontalAlignment="Right"
                                     VerticalAlignment="Bottom"
                                     Margin="0,0,24,24"/>

        <Grid Margin="10,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Top Filter Bar -->
                <RowDefinition Height="Auto"/> <!-- Tab Headers Area -->
                <RowDefinition Height="*"/>    <!-- Data Grid Area -->
                <RowDefinition Height="Auto"/> <!-- Footer Totals & Record Pager -->
            </Grid.RowDefinitions>

            <!-- ================= ROW 0: TOP FILTER BAR ================= -->
            <Border Grid.Row="0"
                    Background="{DynamicResource HeaderBackgroundBrush}"
                    BorderBrush="{DynamicResource HeaderBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="10,6"
                    Margin="0,0,0,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Filters & Action Buttons -->
                    <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Item Head -->
                        <StackPanel Orientation="Horizontal" Margin="0,2,10,2" VerticalAlignment="Center">
                            <TextBlock Text="Item Head:" Style="{StaticResource HeaderFilterLabel}"/>
                            <telerik:RadComboBox ItemsSource="{Binding ItemHeads}"
                                                 SelectedItem="{Binding SelectedItemHead, Mode=TwoWay}"
                                                 Style="{StaticResource FilterComboBoxStyle}"
                                                 Width="110"/>
                        </StackPanel>

                        <!-- Sub Group -->
                        <StackPanel Orientation="Horizontal" Margin="0,2,10,2" VerticalAlignment="Center">
                            <TextBlock Text="Sub Group:" Style="{StaticResource HeaderFilterLabel}"/>
                            <telerik:RadComboBox ItemsSource="{Binding SubGroups}"
                                                 SelectedItem="{Binding SelectedSubGroup, Mode=TwoWay}"
                                                 Style="{StaticResource FilterComboBoxStyle}"
                                                 Width="110"/>
                        </StackPanel>

                        <!-- Purity -->
                        <StackPanel Orientation="Horizontal" Margin="0,2,10,2" VerticalAlignment="Center">
                            <TextBlock Text="Purity:" Style="{StaticResource HeaderFilterLabel}"/>
                            <telerik:RadComboBox ItemsSource="{Binding Purities}"
                                                 SelectedItem="{Binding SelectedPurity, Mode=TwoWay}"
                                                 Style="{StaticResource FilterComboBoxStyle}"
                                                 Width="110"/>
                        </StackPanel>

                        <!-- Item Name -->
                        <StackPanel Orientation="Horizontal" Margin="0,2,10,2" VerticalAlignment="Center">
                            <TextBlock Text="Item Name:" Style="{StaticResource HeaderFilterLabel}"/>
                            <telerik:RadComboBox ItemsSource="{Binding ItemNames}"
                                                 SelectedItem="{Binding SelectedItemName, Mode=TwoWay}"
                                                 Style="{StaticResource FilterComboBoxStyle}"
                                                 Width="120"/>
                        </StackPanel>

                        <!-- Box No Filter -->
                        <StackPanel Orientation="Horizontal" Margin="0,2,10,2" VerticalAlignment="Center">
                            <TextBlock Text="Box No:" Style="{StaticResource HeaderFilterLabel}"/>
                            <telerik:RadComboBox ItemsSource="{Binding BoxNos}"
                                                 SelectedItem="{Binding SelectedBoxNo, Mode=TwoWay}"
                                                 Style="{StaticResource FilterComboBoxStyle}"
                                                 Width="105"/>
                        </StackPanel>

                        <!-- From Date -->
                        <StackPanel Orientation="Horizontal" Margin="0,2,10,2" VerticalAlignment="Center">
                            <TextBlock Text="From Date:" Style="{StaticResource HeaderFilterLabel}"/>
                            <DatePicker SelectedDate="{Binding FromDate, Mode=TwoWay}"
                                        Style="{StaticResource FilterDatePickerStyle}"
                                        Width="105"/>
                        </StackPanel>

                        <!-- To Date -->
                        <StackPanel Orientation="Horizontal" Margin="0,2,10,2" VerticalAlignment="Center">
                            <TextBlock Text="To Date:" Style="{StaticResource HeaderFilterLabel}"/>
                            <DatePicker SelectedDate="{Binding ToDate, Mode=TwoWay}"
                                        Style="{StaticResource FilterDatePickerStyle}"
                                        Width="105"/>
                        </StackPanel>

                        <!-- Search Barcode / Item -->
                        <StackPanel Orientation="Horizontal" Margin="0,2,10,2" VerticalAlignment="Center">
                            <TextBlock Text="Search:" Style="{StaticResource HeaderFilterLabel}"/>
                            <telerik:RadWatermarkTextBox Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         WatermarkContent="Barcode, Phone, Customer..."
                                                         Width="160"
                                                         Height="28"
                                                         FontSize="12"/>
                        </StackPanel>

                        <!-- Actions -->
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,2" VerticalAlignment="Center">
                            <telerik:RadButton Style="{StaticResource IconButtonTopStyle}" Command="{Binding RefreshCommand}" ToolTip="Refresh stock reports">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="14" HorizontalAlignment="Center" Foreground="{DynamicResource AccentBrush}"/>
                                    <TextBlock Text="Refresh" FontSize="10" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </telerik:RadButton>

                            <telerik:RadButton Style="{StaticResource IconButtonTopStyle}" Command="{Binding ResetFiltersCommand}" ToolTip="Reset all filters to defaults">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE894;" FontFamily="Segoe MDL2 Assets" FontSize="14" HorizontalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                    <TextBlock Text="Reset" FontSize="10" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </telerik:RadButton>

                            <telerik:RadButton Style="{StaticResource IconButtonTopStyle}" Command="{Binding PrintCommand}" ToolTip="Print current view">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE749;" FontFamily="Segoe MDL2 Assets" FontSize="14" HorizontalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                    <TextBlock Text="Print" FontSize="10" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </telerik:RadButton>

                            <telerik:RadButton Style="{StaticResource IconButtonTopStyle}" Command="{Binding PrintCapacityCommand}" ToolTip="Print capacity summary">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE749;" FontFamily="Segoe MDL2 Assets" FontSize="14" HorizontalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                    <TextBlock Text="Print Capacity" FontSize="10" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </telerik:RadButton>

                            <telerik:RadButton Style="{StaticResource IconButtonTopStyle}" Command="{Binding ExportToExcelCommand}" ToolTip="Export current list to CSV">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE8E5;" FontFamily="Segoe MDL2 Assets" FontSize="14" HorizontalAlignment="Center" Foreground="{DynamicResource SuccessBrush}"/>
                                    <TextBlock Text="Export" FontSize="10" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </telerik:RadButton>
                        </StackPanel>
                    </WrapPanel>

                    <!-- Right: Large Header Title -->
                    <TextBlock Grid.Column="1"
                               Text="BARCODE STOCK REPORTS"
                               FontSize="17"
                               FontWeight="Bold"
                               Foreground="{DynamicResource AccentBrush}"
                               VerticalAlignment="Center"
                               Margin="16,0,8,0"/>
                </Grid>
            </Border>

            <!-- ================= ROW 1: SINGLE-LINE THEME-AWARE TABS BAR ================= -->
            <Border Grid.Row="1"
                    Background="{DynamicResource HeaderBackgroundBrush}"
                    BorderBrush="{DynamicResource HeaderBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="4,3"
                    Margin="0,0,0,6">
                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled"
                              Focusable="False">
                    <StackPanel Orientation="Horizontal">
                        <!-- 1. Stock In Hand -->
                        <telerik:RadButton Content="Stock In Hand"
                                           Command="{Binding SelectTabCommand}"
                                           CommandParameter="StockInHand">
                            <telerik:RadButton.Style>
                                <Style TargetType="telerik:RadButton" BasedOn="{StaticResource MainTabButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsStockInHandActive}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                            <Setter Property="BorderThickness" Value="1,1,1,1"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </telerik:RadButton.Style>
                        </telerik:RadButton>

                        <!-- 2. Stock Head Group Wise -->
                        <telerik:RadButton Content="Stock Head Group Wise"
                                           Command="{Binding SelectTabCommand}"
                                           CommandParameter="StockHeadGroupWise">
                            <telerik:RadButton.Style>
                                <Style TargetType="telerik:RadButton" BasedOn="{StaticResource MainTabButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsHeadGroupWiseActive}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                            <Setter Property="BorderThickness" Value="1,1,1,1"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </telerik:RadButton.Style>
                        </telerik:RadButton>

                        <!-- 3. Stock In Hand Supplier Wise -->
                        <telerik:RadButton Content="Stock In Hand Supplier Wise"
                                           Command="{Binding SelectTabCommand}"
                                           CommandParameter="StockSupplierWise">
                            <telerik:RadButton.Style>
                                <Style TargetType="telerik:RadButton" BasedOn="{StaticResource MainTabButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSupplierWiseActive}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                            <Setter Property="BorderThickness" Value="1,1,1,1"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </telerik:RadButton.Style>
                        </telerik:RadButton>

                        <!-- 4. Item Wise Stock -->
                        <telerik:RadButton Content="Item Wise Stock"
                                           Command="{Binding SelectTabCommand}"
                                           CommandParameter="ItemWiseStock">
                            <telerik:RadButton.Style>
                                <Style TargetType="telerik:RadButton" BasedOn="{StaticResource MainTabButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsItemWiseStockActive}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                            <Setter Property="BorderThickness" Value="1,1,1,1"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </telerik:RadButton.Style>
                        </telerik:RadButton>

                        <!-- 5. Item Wise Sales -->
                        <telerik:RadButton Content="Item Wise Sales"
                                           Command="{Binding SelectTabCommand}"
                                           CommandParameter="ItemWiseSales">
                            <telerik:RadButton.Style>
                                <Style TargetType="telerik:RadButton" BasedOn="{StaticResource MainTabButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSalesActive}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                            <Setter Property="BorderThickness" Value="1,1,1,1"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </telerik:RadButton.Style>
                        </telerik:RadButton>

                        <!-- 6. Item Wise Sales Return -->
                        <telerik:RadButton Content="Item Wise Sales Return"
                                           Command="{Binding SelectTabCommand}"
                                           CommandParameter="ItemWiseSalesReturn">
                            <telerik:RadButton.Style>
                                <Style TargetType="telerik:RadButton" BasedOn="{StaticResource MainTabButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSalesReturnActive}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                            <Setter Property="BorderThickness" Value="1,1,1,1"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </telerik:RadButton.Style>
                        </telerik:RadButton>

                        <!-- 7. Barcode Movement Details -->
                        <telerik:RadButton Content="Barcode Movement Details"
                                           Command="{Binding SelectTabCommand}"
                                           CommandParameter="BarcodeMovement">
                            <telerik:RadButton.Style>
                                <Style TargetType="telerik:RadButton" BasedOn="{StaticResource MainTabButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMovementActive}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                            <Setter Property="BorderThickness" Value="1,1,1,1"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </telerik:RadButton.Style>
                        </telerik:RadButton>

                        <!-- 8. Item Mismatch -->
                        <telerik:RadButton Content="Item Mismatch"
                                           Command="{Binding SelectTabCommand}"
                                           CommandParameter="ItemMismatch">
                            <telerik:RadButton.Style>
                                <Style TargetType="telerik:RadButton" BasedOn="{StaticResource MainTabButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMismatchActive}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                            <Setter Property="BorderThickness" Value="1,1,1,1"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </telerik:RadButton.Style>
                        </telerik:RadButton>

                        <!-- 9. Stock Check -->
                        <telerik:RadButton Content="Stock Check"
                                           Command="{Binding SelectTabCommand}"
                                           CommandParameter="StockCheck">
                            <telerik:RadButton.Style>
                                <Style TargetType="telerik:RadButton" BasedOn="{StaticResource MainTabButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsStockCheckActive}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                            <Setter Property="BorderThickness" Value="1,1,1,1"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </telerik:RadButton.Style>
                        </telerik:RadButton>

                        <!-- 10. Search Options -->
                        <telerik:RadButton Content="Search Options"
                                           Command="{Binding SelectTabCommand}"
                                           CommandParameter="SearchOptions">
                            <telerik:RadButton.Style>
                                <Style TargetType="telerik:RadButton" BasedOn="{StaticResource MainTabButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSearchOptionsActive}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                            <Setter Property="BorderThickness" Value="1,1,1,1"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </telerik:RadButton.Style>
                        </telerik:RadButton>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ================= ROW 2: MAIN DATA GRID AREA ================= -->
            <Grid Grid.Row="2">
                <!-- Loading indicator -->
                <telerik:RadBusyIndicator IsBusy="{Binding IsBusy}" BusyContent="Loading stock report..." Panel.ZIndex="10"/>

                <!-- 1. Detailed Grid View (Stock In Hand, Sales, Returns, Mismatches, Stock Check, Search Options) -->
                <Grid Visibility="{Binding IsDetailedGridVisible, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/> <!-- Tab-specific photo preview panel -->
                    </Grid.ColumnDefinitions>

                    <telerik:RadGridView Grid.Column="0"
                                         ItemsSource="{Binding Items}"
                                         SelectedItem="{Binding SelectedStockItem, Mode=TwoWay}"
                                         AutoGenerateColumns="False"
                                         IsReadOnly="True"
                                         RowIndicatorVisibility="Collapsed"
                                         ShowGroupPanel="False"
                                         CanUserFreezeColumns="False"
                                         SelectionMode="Multiple"
                                         FontSize="12"
                                         RowHeight="48"
                                         EnableRowVirtualization="True"
                                         VirtualizingPanel.IsVirtualizing="True"
                                         VirtualizingPanel.VirtualizationMode="Recycling"
                                         ScrollViewer.CanContentScroll="True">
                        <telerik:RadGridView.Columns>
                            <!-- Barcode Image Column -->
                            <telerik:GridViewDataColumn Header="Photo" Width="50" IsResizable="False">
                                <telerik:GridViewDataColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Width="48" Height="48"
                                                Background="{DynamicResource PanelBrush}"
                                                CornerRadius="4"
                                                BorderBrush="{DynamicResource CardBorderBrush}"
                                                BorderThickness="1"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                ClipToBounds="True">
                                            <Grid>
                                                <!-- Fallback icon if no photo exists -->
                                                <TextBlock Text="💎"
                                                           FontSize="16"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Visibility="{Binding HasImage, Converter={StaticResource InvBoolToVis}}"/>

                                                <!-- Thumbnail image with memory-efficient thumbnail decoding and hover tooltip -->
                                                <Image Source="{Binding ImagePath, Converter={StaticResource ThumbConverter}}"
                                                       Stretch="UniformToFill"
                                                       RenderOptions.BitmapScalingMode="HighQuality"
                                                       Visibility="{Binding HasImage, Converter={StaticResource BoolToVis}}">
                                                    <Image.ToolTip>
                                                        <ToolTip Background="{DynamicResource CardBackgroundBrush}"
                                                                 BorderBrush="{DynamicResource AccentBrush}"
                                                                 BorderThickness="1.5"
                                                                 Padding="6">
                                                            <StackPanel MaxWidth="320">
                                                                <Border BorderBrush="{DynamicResource CardBorderBrush}"
                                                                        BorderThickness="1"
                                                                        CornerRadius="4"
                                                                        Background="{DynamicResource PanelBrush}"
                                                                        Margin="0,0,0,6">
                                                                    <Image Source="{Binding ImagePath}" MaxWidth="300" MaxHeight="300" Stretch="Uniform" Margin="4"/>
                                                                </Border>
                                                                <TextBlock Text="{Binding Barcode}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource AccentBrush}"/>
                                                                <TextBlock Text="{Binding ItemName}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                                    <TextBlock Text="Purity: " FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                                    <TextBlock Text="{Binding Purity}" FontSize="11" FontWeight="SemiBold" Margin="0,0,10,0" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                                    <TextBlock Text="Net Wt: " FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                                    <TextBlock Text="{Binding NetWt, StringFormat='{}{0:N3} g'}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </ToolTip>
                                                    </Image.ToolTip>
                                                </Image>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </telerik:GridViewDataColumn.CellTemplate>
                            </telerik:GridViewDataColumn>

                            <telerik:GridViewDataColumn Header="Barcode" DataMemberBinding="{Binding Barcode}" Width="90" TextAlignment="Center"/>
                            <telerik:GridViewDataColumn Header="Item Name" DataMemberBinding="{Binding ItemName}" Width="160"/>

                            <!-- Sales Info Columns (Item Wise Sales) -->
                            <telerik:GridViewDataColumn Header="Bill No" DataMemberBinding="{Binding VouNo}" Width="90" TextAlignment="Center"
                                                        IsVisible="{Binding Data.IsSalesActive, Source={StaticResource Proxy}}"/>
                            <telerik:GridViewDataColumn Header="Bill Date" DataMemberBinding="{Binding BillDate, StringFormat='dd/MM/yyyy'}" Width="95" TextAlignment="Center"
                                                        IsVisible="{Binding Data.IsSalesActive, Source={StaticResource Proxy}}"/>
                            <telerik:GridViewDataColumn Header="Customer Name" DataMemberBinding="{Binding CustomerName}" Width="160"
                                                        IsVisible="{Binding Data.IsSalesActive, Source={StaticResource Proxy}}">
                                <telerik:GridViewDataColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid Background="Transparent" VerticalAlignment="Center" HorizontalAlignment="Stretch" ToolTip="Right-click for Customer History or Copy options">
                                            <Grid.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="Customer History"
                                                              Command="{Binding Data.OpenCustomerHistoryCommand, Source={StaticResource Proxy}}"
                                                              CommandParameter="{Binding}">
                                                        <MenuItem.Icon>
                                                            <TextBlock Text="&#xE81C;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <Separator/>
                                                    <MenuItem Header="Copy Customer Name"
                                                              Command="{Binding Data.CopyTextCommand, Source={StaticResource Proxy}}"
                                                              CommandParameter="{Binding CustomerName}">
                                                        <MenuItem.Icon>
                                                            <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="Copy Mobile No"
                                                              Command="{Binding Data.CopyPhoneCommand, Source={StaticResource Proxy}}"
                                                              CommandParameter="{Binding Phone}">
                                                        <MenuItem.Icon>
                                                            <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                </ContextMenu>
                                            </Grid.ContextMenu>
                                            <TextBlock Text="{Binding CustomerName}" VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </telerik:GridViewDataColumn.CellTemplate>
                            </telerik:GridViewDataColumn>
                            <telerik:GridViewDataColumn Header="Mobile No" DataMemberBinding="{Binding Phone}" Width="120" TextAlignment="Center"
                                                        IsVisible="{Binding Data.IsSalesActive, Source={StaticResource Proxy}}">
                                <telerik:GridViewDataColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid Background="Transparent" VerticalAlignment="Center" HorizontalAlignment="Stretch" ToolTip="Right-click for Customer History or Copy options">
                                            <Grid.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="Customer History"
                                                              Command="{Binding Data.OpenCustomerHistoryCommand, Source={StaticResource Proxy}}"
                                                              CommandParameter="{Binding}">
                                                        <MenuItem.Icon>
                                                            <TextBlock Text="&#xE81C;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <Separator/>
                                                    <MenuItem Header="Copy Mobile No"
                                                              Command="{Binding Data.CopyPhoneCommand, Source={StaticResource Proxy}}"
                                                              CommandParameter="{Binding Phone}">
                                                        <MenuItem.Icon>
                                                            <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="Copy Customer Name"
                                                              Command="{Binding Data.CopyTextCommand, Source={StaticResource Proxy}}"
                                                              CommandParameter="{Binding CustomerName}">
                                                        <MenuItem.Icon>
                                                            <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                </ContextMenu>
                                            </Grid.ContextMenu>
                                            <TextBlock Text="{Binding Phone}" TextAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </telerik:GridViewDataColumn.CellTemplate>
                            </telerik:GridViewDataColumn>

                            <telerik:GridViewDataColumn Header="Qty" DataMemberBinding="{Binding Qty, StringFormat='{}{0:N0}'}" Width="60" TextAlignment="Right"/>
                            <telerik:GridViewDataColumn Header="Gross Wt" DataMemberBinding="{Binding GrossWt, StringFormat='{}{0:N3}'}" Width="95" TextAlignment="Right"/>
                            <telerik:GridViewDataColumn Header="Stn Wt" DataMemberBinding="{Binding StoneWt, StringFormat='{}{0:N3}'}" Width="90" TextAlignment="Right"/>
                            <telerik:GridViewDataColumn Header="Net Wt" DataMemberBinding="{Binding NetWt, StringFormat='{}{0:N3}'}" Width="95" TextAlignment="Right"/>
                            <telerik:GridViewDataColumn Header="Stn Value" DataMemberBinding="{Binding StoneValue, StringFormat='{}{0:N2}'}" Width="95" TextAlignment="Right"/>
                            <telerik:GridViewDataColumn Header="Making" DataMemberBinding="{Binding Making, StringFormat='{}{0:N2}'}" Width="95" TextAlignment="Right"/>
                            <telerik:GridViewDataColumn Header="Making/g" DataMemberBinding="{Binding MakingPerGram, StringFormat='{}{0:N2}'}" Width="85" TextAlignment="Right"/>
                            <telerik:GridViewDataColumn Header="Purity" DataMemberBinding="{Binding Purity}" Width="90" TextAlignment="Center"/>
                            <telerik:GridViewDataColumn Header="Sub Group" DataMemberBinding="{Binding SubGroup}" Width="100"/>
                            <telerik:GridViewDataColumn Header="Head Group" DataMemberBinding="{Binding HeadGroup}" Width="100"/>
                            <telerik:GridViewDataColumn Header="Supplier" DataMemberBinding="{Binding SupplierName}" Width="*"/>
                        </telerik:RadGridView.Columns>
                    </telerik:RadGridView>

                    <!-- Dedicated Photo Preview Card for Detailed View -->
                    <Border Grid.Column="1"
                            Width="150"
                            Margin="8,0,0,0"
                            Background="{DynamicResource PanelBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="8"
                            Visibility="{Binding SelectedStockItem.HasImage, Converter={StaticResource BoolToVis}}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="PHOTO PREVIEW" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                <Border Height="130" Width="130" CornerRadius="4" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" ClipToBounds="True">
                                    <Image Source="{Binding SelectedStockItem.ImagePath}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Border>
                                <TextBlock Text="{Binding SelectedStockItem.Barcode}" FontWeight="Bold" FontSize="12.5" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                <TextBlock Text="{Binding SelectedStockItem.ItemName}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding SelectedStockItem.Purity}" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                <TextBlock Text="{Binding SelectedStockItem.NetWt, StringFormat='{}Net: {0:N3} g'}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- 2. Group Summary Grid (Supplier Wise, Item Wise) -->
                <Grid Visibility="{Binding IsGroupGridVisible, Converter={StaticResource BoolToVis}}">
                    <telerik:RadGridView ItemsSource="{Binding GroupSummaries}"
                                         AutoGenerateColumns="False"
                                         IsReadOnly="True"
                                         RowIndicatorVisibility="Collapsed"
                                         ShowGroupPanel="False"
                                         CanUserFreezeColumns="False"
                                         SelectionMode="Single"
                                         FontSize="12">
                        <telerik:RadGridView.Columns>
                            <telerik:GridViewDataColumn Header="Group / Category / Supplier" DataMemberBinding="{Binding GroupKey}" Width="220"/>
                            <telerik:GridViewDataColumn Header="Purity" DataMemberBinding="{Binding Purity}" Width="100" TextAlignment="Center"/>
                            <telerik:GridViewDataColumn Header="Barcodes" DataMemberBinding="{Binding ItemCount, StringFormat='{}{0:N0}'}" Width="85" TextAlignment="Right"/>
                            <telerik:GridViewDataColumn Header="Total Qty" DataMemberBinding="{Binding TotalQty, StringFormat='{}{0:N0}'}" Width="85" TextAlignment="Right"/>
                            <telerik:GridViewDataColumn Header="Gross Wt" DataMemberBinding="{Binding TotalGrossWt, StringFormat='{}{0:N3}'}" Width="120" TextAlignment="Right"/>
                            <telerik:GridViewDataColumn Header="Stn Wt" DataMemberBinding="{Binding TotalStoneWt, StringFormat='{}{0:N3}'}" Width="110" TextAlignment="Right"/>
                            <telerik:GridViewDataColumn Header="Net Wt" DataMemberBinding="{Binding TotalNetWt, StringFormat='{}{0:N3}'}" Width="120" TextAlignment="Right"/>
                            <telerik:GridViewDataColumn Header="Stn Value" DataMemberBinding="{Binding TotalStoneValue, StringFormat='{}{0:N2}'}" Width="120" TextAlignment="Right"/>
                            <telerik:GridViewDataColumn Header="Making" DataMemberBinding="{Binding TotalMaking, StringFormat='{}{0:N2}'}" Width="120" TextAlignment="Right"/>
                        </telerik:RadGridView.Columns>
                    </telerik:RadGridView>
                </Grid>

                <!-- 3. Movement Details Grid -->
                <Grid Visibility="{Binding IsMovementGridVisible, Converter={StaticResource BoolToVis}}">
                    <telerik:RadGridView ItemsSource="{Binding MovementItems}"
                                         AutoGenerateColumns="False"
                                         IsReadOnly="True"
                                         RowIndicatorVisibility="Collapsed"
                                         ShowGroupPanel="False"
                                         CanUserFreezeColumns="False"
                                         SelectionMode="Single"
                                         FontSize="12">
                        <telerik:RadGridView.Columns>
                            <telerik:GridViewDataColumn Header="Date" DataMemberBinding="{Binding Date, StringFormat='dd/MM/yyyy'}" Width="90" TextAlignment="Center"/>
                            <telerik:GridViewDataColumn Header="Barcode" DataMemberBinding="{Binding Barcode}" Width="90" TextAlignment="Center"/>
                            <telerik:GridViewDataColumn Header="Item Name" DataMemberBinding="{Binding ItemName}" Width="140"/>
                            <telerik:GridViewDataColumn Header="Movement Type" DataMemberBinding="{Binding MovementType}" Width="130"/>
                            <telerik:GridViewDataColumn Header="Voucher No" DataMemberBinding="{Binding ReferenceVouNo}" Width="100" TextAlignment="Center"/>
                            <telerik:GridViewDataColumn Header="Party / Supplier" DataMemberBinding="{Binding PartyOrSupplier}" Width="180"/>
                            <telerik:GridViewDataColumn Header="Qty" DataMemberBinding="{Binding Qty, StringFormat='{}{0:N0}'}" Width="60" TextAlignment="Right"/>
                            <telerik:GridViewDataColumn Header="Gross Wt" DataMemberBinding="{Binding GrossWt, StringFormat='{}{0:N3}'}" Width="95" TextAlignment="Right"/>
                            <telerik:GridViewDataColumn Header="Net Wt" DataMemberBinding="{Binding NetWt, StringFormat='{}{0:N3}'}" Width="95" TextAlignment="Right"/>
                            <telerik:GridViewDataColumn Header="Amount" DataMemberBinding="{Binding Amount, StringFormat='{}{0:N2}'}" Width="110" TextAlignment="Right"/>
                            <telerik:GridViewDataColumn Header="User" DataMemberBinding="{Binding User}" Width="80"/>
                        </telerik:RadGridView.Columns>
                    </telerik:RadGridView>
                </Grid>

                <!-- 4. 3-Tier Drilldown View for Stock Head Group Wise -->
                <Grid Visibility="{Binding IsHeadGroupWiseVisible, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1.1*"/>
                        <RowDefinition Height="1.3*"/>
                        <RowDefinition Height="1.6*"/>
                    </Grid.RowDefinitions>

                    <!-- LEVEL 1: HeadGroup Summary (Top) -->
                    <Border Grid.Row="0" Margin="0,0,0,6"
                            Background="{DynamicResource HeaderBackgroundBrush}"
                            CornerRadius="4"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <telerik:RadGridView Grid.Row="0"
                                                 ItemsSource="{Binding HeadGroupWiseList}"
                                                 SelectedItem="{Binding SelectedHeadGroupSummary, Mode=TwoWay}"
                                                 AutoGenerateColumns="False"
                                                 IsReadOnly="True"
                                                 RowIndicatorVisibility="Collapsed"
                                                 ShowGroupPanel="False"
                                                 CanUserFreezeColumns="False"
                                                 SelectionMode="Single"
                                                 FontSize="12"
                                                 RowHeight="26">
                                <telerik:RadGridView.Columns>
                                    <telerik:GridViewDataColumn Header="HeadGroup" DataMemberBinding="{Binding HeadGroup}" Width="200"/>
                                    <telerik:GridViewDataColumn Header="Qty" DataMemberBinding="{Binding TotalQty, StringFormat='{}{0:N0}'}" Width="80" TextAlignment="Right"/>
                                    <telerik:GridViewDataColumn Header="Gross Wt" DataMemberBinding="{Binding TotalGrossWt, StringFormat='{}{0:N3}'}" Width="120" TextAlignment="Right"/>
                                    <telerik:GridViewDataColumn Header="Stone Wt" DataMemberBinding="{Binding TotalStoneWt, StringFormat='{}{0:N3}'}" Width="110" TextAlignment="Right"/>
                                    <telerik:GridViewDataColumn Header="Net Wt" DataMemberBinding="{Binding TotalNetWt, StringFormat='{}{0:N3}'}" Width="120" TextAlignment="Right"/>
                                    <telerik:GridViewDataColumn Header="Stone Value" DataMemberBinding="{Binding TotalStoneValue, StringFormat='{}{0:N2}'}" Width="120" TextAlignment="Right"/>
                                    <telerik:GridViewDataColumn Header="Making" DataMemberBinding="{Binding TotalMaking, StringFormat='{}{0:N2}'}" Width="*" TextAlignment="Right"/>
                                </telerik:RadGridView.Columns>
                            </telerik:RadGridView>

                            <!-- Level 1 Summary Row -->
                            <Border Grid.Row="1"
                                    Background="{DynamicResource PanelBrush}"
                                    Padding="4,3"
                                    BorderBrush="{DynamicResource CardBorderBrush}"
                                    BorderThickness="0,1,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="1" Style="{StaticResource TotalBoxStyle}" Margin="1,0"><TextBlock Text="{Binding HeadGroupTotalQty, StringFormat='{}{0:N0}'}" FontWeight="Bold" TextAlignment="Right" Foreground="{DynamicResource PrimaryTextBrush}"/></Border>
                                    <Border Grid.Column="2" Style="{StaticResource TotalBoxStyle}" Margin="1,0"><TextBlock Text="{Binding HeadGroupTotalGrossWt, StringFormat='{}{0:N3}'}" FontWeight="Bold" TextAlignment="Right" Foreground="{DynamicResource PrimaryTextBrush}"/></Border>
                                    <Border Grid.Column="3" Style="{StaticResource TotalBoxStyle}" Margin="1,0"><TextBlock Text="{Binding HeadGroupTotalStoneWt, StringFormat='{}{0:N3}'}" FontWeight="Bold" TextAlignment="Right" Foreground="{DynamicResource PrimaryTextBrush}"/></Border>
                                    <Border Grid.Column="4" Style="{StaticResource TotalBoxStyle}" Margin="1,0"><TextBlock Text="{Binding HeadGroupTotalNetWt, StringFormat='{}{0:N3}'}" FontWeight="Bold" TextAlignment="Right" Foreground="{DynamicResource PrimaryTextBrush}"/></Border>
                                    <Border Grid.Column="5" Style="{StaticResource TotalBoxStyle}" Margin="1,0"><TextBlock Text="{Binding HeadGroupTotalStoneValue, StringFormat='{}{0:N2}'}" FontWeight="Bold" TextAlignment="Right" Foreground="{DynamicResource PrimaryTextBrush}"/></Border>
                                    <Border Grid.Column="6" Style="{StaticResource TotalBoxStyle}" Margin="1,0"><TextBlock Text="{Binding HeadGroupTotalMaking, StringFormat='{}{0:N2}'}" FontWeight="Bold" TextAlignment="Right" Foreground="{DynamicResource PrimaryTextBrush}"/></Border>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- LEVEL 2: SubGroup Summary (Middle) -->
                    <Border Grid.Row="1" Margin="0,0,0,6"
                            Background="{DynamicResource HeaderBackgroundBrush}"
                            CornerRadius="4"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <telerik:RadGridView Grid.Row="0"
                                                 ItemsSource="{Binding SubGroupWiseList}"
                                                 SelectedItem="{Binding SelectedSubGroupSummary, Mode=TwoWay}"
                                                 AutoGenerateColumns="False"
                                                 IsReadOnly="True"
                                                 RowIndicatorVisibility="Collapsed"
                                                 ShowGroupPanel="False"
                                                 CanUserFreezeColumns="False"
                                                 SelectionMode="Single"
                                                 FontSize="12"
                                                 RowHeight="26">
                                <telerik:RadGridView.Columns>
                                    <telerik:GridViewDataColumn Header="HeadGroup" DataMemberBinding="{Binding HeadGroup}" Width="100"/>
                                    <telerik:GridViewDataColumn Header="Sub Group" DataMemberBinding="{Binding SubGroup}" Width="160"/>
                                    <telerik:GridViewDataColumn Header="Qty" DataMemberBinding="{Binding TotalQty, StringFormat='{}{0:N0}'}" Width="80" TextAlignment="Right"/>
                                    <telerik:GridViewDataColumn Header="Gross Wt" DataMemberBinding="{Binding TotalGrossWt, StringFormat='{}{0:N3}'}" Width="120" TextAlignment="Right"/>
                                    <telerik:GridViewDataColumn Header="Stone Wt" DataMemberBinding="{Binding TotalStoneWt, StringFormat='{}{0:N3}'}" Width="110" TextAlignment="Right"/>
                                    <telerik:GridViewDataColumn Header="Net Wt" DataMemberBinding="{Binding TotalNetWt, StringFormat='{}{0:N3}'}" Width="120" TextAlignment="Right"/>
                                    <telerik:GridViewDataColumn Header="Stone Value" DataMemberBinding="{Binding TotalStoneValue, StringFormat='{}{0:N2}'}" Width="120" TextAlignment="Right"/>
                                    <telerik:GridViewDataColumn Header="Making" DataMemberBinding="{Binding TotalMaking, StringFormat='{}{0:N2}'}" Width="*" TextAlignment="Right"/>
                                </telerik:RadGridView.Columns>
                            </telerik:RadGridView>

                            <!-- Level 2 Summary Row -->
                            <Border Grid.Row="1"
                                    Background="{DynamicResource PanelBrush}"
                                    Padding="6,3"
                                    BorderBrush="{DynamicResource CardBorderBrush}"
                                    BorderThickness="0,1,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="260"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding SubGroupCountDisplay}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}"/>
                                    <Border Grid.Column="1" Style="{StaticResource TotalBoxStyle}" Margin="1,0"><TextBlock Text="{Binding SubGroupTotalQty, StringFormat='{}{0:N0}'}" FontWeight="Bold" TextAlignment="Right" Foreground="{DynamicResource PrimaryTextBrush}"/></Border>
                                    <Border Grid.Column="2" Style="{StaticResource TotalBoxStyle}" Margin="1,0"><TextBlock Text="{Binding SubGroupTotalGrossWt, StringFormat='{}{0:N3}'}" FontWeight="Bold" TextAlignment="Right" Foreground="{DynamicResource PrimaryTextBrush}"/></Border>
                                    <Border Grid.Column="3" Style="{StaticResource TotalBoxStyle}" Margin="1,0"><TextBlock Text="{Binding SubGroupTotalStoneWt, StringFormat='{}{0:N3}'}" FontWeight="Bold" TextAlignment="Right" Foreground="{DynamicResource PrimaryTextBrush}"/></Border>
                                    <Border Grid.Column="4" Style="{StaticResource TotalBoxStyle}" Margin="1,0"><TextBlock Text="{Binding SubGroupTotalNetWt, StringFormat='{}{0:N3}'}" FontWeight="Bold" TextAlignment="Right" Foreground="{DynamicResource PrimaryTextBrush}"/></Border>
                                    <Border Grid.Column="5" Style="{StaticResource TotalBoxStyle}" Margin="1,0"><TextBlock Text="{Binding SubGroupTotalStoneValue, StringFormat='{}{0:N2}'}" FontWeight="Bold" TextAlignment="Right" Foreground="{DynamicResource PrimaryTextBrush}"/></Border>
                                    <Border Grid.Column="6" Style="{StaticResource TotalBoxStyle}" Margin="1,0"><TextBlock Text="{Binding SubGroupTotalMaking, StringFormat='{}{0:N2}'}" FontWeight="Bold" TextAlignment="Right" Foreground="{DynamicResource PrimaryTextBrush}"/></Border>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- LEVEL 3: Barcode Details (Bottom) -->
                    <Border Grid.Row="2"
                            Background="{DynamicResource HeaderBackgroundBrush}"
                            CornerRadius="4"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Level 3 Grid with dedicated preview column -->
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <telerik:RadGridView Grid.Column="0"
                                                     ItemsSource="{Binding HeadGroupBarcodeList}"
                                                     SelectedItem="{Binding SelectedStockItem, Mode=TwoWay}"
                                                     AutoGenerateColumns="False"
                                                     IsReadOnly="True"
                                                     RowIndicatorVisibility="Collapsed"
                                                     ShowGroupPanel="False"
                                                     CanUserFreezeColumns="False"
                                                     SelectionMode="Single"
                                                     FontSize="12"
                                                     RowHeight="26">
                                    <telerik:RadGridView.Columns>
                                        <telerik:GridViewDataColumn Header="HeadGroup" DataMemberBinding="{Binding HeadGroup}" Width="90"/>
                                        <telerik:GridViewDataColumn Header="Sub Group" DataMemberBinding="{Binding SubGroup}" Width="120"/>
                                        <telerik:GridViewDataColumn Header="Item Name" DataMemberBinding="{Binding ItemName}" Width="120"/>
                                        <telerik:GridViewDataColumn Header="Barcode" DataMemberBinding="{Binding Barcode}" Width="90" TextAlignment="Center"/>
                                        <telerik:GridViewDataColumn Header="Box No" DataMemberBinding="{Binding BoxNo}" Width="80" TextAlignment="Center"/>
                                        <telerik:GridViewDataColumn Header="Qty" DataMemberBinding="{Binding Qty, StringFormat='{}{0:N0}'}" Width="60" TextAlignment="Right"/>
                                        <telerik:GridViewDataColumn Header="Gross Wt" DataMemberBinding="{Binding GrossWt, StringFormat='{}{0:N3}'}" Width="95" TextAlignment="Right"/>
                                        <telerik:GridViewDataColumn Header="Stone Wt" DataMemberBinding="{Binding StoneWt, StringFormat='{}{0:N3}'}" Width="90" TextAlignment="Right"/>
                                        <telerik:GridViewDataColumn Header="Net Wt" DataMemberBinding="{Binding NetWt, StringFormat='{}{0:N3}'}" Width="95" TextAlignment="Right"/>
                                        <telerik:GridViewDataColumn Header="Stone Value" DataMemberBinding="{Binding StoneValue, StringFormat='{}{0:N2}'}" Width="95" TextAlignment="Right"/>
                                        <telerik:GridViewDataColumn Header="Making" DataMemberBinding="{Binding Making, StringFormat='{}{0:N2}'}" Width="*" TextAlignment="Right"/>
                                    </telerik:RadGridView.Columns>
                                </telerik:RadGridView>

                                <!-- Level 3 Barcode Photo Preview Card -->
                                <Border Grid.Column="1"
                                        Width="130"
                                        Margin="6,0,0,0"
                                        Background="{DynamicResource PanelBrush}"
                                        BorderBrush="{DynamicResource CardBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="4"
                                        Visibility="{Binding SelectedStockItem.HasImage, Converter={StaticResource BoolToVis}}">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="PHOTO PREVIEW" FontSize="8.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" Margin="0,0,0,3"/>
                                        <Border Height="80" Width="80" CornerRadius="4" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" ClipToBounds="True">
                                            <Image Source="{Binding SelectedStockItem.ImagePath}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Border>
                                        <TextBlock Text="{Binding SelectedStockItem.Barcode}" FontWeight="Bold" FontSize="10.5" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                        <TextBlock Text="{Binding SelectedStockItem.NetWt, StringFormat='{}{0:N3} g'}" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Level 3 Summary Row -->
                            <Border Grid.Row="1"
                                    Background="{DynamicResource PanelBrush}"
                                    Padding="6,3"
                                    BorderBrush="{DynamicResource CardBorderBrush}"
                                    BorderThickness="0,1,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="420"/>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="95"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="95"/>
                                        <ColumnDefinition Width="95"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding BarcodeCountDisplay}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}"/>
                                    <Border Grid.Column="1" Style="{StaticResource TotalBoxStyle}" Margin="1,0"><TextBlock Text="{Binding BarcodeTotalQty, StringFormat='{}{0:N0}'}" FontWeight="Bold" TextAlignment="Right" Foreground="{DynamicResource PrimaryTextBrush}"/></Border>
                                    <Border Grid.Column="2" Style="{StaticResource TotalBoxStyle}" Margin="1,0"><TextBlock Text="{Binding BarcodeTotalGrossWt, StringFormat='{}{0:N3}'}" FontWeight="Bold" TextAlignment="Right" Foreground="{DynamicResource PrimaryTextBrush}"/></Border>
                                    <Border Grid.Column="3" Style="{StaticResource TotalBoxStyle}" Margin="1,0"><TextBlock Text="{Binding BarcodeTotalStoneWt, StringFormat='{}{0:N3}'}" FontWeight="Bold" TextAlignment="Right" Foreground="{DynamicResource PrimaryTextBrush}"/></Border>
                                    <Border Grid.Column="4" Style="{StaticResource TotalBoxStyle}" Margin="1,0"><TextBlock Text="{Binding BarcodeTotalNetWt, StringFormat='{}{0:N3}'}" FontWeight="Bold" TextAlignment="Right" Foreground="{DynamicResource PrimaryTextBrush}"/></Border>
                                    <Border Grid.Column="5" Style="{StaticResource TotalBoxStyle}" Margin="1,0"><TextBlock Text="{Binding BarcodeTotalStoneValue, StringFormat='{}{0:N2}'}" FontWeight="Bold" TextAlignment="Right" Foreground="{DynamicResource PrimaryTextBrush}"/></Border>
                                    <Border Grid.Column="6" Style="{StaticResource TotalBoxStyle}" Margin="1,0"><TextBlock Text="{Binding BarcodeTotalMaking, StringFormat='{}{0:N2}'}" FontWeight="Bold" TextAlignment="Right" Foreground="{DynamicResource PrimaryTextBrush}"/></Border>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <!-- 5. Dedicated Two-Grid View for Stock Check (Scanned Barcodes + Pending Barcodes) -->
                <Grid Visibility="{Binding IsStockCheckVisible, Converter={StaticResource BoolToVis}}"
                      PreviewKeyDown="StockCheckGrid_PreviewKeyDown">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Scan / Search Bar -->
                        <RowDefinition Height="1.1*"/> <!-- Top Grid: Scanned Barcodes -->
                        <RowDefinition Height="6"/>    <!-- GridSplitter -->
                        <RowDefinition Height="1.3*"/> <!-- Bottom Grid: Pending Barcodes -->
                    </Grid.RowDefinitions>

                    <!-- TOP ROW: Scanner Bar -->
                    <Border Grid.Row="0"
                            Background="{DynamicResource HeaderBackgroundBrush}"
                            BorderBrush="{DynamicResource HeaderBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="8,5"
                            Margin="0,0,0,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="260"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="Scan / Enter Barcode:"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"/>

                            <telerik:RadWatermarkTextBox Grid.Column="1"
                                                         x:Name="StockCheckScanTextBox"
                                                         Text="{Binding ScanBarcodeText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         WatermarkContent="Scan barcode or type # and press Enter..."
                                                         Height="28"
                                                         FontSize="12"
                                                         VerticalAlignment="Center"
                                                         Margin="0,0,8,0"
                                                         PreviewKeyDown="StockCheckScanTextBox_PreviewKeyDown"
                                                         KeyDown="StockCheckScanTextBox_KeyDown"/>

                            <!-- Box Selection & Assignment -->
                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                                <TextBlock Text="Box:"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,6,0"/>
                                <telerik:RadComboBox ItemsSource="{Binding StockCheckBoxes}"
                                                     SelectedItem="{Binding SelectedStockCheckBox, Mode=TwoWay}"
                                                     IsEditable="True"
                                                     Width="140"
                                                     Height="28"
                                                     VerticalAlignment="Center"
                                                     Margin="0,0,6,0"
                                                     ToolTip="Select Box to automatically assign scanned items to this Box"/>
                                <telerik:RadButton Command="{Binding AssignBoxCommand}"
                                                   Height="28"
                                                   Padding="10,2"
                                                   Background="{DynamicResource PanelBrush}"
                                                   BorderBrush="{DynamicResource CardBorderBrush}"
                                                   BorderThickness="1"
                                                   FontWeight="SemiBold"
                                                   FontSize="11"
                                                   VerticalAlignment="Center"
                                                   Cursor="Hand"
                                                   ToolTip="Assign selected Box to checked or selected item(s) in Scanned Barcodes">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}"/>
                                        <TextBlock Text="Assign Box" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </telerik:RadButton>
                            </StackPanel>

                            <!-- Progress & Status Badge -->
                            <Border Grid.Column="4"
                                    Background="{DynamicResource PanelBrush}"
                                    BorderBrush="{DynamicResource CardBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="3"
                                    Padding="10,4"
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="&#xEC42;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource AccentBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding StockCheckProgressDisplay}"
                                               FontWeight="SemiBold"
                                               FontSize="12"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- ROW 1: TOP GRID (SCANNED BARCODES) -->
                    <Border Grid.Row="1"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/> <!-- Title Header -->
                                <RowDefinition Height="*"/>    <!-- Scanned Grid -->
                                <RowDefinition Height="Auto"/> <!-- Scanned Footer (Totals & Actions) -->
                            </Grid.RowDefinitions>

                            <!-- Header Bar -->
                            <Border Grid.Row="0"
                                    Background="{DynamicResource PanelBrush}"
                                    BorderBrush="{DynamicResource CardBorderBrush}"
                                    BorderThickness="0,0,0,1"
                                    Padding="8,5">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Left: Title & Scanned Counter Badge -->
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE8FB;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource SuccessBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="SCANNED BARCODES" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                                        <Border Background="{DynamicResource SuccessBrush}" CornerRadius="8" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ScannedTotalCount, StringFormat='{}{0} Scanned'}" Foreground="White" FontSize="10.5" FontWeight="Bold"/>
                                        </Border>
                                        <Border Background="{DynamicResource AccentBrush}" CornerRadius="8" Padding="6,1" Margin="6,0,0,0" VerticalAlignment="Center"
                                                Visibility="{Binding HasScannedSelection, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{Binding SelectedScannedCount, StringFormat='{}{0} Selected'}" Foreground="White" FontSize="10.5" FontWeight="Bold"/>
                                        </Border>
                                    </StackPanel>

                                    <!-- Right: Rate textbox & Update MRP & Print button -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Rate:"
                                                   FontWeight="SemiBold"
                                                   FontSize="11.5"
                                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,6,0"/>
                                        <telerik:RadNumericUpDown x:Name="UpdateMrpRateBox"
                                                                  Value="{Binding UpdateMrpRate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                  Minimum="0"
                                                                  Maximum="1000"
                                                                  NumberDecimalDigits="2"
                                                                  Width="85"
                                                                  Height="26"
                                                                  VerticalAlignment="Center"
                                                                  Margin="0,0,8,0"
                                                                  ToolTip="Enter rate between 0 and 1000"/>
                                        <telerik:RadButton Command="{Binding UpdateMrpAndPrintCommand}"
                                                           Height="26"
                                                           Padding="10,2"
                                                           Background="#059669"
                                                           Foreground="White"
                                                           FontWeight="SemiBold"
                                                           FontSize="11.5"
                                                           VerticalAlignment="Center"
                                                           Cursor="Hand"
                                                           ToolTip="Update MRP = NetWt * Rate, save to database, and print using StickerPc.PRN">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="&#xE749;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Update MRP &amp; Print" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </telerik:RadButton>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Scanned RadGridView -->
                            <telerik:RadGridView x:Name="ScannedStockGridView"
                                                 Grid.Row="1"
                                                 ItemsSource="{Binding ScannedStockItems}"
                                                 SelectedItem="{Binding SelectedScannedStockItem, Mode=TwoWay}"
                                                 AutoGenerateColumns="False"
                                                 IsReadOnly="True"
                                                 IsTabStop="False"
                                                 Focusable="False"
                                                 IsSynchronizedWithCurrentItem="False"
                                                 RowIndicatorVisibility="Collapsed"
                                                 ShowGroupPanel="False"
                                                 CanUserFreezeColumns="False"
                                                 SelectionMode="Single"
                                                 FontSize="12"
                                                 RowHeight="28"
                                                 EnableLostFocusSelectedState="False"
                                                 Filtered="ScannedStockGridView_Filtered">
                                <telerik:RadGridView.RowStyle>
                                    <Style TargetType="telerik:GridViewRow" BasedOn="{StaticResource GridViewRowStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsNewlyScanned}" Value="True">
                                                <Setter Property="Background" Value="#86EFAC"/>
                                                <Setter Property="SelectedBackground" Value="#4ADE80"/>
                                                <Setter Property="Foreground" Value="#064E3B"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </telerik:RadGridView.RowStyle>
                                <telerik:RadGridView.Columns>
                                    <!-- Selection CheckBox Column -->
                                    <telerik:GridViewColumn Width="45" TextAlignment="Center" IsResizable="False">
                                        <telerik:GridViewColumn.Header>
                                            <CheckBox HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      IsChecked="{Binding DataContext.IsAllScannedSelected, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"
                                                      ToolTip="Select All / Deselect All" />
                                        </telerik:GridViewColumn.Header>
                                        <telerik:GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            </DataTemplate>
                                        </telerik:GridViewColumn.CellTemplate>
                                    </telerik:GridViewColumn>

                                    <telerik:GridViewDataColumn Header="Barcode" DataMemberBinding="{Binding Barcode}" Width="100" TextAlignment="Center"/>
                                    <telerik:GridViewDataColumn Header="Item Name" DataMemberBinding="{Binding ItemName}" Width="160"/>
                                    <telerik:GridViewDataColumn Header="Size" DataMemberBinding="{Binding Size}" Width="80" TextAlignment="Center"/>
                                    <telerik:GridViewDataColumn Header="Box No" DataMemberBinding="{Binding BoxNo}" Width="80" TextAlignment="Center"/>
                                    <telerik:GridViewDataColumn Header="Qty" DataMemberBinding="{Binding Qty, StringFormat='{}{0:N0}'}" Width="60" TextAlignment="Right"/>
                                    <telerik:GridViewDataColumn Header="Gross Wt" DataMemberBinding="{Binding GrossWt, StringFormat='{}{0:N3}'}" Width="95" TextAlignment="Right"/>
                                    <telerik:GridViewDataColumn Header="Stone Wt" DataMemberBinding="{Binding StoneWt, StringFormat='{}{0:N3}'}" Width="90" TextAlignment="Right"/>
                                    <telerik:GridViewDataColumn Header="Net Wt" DataMemberBinding="{Binding NetWt, StringFormat='{}{0:N3}'}" Width="95" TextAlignment="Right"/>
                                    <telerik:GridViewDataColumn Header="Stone Vl" DataMemberBinding="{Binding StoneValue, StringFormat='{}{0:N2}'}" Width="95" TextAlignment="Right"/>
                                    <telerik:GridViewDataColumn Header="Making" DataMemberBinding="{Binding Making, StringFormat='{}{0:N2}'}" Width="90" TextAlignment="Right"/>
                                    <telerik:GridViewDataColumn Header="Making/g" DataMemberBinding="{Binding MakingPerGram, StringFormat='{}{0:N2}'}" Width="85" TextAlignment="Right"/>
                                    <telerik:GridViewDataColumn Header="MRP" DataMemberBinding="{Binding MRP, StringFormat='{}{0:N2}'}" Width="95" TextAlignment="Right"/>
                                    <telerik:GridViewDataColumn Header="Purity" DataMemberBinding="{Binding Purity}" Width="90" TextAlignment="Center"/>
                                    <telerik:GridViewDataColumn Header="TimeStamp" DataMemberBinding="{Binding TimeStamp, StringFormat='dd/MM/yyyy HH:mm:ss', TargetNullValue='-'}" Width="140" TextAlignment="Center"/>
                                    <telerik:GridViewColumn Header="Action" Width="65">
                                        <telerik:GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <telerik:RadButton Command="{Binding DataContext.RemoveScannedItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                   CommandParameter="{Binding}"
                                                                   ToolTip="Remove from scanned"
                                                                   Height="22"
                                                                   Padding="6,1"
                                                                   Background="Transparent"
                                                                   BorderThickness="0"
                                                                   Cursor="Hand">
                                                    <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{DynamicResource DangerBrush}"/>
                                                </telerik:RadButton>
                                            </DataTemplate>
                                        </telerik:GridViewColumn.CellTemplate>
                                    </telerik:GridViewColumn>
                                </telerik:RadGridView.Columns>
                            </telerik:RadGridView>

                            <!-- Scanned Footer Row: Remove All + Totals -->
                            <Border Grid.Row="2"
                                    Background="{DynamicResource PanelBrush}"
                                    Padding="6,4"
                                    BorderBrush="{DynamicResource CardBorderBrush}"
                                    BorderThickness="0,1,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/> <!-- Remove All button & Record Indicator -->
                                        <ColumnDefinition Width="*"/>    <!-- Totals boxes on right -->
                                    </Grid.ColumnDefinitions>

                                    <!-- Left: Remove All & Record count -->
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <telerik:RadButton Content="Remove All"
                                                           Command="{Binding RemoveAllScannedCommand}"
                                                           Height="26"
                                                           Padding="10,2"
                                                           Background="#FEE2E2"
                                                           Foreground="#991B1B"
                                                           BorderBrush="#FCA5A5"
                                                           BorderThickness="1"
                                                           FontWeight="SemiBold"
                                                           FontSize="11"
                                                           Cursor="Hand"
                                                           ToolTip="Clear all scanned items and return them to pending"
                                                           Margin="0,0,12,0"/>
                                        <TextBlock Text="{Binding ScannedRecordCountDisplay}"
                                                   FontSize="11.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <!-- Right: Scanned Totals -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <!-- Qty -->
                                        <Border Style="{StaticResource TotalBoxStyle}" Width="60" ToolTip="Scanned Total Qty">
                                            <TextBlock Text="{Binding ScannedTotalQty, StringFormat='{}{0:N0}'}" Style="{StaticResource TotalTextStyle}"/>
                                        </Border>
                                        <!-- Gross Wt -->
                                        <Border Style="{StaticResource TotalBoxStyle}" Width="95" ToolTip="Scanned Total Gross Wt (g)">
                                            <TextBlock Text="{Binding ScannedTotalGrossWt, StringFormat='{}{0:N3}'}" Style="{StaticResource TotalTextStyle}"/>
                                        </Border>
                                        <!-- Stone Wt -->
                                        <Border Style="{StaticResource TotalBoxStyle}" Width="90" ToolTip="Scanned Total Stone Wt (g)">
                                            <TextBlock Text="{Binding ScannedTotalStoneWt, StringFormat='{}{0:N3}'}" Style="{StaticResource TotalTextStyle}"/>
                                        </Border>
                                        <!-- Net Wt -->
                                        <Border Style="{StaticResource TotalBoxStyle}" Width="95" ToolTip="Scanned Total Net Wt (g)">
                                            <TextBlock Text="{Binding ScannedTotalNetWt, StringFormat='{}{0:N3}'}" Style="{StaticResource TotalTextStyle}" Foreground="{DynamicResource AccentBrush}"/>
                                        </Border>
                                        <!-- Stone Vl -->
                                        <Border Style="{StaticResource TotalBoxStyle}" Width="95" ToolTip="Scanned Total Stone Value (₹)">
                                            <TextBlock Text="{Binding ScannedTotalStoneValue, StringFormat='{}{0:N2}'}" Style="{StaticResource TotalTextStyle}"/>
                                        </Border>
                                        <!-- MRP -->
                                        <Border Style="{StaticResource TotalBoxStyle}" Width="95" ToolTip="Scanned Total MRP (₹)">
                                            <TextBlock Text="{Binding ScannedTotalMRP, StringFormat='{}{0:N2}'}" Style="{StaticResource TotalTextStyle}"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- ROW 2: GRIDSPLITTER -->
                    <GridSplitter Grid.Row="2"
                                  Height="6"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Center"
                                  Background="{DynamicResource CardBorderBrush}"
                                  Cursor="SizeNS"
                                  ToolTip="Drag to resize scanned and pending sections"/>

                    <!-- ROW 3: BOTTOM GRID (PENDING BARCODES) -->
                    <Border Grid.Row="3"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/> <!-- Title Header -->
                                <RowDefinition Height="*"/>    <!-- Pending Grid -->
                                <RowDefinition Height="Auto"/> <!-- Pending Footer (Totals & Pager) -->
                            </Grid.RowDefinitions>

                            <!-- Header Bar -->
                            <Border Grid.Row="0"
                                    Background="{DynamicResource PanelBrush}"
                                    BorderBrush="{DynamicResource CardBorderBrush}"
                                    BorderThickness="0,0,0,1"
                                    Padding="8,5">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#D97706" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="PENDING BARCODES" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                                        <Border Background="#FEF3C7" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="8" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding PendingTotalCount, StringFormat='{}{0} Pending'}" Foreground="#92400E" FontSize="10.5" FontWeight="Bold"/>
                                        </Border>
                                        <TextBlock Text="— Barcodes matching filter waiting to be scanned" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <!-- Right: Adjust Button -->
                                    <telerik:RadButton Grid.Column="2"
                                                       Command="{Binding AdjustStockCommand}"
                                                       Height="26"
                                                       Padding="10,2"
                                                       Background="#DC2626"
                                                       Foreground="White"
                                                       BorderBrush="#B91C1C"
                                                       BorderThickness="1"
                                                       FontWeight="SemiBold"
                                                       FontSize="11.5"
                                                       VerticalAlignment="Center"
                                                       Cursor="Hand"
                                                       ToolTip="Adjust all missing/pending barcodes via Stock Transfer from Showroom to Damage">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="&#xE8DE;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Adjust (Transfer to Damage)" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </telerik:RadButton>
                                </Grid>
                            </Border>

                            <!-- Pending RadGridView -->
                            <telerik:RadGridView x:Name="PendingStockGridView"
                                                 Grid.Row="1"
                                                 ItemsSource="{Binding PendingStockItems}"
                                                 SelectedItem="{Binding SelectedPendingStockItem, Mode=TwoWay}"
                                                 AutoGenerateColumns="False"
                                                 IsReadOnly="True"
                                                 IsTabStop="False"
                                                 Focusable="False"
                                                 IsSynchronizedWithCurrentItem="False"
                                                 RowIndicatorVisibility="Collapsed"
                                                 ShowGroupPanel="False"
                                                 CanUserFreezeColumns="False"
                                                 SelectionMode="Single"
                                                 FontSize="12"
                                                 RowHeight="28"
                                                  Filtered="PendingStockGridView_Filtered">
                                <telerik:RadGridView.Columns>
                                    <telerik:GridViewDataColumn Header="Barcode" DataMemberBinding="{Binding Barcode}" Width="100" TextAlignment="Center"/>
                                    <telerik:GridViewDataColumn Header="Item Name" DataMemberBinding="{Binding ItemName}" Width="160"/>
                                    <telerik:GridViewDataColumn Header="Size" DataMemberBinding="{Binding Size}" Width="80" TextAlignment="Center"/>
                                    <telerik:GridViewDataColumn Header="Box No" DataMemberBinding="{Binding BoxNo}" Width="80" TextAlignment="Center"/>
                                    <telerik:GridViewDataColumn Header="Qty" DataMemberBinding="{Binding Qty, StringFormat='{}{0:N0}'}" Width="60" TextAlignment="Right"/>
                                    <telerik:GridViewDataColumn Header="Description" DataMemberBinding="{Binding Description}" Width="140"/>
                                    <telerik:GridViewDataColumn Header="Cost" DataMemberBinding="{Binding CostPrice, StringFormat='{}{0:N2}'}" Width="95" TextAlignment="Right"/>
                                    <telerik:GridViewDataColumn Header="Net Wt" DataMemberBinding="{Binding NetWt, StringFormat='{}{0:N3}'}" Width="95" TextAlignment="Right"/>
                                    <telerik:GridViewDataColumn Header="MRP Value" DataMemberBinding="{Binding MRP, StringFormat='{}{0:N2}'}" Width="95" TextAlignment="Right"/>
                                    <telerik:GridViewDataColumn Header="Making" DataMemberBinding="{Binding Making, StringFormat='{}{0:N2}'}" Width="95" TextAlignment="Right"/>
                                    <telerik:GridViewDataColumn Header="Making/g" DataMemberBinding="{Binding MakingPerGram, StringFormat='{}{0:N2}'}" Width="85" TextAlignment="Right"/>
                                    <telerik:GridViewDataColumn Header="Purity" DataMemberBinding="{Binding Purity}" Width="90" TextAlignment="Center"/>
                                    <telerik:GridViewDataColumn Header="TimeStamp" DataMemberBinding="{Binding TimeStamp, StringFormat='dd/MM/yyyy HH:mm:ss', TargetNullValue='-'}" Width="140" TextAlignment="Center"/>
                                </telerik:RadGridView.Columns>
                            </telerik:RadGridView>

                            <!-- Pending Footer Row: Totals & Record count -->
                            <Border Grid.Row="2"
                                    Background="{DynamicResource PanelBrush}"
                                    Padding="6,4"
                                    BorderBrush="{DynamicResource CardBorderBrush}"
                                    BorderThickness="0,1,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/> <!-- Record Indicator -->
                                        <ColumnDefinition Width="*"/>    <!-- Totals boxes on right -->
                                    </Grid.ColumnDefinitions>

                                    <!-- Left: Record count -->
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding PendingRecordCountDisplay}"
                                                   FontSize="11.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <!-- Right: Pending Totals matching screenshot columns -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <!-- Qty -->
                                        <Border Style="{StaticResource TotalBoxStyle}" Width="60" ToolTip="Pending Total Qty">
                                            <TextBlock Text="{Binding PendingTotalQty, StringFormat='{}{0:N0}'}" Style="{StaticResource TotalTextStyle}"/>
                                        </Border>
                                        <!-- Cost -->
                                        <Border Style="{StaticResource TotalBoxStyle}" Width="95" ToolTip="Pending Total Cost (₹)">
                                            <TextBlock Text="{Binding PendingTotalCost, StringFormat='{}{0:N2}'}" Style="{StaticResource TotalTextStyle}"/>
                                        </Border>
                                        <!-- Net Wt -->
                                        <Border Style="{StaticResource TotalBoxStyle}" Width="95" ToolTip="Pending Total Net Wt (g)">
                                            <TextBlock Text="{Binding PendingTotalNetWt, StringFormat='{}{0:N3}'}" Style="{StaticResource TotalTextStyle}" Foreground="{DynamicResource AccentBrush}"/>
                                        </Border>
                                        <!-- MRP Value -->
                                        <Border Style="{StaticResource TotalBoxStyle}" Width="95" ToolTip="Pending Total MRP Value (₹)">
                                            <TextBlock Text="{Binding PendingTotalMRP, StringFormat='{}{0:N2}'}" Style="{StaticResource TotalTextStyle}"/>
                                        </Border>
                                        <!-- Making -->
                                        <Border Style="{StaticResource TotalBoxStyle}" Width="95" ToolTip="Pending Total Making Charges (₹)">
                                            <TextBlock Text="{Binding PendingTotalMaking, StringFormat='{}{0:N2}'}" Style="{StaticResource TotalTextStyle}"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- ================= ROW 3: FOOTER TOTALS & RECORD PAGER ================= -->
            <Border Grid.Row="3"
                    Background="{DynamicResource HeaderBackgroundBrush}"
                    BorderBrush="{DynamicResource HeaderBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="10,4"
                    Margin="0,6,0,0"
                    Visibility="{Binding IsStockCheckActive, Converter={StaticResource InvBoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/> <!-- Pager on left -->
                        <ColumnDefinition Width="*"/>    <!-- Totals boxes on right -->
                    </Grid.ColumnDefinitions>

                    <!-- Left: Record Pager Controls (as in image) -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding RecordCountDisplay}"
                                   FontWeight="SemiBold"
                                   FontSize="12"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Right: Numeric Totals Boxes matching screenshot columns -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <!-- Total Qty -->
                        <Border Style="{StaticResource TotalBoxStyle}" Width="85" ToolTip="Total Quantity">
                            <TextBlock Text="{Binding TotalQty, StringFormat='{}{0:N1}'}" Style="{StaticResource TotalTextStyle}"/>
                        </Border>

                        <!-- Total Gross Wt -->
                        <Border Style="{StaticResource TotalBoxStyle}" Width="110" ToolTip="Total Gross Weight (g)">
                            <TextBlock Text="{Binding TotalGrossWt, StringFormat='{}{0:N3}'}" Style="{StaticResource TotalTextStyle}"/>
                        </Border>

                        <!-- Total Stn Wt -->
                        <Border Style="{StaticResource TotalBoxStyle}" Width="95" ToolTip="Total Stone Weight (g)">
                            <TextBlock Text="{Binding TotalStoneWt, StringFormat='{}{0:N3}'}" Style="{StaticResource TotalTextStyle}"/>
                        </Border>

                        <!-- Total Net Wt -->
                        <Border Style="{StaticResource TotalBoxStyle}" Width="115" ToolTip="Total Net Weight (g)">
                            <TextBlock Text="{Binding TotalNetWt, StringFormat='{}{0:N3}'}" Style="{StaticResource TotalTextStyle}" Foreground="{DynamicResource AccentBrush}"/>
                        </Border>

                        <!-- Total Stn Value -->
                        <Border Style="{StaticResource TotalBoxStyle}" Width="110" ToolTip="Total Stone Value (₹)">
                            <TextBlock Text="{Binding TotalStoneValue, StringFormat='{}{0:N2}'}" Style="{StaticResource TotalTextStyle}"/>
                        </Border>

                        <!-- Total Making -->
                        <Border Style="{StaticResource TotalBoxStyle}" Width="110" ToolTip="Total Making Charges (₹)">
                            <TextBlock Text="{Binding TotalMaking, StringFormat='{}{0:N2}'}" Style="{StaticResource TotalTextStyle}"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
