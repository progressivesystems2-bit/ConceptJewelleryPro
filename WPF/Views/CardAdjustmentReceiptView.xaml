<UserControl x:Class="ConceptJewelleryPro.WPF.Views.CardAdjustmentReceiptView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
             mc:Ignorable="d" 
             d:DesignHeight="850" d:DesignWidth="1200"
             Background="{DynamicResource WindowBackgroundBrush}">

    <UserControl.InputBindings>
        <KeyBinding Key="N" Modifiers="Alt" Command="{Binding NewReceiptCommand}"/>
        <KeyBinding Key="F2" Command="{Binding NewReceiptCommand}"/>
        <KeyBinding Key="S" Modifiers="Alt" Command="{Binding SaveReceiptCommand}"/>
        <KeyBinding Key="F8" Command="{Binding SaveReceiptCommand}"/>
        <KeyBinding Key="P" Modifiers="Alt" Command="{Binding PrintReceiptCommand}"/>
        <KeyBinding Key="E" Modifiers="Alt" Command="{Binding ExportToExcelCommand}"/>
        <KeyBinding Key="Delete" Modifiers="Alt" Command="{Binding DeleteReceiptCommand}"/>
    </UserControl.InputBindings>

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <!-- 0: Header & Action Command Bar -->
            <RowDefinition Height="Auto"/>
            <!-- 1: Parameter Filters Bar -->
            <RowDefinition Height="Auto"/>
            <!-- 2: DataGrid & Totals -->
            <RowDefinition Height="*"/>
            <!-- 3: Settlement, Commission & GST Panel -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ======================================================== -->
        <!-- ROW 0: Top Header & Command Toolbar                      -->
        <!-- ======================================================== -->
        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="14,10" Margin="0,0,0,10">
            <DockPanel LastChildFill="False">
                <!-- Left: Title, Badges, Navigation & Status -->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#203B82F6" CornerRadius="8" Width="36" Height="36" Margin="0,0,10,0">
                        <TextBlock Text="&#xE8C7;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#3B82F6" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Card Adjustment Receipt" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <Border Background="#1510B981" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center"
                                    Visibility="{Binding IsExistingReceipt, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="SAVED" FontSize="9" FontWeight="Bold" Foreground="#10B981"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding StatusMessage}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"
                                   MaxWidth="280" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <!-- Record Navigation Buttons -->
                    <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="3" Margin="0,0,8,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <telerik:RadButton Command="{Binding NavigateFirstCommand}"
                                               Style="{StaticResource ToolbarButtonStyle}"
                                               Height="28" Width="30" Padding="0" Margin="0,0,2,0" ToolTip="First Record">
                                <TextBlock Text="&#xE892;" FontFamily="Segoe MDL2 Assets" FontSize="11"/>
                            </telerik:RadButton>
                            <telerik:RadButton Command="{Binding NavigatePreviousCommand}"
                                               Style="{StaticResource ToolbarButtonStyle}"
                                               Height="28" Width="30" Padding="0" Margin="0,0,2,0" ToolTip="Previous Record">
                                <TextBlock Text="&#xE76B;" FontFamily="Segoe MDL2 Assets" FontSize="11"/>
                            </telerik:RadButton>
                            <telerik:RadButton Command="{Binding NavigateNextCommand}"
                                               Style="{StaticResource ToolbarButtonStyle}"
                                               Height="28" Width="30" Padding="0" Margin="0,0,2,0" ToolTip="Next Record">
                                <TextBlock Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="11"/>
                            </telerik:RadButton>
                            <telerik:RadButton Command="{Binding NavigateLastCommand}"
                                               Style="{StaticResource ToolbarButtonStyle}"
                                               Height="28" Width="30" Padding="0" ToolTip="Last Record">
                                <TextBlock Text="&#xE893;" FontFamily="Segoe MDL2 Assets" FontSize="11"/>
                            </telerik:RadButton>
                        </StackPanel>
                    </Border>

                    <!-- Receipt No Badge -->
                    <Border Background="#103B82F6" BorderBrush="#303B82F6" BorderThickness="1" CornerRadius="6" Padding="8,3" Margin="0,0,6,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Receipt: " FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <TextBlock Text="{Binding ReceiptNo}" FontSize="11" FontWeight="Bold" Foreground="#3B82F6"/>
                        </StackPanel>
                    </Border>

                    <!-- Branch Badge -->
                    <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,3" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Branch: " FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <TextBlock Text="{Binding Branch}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Right: Action Buttons -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Card Setup Dialog -->
                    <telerik:RadButton Command="{Binding OpenCardSetupCommand}"
                                       Style="{StaticResource ToolbarButtonStyle}"
                                       Height="32" Padding="10,0" Margin="0,0,6,0"
                                       ToolTip="Open Card Setup to manage accepted cards">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Card Setup"/>
                        </StackPanel>
                    </telerik:RadButton>

                    <!-- New / Reset -->
                    <telerik:RadButton Command="{Binding NewReceiptCommand}"
                                       Style="{StaticResource ToolbarButtonStyle}"
                                       Height="32" Padding="10,0" Margin="0,0,6,0"
                                       ToolTip="New Receipt (Alt+N / F2)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="New Receipt"/>
                        </StackPanel>
                    </telerik:RadButton>

                    <!-- Export to CSV / Excel -->
                    <telerik:RadButton Command="{Binding ExportToExcelCommand}"
                                       Style="{StaticResource ToolbarButtonStyle}"
                                       Height="32" Padding="10,0" Margin="0,0,6,0"
                                       ToolTip="Export to CSV (Alt+E)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8B9;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="#10B981" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Export CSV"/>
                        </StackPanel>
                    </telerik:RadButton>

                    <!-- Print -->
                    <telerik:RadButton Command="{Binding PrintReceiptCommand}"
                                       Style="{StaticResource ToolbarButtonStyle}"
                                       Height="32" Padding="10,0" Margin="0,0,6,0"
                                       ToolTip="Print Preview (Alt+P)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE749;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Print"/>
                        </StackPanel>
                    </telerik:RadButton>

                    <!-- Delete -->
                    <telerik:RadButton Command="{Binding DeleteReceiptCommand}"
                                       Style="{StaticResource DangerToolbarButtonStyle}"
                                       Height="32" Padding="10,0" Margin="0,0,8,0"
                                       IsEnabled="{Binding IsExistingReceipt}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Delete"/>
                        </StackPanel>
                    </telerik:RadButton>

                    <!-- Save Adjustment -->
                    <telerik:RadButton Command="{Binding SaveReceiptCommand}"
                                       Style="{StaticResource PrimaryToolbarButtonStyle}"
                                       Height="32" Padding="14,0"
                                       ToolTip="Save Adjustment (Alt+S / F8)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Save Adjustment" FontWeight="Bold"/>
                        </StackPanel>
                    </telerik:RadButton>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ========================================== -->
        <!-- ROW 1: Parameter Filters Bar               -->
        <!-- ========================================== -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="14,10" Margin="0,0,0,10">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Card Account Dropdown -->
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="CARD ACCOUNT" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,3"/>
                    <ComboBox ItemsSource="{Binding CardAccounts}"
                              SelectedItem="{Binding SelectedCardAccount, Mode=TwoWay}"
                              Width="220" Height="30"/>
                </StackPanel>

                <!-- Bill Dates Group: From & To -->
                <StackPanel Margin="0,0,16,0" Orientation="Horizontal">
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="BILL DATES: FROM" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,3"/>
                        <DatePicker SelectedDate="{Binding FromDate, Mode=TwoWay}" Width="130" Height="30"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="TO" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,3"/>
                        <DatePicker SelectedDate="{Binding ToDate, Mode=TwoWay}" Width="130" Height="30"/>
                    </StackPanel>
                </StackPanel>

                <!-- Default Commission % & Apply -->
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="DEFAULT COMM %" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,3"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBox Text="{Binding GlobalCommissionPercent, Mode=TwoWay, StringFormat=F2}"
                                 Width="75" Height="30" TextAlignment="Right" VerticalContentAlignment="Center"/>
                        <telerik:RadButton Command="{Binding ApplyGlobalCommissionCommand}"
                                           Style="{StaticResource ToolbarButtonStyle}"
                                           Height="30" Padding="8,0" Margin="4,0,0,0"
                                           ToolTip="Apply this commission % to all items">
                            <TextBlock Text="Apply" FontSize="11"/>
                        </telerik:RadButton>
                    </StackPanel>
                </StackPanel>

                <!-- Fetch Button -->
                <StackPanel Margin="0,0,0,0" VerticalAlignment="Bottom">
                    <telerik:RadButton Command="{Binding FetchTransactionsCommand}"
                                       Style="{StaticResource PrimaryToolbarButtonStyle}"
                                       Height="30" Padding="16,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Fetch Transactions" FontWeight="Bold"/>
                        </StackPanel>
                    </telerik:RadButton>
                </StackPanel>
            </WrapPanel>
        </Border>

        <!-- ========================================== -->
        <!-- ROW 2: Transactions DataGrid & Totals      -->
        <!-- ========================================== -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="0" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- RadGridView Transactions -->
                <telerik:RadGridView Grid.Row="0"
                                     ItemsSource="{Binding Items}"
                                     SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                                     AutoGenerateColumns="False"
                                     CanUserInsertRows="False"
                                     CanUserDeleteRows="False"
                                     ShowGroupPanel="False"
                                     RowIndicatorVisibility="Collapsed"
                                     GridLinesVisibility="Horizontal"
                                     EnableRowVirtualization="True"
                                     EnableColumnVirtualization="True"
                                     SelectionMode="Single"
                                     EditTriggers="CellClick"
                                     BorderThickness="0"
                                     Background="Transparent">
                    <telerik:RadGridView.Columns>
                        <!-- Checkbox with Header Select All -->
                        <telerik:GridViewCheckBoxColumn UniqueName="SelectCol"
                                                        DataMemberBinding="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                        Width="45"
                                                        AutoSelectOnEdit="True"
                                                        IsResizable="False"
                                                        IsFilterable="False"
                                                        IsSortable="False">
                            <telerik:GridViewCheckBoxColumn.Header>
                                <CheckBox IsChecked="{Binding DataContext.IsSelectAll, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"
                                          ToolTip="Select / Deselect All Rows"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                            </telerik:GridViewCheckBoxColumn.Header>
                        </telerik:GridViewCheckBoxColumn>

                        <!-- Sr No -->
                        <telerik:GridViewDataColumn Header="Sr." DataMemberBinding="{Binding SrNo}" Width="60" IsReadOnly="True" TextAlignment="Center"/>

                        <!-- DB Name -->
                        <telerik:GridViewDataColumn Header="Tran Name" DataMemberBinding="{Binding DbName}" Width="100" IsReadOnly="True"/>

                        <!-- Bill No -->
                        <telerik:GridViewDataColumn Header="Bill No" DataMemberBinding="{Binding BillNo}" Width="110" IsReadOnly="True">
                            <telerik:GridViewDataColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding BillNo}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </telerik:GridViewDataColumn.CellTemplate>
                        </telerik:GridViewDataColumn>

                        <!-- Bill Date -->
                        <telerik:GridViewDataColumn Header="Bill Date" DataMemberBinding="{Binding BillDate, StringFormat=dd/MM/yyyy}" Width="110" IsReadOnly="True"/>

                        <!-- Account / Customer -->
                        <telerik:GridViewDataColumn Header="Account / Customer" DataMemberBinding="{Binding AccountName}" Width="*" MinWidth="160" IsReadOnly="True"/>

                        <!-- Card No / Tran No -->
                        <telerik:GridViewDataColumn Header="Card / Tran No" DataMemberBinding="{Binding CardNo}" Width="140" IsReadOnly="True"/>

                        <!-- Card Bank -->
                        <telerik:GridViewDataColumn Header="Card Bank" DataMemberBinding="{Binding CardBank}" Width="130" IsReadOnly="True"/>

                        <!-- Card Amount -->
                        <telerik:GridViewDataColumn Header="Card Amt" DataMemberBinding="{Binding CardAmount, StringFormat=N2}" Width="115" IsReadOnly="True" TextAlignment="Right">
                            <telerik:GridViewDataColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding CardAmount, StringFormat=N2}" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </telerik:GridViewDataColumn.CellTemplate>
                        </telerik:GridViewDataColumn>

                        <!-- Commission % -->
                        <telerik:GridViewDataColumn Header="Comm %" DataMemberBinding="{Binding CommissionPercent, Mode=TwoWay, StringFormat=F2, UpdateSourceTrigger=PropertyChanged}" Width="105" TextAlignment="Right">
                            <telerik:GridViewDataColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding CommissionPercent, StringFormat=F2}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </telerik:GridViewDataColumn.CellTemplate>
                            <telerik:GridViewDataColumn.CellEditTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding CommissionPercent, Mode=TwoWay, StringFormat=F2, UpdateSourceTrigger=LostFocus}"
                                             HorizontalContentAlignment="Right"
                                             VerticalContentAlignment="Center"/>
                                </DataTemplate>
                            </telerik:GridViewDataColumn.CellEditTemplate>
                        </telerik:GridViewDataColumn>

                        <!-- Commission Amt -->
                        <telerik:GridViewDataColumn Header="Commission Amt" DataMemberBinding="{Binding CommissionAmount, Mode=TwoWay, StringFormat=N2, UpdateSourceTrigger=PropertyChanged}" Width="120" TextAlignment="Right">
                            <telerik:GridViewDataColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding CommissionAmount, StringFormat=N2}" Foreground="#EF4444" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </telerik:GridViewDataColumn.CellTemplate>
                            <telerik:GridViewDataColumn.CellEditTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding CommissionAmount, Mode=TwoWay, StringFormat=N2, UpdateSourceTrigger=LostFocus}"
                                             Foreground="#EF4444"
                                             HorizontalContentAlignment="Right"
                                             VerticalContentAlignment="Center"/>
                                </DataTemplate>
                            </telerik:GridViewDataColumn.CellEditTemplate>
                        </telerik:GridViewDataColumn>

                        <!-- Received Amt (Settled in Bank) -->
                        <telerik:GridViewDataColumn Header="Received Amt" DataMemberBinding="{Binding ReceivedAmount, Mode=TwoWay, StringFormat=N2, UpdateSourceTrigger=PropertyChanged}" Width="135" TextAlignment="Right">
                            <telerik:GridViewDataColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ReceivedAmount, StringFormat=N2}" FontWeight="Bold" Foreground="#10B981" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </telerik:GridViewDataColumn.CellTemplate>
                            <telerik:GridViewDataColumn.CellEditTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding ReceivedAmount, Mode=TwoWay, StringFormat=N2, UpdateSourceTrigger=LostFocus}"
                                             FontWeight="Bold"
                                             Foreground="#10B981"
                                             HorizontalContentAlignment="Right"
                                             VerticalContentAlignment="Center"/>
                                </DataTemplate>
                            </telerik:GridViewDataColumn.CellEditTemplate>
                        </telerik:GridViewDataColumn>
                    </telerik:RadGridView.Columns>
                </telerik:RadGridView>

                <!-- Grid Totals Bar -->
                <Border Grid.Row="1" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,1,0,0" Padding="16,8">
                    <DockPanel LastChildFill="True">
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Total Transactions: " FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <TextBlock Text="{Binding ItemCount}" FontWeight="Bold" FontSize="12" Margin="0,0,16,0"/>
                            <TextBlock Text="Selected: " FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <TextBlock Text="{Binding SelectedCount}" FontWeight="Bold" FontSize="12" Foreground="#3B82F6"/>
                        </StackPanel>

                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Total Card Amt -->
                            <Border Background="#103B82F6" CornerRadius="6" Padding="10,4" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Total Card: " FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                    <TextBlock Text="{Binding TotalCardAmount, StringFormat=C2}" FontWeight="Bold" FontSize="12"/>
                                </StackPanel>
                            </Border>

                            <!-- Total Commission Amt -->
                            <Border Background="#10EF4444" CornerRadius="6" Padding="10,4" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Total Comm: " FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                    <TextBlock Text="{Binding TotalCommissionAmount, StringFormat=C2}" FontWeight="Bold" FontSize="12" Foreground="#EF4444"/>
                                </StackPanel>
                            </Border>

                            <!-- Total Received Amt -->
                            <Border Background="#1510B981" CornerRadius="6" Padding="12,4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Net Received: " FontSize="12" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                    <TextBlock Text="{Binding TotalReceivedAmount, StringFormat=C2}" FontWeight="Bold" FontSize="13" Foreground="#10B981"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ======================================================== -->
        <!-- ROW 3: Settlement Accounts, Commission & GST Info Cards  -->
        <!-- ======================================================== -->
        <Grid Grid.Row="3" Margin="0">
            <Grid.ColumnDefinitions>
                <!-- Col 0: Bank & Settlement Accounts -->
                <ColumnDefinition Width="1.5*"/>
                <ColumnDefinition Width="12"/>
                <!-- Col 1: Commission Breakdown -->
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="12"/>
                <!-- Col 2: GST Information -->
                <ColumnDefinition Width="1.2*"/>
            </Grid.ColumnDefinitions>

            <!-- Card 0: Settlement & Posting Accounts -->
            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="14,10">
                <StackPanel>
                    <TextBlock Text="SETTLEMENT &amp; POSTING ACCOUNTS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,8"/>

                    <!-- Posting / Settlement Date -->
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Posting Date" VerticalAlignment="Center" FontSize="11" FontWeight="Bold"/>
                        <DatePicker Grid.Column="1" SelectedDate="{Binding ReceiptDate, Mode=TwoWay}" Height="28"/>
                    </Grid>

                    <!-- Deposit Bank -->
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Deposit Bank" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold"/>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding BankAccounts}"
                                  SelectedItem="{Binding SelectedBankAccount, Mode=TwoWay}"
                                  DisplayMemberPath="AccountName"
                                  Height="28"/>
                    </Grid>

                    <!-- Clearing Account (Auto-linked to Selected Card Account) -->
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Clearing A/c" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <Border Grid.Column="1" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="4" Height="28" Padding="8,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectedCardAccount}" FontWeight="SemiBold" FontSize="11"/>
                                <TextBlock Text=" (Auto-cleared)" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="10" Margin="4,0,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Commission Account -->
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Commission Account" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold"/>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding CommissionAccounts}"
                                  SelectedItem="{Binding SelectedCommissionAccount, Mode=TwoWay}"
                                  DisplayMemberPath="AccountName"
                                  Height="28"/>
                    </Grid>

                    <!-- Remarks -->
                    <Grid Margin="0,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Remarks / Narration" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold"/>
                        <TextBox Grid.Column="1" Text="{Binding Remarks, Mode=TwoWay}" Height="28" VerticalContentAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Card 1: Commission Summary -->
            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="14,10">
                <StackPanel>
                    <TextBlock Text="COMMISSION &amp; SETTLEMENT INFO" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,8"/>

                    <!-- Total Card Amount (Gross) -->
                    <Grid Margin="0,0,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="105"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Total Card Amt" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold"/>
                        <TextBox Grid.Column="1" Text="{Binding TotalCardAmount, StringFormat=F2, Mode=OneWay}" IsReadOnly="True" Height="25" TextAlignment="Right" VerticalContentAlignment="Center" FontWeight="SemiBold"/>
                    </Grid>

                    <!-- Received in Bank (Settled) - User Editable -->
                    <Grid Margin="0,0,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="105"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Received in Bank" VerticalAlignment="Center" FontSize="11" FontWeight="Bold" Foreground="#10B981"/>
                        <TextBox Grid.Column="1"
                                 Text="{Binding TotalAccountReceivedAmount, StringFormat=F2, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                 Height="25" TextAlignment="Right" VerticalContentAlignment="Center"
                                 FontWeight="Bold" Foreground="#10B981"
                                 ToolTip="Enter settled amount received in bank. The rest automatically goes to commission entry."/>
                    </Grid>

                    <!-- Commission / Charges - User Editable -->
                    <Grid Margin="0,0,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="105"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Commission / Charges" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="#EF4444"/>
                        <TextBox Grid.Column="1"
                                 Text="{Binding TotalCommissionAmount, StringFormat=F2, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                 Height="25" TextAlignment="Right" VerticalContentAlignment="Center"
                                 FontWeight="Bold" Foreground="#EF4444"
                                 ToolTip="Commission fee deducted by card/bank aggregator."/>
                    </Grid>

                    <!-- Taxable Amount (for GST) -->
                    <Grid Margin="0,0,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="105"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Taxable Amount" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold"/>
                        <TextBox Grid.Column="1" Text="{Binding TaxableAmount, StringFormat=F2, Mode=OneWay}" IsReadOnly="True" Height="25" TextAlignment="Right" VerticalContentAlignment="Center"/>
                    </Grid>

                    <!-- ROF (Round Off) -->
                    <Grid Margin="0,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="105"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="ROF (Round Off) Amt" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold"/>
                        <TextBox Grid.Column="1" Text="{Binding RofAmount, StringFormat=F2, Mode=OneWay}" IsReadOnly="True" Height="25" TextAlignment="Right" VerticalContentAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Card 2: GST Information -->
            <Border Grid.Column="4" Style="{StaticResource CardStyle}" Padding="14,10">
                <StackPanel>
                    <TextBlock Text="GST &amp; TAX DETAILS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,8"/>

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Invoice Type" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold"/>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding InvoiceTypeOptions}" SelectedItem="{Binding InvoiceType, Mode=TwoWay}" Height="26"/>
                    </Grid>

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Tax Type" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold"/>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding TaxTypeOptions}" SelectedItem="{Binding TaxType, Mode=TwoWay}" Height="26"/>
                    </Grid>

                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,4,0">
                            <TextBlock Text="CGST" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <TextBox Text="{Binding CgstTaxAmount, StringFormat=F2, Mode=TwoWay}" Height="24" TextAlignment="Right" VerticalContentAlignment="Center" IsReadOnly="{Binding TaxManual, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="2,0,2,0">
                            <TextBlock Text="SGST" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <TextBox Text="{Binding SgstTaxAmount, StringFormat=F2, Mode=TwoWay}" Height="24" TextAlignment="Right" VerticalContentAlignment="Center" IsReadOnly="{Binding TaxManual, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="4,0,0,0">
                            <TextBlock Text="IGST" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <TextBox Text="{Binding IgstTaxAmount, StringFormat=F2, Mode=TwoWay}" Height="24" TextAlignment="Right" VerticalContentAlignment="Center" IsReadOnly="{Binding TaxManual, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
