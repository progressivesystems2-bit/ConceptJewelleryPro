<UserControl x:Class="ConceptJewelleryPro.WPF.Views.BackupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
             xmlns:controls="clr-namespace:ConceptJewelleryPro.WPF.Controls"
             FontFamily="Segoe UI"
             TextOptions.TextFormattingMode="Display">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="ToolbarButtonStyle" TargetType="telerik:RadButton" BasedOn="{StaticResource RadButtonStyle}">
            <Setter Property="Height" Value="36" />
            <Setter Property="MinWidth" Value="90" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>

        <Style x:Key="AccentToolbarButtonStyle" TargetType="telerik:RadButton" BasedOn="{StaticResource ToolbarButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
        </Style>

        <Style x:Key="TableActionButtonStyle" TargetType="telerik:RadButton" BasedOn="{StaticResource RadButtonStyle}">
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Toast Notifications Container -->
        <controls:ToastNotification Grid.Row="0"
                                     Grid.RowSpan="2"
                                     Panel.ZIndex="99"
                                     HorizontalAlignment="Right"
                                     VerticalAlignment="Bottom"
                                     Margin="0,0,24,24"
                                     Message="{Binding ToastMessage}"
                                     ToastType="{Binding ToastType}" />

        <!-- Header / Actions Bar -->
        <Border Grid.Row="0"
                Background="{DynamicResource HeaderBackgroundBrush}"
                BorderBrush="{DynamicResource HeaderBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="24,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="40" Height="40" CornerRadius="8" Background="{DynamicResource PanelBrush}">
                        <TextBlock Text="&#xEA35;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="18"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Database Backup &amp; Restore" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                        <TextBlock Text="Create, compress, and restore backups for Microsoft Access and SQL Server databases" FontSize="11.5" Foreground="{DynamicResource SecondaryTextBrush}" />
                    </StackPanel>
                </StackPanel>

                <!-- Top Bar Action Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <telerik:RadButton Content="Take Backup Now"
                                       Style="{StaticResource AccentToolbarButtonStyle}"
                                       Command="{Binding TakeBackupCommand}" />

                    <telerik:RadButton Content="Open Backup Folder"
                                       Style="{StaticResource ToolbarButtonStyle}"
                                       Command="{Binding OpenBackupFolderCommand}" />

                    <telerik:RadButton Content="Refresh History"
                                       Style="{StaticResource ToolbarButtonStyle}"
                                       Command="{Binding RefreshHistoryCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <telerik:RadBusyIndicator Grid.Row="1" IsBusy="{Binding IsBusy, Mode=OneWay}" BusyContent="{Binding BusyMessage}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="24,20,24,30" MaxWidth="1000" HorizontalAlignment="Left">
                    <!-- SECTION 1: Database Engine Selection & Status -->
                    <Border Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="20"
                            Margin="0,0,0,18">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <TextBlock Text="&#xEEA3;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="15"
                                           Foreground="{DynamicResource AccentBrush}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0" />
                                <TextBlock Text="Database Engine Selection"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>

                            <TextBlock Text="Select the target database type for taking backups. The application automatically detects your active connection settings."
                                       FontSize="12"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Margin="0,0,0,14" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Access Option Radio -->
                                <RadioButton Grid.Column="0"
                                             GroupName="DbEngine"
                                             IsChecked="{Binding IsAccessSelected, Mode=OneWay}"
                                             Checked="OnAccessRadioChecked"
                                             VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Margin="4,0,0,0">
                                        <TextBlock Text="&#xED25;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource AccentBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Microsoft Access (.mdb / .accdb)" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>

                                <!-- SQL Server Option Radio -->
                                <RadioButton Grid.Column="2"
                                             GroupName="DbEngine"
                                             IsChecked="{Binding IsSqlSelected, Mode=OneWay}"
                                             Checked="OnSqlRadioChecked"
                                             VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Margin="4,0,0,0">
                                        <TextBlock Text="&#xEEA3;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource AccentBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Microsoft SQL Server (.bak)" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>

                                <!-- Status Badge -->
                                <Border Grid.Column="4"
                                        Background="{DynamicResource InputBackgroundBrush}"
                                        BorderBrush="{DynamicResource InputBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="12,6"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ProviderSummaryText}"
                                               FontSize="11.5"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource AccentBrush}" />
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- SECTION 2A: Microsoft Access Backup Configuration -->
                    <Border Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="20"
                            Margin="0,0,0,18"
                            Visibility="{Binding IsAccessSelected, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <TextBlock Text="&#xED25;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="15"
                                           Foreground="{DynamicResource AccentBrush}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0" />
                                <TextBlock Text="Microsoft Access Backup Configuration"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>

                            <!-- Source Database File -->
                            <Grid Margin="0,4,0,14">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Text="Source Access Database Path (.mdb / .accdb)"
                                           FontSize="12"
                                           FontWeight="Medium"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           Margin="0,0,0,6" />

                                <telerik:RadWatermarkTextBox Grid.Row="1" Grid.Column="0"
                                                             Height="40"
                                                             VerticalContentAlignment="Center"
                                                             Padding="8,0"
                                                             FontSize="12.5"
                                                             WatermarkContent="Select or enter source database path"
                                                             Text="{Binding AccessSourcePath, UpdateSourceTrigger=PropertyChanged}" />

                                <telerik:RadButton Grid.Row="1" Grid.Column="1"
                                                   Content="Browse DB..."
                                                   Style="{StaticResource ToolbarButtonStyle}"
                                                   Height="40"
                                                   Margin="8,0,0,0"
                                                   Command="{Binding BrowseSourceAccessDbCommand}" />
                            </Grid>

                            <!-- Backup Destination Folder -->
                            <Grid Margin="0,0,0,14">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Text="Backup Destination Directory"
                                           FontSize="12"
                                           FontWeight="Medium"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           Margin="0,0,0,6" />

                                <telerik:RadWatermarkTextBox Grid.Row="1" Grid.Column="0"
                                                             Height="40"
                                                             VerticalContentAlignment="Center"
                                                             Padding="8,0"
                                                             FontSize="12.5"
                                                             WatermarkContent="Folder where backup files will be saved"
                                                             Text="{Binding BackupFolder, UpdateSourceTrigger=PropertyChanged}" />

                                <telerik:RadButton Grid.Row="1" Grid.Column="1"
                                                   Content="Browse Folder..."
                                                   Style="{StaticResource ToolbarButtonStyle}"
                                                   Height="40"
                                                   Margin="8,0,0,0"
                                                   Command="{Binding BrowseBackupFolderCommand}" />
                            </Grid>

                            <!-- Compression Option & Action Button -->
                            <Border Background="{DynamicResource InputBackgroundBrush}"
                                    BorderBrush="{DynamicResource InputBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="14,10"
                                    Margin="0,0,0,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <CheckBox Grid.Column="0"
                                              IsChecked="{Binding AccessCompressToZip, Mode=TwoWay}"
                                              VerticalAlignment="Center">
                                        <StackPanel Margin="8,0,0,0">
                                            <TextBlock Text="Compress Backup to ZIP Archive (.zip)"
                                                       FontSize="12.5"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource PrimaryTextBrush}" />
                                            <TextBlock Text="Reduces file size by up to 85% and creates a clean, timestamped archive."
                                                       FontSize="11"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                       Margin="0,2,0,0" />
                                        </StackPanel>
                                    </CheckBox>

                                    <telerik:RadButton Grid.Column="1"
                                                       Content="Take Access Backup"
                                                       Style="{StaticResource AccentToolbarButtonStyle}"
                                                       Height="36"
                                                       Command="{Binding TakeBackupCommand}" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                    <!-- SECTION 2B: Microsoft SQL Server Backup Configuration -->
                    <Border Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="20"
                            Margin="0,0,0,18"
                            Visibility="{Binding IsSqlSelected, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <TextBlock Text="&#xEEA3;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="15"
                                           Foreground="{DynamicResource AccentBrush}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0" />
                                <TextBlock Text="SQL Server Backup Configuration"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>

                            <!-- Row 1: Server Name + Authentication -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Server Name -->
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="SQL Server Name / Instance"
                                               FontSize="12" FontWeight="Medium"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               Margin="0,0,0,6" />
                                    <telerik:RadWatermarkTextBox Height="40"
                                                                 VerticalContentAlignment="Center"
                                                                 Padding="8,0" FontSize="12.5"
                                                                 WatermarkContent="e.g. localhost, .\SQLEXPRESS, SERVER\INSTANCE"
                                                                 Text="{Binding SqlServerName, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>

                                <!-- Database Name Selection -->
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Database Name"
                                               FontSize="12" FontWeight="Medium"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               Margin="0,0,0,6" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <telerik:RadComboBox Grid.Column="0"
                                                             Height="40"
                                                             IsEditable="True"
                                                             ItemsSource="{Binding AvailableDatabases}"
                                                             Text="{Binding SqlDatabaseName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             FontSize="12.5"
                                                             VerticalContentAlignment="Center" />
                                        <telerik:RadButton Grid.Column="1"
                                                           Content="Fetch DBs"
                                                           Style="{StaticResource ToolbarButtonStyle}"
                                                           Height="40"
                                                           Margin="6,0,0,0"
                                                           Command="{Binding LoadSqlDatabasesCommand}" />
                                    </Grid>
                                </StackPanel>
                            </Grid>

                            <!-- Row 2: Authentication Mode Toggle -->
                            <Border Background="{DynamicResource InputBackgroundBrush}"
                                    BorderBrush="{DynamicResource InputBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="14,10"
                                    Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <RadioButton Grid.Column="0"
                                                 GroupName="SqlAuthMode"
                                                 Content="Windows Integrated Authentication"
                                                 IsChecked="{Binding SqlUseWindowsAuth, Mode=TwoWay}"
                                                 FontSize="12"
                                                 VerticalAlignment="Center" />

                                    <RadioButton Grid.Column="2"
                                                 GroupName="SqlAuthMode"
                                                 Content="SQL Server Authentication"
                                                 IsChecked="{Binding SqlIsSqlAuth, Mode=TwoWay}"
                                                 FontSize="12"
                                                 VerticalAlignment="Center" />

                                    <telerik:RadButton Grid.Column="4"
                                                       Content="Test Connection"
                                                       Style="{StaticResource ToolbarButtonStyle}"
                                                       Height="32"
                                                       Command="{Binding TestSqlConnectionCommand}" />
                                </Grid>
                            </Border>

                            <!-- Row 3: Username & Password (if SQL Auth) -->
                            <Grid Margin="0,0,0,12" Visibility="{Binding SqlIsSqlAuth, Converter={StaticResource BoolToVis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="SQL Username"
                                               FontSize="12" FontWeight="Medium"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               Margin="0,0,0,6" />
                                    <telerik:RadWatermarkTextBox Height="40"
                                                                 VerticalContentAlignment="Center"
                                                                 Padding="8,0" FontSize="12.5"
                                                                 WatermarkContent="sa"
                                                                 Text="{Binding SqlUsername, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="SQL Password"
                                               FontSize="12" FontWeight="Medium"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               Margin="0,0,0,6" />
                                    <telerik:RadWatermarkTextBox Height="40"
                                                                 VerticalContentAlignment="Center"
                                                                 Padding="8,0" FontSize="12.5"
                                                                 WatermarkContent="Enter password"
                                                                 Text="{Binding SqlPassword, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Grid>

                            <!-- Destination Folder & Backup Button -->
                            <Grid Margin="0,0,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Text="Backup Destination Directory"
                                           FontSize="12"
                                           FontWeight="Medium"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           Margin="0,0,0,6" />

                                <telerik:RadWatermarkTextBox Grid.Row="1" Grid.Column="0"
                                                             Height="40"
                                                             VerticalContentAlignment="Center"
                                                             Padding="8,0"
                                                             FontSize="12.5"
                                                             WatermarkContent="Folder where .bak files will be saved"
                                                             Text="{Binding BackupFolder, UpdateSourceTrigger=PropertyChanged}" />

                                <telerik:RadButton Grid.Row="1" Grid.Column="1"
                                                   Content="Browse..."
                                                   Style="{StaticResource ToolbarButtonStyle}"
                                                   Height="40"
                                                   Margin="8,0,0,0"
                                                   Command="{Binding BrowseBackupFolderCommand}" />

                                <telerik:RadButton Grid.Row="1" Grid.Column="2"
                                                   Content="Take SQL Backup"
                                                   Style="{StaticResource AccentToolbarButtonStyle}"
                                                   Height="40"
                                                   Margin="8,0,0,0"
                                                   Command="{Binding TakeBackupCommand}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- SECTION 3: Backup History & Management -->
                    <Border Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="20">
                        <StackPanel>
                            <!-- Section Header -->
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE81C;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="15"
                                               Foreground="{DynamicResource AccentBrush}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0" />
                                    <TextBlock Text="Backup History &amp; Previous Snapshots"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               VerticalAlignment="Center" />
                                    <Border Background="{DynamicResource AccentBrush}"
                                            CornerRadius="10"
                                            Padding="8,2"
                                            Margin="10,0,0,0"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding BackupHistory.Count, StringFormat='{}{0} Backups'}"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource AccentTextBrush}" />
                                    </Border>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <telerik:RadButton Content="Open Folder in Explorer"
                                                       Style="{StaticResource TableActionButtonStyle}"
                                                       Command="{Binding OpenBackupFolderCommand}" />
                                </StackPanel>
                            </Grid>

                            <!-- Backup Files Table / Grid -->
                            <telerik:RadGridView ItemsSource="{Binding BackupHistory}"
                                                 SelectedItem="{Binding SelectedBackupFile, Mode=TwoWay}"
                                                 AutoGenerateColumns="False"
                                                 CanUserFreezeColumns="False"
                                                 CanUserReorderColumns="False"
                                                 CanUserResizeColumns="True"
                                                 CanUserSortColumns="True"
                                                 IsReadOnly="True"
                                                 RowIndicatorVisibility="Collapsed"
                                                 ShowGroupPanel="False"
                                                 MinHeight="220"
                                                 MaxHeight="400">
                                <telerik:RadGridView.Columns>
                                    <!-- File Name -->
                                    <telerik:GridViewDataColumn Header="Backup File Name"
                                                                DataMemberBinding="{Binding FileName}"
                                                                Width="*"
                                                                TextAlignment="Left">
                                        <telerik:GridViewDataColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="&#xEA35;"
                                                               FontFamily="Segoe MDL2 Assets"
                                                               FontSize="13"
                                                               Foreground="{DynamicResource AccentBrush}"
                                                               Margin="0,0,8,0"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding FileName}"
                                                               FontWeight="SemiBold"
                                                               FontSize="12"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </telerik:GridViewDataColumn.CellTemplate>
                                    </telerik:GridViewDataColumn>

                                    <!-- Engine / Type -->
                                    <telerik:GridViewDataColumn Header="Database Type"
                                                                DataMemberBinding="{Binding Extension}"
                                                                Width="140">
                                        <telerik:GridViewDataColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="4"
                                                        Padding="6,2"
                                                        HorizontalAlignment="Left"
                                                        Background="{DynamicResource InputBackgroundBrush}"
                                                        BorderBrush="{DynamicResource InputBorderBrush}"
                                                        BorderThickness="1">
                                                    <TextBlock Text="{Binding Extension}"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource PrimaryTextBrush}" />
                                                </Border>
                                            </DataTemplate>
                                        </telerik:GridViewDataColumn.CellTemplate>
                                    </telerik:GridViewDataColumn>

                                    <!-- File Size -->
                                    <telerik:GridViewDataColumn Header="Size"
                                                                DataMemberBinding="{Binding FormattedFileSize}"
                                                                Width="110"
                                                                TextAlignment="Right" />

                                    <!-- Date Created -->
                                    <telerik:GridViewDataColumn Header="Date Created"
                                                                DataMemberBinding="{Binding CreatedAt, StringFormat='{}{0:dd/MM/yyyy HH:mm:ss}'}"
                                                                Width="160" />

                                    <!-- Action Buttons -->
                                    <telerik:GridViewColumn Header="Actions" Width="210" IsSortable="False">
                                        <telerik:GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <telerik:RadButton Content="Locate"
                                                                       ToolTip="Show in Windows Explorer"
                                                                       Style="{StaticResource TableActionButtonStyle}"
                                                                       Command="{Binding DataContext.OpenFileLocationCommand, RelativeSource={RelativeSource AncestorType=telerik:RadGridView}}"
                                                                       CommandParameter="{Binding}" />

                                                    <telerik:RadButton Content="Restore"
                                                                       ToolTip="Restore database from this backup"
                                                                       Style="{StaticResource TableActionButtonStyle}"
                                                                       Command="{Binding DataContext.RestoreBackupCommand, RelativeSource={RelativeSource AncestorType=telerik:RadGridView}}"
                                                                       CommandParameter="{Binding}" />

                                                    <telerik:RadButton Content="Delete"
                                                                       ToolTip="Permanently delete this backup"
                                                                       Style="{StaticResource TableActionButtonStyle}"
                                                                       Foreground="#E11D48"
                                                                       Command="{Binding DataContext.DeleteBackupCommand, RelativeSource={RelativeSource AncestorType=telerik:RadGridView}}"
                                                                       CommandParameter="{Binding}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </telerik:GridViewColumn.CellTemplate>
                                    </telerik:GridViewColumn>
                                </telerik:RadGridView.Columns>
                            </telerik:RadGridView>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </telerik:RadBusyIndicator>
    </Grid>
</UserControl>
