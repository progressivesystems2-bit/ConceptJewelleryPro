<UserControl x:Class="ConceptJewelleryPro.WPF.Views.NonBarcodeStockView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
             xmlns:controls="clr-namespace:ConceptJewelleryPro.WPF.Controls"
             xmlns:vm="clr-namespace:ConceptJewelleryPro.WPF.ViewModels"
             FontFamily="Segoe UI"
             TextOptions.TextFormattingMode="Display">

    <UserControl.InputBindings>
        <KeyBinding Key="A" Modifiers="Alt" Command="{Binding NewStockCommand}"/>
        <KeyBinding Key="S" Modifiers="Alt" Command="{Binding SaveStockCommand}"/>
        <KeyBinding Key="M" Modifiers="Alt" Command="{Binding ModifyStockCommand}"/>
        <KeyBinding Key="D" Modifiers="Alt" Command="{Binding DeleteStockCommand}"/>
        <KeyBinding Key="C" Modifiers="Alt" Command="{Binding CancelStockCommand}"/>
    </UserControl.InputBindings>

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14,12"/>
        </Style>

        <Style x:Key="HeaderLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <!-- Toast Notification Overlay -->
        <controls:ToastNotification x:Name="ToastNotification"
                                     Panel.ZIndex="99"
                                     Message="{Binding ToastMessage, FallbackValue=''}"
                                     ToastType="{Binding ToastType, FallbackValue=Info}"
                                     AutoCloseDelay="4000"
                                     FontSize="13"
                                     VerticalAlignment="Top"/>

        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Row 0: Top Action Toolbar -->
                <RowDefinition Height="Auto"/> <!-- Row 1: Header Details Card -->
                <RowDefinition Height="*"/>    <!-- Row 2: Items Grid & Summary -->
            </Grid.RowDefinitions>

            <!-- Row 0: Header & Top Action Toolbar -->
            <Border Grid.Row="0"
                    Background="{DynamicResource HeaderBackgroundBrush}"
                    BorderBrush="{DynamicResource HeaderBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12,8"
                    Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Module Title & Icon -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                        <Border Width="36" Height="36" CornerRadius="8" Background="{DynamicResource PanelBrush}" Margin="0,0,10,0">
                            <TextBlock Text="&#xE805;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="17"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Non-Barcode Stock Entry" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock Text="{Binding VouNo, StringFormat='Voucher: {0}', FallbackValue='Voucher: -'}" FontSize="11.5" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Action Toolbar Buttons -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <telerik:RadButton Style="{StaticResource PrimaryToolbarButtonStyle}" Command="{Binding NewStockCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Add New (Alt+A)" VerticalAlignment="Center"/>
                            </StackPanel>
                        </telerik:RadButton>

                        <telerik:RadButton Style="{StaticResource ToolbarButtonStyle}" Command="{Binding SaveStockCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Save (Alt+S)" VerticalAlignment="Center"/>
                            </StackPanel>
                        </telerik:RadButton>

                        <telerik:RadButton Style="{StaticResource ToolbarButtonStyle}" Command="{Binding PrintStockCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE749;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Print" VerticalAlignment="Center"/>
                            </StackPanel>
                        </telerik:RadButton>

                        <telerik:RadButton Style="{StaticResource ToolbarButtonStyle}" Command="{Binding ModifyStockCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Modify (Alt+M)" VerticalAlignment="Center"/>
                            </StackPanel>
                        </telerik:RadButton>

                        <telerik:RadButton Style="{StaticResource DangerToolbarButtonStyle}" Command="{Binding DeleteStockCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Delete (Alt+D)" VerticalAlignment="Center"/>
                            </StackPanel>
                        </telerik:RadButton>

                        <telerik:RadButton Style="{StaticResource ToolbarButtonStyle}" Command="{Binding CancelStockCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Cancel (Alt+C)" VerticalAlignment="Center"/>
                            </StackPanel>
                        </telerik:RadButton>
                    </StackPanel>

                    <!-- Right Side: Voucher Badge, Mode Badge & Recent Selector -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#FFFDE7" BorderBrush="#FBC02D" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,8,0">
                            <TextBlock Text="{Binding VouNo, StringFormat='Voucher: {0}'}" FontWeight="Bold" FontSize="12.5" Foreground="#E65100"/>
                        </Border>
                        <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,10,0">
                            <TextBlock Text="{Binding FormMode, StringFormat='Mode: {0}'}" FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource PrimaryTextBrush}"/>
                        </Border>
                        <TextBlock Text="Recent:" VerticalAlignment="Center" FontSize="11.5" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,6,0"/>
                        <telerik:RadComboBox Width="170"
                                             ItemsSource="{Binding RecentRecords}"
                                             SelectedItem="{Binding SelectedRecentRecord, Mode=TwoWay}"
                                             DisplayMemberPath="DisplayText"
                                             IsEditable="True"
                                             IsTextSearchEnabled="True"
                                             Height="30"
                                             Background="{DynamicResource InputBackgroundBrush}"
                                             BorderBrush="{DynamicResource InputBorderBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Row 1: Section 1 Header Details Card -->
            <Border Grid.Row="1"
                    Style="{StaticResource CardStyle}"
                    Margin="0,0,0,10"
                    IsEnabled="{Binding IsFormEnabled}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Row 0, Col 0: Voucher Number -->
                    <Grid Grid.Row="0" Grid.Column="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Voucher No:" Style="{StaticResource HeaderLabelStyle}"/>
                        <telerik:RadWatermarkTextBox Grid.Column="1"
                                                     Text="{Binding VouNo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     WatermarkContent="Auto-generated"
                                                     IsReadOnly="True"
                                                     FontWeight="SemiBold"
                                                     Height="34"
                                                     Background="{DynamicResource PanelBrush}"/>
                    </Grid>

                    <!-- Row 0, Col 2: Voucher Date -->
                    <Grid Grid.Row="0" Grid.Column="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Voucher Date:" Style="{StaticResource HeaderLabelStyle}"/>
                        <telerik:RadDatePicker Grid.Column="1"
                                               SelectedDate="{Binding VouDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                               Height="34"
                                               VerticalContentAlignment="Center"/>
                    </Grid>

                    <!-- Row 0, Col 4: Operator -->
                    <Grid Grid.Row="0" Grid.Column="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Operator:" Style="{StaticResource HeaderLabelStyle}"/>
                        <telerik:RadWatermarkTextBox Grid.Column="1"
                                                     Text="{Binding EntryUser, Mode=OneWay}"
                                                     IsReadOnly="True"
                                                     Height="34"
                                                     Background="{DynamicResource PanelBrush}"/>
                    </Grid>

                    <!-- Row 2, Col 0-2 (Spanning 3 cols): Supplier / Party -->
                    <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Supplier / Party:" Style="{StaticResource HeaderLabelStyle}"/>
                        <telerik:RadComboBox Grid.Column="1"
                                             ItemsSource="{Binding Suppliers}"
                                             DisplayMemberPath="AccountName"
                                             SelectedValuePath="AccountName"
                                             SelectedValue="{Binding SupplierName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Text="{Binding SupplierName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             IsEditable="True"
                                             IsFilteringEnabled="True"
                                             TextSearchMode="Contains"
                                             DropDownWidth="380"
                                             Height="34"
                                             VerticalContentAlignment="Center"/>
                    </Grid>

                    <!-- Row 2, Col 4: Terminal -->
                    <Grid Grid.Row="2" Grid.Column="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Terminal:" Style="{StaticResource HeaderLabelStyle}"/>
                        <telerik:RadWatermarkTextBox Grid.Column="1"
                                                     Text="{Binding ComputerName, Mode=OneWay}"
                                                     IsReadOnly="True"
                                                     Height="34"
                                                     Background="{DynamicResource PanelBrush}"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- Row 2: Section 2 Items Grid & Summary Cards -->
            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Items RadGridView -->
                <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,0,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Grid Header & Row Action Buttons -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Non-Barcode Stock Items"
                                           FontSize="13.5"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding TotalItemsCount, StringFormat=' ({0} items)'}"
                                           FontSize="11.5"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           VerticalAlignment="Center"
                                           Margin="6,0,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <telerik:RadButton Content="+ Add Row"
                                                   Command="{Binding AddLineCommand}"
                                                   Style="{StaticResource ToolbarButtonStyle}"
                                                   Height="32"
                                                   MinWidth="85"
                                                   Margin="0,0,6,0"/>
                                <telerik:RadButton Content="✕ Remove Row"
                                                   Command="{Binding RemoveLineCommand}"
                                                   Style="{StaticResource DangerToolbarButtonStyle}"
                                                   Height="32"
                                                   MinWidth="95"/>
                            </StackPanel>
                        </Grid>

                        <!-- RadGridView for Items -->
                        <telerik:RadGridView x:Name="StockGrid"
                                             Grid.Row="1"
                                             ItemsSource="{Binding Lines}"
                                             SelectedItem="{Binding SelectedLine, Mode=TwoWay}"
                                             AutoGenerateColumns="False"
                                             CanUserInsertRows="True"
                                             CanUserDeleteRows="True"
                                             IsReadOnly="{Binding IsReadOnly}"
                                             CellEditEnded="StockGrid_CellEditEnded"
                                             ShowGroupPanel="False"
                                             RowIndicatorVisibility="Visible"
                                             GridLinesVisibility="Both"
                                             MinHeight="250">
                            <telerik:RadGridView.Columns>
                                <telerik:GridViewDataColumn Header="Item Name / Description"
                                                            DataMemberBinding="{Binding ItemName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                            Width="*">
                                    <telerik:GridViewDataColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding ItemName}"
                                                       VerticalAlignment="Center"
                                                       Margin="6,0"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </DataTemplate>
                                    </telerik:GridViewDataColumn.CellTemplate>
                                    <telerik:GridViewDataColumn.CellEditTemplate>
                                        <DataTemplate>
                                            <telerik:RadComboBox x:Name="ItemNameCombo"
                                                                 ItemsSource="{Binding DataContext.AvailableItemNames, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                 Text="{Binding ItemName, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                                 IsEditable="True"
                                                                 IsFilteringEnabled="True"
                                                                 TextSearchMode="Contains"
                                                                 IsTextSearchEnabled="True"
                                                                 OpenDropDownOnFocus="True"
                                                                 Loaded="ItemNameCombo_Loaded"
                                                                 SelectionChanged="ItemNameCombo_SelectionChanged"
                                                                 LostFocus="ItemNameCombo_LostFocus"
                                                                 PreviewKeyDown="ItemNameCombo_PreviewKeyDown"/>
                                        </DataTemplate>
                                    </telerik:GridViewDataColumn.CellEditTemplate>
                                </telerik:GridViewDataColumn>
                                <telerik:GridViewDataColumn Header="Quantity / Pcs"
                                                            DataMemberBinding="{Binding Qty, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                            DataFormatString="{}{0:N2}"
                                                            TextAlignment="Right"
                                                            Width="150"/>
                                <telerik:GridViewDataColumn Header="Weight (Grams)"
                                                            DataMemberBinding="{Binding Weight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                            DataFormatString="{}{0:N3}"
                                                            TextAlignment="Right"
                                                            Width="180"/>
                                <telerik:GridViewDataColumn Header="Punch Time"
                                                            DataMemberBinding="{Binding PunchTime, Mode=OneWay}"
                                                            DataFormatString="{}{0:hh:mm:ss tt}"
                                                            IsReadOnly="True"
                                                            TextAlignment="Center"
                                                            Width="140"/>
                            </telerik:RadGridView.Columns>
                        </telerik:RadGridView>
                    </Grid>
                </Border>

                <!-- Summary Totals Footer Card -->
                <Border Grid.Row="1"
                        Style="{StaticResource CardStyle}"
                        Background="{DynamicResource PanelBrush}"
                        Padding="14,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Summary &amp; Stock Totals" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Total Items -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Total Items:" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="12,4">
                                <TextBlock Text="{Binding TotalItemsCount}" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            </Border>
                        </StackPanel>

                        <!-- Total Quantity -->
                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Total Quantity (Pcs):" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="14,4">
                                <TextBlock Text="{Binding TotalQty, StringFormat='{}{0:N2}'}" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            </Border>
                        </StackPanel>

                        <!-- Total Weight -->
                        <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Total Net Weight (g):" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="14,4">
                                <TextBlock Text="{Binding TotalWeight, StringFormat='{}{0:N3}'}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
