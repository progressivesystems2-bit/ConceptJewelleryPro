<Window x:Class="ConceptJewelleryPro.WPF.Views.LicenseLockedWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
        Title="Concept Jewellery Pro - License Activation Required"
        Width="560"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        FontFamily="Segoe UI"
        Background="{DynamicResource WindowBackgroundBrush}"
        TextOptions.TextFormattingMode="Display">

    <Border Background="{DynamicResource CardBackgroundBrush}"
            BorderBrush="{DynamicResource CardBorderBrush}"
            BorderThickness="1"
            Padding="28">
        <StackPanel>
            <!-- Top Badge & Title -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                <Border Width="48" Height="48" CornerRadius="10" Background="#20DC2626" BorderBrush="#50DC2626" BorderThickness="1">
                    <TextBlock Text="&#xE72E;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="22"
                               Foreground="#DC2626"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusTitle}"
                               FontSize="19"
                               FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryTextBrush}" />
                    <TextBlock Text="Concept Jewellery Pro — Cloud License Enforcement"
                               FontSize="12"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Margin="0,2,0,0" />
                </StackPanel>
            </StackPanel>

            <!-- Company & Machine Card -->
            <Border Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16,14"
                    Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0">
                        <TextBlock Text="Company Name (from Database)" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" />
                        <TextBlock Text="{Binding CompanyName}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,2,8,0" TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="1">
                        <TextBlock Text="Computer / Node Name" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" />
                        <TextBlock Text="{Binding MachineName}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,2,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2">
                        <TextBlock Text="License Details" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" />
                        <TextBlock Text="{Binding ValidToText}" FontSize="13" FontWeight="SemiBold" Foreground="#DC2626" Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Status Message -->
            <TextBlock Text="{Binding StatusMessage}"
                       FontSize="13"
                       Foreground="{DynamicResource PrimaryTextBrush}"
                       TextWrapping="Wrap"
                       LineHeight="20"
                       Margin="0,0,0,12" />

            <TextBlock Text="{Binding CheckResultMessage}"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource AccentBrush}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,16" />

            <!-- Buttons -->
            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <telerik:RadButton Grid.Column="1"
                                   Content="Retry Verification"
                                   Height="38"
                                   MinWidth="145"
                                   Padding="16,0"
                                   FontWeight="SemiBold"
                                   Background="{DynamicResource AccentBrush}"
                                   Foreground="{DynamicResource AccentTextBrush}"
                                   Command="{Binding RetryVerificationCommand}" />

                <telerik:RadButton Grid.Column="3"
                                   Content="Exit Application"
                                   Height="38"
                                   MinWidth="120"
                                   Padding="14,0"
                                   FontWeight="SemiBold"
                                   Command="{Binding ExitCommand}" />
            </Grid>
        </StackPanel>
    </Border>
</Window>
