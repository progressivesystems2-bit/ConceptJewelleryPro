<UserControl x:Class="ConceptJewelleryPro.WPF.Views.AuditReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
             xmlns:controls="clr-namespace:ConceptJewelleryPro.WPF.Controls"
             xmlns:vm="clr-namespace:ConceptJewelleryPro.WPF.ViewModels"
             xmlns:entities="clr-namespace:ConceptJewelleryPro.Domain.Entities;assembly=ConceptJewelleryPro.Domain"
             FontFamily="Segoe UI"
             TextOptions.TextFormattingMode="Display">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12,8"/>
        </Style>

        <Style x:Key="KpiCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <!-- Toast Notification -->
        <controls:ToastNotification x:Name="ToastNotification"
                                     Panel.ZIndex="99"
                                     Message="{Binding ToastMessage, FallbackValue=''}"
                                     ToastType="{Binding ToastType, FallbackValue=Info}"
                                     AutoCloseDelay="4000"
                                     FontSize="13"
                                     HorizontalAlignment="Right"
                                     VerticalAlignment="Top"
                                     Margin="0,16,24,0"/>

        <Grid Margin="14,10">
            <Grid.RowDefinitions>
                <!-- 0: KPI Summary Metric Cards -->
                <RowDefinition Height="Auto"/>
                <!-- 1: Filter Bar -->
                <RowDefinition Height="Auto"/>
                <!-- 2: Master & Detail Data -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 0: KPI Summary Metric Cards -->
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- Total Actions -->
                <Border Grid.Column="0" Style="{StaticResource KpiCardStyle}">
                    <StackPanel>
                        <TextBlock Text="AUDIT ACTIONS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <TextBlock Text="{Binding TotalRecordsCount}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,2,0,0"/>
                        <TextBlock Text="Grouped transactions" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                    </StackPanel>
                </Border>

                <!-- Total Field Changes -->
                <Border Grid.Column="1" Style="{StaticResource KpiCardStyle}">
                    <StackPanel>
                        <TextBlock Text="TOTAL FIELD DIFFS" FontSize="11" FontWeight="Bold" Foreground="SteelBlue"/>
                        <TextBlock Text="{Binding TotalChangesCount}" FontSize="22" FontWeight="Bold" Foreground="SteelBlue" Margin="0,2,0,0"/>
                        <TextBlock Text="Individual cell changes" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                    </StackPanel>
                </Border>

                <!-- Pending Verification (Unchecked) -->
                <Border Grid.Column="2" Style="{StaticResource KpiCardStyle}" Background="#FFFBEB" BorderBrush="#FCD34D">
                    <StackPanel>
                        <TextBlock Text="PENDING VERIFICATION" FontSize="11" FontWeight="Bold" Foreground="#B45309"/>
                        <TextBlock Text="{Binding UncheckedCount}" FontSize="22" FontWeight="Bold" Foreground="#B45309" Margin="0,2,0,0"/>
                        <TextBlock Text="Unchecked modifications" FontSize="11" Foreground="#92400E"/>
                    </StackPanel>
                </Border>

                <!-- Modifications -->
                <Border Grid.Column="3" Style="{StaticResource KpiCardStyle}">
                    <StackPanel>
                        <TextBlock Text="MODIFICATIONS" FontSize="11" FontWeight="Bold" Foreground="#15803D"/>
                        <TextBlock Text="{Binding ModificationsCount}" FontSize="22" FontWeight="Bold" Foreground="#15803D" Margin="0,2,0,0"/>
                        <TextBlock Text="Updated records" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                    </StackPanel>
                </Border>

                <!-- Deletions -->
                <Border Grid.Column="4" Style="{StaticResource KpiCardStyle}" Background="#FEF2F2" BorderBrush="#FCA5A5">
                    <StackPanel>
                        <TextBlock Text="DELETIONS" FontSize="11" FontWeight="Bold" Foreground="#B91C1C"/>
                        <TextBlock Text="{Binding DeletionsCount}" FontSize="22" FontWeight="Bold" Foreground="#B91C1C" Margin="0,2,0,0"/>
                        <TextBlock Text="Removed records" FontSize="11" Foreground="#991B1B"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 1: Filter Bar -->
            <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <!-- From Date -->
                        <ColumnDefinition Width="135"/>
                        <!-- To Date -->
                        <ColumnDefinition Width="135"/>
                        <!-- User -->
                        <ColumnDefinition Width="150"/>
                        <!-- Module / EntryType -->
                        <ColumnDefinition Width="160"/>
                        <!-- Status Filter -->
                        <ColumnDefinition Width="150"/>
                        <!-- Search Box -->
                        <ColumnDefinition Width="*"/>
                        <!-- Action Buttons -->
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- From Date -->
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="FROM DATE" Style="{StaticResource FieldLabel}"/>
                        <telerik:RadDatePicker SelectedValue="{Binding FromDate, Mode=TwoWay}"
                                                DateTimeWatermarkContent="From Date"
                                               Padding="0,-20,0,0"
                                                Height="40"/>
                    </StackPanel>

                    <!-- To Date -->
                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                        <TextBlock Text="TO DATE" Style="{StaticResource FieldLabel}"/>
                        <telerik:RadDatePicker SelectedValue="{Binding ToDate, Mode=TwoWay}"
                                                DateTimeWatermarkContent="To Date"
                                               Padding="0,-20,0,0"
                                                Height="40"/>
                    </StackPanel>

                    <!-- User Filter -->
                    <StackPanel Grid.Column="2" Margin="0,0,8,0">
                        <TextBlock Text="USER" Style="{StaticResource FieldLabel}"/>
                        <telerik:RadComboBox ItemsSource="{Binding Users}"
                                             SelectedItem="{Binding SelectedUser, Mode=TwoWay}"
                                             Height="40"/>
                    </StackPanel>

                    <!-- Module / EntryType -->
                    <StackPanel Grid.Column="3" Margin="0,0,8,0">
                        <TextBlock Text="MODULE" Style="{StaticResource FieldLabel}"/>
                        <telerik:RadComboBox ItemsSource="{Binding EntryTypes}"
                                             SelectedItem="{Binding SelectedEntryType, Mode=TwoWay}"
                                             Height="40"/>
                    </StackPanel>

                    <!-- Status Filter -->
                    <StackPanel Grid.Column="4" Margin="0,0,8,0">
                        <TextBlock Text="STATUS" Style="{StaticResource FieldLabel}"/>
                        <telerik:RadComboBox SelectedIndex="{Binding SelectedStatus, Mode=TwoWay, Converter={x:Null}}"
                                             SelectedValue="{Binding SelectedStatus, Mode=TwoWay}"
                                             SelectedValuePath="Tag"
                                             Height="40">
                            <telerik:RadComboBoxItem Content="All Records" Tag="{x:Static entities:AuditStatusFilter.All}" IsSelected="True"/>
                            <telerik:RadComboBoxItem Content="Unchecked Only" Tag="{x:Static entities:AuditStatusFilter.UncheckedOnly}"/>
                            <telerik:RadComboBoxItem Content="Checked Only" Tag="{x:Static entities:AuditStatusFilter.CheckedOnly}"/>
                        </telerik:RadComboBox>
                    </StackPanel>

                    <!-- Search Box -->
                    <StackPanel Grid.Column="5" Margin="0,0,10,0">
                        <TextBlock Text="SEARCH KEYWORD" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Height="35"
                                 VerticalContentAlignment="Center"
                                 Padding="6,0"/>
                    </StackPanel>

                    <!-- Action Buttons -->
                    <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,1">
                        <telerik:RadButton Command="{Binding RefreshCommand}"
                                           Height="40"
                                           Padding="12,0"
                                           Background="CadetBlue"
                                           Foreground="White"
                                           FontWeight="SemiBold"
                                           Margin="0,0,6,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔍 Filter / Refresh"/>
                            </StackPanel>
                        </telerik:RadButton>

                        <telerik:RadButton Command="{Binding ResetFiltersCommand}"
                                           Height="40"
                                           Padding="10,0"
                                           FontWeight="SemiBold"
                                           Margin="0,0,6,0"
                                           Content="Reset"/>

                        <telerik:RadButton Command="{Binding ExportCsvCommand}"
                                           Height="40"
                                           Padding="10,0"
                                           Background="#10B981"
                                           Foreground="White"
                                           FontWeight="SemiBold"
                                           Content="📥 CSV"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2: Master & Detail Data -->
            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="220"/>
                </Grid.RowDefinitions>

                <!-- Master: Grouped Audit Log Grid -->
                <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="0">
                    <Grid>
                        <telerik:RadGridView x:Name="AuditGridView"
                                             ItemsSource="{Binding GroupedLogs}"
                                             SelectedItem="{Binding SelectedGroup, Mode=TwoWay}"
                                             AutoGenerateColumns="False"
                                             IsReadOnly="True"
                                             CanUserFreezeColumns="False"
                                             RowIndicatorVisibility="Collapsed"
                                             ShowGroupPanel="False"
                                             SelectionMode="Single"
                                             BorderThickness="0"
                                             FontSize="12">
                            <telerik:RadGridView.Columns>
                                <!-- Timestamp -->
                                <telerik:GridViewDataColumn Header="Date &amp; Time"
                                                            DataMemberBinding="{Binding Timestamp, StringFormat='dd/MM/yyyy HH:mm:ss'}"
                                                            Width="140"/>

                                <!-- User -->
                                <telerik:GridViewDataColumn Header="User"
                                                            DataMemberBinding="{Binding User}"
                                                            Width="100">
                                    <telerik:GridViewDataColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="#F1F5F9" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding User}" FontWeight="Bold" FontSize="11" Foreground="#334155"/>
                                            </Border>
                                        </DataTemplate>
                                    </telerik:GridViewDataColumn.CellTemplate>
                                </telerik:GridViewDataColumn>

                                <!-- Module / EntryType -->
                                <telerik:GridViewDataColumn Header="Module"
                                                            DataMemberBinding="{Binding EntryType}"
                                                            Width="130"/>

                                <!-- VouNo / Record ID -->
                                <telerik:GridViewDataColumn Header="Document / Record #"
                                                            DataMemberBinding="{Binding VouNo}"
                                                            Width="160"/>

                                <!-- Action Type -->
                                <telerik:GridViewDataColumn Header="Action" Width="100">
                                    <telerik:GridViewDataColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#DCFCE7"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsDeleted}" Value="True">
                                                                <Setter Property="Background" Value="#FEE2E2"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding ActionDisplay}" FontWeight="Bold" FontSize="11">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#15803D"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsDeleted}" Value="True">
                                                                    <Setter Property="Foreground" Value="#B91C1C"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </DataTemplate>
                                    </telerik:GridViewDataColumn.CellTemplate>
                                </telerik:GridViewDataColumn>

                                <!-- Change Count -->
                                <telerik:GridViewDataColumn Header="Diffs"
                                                            DataMemberBinding="{Binding ChangeCount}"
                                                            TextAlignment="Center"
                                                            Width="60"/>

                                <!-- Verification Status -->
                                <telerik:GridViewDataColumn Header="Audit Status" Width="120">
                                    <telerik:GridViewDataColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding AllChecked, Converter={x:Null}}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="⏳ Pending"/>
                                                            <Setter Property="Foreground" Value="#D97706"/>
                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding AllChecked}" Value="True">
                                                                    <Setter Property="Text" Value="✓ Verified"/>
                                                                    <Setter Property="Foreground" Value="#16A34A"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </DataTemplate>
                                    </telerik:GridViewDataColumn.CellTemplate>
                                </telerik:GridViewDataColumn>

                                <!-- Summary -->
                                <telerik:GridViewDataColumn Header="Summary"
                                                            DataMemberBinding="{Binding SummaryText}"
                                                            Width="*"/>
                            </telerik:RadGridView.Columns>
                        </telerik:RadGridView>

                        <!-- Loading Indicator -->
                        <Border Background="#80FFFFFF"
                                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <telerik:RadBusyIndicator IsBusy="True" IsIndeterminate="True"/>
                                <TextBlock Text="{Binding StatusMessage}" Margin="0,10,0,0" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Middle Toolbar for verification -->
                <Grid Grid.Row="1" Margin="0,6,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="DETAILED FIELD CHANGES" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <TextBlock Text=" (Select a transaction above to view before &amp; after diffs)" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="6,0,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <telerik:RadButton Command="{Binding MarkCheckedCommand}"
                                           Height="40"
                                           Padding="10,0"
                                           Background="#16A34A"
                                           Foreground="White"
                                           FontWeight="SemiBold"
                                           Margin="0,0,6,0"
                                           Content="✓ Mark Selected as Verified (Checked)"/>

                        <telerik:RadButton Command="{Binding MarkUncheckedCommand}"
                                           Height="40"
                                           Padding="10,0"
                                           FontWeight="SemiBold"
                                           Content="⏳ Mark as Unchecked"/>
                    </StackPanel>
                </Grid>

                <!-- Detail: Field Diffs Grid -->
                <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="0">
                    <telerik:RadGridView ItemsSource="{Binding SelectedGroup.Changes}"
                                         AutoGenerateColumns="False"
                                         IsReadOnly="True"
                                         RowIndicatorVisibility="Collapsed"
                                         ShowGroupPanel="False"
                                         BorderThickness="0"
                                         FontSize="12">
                        <telerik:RadGridView.Columns>
                            <!-- ID -->
                            <telerik:GridViewDataColumn Header="ID" DataMemberBinding="{Binding IdNo}" Width="60"/>

                            <!-- Field Name -->
                            <telerik:GridViewDataColumn Header="Field Name"
                                                        DataMemberBinding="{Binding FieldName}"
                                                        Width="160"/>

                            <!-- Old Value -->
                            <telerik:GridViewDataColumn Header="Old Value (Before Change)" Width="280">
                                <telerik:GridViewDataColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="3" Padding="6,3" Margin="2">
                                            <TextBlock Text="{Binding OldValue}" Foreground="#991B1B" FontFamily="Consolas, Segoe UI"/>
                                        </Border>
                                    </DataTemplate>
                                </telerik:GridViewDataColumn.CellTemplate>
                            </telerik:GridViewDataColumn>

                            <!-- Arrow -->
                            <telerik:GridViewDataColumn Header="" Width="40">
                                <telerik:GridViewDataColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="➔" FontSize="14" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </telerik:GridViewDataColumn.CellTemplate>
                            </telerik:GridViewDataColumn>

                            <!-- New Value -->
                            <telerik:GridViewDataColumn Header="New Value (After Change)" Width="280">
                                <telerik:GridViewDataColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="3" BorderThickness="1" Padding="6,3" Margin="2">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#F0FDF4"/>
                                                    <Setter Property="BorderBrush" Value="#BBF7D0"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDeleted}" Value="True">
                                                            <Setter Property="Background" Value="#FEE2E2"/>
                                                            <Setter Property="BorderBrush" Value="#FCA5A5"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding NewValue}" FontFamily="Consolas, Segoe UI" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#166534"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsDeleted}" Value="True">
                                                                <Setter Property="Foreground" Value="#991B1B"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </telerik:GridViewDataColumn.CellTemplate>
                            </telerik:GridViewDataColumn>

                            <!-- Checked Status -->
                            <telerik:GridViewDataColumn Header="Checked" Width="90">
                                <telerik:GridViewDataColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Checked, Converter={x:Null}}" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="No"/>
                                                    <Setter Property="Foreground" Value="#D97706"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Checked}" Value="True">
                                                            <Setter Property="Text" Value="Yes"/>
                                                            <Setter Property="Foreground" Value="#16A34A"/>
                                                            <Setter Property="FontWeight" Value="Bold"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </telerik:GridViewDataColumn.CellTemplate>
                            </telerik:GridViewDataColumn>
                        </telerik:RadGridView.Columns>
                    </telerik:RadGridView>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
