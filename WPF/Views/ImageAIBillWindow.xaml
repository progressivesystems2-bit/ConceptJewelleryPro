<Window x:Class="ConceptJewelleryPro.WPF.Views.ImageAIBillWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
        Title="Image AI Bill Generator"
        Height="700" Width="1020"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI">

    <Border Background="{DynamicResource WindowBackgroundBrush}"
            BorderBrush="{DynamicResource AccentBrush}"
            BorderThickness="2"
            CornerRadius="8"
            Padding="0">
        <Border.Effect>
            <DropShadowEffect BlurRadius="25" ShadowDepth="6" Opacity="0.4" Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52" />
                <RowDefinition Height="*" />
                <RowDefinition Height="60" />
            </Grid.RowDefinitions>

            <!-- Window Header (Draggable) -->
            <Border Grid.Row="0"
                    Background="{DynamicResource HeaderBackgroundBrush}"
                    CornerRadius="6,6,0,0"
                    BorderBrush="{DynamicResource HeaderBorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="18,0"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="32" Height="32" Background="{DynamicResource PanelBrush}" CornerRadius="6" VerticalAlignment="Center" Margin="0,0,10,0">
                            <TextBlock Text="&#xEB9F;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Image AI Bill Generator" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="15" FontWeight="Bold" />
                            <TextBlock Text="Upload bill or estimate image to automatically extract and populate invoice items" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" />
                        </StackPanel>
                    </StackPanel>

                    <telerik:RadButton Content="✕"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       Background="Transparent"
                                       BorderThickness="0"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Right"
                                       Click="Cancel_Click"
                                       Cursor="Hand"
                                       Padding="6"
                                       Focusable="False" />
                </Grid>
            </Border>

            <!-- Main Content Area: Split View (Left: Upload & Preview, Right: AI Extracted Data) -->
            <Grid Grid.Row="1" Margin="14,12,14,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="420" MinWidth="340" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" MinWidth="420" />
                </Grid.ColumnDefinitions>

                <!-- LEFT PANEL: Image Upload & Preview -->
                <Border Grid.Column="0"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Upload Actions Toolbar -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                <telerik:RadButton x:Name="BrowseButton"
                                                   Content="📁 Browse Image..."
                                                   Height="34"
                                                   Padding="12,0"
                                                   Margin="0,0,6,0"
                                                   FontWeight="SemiBold"
                                                   FontSize="12"
                                                   Click="BrowseButton_Click" />
                                <telerik:RadButton x:Name="PasteButton"
                                                   Content="📋 Paste"
                                                   Height="34"
                                                   Padding="10,0"
                                                   Margin="0,0,6,0"
                                                   FontSize="12"
                                                   ToolTip="Paste image from clipboard"
                                                   Click="PasteButton_Click" />
                                <telerik:RadButton x:Name="ClearButton"
                                                   Content="🗑 Clear"
                                                   Height="34"
                                                   Padding="10,0"
                                                   FontSize="12"
                                                   IsEnabled="False"
                                                   Click="ClearButton_Click" />
                            </StackPanel>
                        </Grid>

                        <!-- Drop Zone / Image Display Area -->
                        <Border Grid.Row="1"
                                x:Name="DropZoneBorder"
                                Background="{DynamicResource PanelBrush}"
                                BorderBrush="{DynamicResource InputBorderBrush}"
                                BorderThickness="2"
                                CornerRadius="4"
                                AllowDrop="True"
                                DragEnter="DropZone_DragEnter"
                                DragLeave="DropZone_DragLeave"
                                Drop="DropZone_Drop"
                                MouseLeftButtonDown="DropZone_MouseLeftButtonDown"
                                Cursor="Hand">
                            <Grid>
                                <!-- Placeholder prompt when no image is loaded -->
                                <StackPanel x:Name="EmptyPromptPanel"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Center"
                                            Margin="16">
                                    <TextBlock Text="&#xE8B9;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="48"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               HorizontalAlignment="Center"
                                               Margin="0,0,0,10" />
                                    <TextBlock Text="Drag &amp; Drop Bill Image Here"
                                               FontSize="14"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Text="Supports PNG, JPG, JPEG, BMP, WEBP"
                                               FontSize="11.5"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               HorizontalAlignment="Center"
                                               Margin="0,4,0,8" />
                                    <TextBlock Text="or click to choose a file"
                                               FontSize="12"
                                               Foreground="{DynamicResource AccentBrush}"
                                               HorizontalAlignment="Center"
                                               TextDecorations="Underline" />
                                </StackPanel>

                                <!-- Image Preview when loaded -->
                                <ScrollViewer x:Name="ImageScrollViewer"
                                              HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollBarVisibility="Auto"
                                              Visibility="Collapsed">
                                    <Image x:Name="BillImagePreview"
                                           Stretch="Uniform"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                </ScrollViewer>
                            </Grid>
                        </Border>

                        <!-- File Info Bar -->
                        <Border Grid.Row="2"
                                Margin="0,8,0,0"
                                Background="{DynamicResource PanelBrush}"
                                Padding="8,5"
                                CornerRadius="3">
                            <TextBlock x:Name="ImageInfoTextBlock"
                                       Text="No image selected"
                                       FontSize="11"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       TextTrimming="CharacterEllipsis" />
                        </Border>
                    </Grid>
                </Border>

                <!-- Grid Splitter -->
                <GridSplitter Grid.Column="1"
                              Width="4"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Stretch"
                              Background="Transparent"
                              Cursor="SizeWE" />

                <!-- RIGHT PANEL: AI Analysis & Bill Extracted Table -->
                <Border Grid.Column="2"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="14,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- AI Processing Trigger Bar -->
                        <Border Grid.Row="0"
                                Background="{DynamicResource PanelBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="12,10"
                                Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="AI Invoice Extraction" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" />
                                    <TextBlock x:Name="AiStatusTextBlock"
                                               Text="Upload an image to start scanning bill contents"
                                               FontSize="11.5"
                                               Foreground="{DynamicResource SecondaryTextBrush}" />
                                </StackPanel>

                                <telerik:RadButton x:Name="ExtractButton"
                                                   Grid.Column="1"
                                                   Content="⚡ Extract &amp; Generate Bill"
                                                   Height="36"
                                                   Padding="14,0"
                                                   FontWeight="Bold"
                                                   FontSize="12.5"
                                                   Background="{DynamicResource AccentBrush}"
                                                   Foreground="{DynamicResource AccentTextBrush}"
                                                   IsEnabled="False"
                                                   Click="ExtractButton_Click" />
                            </Grid>
                        </Border>

                        <!-- Extracted Header Details Form -->
                        <Border Grid.Row="1"
                                Background="{DynamicResource PanelBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="10,8"
                                Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="1.5*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="1.2*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Customer Name" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,3" />
                                    <telerik:RadWatermarkTextBox x:Name="CustomerNameTextBox"
                                                                 WatermarkContent="Customer Name"
                                                                 Height="32"
                                                                 FontSize="12.5" />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Phone / Mobile" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,3" />
                                    <telerik:RadWatermarkTextBox x:Name="PhoneTextBox"
                                                                 WatermarkContent="Phone"
                                                                 Height="32"
                                                                 FontSize="12.5" />
                                </StackPanel>

                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Bill Date" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,3" />
                                    <telerik:RadDatePicker x:Name="BillDatePicker"
                                                           Height="32"
                                                           FontSize="12.5" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Extracted Bill Items DataGrid -->
                        <Grid Grid.Row="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Text="Extracted Line Items (Editable):"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       Margin="0,0,0,6" />

                            <DataGrid x:Name="ExtractedItemsGrid"
                                      Grid.Row="1"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="True"
                                      CanUserDeleteRows="True"
                                      GridLinesVisibility="All"
                                      HorizontalGridLinesBrush="{DynamicResource CardBorderBrush}"
                                      VerticalGridLinesBrush="{DynamicResource CardBorderBrush}"
                                      RowHeight="32"
                                      ColumnHeaderHeight="30"
                                      FontSize="12"
                                      Background="{DynamicResource CardBackgroundBrush}"
                                      Foreground="{DynamicResource PrimaryTextBrush}"
                                      BorderBrush="{DynamicResource CardBorderBrush}"
                                      BorderThickness="1">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Item Name" Binding="{Binding ItemName, Mode=TwoWay}" Width="*" />
                                    <DataGridTextColumn Header="Qty" Binding="{Binding Qty, Mode=TwoWay}" Width="45" />
                                    <DataGridTextColumn Header="GrWt" Binding="{Binding GrWt, Mode=TwoWay, StringFormat=N3}" Width="65" />
                                    <DataGridTextColumn Header="NtWt" Binding="{Binding NtWt, Mode=TwoWay, StringFormat=N3}" Width="65" />
                                    <DataGridTextColumn Header="Rate" Binding="{Binding Rate, Mode=TwoWay, StringFormat=N2}" Width="75" />
                                    <DataGridTextColumn Header="Making" Binding="{Binding Making, Mode=TwoWay, StringFormat=N2}" Width="65" />
                                    <DataGridTextColumn Header="Amount" Binding="{Binding Amount, Mode=TwoWay, StringFormat=N2}" Width="85" />
                                    <DataGridTextColumn Header="GST%" Binding="{Binding Tax, Mode=TwoWay, StringFormat=N2}" Width="45" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>

                        <!-- Extracted Totals Summary Bar -->
                        <Border Grid.Row="3"
                                Background="{DynamicResource PanelBrush}"
                                CornerRadius="4"
                                Padding="12,8"
                                Margin="0,8,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <TextBlock Text="Total Items: " FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" />
                                    <TextBlock x:Name="TotalItemsTextBlock" Text="0" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="Gross Wt: " FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" />
                                    <TextBlock x:Name="TotalGrWtTextBlock" Text="0.000 g" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock Text="Total Net: ₹ " FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" />
                                    <TextBlock x:Name="TotalNetAmtTextBlock" Text="0.00" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- Bottom Action Buttons Bar -->
            <Border Grid.Row="2"
                    Background="{DynamicResource HeaderBackgroundBrush}"
                    CornerRadius="0,0,6,6"
                    BorderBrush="{DynamicResource HeaderBorderBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="18,0">
                <Grid VerticalAlignment="Center">
                    <TextBlock Text="Tip: You can edit or add items in the table before populating into the invoice."
                               FontSize="11.5"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               VerticalAlignment="Center" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <telerik:RadButton Content="Cancel"
                                           Height="36"
                                           MinWidth="85"
                                           Padding="14,0"
                                           Margin="0,0,10,0"
                                           Click="Cancel_Click" />
                        <telerik:RadButton x:Name="ApplyButton"
                                           Content="✔ Populate Invoice"
                                           Height="36"
                                           MinWidth="140"
                                           Padding="16,0"
                                           FontWeight="Bold"
                                           Background="{DynamicResource AccentBrush}"
                                           Foreground="{DynamicResource AccentTextBrush}"
                                           IsEnabled="False"
                                           Click="ApplyButton_Click" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
