<Window x:Class="ConceptJewelleryPro.WPF.Views.AdvanceSelectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
        Title="Select Advance Category"
        Height="270" Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI">
    
    <Border Background="{DynamicResource CardBackgroundBrush}"
            BorderBrush="{DynamicResource AccentBrush}"
            BorderThickness="2"
            CornerRadius="8"
            Padding="0">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.35" Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="55" />
            </Grid.RowDefinitions>

            <!-- Header (Theme-Aware) -->
            <Border Grid.Row="0" Background="{DynamicResource HeaderBackgroundBrush}" CornerRadius="6,6,0,0" BorderBrush="{DynamicResource HeaderBorderBrush}" BorderThickness="0,0,0,1" Padding="16,0">
                <Grid VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE8D7;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{DynamicResource AccentBrush}" Margin="0,0,10,0" VerticalAlignment="Center" />
                        <TextBlock Text="Select Advance Category" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
                    </StackPanel>
                    <telerik:RadButton Content="✕"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       Background="Transparent"
                                       BorderThickness="0"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Right"
                                       Click="Cancel_Click"
                                       Cursor="Hand" />
                </Grid>
            </Border>

            <!-- Subheader Account Info (Theme-Aware) -->
            <Border Grid.Row="1" Background="{DynamicResource PanelBrush}" Padding="16,8" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1">
                <StackPanel>
                    <TextBlock Text="Debtors Account Detected:" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" />
                    <TextBlock x:Name="AccountNameText" Text="Customer / Debtor Account" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,2,0,0" />
                </StackPanel>
            </Border>

            <!-- ComboBox Selection Body (Theme-Aware) -->
            <Grid Grid.Row="2" Margin="16,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Advance Category / Option:"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           Margin="0,0,0,6" />

                <telerik:RadComboBox x:Name="AdvanceCategoryComboBox"
                                     Grid.Row="1"
                                     Height="42"
                                     FontSize="14"
                                     FontWeight="SemiBold"
                                     IsEditable="True"
                                     IsFilteringEnabled="True"
                                     TextSearchMode="Contains"
                                     IsTextSearchEnabled="True"
                                     OpenDropDownOnFocus="True"
                                     ClearSelectionButtonVisibility="Collapsed"
                                     KeyDown="AdvanceCategoryComboBox_KeyDown"
                                     GotFocus="AdvanceCategoryComboBox_GotFocus">
                    <telerik:RadComboBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </telerik:RadComboBox.ItemsPanel>
                </telerik:RadComboBox>
            </Grid>

            <!-- Footer (Theme-Aware) -->
            <Border Grid.Row="3" Background="{DynamicResource HeaderBackgroundBrush}" CornerRadius="0,0,6,6" BorderBrush="{DynamicResource HeaderBorderBrush}" BorderThickness="0,1,0,0" Padding="16,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <telerik:RadButton Content="Select (Enter)"
                                       Width="120"
                                       Height="40"
                                       Background="{DynamicResource AccentBrush}"
                                       Foreground="{DynamicResource AccentTextBrush}"
                                       FontWeight="Bold"
                                       Click="Select_Click"
                                       Margin="0,0,10,0"
                                       IsDefault="True" />
                    <telerik:RadButton Content="Cancel (Esc)"
                                       Width="100"
                                       Height="40"
                                       Click="Cancel_Click"
                                       IsCancel="True" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
