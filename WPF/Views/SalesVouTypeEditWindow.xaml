<Window x:Class="ConceptJewelleryPro.WPF.Views.SalesVouTypeEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
        xmlns:controls="clr-namespace:ConceptJewelleryPro.WPF.Controls"
        Title="{Binding Title}"
        Width="760"
        Height="680"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display"
        Background="{DynamicResource WindowBackgroundBrush}">

    <Window.InputBindings>
        <KeyBinding Modifiers="Alt" Key="S" Command="{Binding SaveCommand}" />
        <KeyBinding Key="F10" Command="{Binding SaveCommand}" />
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
    </Window.InputBindings>

    <Window.Resources>

        <Style TargetType="{x:Type telerik:RadWatermarkTextBox}" BasedOn="{StaticResource RadWatermarkTextBoxStyle}">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
            
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Margin" Value="0,3,0,6"/>
        </Style>

        <Style TargetType="{x:Type telerik:RadNumericUpDown}" BasedOn="{StaticResource RadNumericUpDownStyle}">
            
            <Setter Property="Margin" Value="0,3,0,6"/>
            <Setter Property="FontSize" Value="12.5"/>
        </Style>

        <Style TargetType="{x:Type telerik:RadComboBox}" BasedOn="{StaticResource RadComboBoxStyle}">
            <Setter Property="Margin" Value="0,3,0,6"/>
            <Setter Property="Padding" Value="8,0,4,0"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="Margin" Value="0,2,0,2" />
        </Style>

        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Toast Notification -->
        <controls:ToastNotification Grid.Row="0"
                                    Grid.RowSpan="3"
                                    Panel.ZIndex="99"
                                    Message="{Binding ToastMessage}"
                                    ToastType="{Binding ToastType}" />

        <!-- Header -->
        <Border Grid.Row="0"
                Background="{DynamicResource HeaderBackgroundBrush}"
                BorderBrush="{DynamicResource HeaderBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="20,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="36" Height="36" CornerRadius="8" Background="{DynamicResource PanelBrush}">
                    <TextBlock Text="&#xE8A5;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="16"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                    <TextBlock Text="Configure voucher properties, accounts, tax percentages, and default formats" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Form Body -->
        <telerik:RadBusyIndicator Grid.Row="1" IsBusy="{Binding IsBusy, Mode=OneWay}" BusyContent="Saving voucher type...">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="20,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Left Column: General & Layout Details -->
                    <StackPanel Grid.Column="0">
                        <Border Background="{DynamicResource CardBackgroundBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16,12"
                                Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Basic Identification" Style="{StaticResource SectionHeaderStyle}" />

                                <!-- VouType -->
                                <TextBlock Text="Voucher Type Name *" Style="{StaticResource FieldLabelStyle}" />
                                <telerik:RadWatermarkTextBox Text="{Binding VouType, UpdateSourceTrigger=PropertyChanged}"
                                                             WatermarkContent="e.g. TAX INVOICE GOLD, RETAIL INVOICE SILVER"
                                                             TabIndex="1" />

                                <!-- ShortName -->
                                <TextBlock Text="Short Code / Prefix (max 4 chars) *" Style="{StaticResource FieldLabelStyle}" />
                                <telerik:RadWatermarkTextBox Text="{Binding ShortName, UpdateSourceTrigger=PropertyChanged}"
                                                             MaxLength="4"
                                                             WatermarkContent="e.g. TIG, SVN, OGP"
                                                             TabIndex="2" />

                                <!-- HeadCategory -->
                                <TextBlock Text="Head Category" Style="{StaticResource FieldLabelStyle}" />
                                <telerik:RadComboBox ItemsSource="{Binding AvailableHeadCategories}"
                                                     SelectedItem="{Binding HeadCategory, UpdateSourceTrigger=PropertyChanged}"
                                                     IsEditable="True"
                                                     TabIndex="3" />

                                <!-- ItemHead -->
                                <TextBlock Text="Item Head (Filter / Default)" Style="{StaticResource FieldLabelStyle}" />
                                <telerik:RadComboBox ItemsSource="{Binding AvailableItemHeads}"
                                                     SelectedItem="{Binding ItemHead, UpdateSourceTrigger=PropertyChanged}"
                                                     IsEditable="True"
                                                     TabIndex="4" />

                                <!-- PrintFile -->
                                <TextBlock Text="Print Template File" Style="{StaticResource FieldLabelStyle}" />
                                <telerik:RadComboBox ItemsSource="{Binding AvailablePrintFiles}"
                                                     SelectedItem="{Binding PrintFile, UpdateSourceTrigger=PropertyChanged}"
                                                     IsEditable="True"
                                                     TabIndex="5" />

                                <!-- CounterNo -->
                                <TextBlock Text="Allowed Counter(s)" Style="{StaticResource FieldLabelStyle}" />
                                <telerik:RadWatermarkTextBox Text="{Binding CounterNo, UpdateSourceTrigger=PropertyChanged}"
                                                             WatermarkContent="e.g. 1, 2, ALL"
                                                             TabIndex="6" />

                                <!-- Status -->
                                <TextBlock Text="Status" Style="{StaticResource FieldLabelStyle}" />
                                <telerik:RadWatermarkTextBox Text="{Binding Status, UpdateSourceTrigger=PropertyChanged}"
                                                             WatermarkContent="e.g. Active"
                                                             TabIndex="7" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Right Column: Financial, Tax & Inventory Settings -->
                    <StackPanel Grid.Column="2">
                        <Border Background="{DynamicResource CardBackgroundBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16,12"
                                Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Accounts &amp; Tax Mapping" Style="{StaticResource SectionHeaderStyle}" />

                                <!-- SalesAccount -->
                                <TextBlock Text="Sales / Ledger Account" Style="{StaticResource FieldLabelStyle}" />
                                <telerik:RadComboBox ItemsSource="{Binding AvailableAccounts}"
                                                     SelectedItem="{Binding SalesAccount, UpdateSourceTrigger=PropertyChanged}"
                                                     IsEditable="True"
                                                     TabIndex="8" />

                                <!-- VatAccount -->
                                <TextBlock Text="VAT / GST Account" Style="{StaticResource FieldLabelStyle}" />
                                <telerik:RadComboBox ItemsSource="{Binding AvailableAccounts}"
                                                     SelectedItem="{Binding VatAccount, UpdateSourceTrigger=PropertyChanged}"
                                                     IsEditable="True"
                                                     TabIndex="9" />

                                <!-- VatPercentage -->
                                <TextBlock Text="VAT / GST Rate (%)" Style="{StaticResource FieldLabelStyle}" />
                                <telerik:RadNumericUpDown Value="{Binding VatPercentage, UpdateSourceTrigger=PropertyChanged}"
                                                          CustomUnit="%"
                                                          NumberDecimalDigits="2"
                                                          Minimum="0"
                                                          Maximum="100"
                                                          TabIndex="10" />

                                <!-- CardBank -->
                                <TextBlock Text="Card Bank Account" Style="{StaticResource FieldLabelStyle}" />
                                <telerik:RadComboBox ItemsSource="{Binding AvailableCardBanks}"
                                                     SelectedItem="{Binding CardBank, UpdateSourceTrigger=PropertyChanged}"
                                                     IsEditable="True"
                                                     TabIndex="11" />

                                <!-- CardCommission -->
                                <TextBlock Text="Card Commission (%)" Style="{StaticResource FieldLabelStyle}" />
                                <telerik:RadNumericUpDown Value="{Binding CardCommission, UpdateSourceTrigger=PropertyChanged}"
                                                          CustomUnit="%"
                                                          NumberDecimalDigits="4"
                                                          Minimum="0"
                                                          Maximum="100"
                                                          TabIndex="12" />

                                <!-- CommAc -->
                                <TextBlock Text="Commission Ledger Account" Style="{StaticResource FieldLabelStyle}" />
                                <telerik:RadComboBox ItemsSource="{Binding AvailableCommAccounts}"
                                                     SelectedItem="{Binding CommAc, UpdateSourceTrigger=PropertyChanged}"
                                                     IsEditable="True"
                                                     TabIndex="13" />
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource CardBackgroundBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16,12"
                                Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Inventory Conversions &amp; Notes" Style="{StaticResource SectionHeaderStyle}" />

                                <!-- ItemPurchased -->
                                <TextBlock Text="Item Purchased (Old/Purchase Type)" Style="{StaticResource FieldLabelStyle}" />
                                <telerik:RadComboBox ItemsSource="{Binding AvailableItemTypes}"
                                                     SelectedItem="{Binding ItemPurchased, UpdateSourceTrigger=PropertyChanged}"
                                                     IsEditable="True"
                                                     TabIndex="14" />

                                <!-- ItemConvertedTo -->
                                <TextBlock Text="Item Converted To" Style="{StaticResource FieldLabelStyle}" />
                                <telerik:RadComboBox ItemsSource="{Binding AvailableItemTypes}"
                                                     SelectedItem="{Binding ItemConvertedTo, UpdateSourceTrigger=PropertyChanged}"
                                                     IsEditable="True"
                                                     TabIndex="15" />

                                <!-- Note -->
                                <TextBlock Text="Default Invoice Note / Remarks" Style="{StaticResource FieldLabelStyle}" />
                                <telerik:RadWatermarkTextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}"
                                                             WatermarkContent="e.g. Terms of sale, declaration..."
                                                             TabIndex="16" />

                                <!-- Hide Checkbox -->
                                <CheckBox Content="Hide from selection dropdowns (Inactive)"
                                          IsChecked="{Binding Hide, UpdateSourceTrigger=PropertyChanged}"
                                          Margin="0,8,0,0"
                                          FontSize="12"
                                          TabIndex="17" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </telerik:RadBusyIndicator>

        <!-- Footer Actions -->
        <Border Grid.Row="2"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource HeaderBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="20,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <telerik:RadButton Content="Cancel (Esc)"
                                   Width="100"
                                   
                                   Margin="0,0,10,0"
                                   Command="{Binding CancelCommand}"
                                   IsTabStop="False" />
                <telerik:RadButton Content="Save (Alt+S)"
                                   Width="120"
                                   FontWeight="Bold"
                                   Style="{DynamicResource PrimaryToolbarButtonStyle}"
                                   Command="{Binding SaveCommand}"
                                   TabIndex="18"
                                   IsTabStop="True" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
