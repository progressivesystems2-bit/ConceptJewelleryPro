<UserControl x:Class="ConceptJewelleryPro.WPF.Views.UserPermissionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
             xmlns:controls="clr-namespace:ConceptJewelleryPro.WPF.Controls"
             xmlns:helpers="clr-namespace:Telerik.Windows.Controls.Theming.Helpers;assembly=Telerik.Windows.Controls"
             FontFamily="Segoe UI"
             TextOptions.TextFormattingMode="Display">

    <UserControl.Resources>
        <Style x:Key="ToolbarButtonStyle" TargetType="telerik:RadButton" BasedOn="{StaticResource RadButtonStyle}">
            <Setter Property="Height" Value="40" />
            <Setter Property="MinWidth" Value="80" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>

        <Style x:Key="AccentToolbarButtonStyle" TargetType="telerik:RadButton" BasedOn="{StaticResource ToolbarButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Toast Notifications Container -->
        <controls:ToastNotification Grid.Row="0"
                                    Grid.RowSpan="2"
                                    Panel.ZIndex="99"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    Margin="0,0,24,24"
                                    Message="{Binding ToastMessage}"
                                    ToastType="{Binding ToastType}" />

        <!-- Page Header & Action Bar -->
        <Border Grid.Row="0"
                Background="{DynamicResource HeaderBackgroundBrush}"
                BorderBrush="{DynamicResource HeaderBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="20,12">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="36" Height="36" CornerRadius="8" Background="{DynamicResource PanelBrush}">
                        <TextBlock Text="&#xE7EF;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="16"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="User Permission" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                        <TextBlock Text="Manage user accounts, roles, entry permissions and report access" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" />
                    </StackPanel>
                </StackPanel>

                <!-- Search & Actions Bar -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <telerik:RadButton Content="+ Add New"
                                       Style="{StaticResource AccentToolbarButtonStyle}"
                                       Command="{Binding AddCommand}" />

                    <telerik:RadButton Content="Edit"
                                       Style="{StaticResource ToolbarButtonStyle}"
                                       Command="{Binding EditCommand}" />

                    <telerik:RadButton Content="Delete"
                                       Style="{StaticResource ToolbarButtonStyle}"
                                       Command="{Binding DeleteCommand}" />

                    <telerik:RadButton Content="Refresh"
                                       Style="{StaticResource ToolbarButtonStyle}"
                                       Command="{Binding RefreshCommand}" />

                    <Border Width="1" Background="{DynamicResource SeparatorBrush}" Margin="4,4,12,4" />

                    <!-- Search Filter Box -->
                    <Border Width="220"
                            Height="32"
                            CornerRadius="6"
                            Background="{DynamicResource InputBackgroundBrush}"
                            BorderBrush="{DynamicResource InputBorderBrush}"
                            BorderThickness="1">
                        <Grid Margin="8,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE721;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="12"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       VerticalAlignment="Center" />
                            <telerik:RadWatermarkTextBox Grid.Column="1"
                                                         Margin="6,0,0,0"
                                                         Height="28"
                                                         VerticalAlignment="Center"
                                                         Padding="0"
                                                         Background="Transparent"
                                                         BorderThickness="0"
                                                         FontSize="12"
                                                         WatermarkContent="Search user, toolbar..."
                                                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content: RadGridView -->
        <telerik:RadBusyIndicator Grid.Row="1" IsBusy="{Binding IsBusy, Mode=OneWay}" BusyContent="Loading users...">
            <Grid Margin="20,16">
                <Border Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="0">
                    <telerik:RadGridView x:Name="UsersGrid"
                                         ItemsSource="{Binding Users}"
                                         SelectedItem="{Binding SelectedUser, Mode=TwoWay}"
                                         AutoGenerateColumns="False"
                                         IsReadOnly="True"
                                         SelectionMode="Single"
                                         CanUserInsertRows="False"
                                         CanUserDeleteRows="False"
                                         CanUserSortColumns="True"
                                         ShowGroupPanel="False"
                                         RowIndicatorVisibility="Collapsed"
                                         RowHeight="38"
                                         FontSize="13"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         MouseDoubleClick="UsersGrid_MouseDoubleClick">
                        <telerik:RadGridView.Columns>
                            <telerik:GridViewDataColumn Header="User"
                                                        DataMemberBinding="{Binding User}"
                                                        Width="200" />

                            <telerik:GridViewDataColumn Header="Password"
                                                        DataMemberBinding="{Binding Password}"
                                                        Width="160" />

                            <telerik:GridViewDataColumn Header="Toolbar Profile"
                                                        DataMemberBinding="{Binding Toolbar}"
                                                        Width="150" />

                            <telerik:GridViewDataColumn Header="Entry Permissions" Width="180">
                                <telerik:GridViewDataColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="4"
                                                Padding="8,2"
                                                Background="#E3F2FD"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding TotalGrantedEntries, StringFormat='{}{0} / 72 Active'}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="#1565C0" />
                                        </Border>
                                    </DataTemplate>
                                </telerik:GridViewDataColumn.CellTemplate>
                            </telerik:GridViewDataColumn>

                            <telerik:GridViewDataColumn Header="Report Permissions" Width="180">
                                <telerik:GridViewDataColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="4"
                                                Padding="8,2"
                                                Background="#E8F5E9"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding TotalGrantedReports, StringFormat='{}{0} / 22 Active'}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="#2E7D32" />
                                        </Border>
                                    </DataTemplate>
                                </telerik:GridViewDataColumn.CellTemplate>
                            </telerik:GridViewDataColumn>

                            <telerik:GridViewDataColumn Header="Total Access Rights" Width="*">
                                <telerik:GridViewDataColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding TotalPermissions, StringFormat='{}{0} Total Permissions'}"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   VerticalAlignment="Center" />
                                    </DataTemplate>
                                </telerik:GridViewDataColumn.CellTemplate>
                            </telerik:GridViewDataColumn>
                        </telerik:RadGridView.Columns>
                    </telerik:RadGridView>
                </Border>
            </Grid>
        </telerik:RadBusyIndicator>
    </Grid>
</UserControl>
