<UserControl x:Class="ConceptJewelleryPro.WPF.Views.HireReceiveView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
             xmlns:controls="clr-namespace:ConceptJewelleryPro.WPF.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1050"
             Background="{DynamicResource WindowBackgroundBrush}"
             FontFamily="Segoe UI">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="GreenLabelBlock" TargetType="Border">
            <Setter Property="Background" Value="#059669"/>
            <Setter Property="BorderBrush" Value="#047857"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="MinWidth" Value="140"/>
        </Style>

        <Style x:Key="GreenLabelText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="16"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <!-- Header Toolbar -->
            <RowDefinition Height="Auto"/>
            <!-- Content TabControl -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toast Notification -->
        <controls:ToastNotification x:Name="ToastNotification"
                                     Grid.RowSpan="2"
                                     Panel.ZIndex="99"
                                     Message="{Binding ToastMessage, FallbackValue=''}"
                                     ToastType="{Binding ToastType, FallbackValue=Info}"
                                     AutoCloseDelay="4000"
                                     FontSize="13"
                                     HorizontalAlignment="Right"
                                     VerticalAlignment="Top"
                                     Margin="0,16,24,0"/>

        <!-- Top Action Bar -->
        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="10,6"
                Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Action Buttons -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <telerik:RadButton x:Name="AddNewButton"
                                       Style="{StaticResource PrimaryToolbarButtonStyle}"
                                       Command="{Binding NewCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Add New (Alt+A)" VerticalAlignment="Center"/>
                        </StackPanel>
                    </telerik:RadButton>

                    <telerik:RadButton x:Name="SaveButton"
                                       Style="{StaticResource ToolbarButtonStyle}"
                                       Command="{Binding SaveCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Save (Alt+S)" VerticalAlignment="Center"/>
                        </StackPanel>
                    </telerik:RadButton>

                    <telerik:RadButton Style="{StaticResource ToolbarButtonStyle}"
                                       Command="{Binding ModifyCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Modify (Alt+M)" VerticalAlignment="Center"/>
                        </StackPanel>
                    </telerik:RadButton>

                    <telerik:RadButton Style="{StaticResource DangerToolbarButtonStyle}"
                                       Command="{Binding DeleteCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Delete (Alt+D)" VerticalAlignment="Center"/>
                        </StackPanel>
                    </telerik:RadButton>

                    <telerik:RadButton Style="{StaticResource ToolbarButtonStyle}"
                                       Command="{Binding CancelCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Cancel (Alt+C)" VerticalAlignment="Center"/>
                        </StackPanel>
                    </telerik:RadButton>

                    <telerik:RadButton Style="{StaticResource ToolbarButtonStyle}"
                                       Command="{Binding RefreshCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Refresh (F5)" VerticalAlignment="Center"/>
                        </StackPanel>
                    </telerik:RadButton>
                </StackPanel>

                <!-- Status Text -->
                <TextBlock Grid.Column="1"
                           Text="{Binding FormStatusText}"
                           FontWeight="Bold"
                           FontSize="13"
                           Foreground="{DynamicResource AccentBrush}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"/>

                <!-- User & Date Info -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="User: " Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12"/>
                    <TextBlock Text="{Binding CurrentUsername}" FontWeight="SemiBold" FontSize="12" Margin="0,0,10,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main TabControl -->
        <telerik:RadTabControl Grid.Row="1"
                               SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">
            <!-- TAB 1: HIRE RECEIVED ENTRY -->
            <telerik:RadTabItem Header="Hire Received" FontSize="13" FontWeight="SemiBold">
                <Border Style="{StaticResource CardStyle}" Margin="0,8,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="260"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: Input Form Controls -->
                        <StackPanel Grid.Column="0" IsEnabled="{Binding IsFormEnabled}" MaxWidth="650" HorizontalAlignment="Left">
                            <!-- 1. Rec Date -->
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource GreenLabelBlock}">
                                    <TextBlock Text="Receive Date:" Style="{StaticResource GreenLabelText}"/>
                                </Border>
                                <DatePicker Grid.Column="1"
                                            SelectedDate="{Binding RecDate, Mode=TwoWay}"
                                            Height="32"
                                            FontSize="14"
                                            HorizontalAlignment="Left"
                                            Width="160"/>
                            </Grid>

                            <!-- 2. Party Name -->
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource GreenLabelBlock}">
                                    <TextBlock Text="Artisian / Party:" Style="{StaticResource GreenLabelText}"/>
                                </Border>
                                <telerik:RadComboBox Grid.Column="1"
                                                     ItemsSource="{Binding Parties}"
                                                     DisplayMemberPath="AccountName"
                                                     SelectedValuePath="AccountName"
                                                     Text="{Binding PartyName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     IsEditable="True"
                                                     Height="32"
                                                     FontSize="14"
                                                     HorizontalAlignment="Stretch"/>
                            </Grid>

                            <!-- 3. ItemType -->
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource GreenLabelBlock}">
                                    <TextBlock Text="ItemType:" Style="{StaticResource GreenLabelText}"/>
                                </Border>
                                <telerik:RadComboBox Grid.Column="1"
                                                     ItemsSource="{Binding ItemTypes}"
                                                     Text="{Binding ItemType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     IsEditable="True"
                                                     Height="32"
                                                     FontSize="14"
                                                     HorizontalAlignment="Stretch"/>
                            </Grid>

                            <!-- 4. Weight Received -->
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource GreenLabelBlock}">
                                    <TextBlock Text="Weight Received:" Style="{StaticResource GreenLabelText}"/>
                                </Border>
                                <TextBox Grid.Column="1"
                                         Text="{Binding WeightRecd, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=F3}"
                                         Height="32"
                                         FontSize="14"
                                         FontWeight="Bold"
                                         HorizontalAlignment="Left"
                                         Width="160"
                                         VerticalContentAlignment="Center"
                                         Padding="6,0"/>
                            </Grid>

                            <!-- 5. Note -->
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource GreenLabelBlock}" VerticalAlignment="Top">
                                    <TextBlock Text="Note:" Style="{StaticResource GreenLabelText}"/>
                                </Border>
                                <TextBox Grid.Column="1"
                                         Text="{Binding Note, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Height="75"
                                         FontSize="13"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         HorizontalAlignment="Stretch"
                                         Padding="6"/>
                            </Grid>
                        </StackPanel>

                        <!-- Right: Voucher Number Banner -->
                        <Border Grid.Column="1"
                                VerticalAlignment="Top"
                                HorizontalAlignment="Right"
                                Margin="0,10,20,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="{Binding RecNo}"
                                           FontSize="36"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="HIRE RECEIVE VOUCHER"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           HorizontalAlignment="Center"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </telerik:RadTabItem>

            <!-- TAB 2: LIST VIEW -->
            <telerik:RadTabItem Header="List" FontSize="13" FontWeight="SemiBold">
                <Border Style="{StaticResource CardStyle}" Margin="0,8,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Search Bar -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                            <telerik:RadWatermarkTextBox Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         WatermarkContent="Search by Rec No, Party Name, ItemType, Note..."
                                                         Width="350"
                                                         Height="32"
                                                         FontSize="13"/>
                        </StackPanel>

                        <!-- List Grid -->
                        <telerik:RadGridView Grid.Row="1"
                                             ItemsSource="{Binding FilteredReceivedList}"
                                             SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                                             AutoGenerateColumns="False"
                                             CanUserSortColumns="True"
                                             RowIndicatorVisibility="Collapsed"
                                             ShowGroupPanel="False"
                                             VirtualizingPanel.IsVirtualizing="True"
                                             VirtualizingPanel.VirtualizationMode="Recycling">
                            <telerik:RadGridView.Columns>
                                <telerik:GridViewDataColumn Header="Rec No" DataMemberBinding="{Binding RecNo}" Width="120"/>
                                <telerik:GridViewDataColumn Header="Date" DataMemberBinding="{Binding RecDate, StringFormat=dd/MM/yyyy}" Width="100"/>
                                <telerik:GridViewDataColumn Header="Party Name" DataMemberBinding="{Binding PartyName}" Width="200"/>
                                <telerik:GridViewDataColumn Header="ItemType" DataMemberBinding="{Binding ItemType}" Width="130"/>
                                <telerik:GridViewDataColumn Header="Weight Recd (g)" DataMemberBinding="{Binding WeightRecd, StringFormat=N3}" Width="140" TextAlignment="Right"/>
                                <telerik:GridViewDataColumn Header="Note" DataMemberBinding="{Binding Note}" Width="*"/>
                                <telerik:GridViewDataColumn Header="Status" DataMemberBinding="{Binding Status}" Width="90"/>
                            </telerik:RadGridView.Columns>
                        </telerik:RadGridView>
                    </Grid>
                </Border>
            </telerik:RadTabItem>
        </telerik:RadTabControl>
    </Grid>
</UserControl>
