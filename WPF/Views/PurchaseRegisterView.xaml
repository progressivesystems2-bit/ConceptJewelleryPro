<UserControl x:Class="ConceptJewelleryPro.WPF.Views.PurchaseRegisterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
             xmlns:vm="clr-namespace:ConceptJewelleryPro.WPF.ViewModels"
             xmlns:conv="clr-namespace:ConceptJewelleryPro.WPF.Converters"
             FontFamily="Segoe UI"
             TextOptions.TextFormattingMode="Display"
             Background="{DynamicResource WindowBackgroundBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:EqualityToBoolConverter x:Key="EqualityToBoolConverter" />

        <!-- Header Filter Label -->
        <Style x:Key="FilterLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>

        <!-- Summary Label -->
        <Style x:Key="SummaryLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>

        <!-- Summary Total Box -->
        <Style x:Key="SummaryTotalBoxStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="MinHeight" Value="32" />
        </Style>

        <!-- Radio Button Style -->
        <Style x:Key="PrintOptionRadioStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Margin" Value="6,3" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <!-- Standard Toolbar Button -->
        <Style x:Key="WindowButtonStyle" TargetType="telerik:RadButton" BasedOn="{StaticResource RadButtonStyle}">
            <Setter Property="Height" Value="38" />
            <Setter Property="MinWidth" Value="85" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>

        <!-- Pager Nav Button -->
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <!-- Subsheet Plus/Minus Expander Toggle Style -->
        <Style x:Key="SubsheetExpanderToggleStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Background" Value="#3B82F6" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Width="{TemplateBinding Width}"
                                Height="{TemplateBinding Height}"
                                SnapsToDevicePixels="True">
                            <Path x:Name="iconPath"
                                  Data="M 4 8 L 12 8 M 8 4 L 8 12"
                                  Stroke="{TemplateBinding Foreground}"
                                  StrokeThickness="2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="iconPath" Property="Data" Value="M 4 8 L 12 8" />
                                <Setter TargetName="border" Property="Background" Value="#EF4444" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.85" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- 0: Top Filter Header -->
            <RowDefinition Height="*" />    <!-- 1: Main Grid with Master/Detail -->
            <RowDefinition Height="Auto" /> <!-- 2: Record Navigator -->
            <RowDefinition Height="Auto" /> <!-- 3: Summary Totals & Print Options -->
        </Grid.RowDefinitions>

        <!-- ================= 0: TOP FILTER HEADER ================= -->
        <Border Grid.Row="0"
                Background="{DynamicResource HeaderBackgroundBrush}"
                BorderBrush="{DynamicResource HeaderBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Filters -->
                <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- From Date -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,14,0" VerticalAlignment="Center">
                        <TextBlock Text="From Date:" Style="{StaticResource FilterLabelStyle}" />
                        <telerik:RadDatePicker SelectedDate="{Binding FromDate, Mode=TwoWay}"
                                               InputMode="DatePicker"
                                               Width="125"
                                               Height="36"
                                               FontSize="13" />
                    </StackPanel>

                    <!-- To Date -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,14,0" VerticalAlignment="Center">
                        <TextBlock Text="To Date:" Style="{StaticResource FilterLabelStyle}" />
                        <telerik:RadDatePicker SelectedDate="{Binding ToDate, Mode=TwoWay}"
                                               InputMode="DatePicker"
                                               Width="125"
                                               Height="36"
                                               FontSize="13" />
                    </StackPanel>

                    <!-- Item Type -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,14,0" VerticalAlignment="Center">
                        <TextBlock Text="Item Type:" Style="{StaticResource FilterLabelStyle}" />
                        <telerik:RadComboBox ItemsSource="{Binding AvailableItemTypes}"
                                             SelectedItem="{Binding SelectedItemType, Mode=TwoWay}"
                                             Width="175"
                                             Height="36"
                                             FontSize="12.5"
                                             IsEditable="False" />
                    </StackPanel>

                    <!-- Voucher Type -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,14,0" VerticalAlignment="Center">
                        <TextBlock Text="Vou Type:" Style="{StaticResource FilterLabelStyle}" />
                        <telerik:RadComboBox ItemsSource="{Binding AvailableVouTypes}"
                                             SelectedItem="{Binding SelectedVouType, Mode=TwoWay}"
                                             Width="150"
                                             Height="36"
                                             FontSize="12.5"
                                             IsEditable="False" />
                    </StackPanel>

                    <!-- Quick Search Text -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,10,0" VerticalAlignment="Center">
                        <TextBlock Text="Search:" Style="{StaticResource FilterLabelStyle}" />
                        <telerik:RadWatermarkTextBox Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     WatermarkContent="Search pur no, supplier, phone, item..."
                                                     Width="210"
                                                     Height="36"
                                                     FontSize="12.5"
                                                     Padding="6,0" />
                    </StackPanel>
                </WrapPanel>

                <!-- Actions -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <telerik:RadButton Content="Expand/Collapse All"
                                       Style="{StaticResource WindowButtonStyle}"
                                       Command="{Binding ToggleExpandAllCommand}"
                                       ToolTip="Expand or collapse line item subsheets for all purchases" />
                    <telerik:RadButton Content="Refresh"
                                       Style="{StaticResource WindowButtonStyle}"
                                       Command="{Binding RefreshCommand}"
                                       ToolTip="Reload purchases from database" />
                    <telerik:RadButton Content="Export CSV"
                                       Style="{StaticResource WindowButtonStyle}"
                                       Command="{Binding ExportExcelCommand}"
                                       ToolTip="Export filtered purchase register to CSV file" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= 1: MAIN PURCHASE GRID ================= -->
        <telerik:RadBusyIndicator Grid.Row="1"
                                  IsBusy="{Binding IsBusy}"
                                  BusyContent="Loading Purchase Register...">
            <DataGrid x:Name="PurchasesDataGrid"
                      ItemsSource="{Binding Purchases}"
                      SelectedItem="{Binding SelectedPurchase, Mode=TwoWay}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      GridLinesVisibility="All"
                      HorizontalGridLinesBrush="{DynamicResource CardBorderBrush}"
                      VerticalGridLinesBrush="{DynamicResource CardBorderBrush}"
                      Background="{DynamicResource CardBackgroundBrush}"
                      Foreground="{DynamicResource PrimaryTextBrush}"
                      BorderThickness="0"
                      RowHeight="34"
                      ColumnHeaderHeight="32"
                      FontSize="12.5"
                      FontFamily="Segoe UI"
                      MouseDoubleClick="PurchasesDataGrid_MouseDoubleClick">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
                        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                        <Setter Property="DetailsVisibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                <Setter Property="DetailsVisibility" Value="Visible" />
                            </DataTrigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>

                <!-- Subsheet Row Details -->
                <DataGrid.RowDetailsTemplate>
                    <DataTemplate>
                        <Border Background="#F8FAFC"
                                BorderBrush="#2563EB"
                                BorderThickness="3,1,1,1"
                                CornerRadius="0,4,4,4"
                                Margin="28,4,8,8"
                                Padding="10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!-- Subsheet Header Bar -->
                                <Grid Grid.Row="0" Margin="0,0,0,6">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="📦 Purchase Line Items (" FontWeight="Bold" Foreground="#1E293B" FontSize="12.5" />
                                        <TextBlock Text="{Binding ItemsCount}" FontWeight="Bold" Foreground="#2563EB" FontSize="12.5" />
                                        <TextBlock Text=" item(s)) — Pur No: " FontWeight="Bold" Foreground="#1E293B" FontSize="12.5" />
                                        <TextBlock Text="{Binding VouNo}" FontWeight="Bold" Foreground="#2563EB" FontSize="12.5" />
                                        <TextBlock Text=" | Supp Bill: " Foreground="#64748B" FontSize="12" Margin="8,0,0,0" />
                                        <TextBlock Text="{Binding SuppBillNo}" FontWeight="SemiBold" Foreground="#1E293B" FontSize="12" />
                                        <TextBlock Text=" | Date: " Foreground="#64748B" FontSize="12" Margin="8,0,0,0" />
                                        <TextBlock Text="{Binding BillDate, StringFormat='dd/MM/yyyy'}" FontWeight="SemiBold" Foreground="#1E293B" FontSize="12" />
                                    </StackPanel>
                                </Grid>

                                <!-- Subsheet Line Items DataGrid -->
                                <DataGrid Grid.Row="1"
                                          ItemsSource="{Binding Items}"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          IsReadOnly="True"
                                          HeadersVisibility="Column"
                                          GridLinesVisibility="All"
                                          HorizontalGridLinesBrush="#E2E8F0"
                                          VerticalGridLinesBrush="#E2E8F0"
                                          Background="White"
                                          Foreground="#1E293B"
                                          BorderBrush="#CBD5E1"
                                          BorderThickness="1"
                                          RowHeight="28"
                                          ColumnHeaderHeight="26"
                                          FontSize="12">
                                    <DataGrid.ColumnHeaderStyle>
                                        <Style TargetType="DataGridColumnHeader">
                                            <Setter Property="Background" Value="#E2E8F0" />
                                            <Setter Property="Foreground" Value="#334155" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                            <Setter Property="Padding" Value="6,2" />
                                            <Setter Property="BorderThickness" Value="0,0,1,1" />
                                            <Setter Property="BorderBrush" Value="#CBD5E1" />
                                        </Style>
                                    </DataGrid.ColumnHeaderStyle>
                                    <DataGrid.Columns>
                                        <!-- Barcode -->
                                        <DataGridTextColumn Header="Barcode" Binding="{Binding Barcode}" Width="90" />

                                        <!-- Item Name -->
                                        <DataGridTextColumn Header="Item Name" Binding="{Binding ItemName}" Width="160" FontWeight="SemiBold" />

                                        <!-- Purity -->
                                        <DataGridTextColumn Header="Purity" Binding="{Binding Purity}" Width="75">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="HorizontalAlignment" Value="Center" />
                                                    <Setter Property="VerticalAlignment" Value="Center" />
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>

                                        <!-- HSN -->
                                        <DataGridTextColumn Header="HSN" Binding="{Binding HSN}" Width="75" />

                                        <!-- Qty -->
                                        <DataGridTextColumn Header="Qty" Binding="{Binding Qty, StringFormat='N0'}" Width="50">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                                    <Setter Property="VerticalAlignment" Value="Center" />
                                                    <Setter Property="Padding" Value="0,0,4,0" />
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>

                                        <!-- Gross Wt -->
                                        <DataGridTextColumn Header="Gr Wt (g)" Binding="{Binding GrWt, StringFormat='N3'}" Width="80">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                                    <Setter Property="VerticalAlignment" Value="Center" />
                                                    <Setter Property="Padding" Value="0,0,4,0" />
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>

                                        <!-- Net Wt -->
                                        <DataGridTextColumn Header="Net Wt (g)" Binding="{Binding NtWt, StringFormat='N3'}" Width="80">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                                    <Setter Property="VerticalAlignment" Value="Center" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                    <Setter Property="Padding" Value="0,0,4,0" />
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>

                                        <!-- Rate / Gr -->
                                        <DataGridTextColumn Header="Rate/Gr" Binding="{Binding Rate, StringFormat='N2'}" Width="85">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                                    <Setter Property="VerticalAlignment" Value="Center" />
                                                    <Setter Property="Padding" Value="0,0,4,0" />
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>

                                        <!-- Amount -->
                                        <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat='N2'}" Width="95">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                                    <Setter Property="VerticalAlignment" Value="Center" />
                                                    <Setter Property="Padding" Value="0,0,4,0" />
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>

                                        <!-- Taxable Amount -->
                                        <DataGridTextColumn Header="Taxable Amt" Binding="{Binding TaxableAmount, StringFormat='N2'}" Width="95">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                                    <Setter Property="VerticalAlignment" Value="Center" />
                                                    <Setter Property="Padding" Value="0,0,4,0" />
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>

                                        <!-- GST % -->
                                        <DataGridTextColumn Header="GST %" Binding="{Binding GstPer, StringFormat='N2'}" Width="55">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                                    <Setter Property="VerticalAlignment" Value="Center" />
                                                    <Setter Property="Padding" Value="0,0,4,0" />
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>

                                        <!-- GST Amt -->
                                        <DataGridTextColumn Header="GST Amt" Binding="{Binding GstAmt, StringFormat='N2'}" Width="80">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                                    <Setter Property="VerticalAlignment" Value="Center" />
                                                    <Setter Property="Padding" Value="0,0,4,0" />
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>

                                        <!-- Total Amt -->
                                        <DataGridTextColumn Header="Total Amt" Binding="{Binding TotalAmt, StringFormat='N2'}" Width="105">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                                    <Setter Property="VerticalAlignment" Value="Center" />
                                                    <Setter Property="FontWeight" Value="Bold" />
                                                    <Setter Property="Foreground" Value="#1D4ED8" />
                                                    <Setter Property="Padding" Value="0,0,4,0" />
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </DataGrid.RowDetailsTemplate>

                <!-- Grid Columns -->
                <DataGrid.Columns>
                    <!-- Expand Toggle Column -->
                    <DataGridTemplateColumn Width="36">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ToggleButton IsChecked="{Binding IsExpanded, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              Style="{StaticResource SubsheetExpanderToggleStyle}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              ToolTip="Expand/Collapse Items Subsheet" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Date -->
                    <DataGridTextColumn Header="Date" Binding="{Binding BillDate, StringFormat='dd/MM/yyyy'}" Width="85" />

                    <!-- Pur No -->
                    <DataGridTextColumn Header="Pur No" Binding="{Binding VouNo}" Width="95" FontWeight="SemiBold" />

                    <!-- Supp Bill No -->
                    <DataGridTextColumn Header="Supp Bill No" Binding="{Binding SuppBillNo}" Width="105" />

                    <!-- Vou Type -->
                    <DataGridTextColumn Header="Vou Type" Binding="{Binding VouType}" Width="100" />

                    <!-- Supplier / Party Name -->
                    <DataGridTextColumn Header="Supplier / Party" Binding="{Binding PartyDisplayName}" Width="170" FontWeight="SemiBold" />

                    <!-- Phone -->
                    <DataGridTextColumn Header="Phone" Binding="{Binding Phone}" Width="95" />

                    <!-- City -->
                    <DataGridTextColumn Header="City" Binding="{Binding City}" Width="90" />

                    <!-- GSTIN / PAN / Aadhaar -->
                    <DataGridTextColumn Header="GSTIN / ID" Binding="{Binding VatNo}" Width="120" />

                    <!-- Total Qty -->
                    <DataGridTextColumn Header="Qty" Binding="{Binding TotalQty, StringFormat='N0'}" Width="50">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="Padding" Value="0,0,4,0" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Gr Wt -->
                    <DataGridTextColumn Header="Gr Wt" Binding="{Binding GrWt, StringFormat='N3'}" Width="75">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="Padding" Value="0,0,4,0" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Net Wt -->
                    <DataGridTextColumn Header="Net Wt" Binding="{Binding NtWt, StringFormat='N3'}" Width="75">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="Padding" Value="0,0,4,0" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Taxable Amount -->
                    <DataGridTextColumn Header="Taxable Amt" Binding="{Binding TaxableAmount, StringFormat='N2'}" Width="100">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="Padding" Value="0,0,4,0" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- IGST -->
                    <DataGridTextColumn Header="IGST" Binding="{Binding IGSTAmt, StringFormat='N2'}" Width="70">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="Padding" Value="0,0,4,0" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- CGST -->
                    <DataGridTextColumn Header="CGST" Binding="{Binding CGSTAmt, StringFormat='N2'}" Width="70">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="Padding" Value="0,0,4,0" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- SGST -->
                    <DataGridTextColumn Header="SGST" Binding="{Binding SGSTAmt, StringFormat='N2'}" Width="70">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="Padding" Value="0,0,4,0" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Total GST -->
                    <DataGridTextColumn Header="GST Amt" Binding="{Binding TaxAmt, StringFormat='N2'}" Width="80">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="Padding" Value="0,0,4,0" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Net Amount -->
                    <DataGridTextColumn Header="Net Amount" Binding="{Binding NetAmt, StringFormat='N2'}" Width="110">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="FontWeight" Value="Bold" />
                                <Setter Property="Foreground" Value="#1D4ED8" />
                                <Setter Property="Padding" Value="0,0,4,0" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Status -->
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="70" />
                </DataGrid.Columns>
            </DataGrid>
        </telerik:RadBusyIndicator>

        <!-- ================= 2: RECORD NAVIGATOR ================= -->
        <Border Grid.Row="2"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="0,1,0,1"
                Padding="10,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left Pager -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="⏮" Style="{StaticResource NavButtonStyle}" Command="{Binding FirstRecordCommand}" ToolTip="First Record" />
                    <Button Content="◀" Style="{StaticResource NavButtonStyle}" Command="{Binding PrevRecordCommand}" ToolTip="Previous Record" />

                    <TextBlock Text="Record" VerticalAlignment="Center" Margin="6,0,4,0" FontSize="11.5" Foreground="{DynamicResource SecondaryTextBrush}" />
                    <TextBox Text="{Binding SelectedRecordIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Width="45"
                             Height="24"
                             TextAlignment="Center"
                             FontSize="12"
                             FontWeight="SemiBold"
                             VerticalContentAlignment="Center"
                             Background="{DynamicResource InputBackgroundBrush}"
                             Foreground="{DynamicResource PrimaryTextBrush}"
                             BorderBrush="{DynamicResource InputBorderBrush}"
                             BorderThickness="1" />
                    <TextBlock Text=" of " VerticalAlignment="Center" Margin="4,0,2,0" FontSize="11.5" Foreground="{DynamicResource SecondaryTextBrush}" />
                    <TextBlock Text="{Binding TotalPurchases}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12" Foreground="{DynamicResource PrimaryTextBrush}" />

                    <Button Content="▶" Style="{StaticResource NavButtonStyle}" Command="{Binding NextRecordCommand}" ToolTip="Next Record" />
                    <Button Content="⏭" Style="{StaticResource NavButtonStyle}" Command="{Binding LastRecordCommand}" ToolTip="Last Record" />
                </StackPanel>

                <!-- Center Status Info -->
                <TextBlock Grid.Column="1"
                           Text="{Binding StatusMessage}"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           FontSize="11.5"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />

                <!-- Right Error or Warning -->
                <TextBlock Grid.Column="2"
                           Text="{Binding ErrorMessage}"
                           Foreground="#EF4444"
                           FontWeight="SemiBold"
                           FontSize="11.5"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- ================= 3: SUMMARY TOTALS & PRINT OPTIONS ================= -->
        <Border Grid.Row="3"
                Background="{DynamicResource HeaderBackgroundBrush}"
                BorderBrush="{DynamicResource HeaderBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="12,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Row 0: Summary Metric Cards -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Total Purchases -->
                    <Border Grid.Column="0" Style="{StaticResource SummaryTotalBoxStyle}" Margin="0,0,4,0">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="Total Purchases" Style="{StaticResource SummaryLabelStyle}" />
                            <TextBlock Text="{Binding TotalPurchases, StringFormat='N0'}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource PrimaryTextBrush}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Total Qty -->
                    <Border Grid.Column="1" Style="{StaticResource SummaryTotalBoxStyle}" Margin="2,0,4,0">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="Total Qty" Style="{StaticResource SummaryLabelStyle}" />
                            <TextBlock Text="{Binding TotalQty, StringFormat='N0'}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource PrimaryTextBrush}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Total Net Wt -->
                    <Border Grid.Column="2" Style="{StaticResource SummaryTotalBoxStyle}" Margin="2,0,4,0">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="Total Net Wt (g)" Style="{StaticResource SummaryLabelStyle}" />
                            <TextBlock Text="{Binding TotalNetWeight, StringFormat='N3'}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource PrimaryTextBrush}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Total Gross Wt -->
                    <Border Grid.Column="3" Style="{StaticResource SummaryTotalBoxStyle}" Margin="2,0,4,0">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="Total Gross Wt (g)" Style="{StaticResource SummaryLabelStyle}" />
                            <TextBlock Text="{Binding TotalGrossWeight, StringFormat='N3'}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource PrimaryTextBrush}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Total Taxable Amount -->
                    <Border Grid.Column="4" Style="{StaticResource SummaryTotalBoxStyle}" Margin="2,0,4,0">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="Taxable Amount" Style="{StaticResource SummaryLabelStyle}" />
                            <TextBlock Text="{Binding TotalTaxableAmount, StringFormat='₹ {0:N2}'}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource PrimaryTextBrush}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Total IGST -->
                    <Border Grid.Column="5" Style="{StaticResource SummaryTotalBoxStyle}" Margin="2,0,4,0">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="Total IGST" Style="{StaticResource SummaryLabelStyle}" />
                            <TextBlock Text="{Binding TotalIGST, StringFormat='₹ {0:N2}'}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource PrimaryTextBrush}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Total GST -->
                    <Border Grid.Column="6" Style="{StaticResource SummaryTotalBoxStyle}" Margin="2,0,4,0">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="Total GST Amount" Style="{StaticResource SummaryLabelStyle}" />
                            <TextBlock Text="{Binding TotalTaxAmount, StringFormat='₹ {0:N2}'}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource PrimaryTextBrush}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Total Net Amount -->
                    <Border Grid.Column="7" Style="{StaticResource SummaryTotalBoxStyle}" Margin="2,0,0,0" Background="#EFF6FF" BorderBrush="#3B82F6">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="Net Amount" Style="{StaticResource SummaryLabelStyle}" Foreground="#1D4ED8" />
                            <TextBlock Text="{Binding TotalNetAmount, StringFormat='₹ {0:N2}'}" FontWeight="Bold" FontSize="14" Foreground="#1D4ED8" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Row 1: Print Options & Final Actions -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Print Options Selector -->
                    <GroupBox Grid.Column="0"
                              Header="Print Options"
                              Foreground="{DynamicResource PrimaryTextBrush}"
                              BorderBrush="{DynamicResource CardBorderBrush}"
                              BorderThickness="1"
                              Padding="8,4"
                              Margin="0,0,12,0">
                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <RadioButton Content="1. Itemwise Print Detailed"
                                         Style="{StaticResource PrintOptionRadioStyle}"
                                         IsChecked="{Binding SelectedPrintOption, Converter={StaticResource EqualityToBoolConverter}, ConverterParameter='ItemwiseDetailedPrint'}"
                                         FontWeight="Bold"
                                         Foreground="#2563EB" />
                            <RadioButton Content="2. ItemWise Summary"
                                         Style="{StaticResource PrintOptionRadioStyle}"
                                         IsChecked="{Binding SelectedPrintOption, Converter={StaticResource EqualityToBoolConverter}, ConverterParameter='ItemWiseSummary'}"
                                         FontWeight="Bold"
                                         Foreground="#2563EB" />
                            <RadioButton Content="3. Day Wise Register"
                                         Style="{StaticResource PrintOptionRadioStyle}"
                                         IsChecked="{Binding SelectedPrintOption, Converter={StaticResource EqualityToBoolConverter}, ConverterParameter='DayWisePrint'}" />
                            <RadioButton Content="4. Party Wise Register"
                                         Style="{StaticResource PrintOptionRadioStyle}"
                                         IsChecked="{Binding SelectedPrintOption, Converter={StaticResource EqualityToBoolConverter}, ConverterParameter='PartyWisePrint'}" />
                        </WrapPanel>
                    </GroupBox>

                    <!-- Actions -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <telerik:RadButton Content="Print (Alt+P)"
                                           Style="{StaticResource PrimaryToolbarButtonStyle}"
                                           MinWidth="110"
                                           Height="42"
                                           FontWeight="Bold"
                                           Command="{Binding PrintReportCommand}"
                                           ToolTip="Generate and view FlowDocument print preview" />
                        <telerik:RadButton Content="Close (Esc)"
                                           Style="{StaticResource WindowButtonStyle}"
                                           MinWidth="90"
                                           Height="42"
                                           Command="{Binding CloseCommand}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
