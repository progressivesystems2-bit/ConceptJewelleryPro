<Window x:Class="ConceptJewelleryPro.WPF.Views.PurityEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
        xmlns:controls="clr-namespace:ConceptJewelleryPro.WPF.Controls"
        Title="{Binding Title}"
        Width="500"
        Height="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display"
        Background="{DynamicResource WindowBackgroundBrush}">

    <Window.InputBindings>
        <KeyBinding Modifiers="Alt" Key="S" Command="{Binding SaveCommand}" />
        <KeyBinding Key="F10" Command="{Binding SaveCommand}" />
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
    </Window.InputBindings>

    <Window.Resources>

        <Style TargetType="{x:Type telerik:RadWatermarkTextBox}" BasedOn="{StaticResource RadWatermarkTextBoxStyle}">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,4"/>
        </Style>

        <Style TargetType="{x:Type telerik:RadNumericUpDown}" BasedOn="{StaticResource RadNumericUpDownStyle}">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="0,4"/>
        </Style>

        <Style TargetType="{x:Type telerik:RadComboBox}" BasedOn="{StaticResource RadComboBoxStyle}">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="Padding" Value="8,0,4,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Toast Notification -->
        <controls:ToastNotification Grid.Row="0"
                                    Grid.RowSpan="3"
                                    Panel.ZIndex="99"
                                    Message="{Binding ToastMessage}"
                                    ToastType="{Binding ToastType}" />

        <!-- Header -->
        <Border Grid.Row="0"
                Background="{DynamicResource HeaderBackgroundBrush}"
                BorderBrush="{DynamicResource HeaderBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="20,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="36" Height="36" CornerRadius="8" Background="{DynamicResource PanelBrush}">
                    <TextBlock Text="&#xE790;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="16"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                    <TextBlock Text="Configure purity name, rate per gram, item head and type" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Form Body -->
        <telerik:RadBusyIndicator Grid.Row="1" IsBusy="{Binding IsBusy, Mode=OneWay}" BusyContent="Saving...">
            <Border Margin="20,16"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Purity -->
                    <TextBlock Grid.Row="0" Text="Purity *" Style="{StaticResource FieldLabelStyle}" />
                    <telerik:RadWatermarkTextBox x:Name="PurityTextBox"
                                                 Grid.Row="0"
                                                 Grid.Column="1"
                                                 Text="{Binding Purity, UpdateSourceTrigger=PropertyChanged}"
                                                 WatermarkContent="Enter purity (e.g. 916, 22/20, 18ct)"
                                                 TabIndex="1" />

                    <!-- Rate / Gram -->
                    <TextBlock Grid.Row="1" Text="Rate / Gram" Style="{StaticResource FieldLabelStyle}" />
                    <telerik:RadNumericUpDown Grid.Row="1"
                                              Grid.Column="1"
                                              Value="{Binding RatePerGram, UpdateSourceTrigger=PropertyChanged}"
                                              CustomUnit="₹"
                                              NumberDecimalDigits="2"
                                              Minimum="0"
                                              Maximum="1000000"
                                              TabIndex="2" />

                    <!-- Item Head (Limit to list from Db.ItemHead) -->
                    <TextBlock Grid.Row="2" Text="Item Head" Style="{StaticResource FieldLabelStyle}" />
                    <telerik:RadComboBox Grid.Row="2"
                                         Grid.Column="1"
                                         ItemsSource="{Binding AvailableItemHeads}"
                                         SelectedItem="{Binding ItemHead, UpdateSourceTrigger=PropertyChanged}"
                                         IsEditable="False"
                                         TabIndex="3" />

                    <!-- Item Type (Limit to list from Db.ItemType) -->
                    <TextBlock Grid.Row="3" Text="Item Type" Style="{StaticResource FieldLabelStyle}" />
                    <telerik:RadComboBox Grid.Row="3"
                                         Grid.Column="1"
                                         ItemsSource="{Binding AvailableItemTypes}"
                                         SelectedItem="{Binding ItemType, UpdateSourceTrigger=PropertyChanged}"
                                         IsEditable="False"
                                         TabIndex="4" />

                    <!-- Hide / Inactive -->
                    <TextBlock Grid.Row="4" Text="Options" Style="{StaticResource FieldLabelStyle}" />
                    <CheckBox Grid.Row="4"
                              Grid.Column="1"
                              Content="Hide from selections"
                              IsChecked="{Binding Hide, UpdateSourceTrigger=PropertyChanged}"
                              VerticalAlignment="Center"
                              Margin="0,8"
                              TabIndex="5" />
                </Grid>
            </Border>
        </telerik:RadBusyIndicator>

        <!-- Footer Actions -->
        <Border Grid.Row="2"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource HeaderBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="20,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <telerik:RadButton Content="Cancel"
                                   Width="90"
                                   Height="40"
                                   Margin="0,0,10,0"
                                   Command="{Binding CancelCommand}"
                                   IsTabStop="False" />
                <telerik:RadButton Content="Save (Alt+S)"
                                   Width="120"
                                   Height="40"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   Background="CadetBlue"
                                   Command="{Binding SaveCommand}"
                                   TabIndex="6"
                                   IsTabStop="True" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
