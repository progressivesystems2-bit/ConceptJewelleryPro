<UserControl x:Class="ConceptJewelleryPro.WPF.Views.KarigharIssueView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
             xmlns:controls="clr-namespace:ConceptJewelleryPro.WPF.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1050"
             Background="{DynamicResource WindowBackgroundBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="YellowLabelBlock" TargetType="Border">
            <Setter Property="Background" Value="#FFF9C4"/>
            <Setter Property="BorderBrush" Value="#FBC02D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="MinWidth" Value="125"/>
        </Style>

        <Style x:Key="YellowLabelText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#5D4037"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <!-- Header Toolbar -->
            <RowDefinition Height="Auto"/>
            <!-- Content TabControl -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Action Bar -->
        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="10,6"
                Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Action Buttons -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <telerik:RadButton x:Name="AddNewButton"
                                       Style="{StaticResource PrimaryToolbarButtonStyle}"
                                       Command="{Binding NewCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Add New (Alt+A)" VerticalAlignment="Center"/>
                        </StackPanel>
                    </telerik:RadButton>

                    <telerik:RadButton x:Name="SaveButton"
                                       Style="{StaticResource ToolbarButtonStyle}"
                                       Command="{Binding SaveCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Save (Alt+S)" VerticalAlignment="Center"/>
                        </StackPanel>
                    </telerik:RadButton>

                    <telerik:RadButton Style="{StaticResource ToolbarButtonStyle}"
                                       Command="{Binding ModifyCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Modify (Alt+M)" VerticalAlignment="Center"/>
                        </StackPanel>
                    </telerik:RadButton>

                    <telerik:RadButton Style="{StaticResource DangerToolbarButtonStyle}"
                                       Command="{Binding DeleteCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Delete (Alt+D)" VerticalAlignment="Center"/>
                        </StackPanel>
                    </telerik:RadButton>

                    <telerik:RadButton Style="{StaticResource ToolbarButtonStyle}"
                                       Command="{Binding CancelCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Cancel (Alt+C)" VerticalAlignment="Center"/>
                        </StackPanel>
                    </telerik:RadButton>

                    <telerik:RadButton Style="{StaticResource ToolbarButtonStyle}"
                                       Command="{Binding RefreshCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Refresh" VerticalAlignment="Center"/>
                        </StackPanel>
                    </telerik:RadButton>
                </StackPanel>

                <!-- Document Badge -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#FFFDE7" BorderBrush="#FBC02D" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,8,0">
                        <TextBlock Text="{Binding IssueNo, StringFormat='Issue No: {0}'}" FontWeight="Bold" FontSize="13" Foreground="#E65100"/>
                    </Border>
                    <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8,4">
                        <TextBlock Text="{Binding FormMode, StringFormat='Mode: {0}'}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource PrimaryTextBrush}"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Tabbed Container: Metal Issued & List -->
        <telerik:RadTabControl Grid.Row="1"
                               SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">
            <!-- Tab 1: Metal Issued Entry Form -->
            <telerik:RadTabItem Header="Metal Issued" FontSize="13" FontWeight="SemiBold">
                <Border Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1,0,1,1"
                        Padding="24">
                    <Grid MaxWidth="750" HorizontalAlignment="Left" VerticalAlignment="Top">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- 1. Issue Date -->
                        <Grid Grid.Row="0" Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="420"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource YellowLabelBlock}">
                                <TextBlock Text="Issue Date:" Style="{StaticResource YellowLabelText}"/>
                            </Border>
                            <telerik:RadDatePicker Grid.Column="1"
                                                   SelectedDate="{Binding IssueDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                   IsEnabled="{Binding IsFormEnabled}"
                                                   VerticalContentAlignment="Center"
                                                   Height="36"
                                                   TabIndex="1"/>
                        </Grid>

                        <!-- 2. Artisian Name -->
                        <Grid Grid.Row="1" Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="420"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource YellowLabelBlock}">
                                <TextBlock Text="Artisian Name:" Style="{StaticResource YellowLabelText}"/>
                            </Border>
                            <telerik:RadComboBox x:Name="ArtisianNameComboBox"
                                                 Grid.Column="1"
                                                 ItemsSource="{Binding Artisans}"
                                                 DisplayMemberPath="AccountName"
                                                 SelectedValuePath="AccountName"
                                                 SelectedValue="{Binding ArtisianName, Mode=TwoWay}"
                                                 Text="{Binding ArtisianName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 IsEditable="True"
                                                 IsEnabled="{Binding IsFormEnabled}"
                                                 Height="36"
                                                 TabIndex="2"/>
                        </Grid>

                        <!-- 3. ItemType -->
                        <Grid Grid.Row="2" Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="420"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource YellowLabelBlock}">
                                <TextBlock Text="ItemType:" Style="{StaticResource YellowLabelText}"/>
                            </Border>
                            <telerik:RadComboBox Grid.Column="1"
                                                 ItemsSource="{Binding ItemTypes}"
                                                 SelectedItem="{Binding ItemType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 Text="{Binding ItemType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 IsEditable="True"
                                                 IsEnabled="{Binding IsFormEnabled}"
                                                 Height="36"
                                                 TabIndex="3"/>
                        </Grid>

                        <!-- 4. Purity -->
                        <Grid Grid.Row="3" Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="420"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource YellowLabelBlock}">
                                <TextBlock Text="Purity:" Style="{StaticResource YellowLabelText}"/>
                            </Border>
                            <telerik:RadComboBox Grid.Column="1"
                                                 ItemsSource="{Binding Purities}"
                                                 DisplayMemberPath="Purity"
                                                 SelectedValuePath="Purity"
                                                 SelectedValue="{Binding Purity, Mode=TwoWay}"
                                                 Text="{Binding Purity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 IsEditable="True"
                                                 IsEnabled="{Binding IsFormEnabled}"
                                                 Height="36"
                                                 TabIndex="4"/>
                        </Grid>

                        <!-- 5. WeightIssued -->
                        <Grid Grid.Row="4" Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="420"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource YellowLabelBlock}">
                                <TextBlock Text="WeightIssued:" Style="{StaticResource YellowLabelText}"/>
                            </Border>
                            <TextBox Grid.Column="1"
                                     Text="{Binding WeightIssued, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=F3}"
                                     IsEnabled="{Binding IsFormEnabled}"
                                     FontSize="14"
                                     FontWeight="Bold"
                                     HorizontalContentAlignment="Right"
                                     Height="36"
                                     Padding="6,4"
                                     TabIndex="5"/>
                        </Grid>

                        <!-- 6. Note -->
                        <Grid Grid.Row="5" Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="420"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource YellowLabelBlock}" VerticalAlignment="Top">
                                <TextBlock Text="Note:" Style="{StaticResource YellowLabelText}"/>
                            </Border>
                            <TextBox Grid.Column="1"
                                     Text="{Binding Note, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding IsFormEnabled}"
                                     Height="75"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     Padding="6,6"
                                     TabIndex="6"/>
                        </Grid>
                    </Grid>
                </Border>
            </telerik:RadTabItem>

            <!-- Tab 2: List of All Metal Issued Entries -->
            <telerik:RadTabItem Header="List" FontSize="13" FontWeight="SemiBold">
                <Border Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1,0,1,1"
                        Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Search Filter Bar -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0"
                                     Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Height="32"
                                     Padding="6,4"
                                     FontSize="13"
                                     VerticalAlignment="Center"/>

                            <TextBlock Grid.Column="0"
                                       Text="Search by Issue No, Artisan, ItemType, Purity or Note..."
                                       Foreground="#888888"
                                       IsHitTestVisible="False"
                                       VerticalAlignment="Center"
                                       Margin="10,0,0,0"
                                       Visibility="{Binding SearchText, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"/>

                            <TextBlock Grid.Column="1"
                                       Text="{Binding FilteredIssuedList.Count, StringFormat='Total Records: {0}'}"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"
                                       Margin="12,0,0,0"/>
                        </Grid>

                        <!-- Data Grid -->
                        <telerik:RadGridView Grid.Row="1"
                                             ItemsSource="{Binding FilteredIssuedList}"
                                             SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                                             AutoGenerateColumns="False"
                                             IsReadOnly="True"
                                             RowIndicatorVisibility="Collapsed"
                                             ShowGroupPanel="False"
                                             EnableRowVirtualization="True"
                                             SelectionMode="Single">
                            <telerik:RadGridView.Columns>
                                <telerik:GridViewDataColumn Header="Issue No" DataMemberBinding="{Binding IssueNo}" Width="100"/>
                                <telerik:GridViewDataColumn Header="Issue Date" DataMemberBinding="{Binding IssueDate, StringFormat='dd/MM/yyyy'}" Width="100"/>
                                <telerik:GridViewDataColumn Header="Artisian Name" DataMemberBinding="{Binding ArtisianName}" Width="200"/>
                                <telerik:GridViewDataColumn Header="Item Type" DataMemberBinding="{Binding ItemType}" Width="140"/>
                                <telerik:GridViewDataColumn Header="Purity" DataMemberBinding="{Binding Purity}" Width="90"/>
                                <telerik:GridViewDataColumn Header="Weight Issued" DataMemberBinding="{Binding WeightIssued, StringFormat='{}{0:0.000}'}" TextAlignment="Right" Width="110"/>
                                <telerik:GridViewDataColumn Header="Note" DataMemberBinding="{Binding Note}" Width="*"/>
                            </telerik:RadGridView.Columns>
                        </telerik:RadGridView>
                    </Grid>
                </Border>
            </telerik:RadTabItem>
        </telerik:RadTabControl>

        <!-- Toast Notification (Bottom Right) -->
        <controls:ToastNotification x:Name="ToastNotification"
                                    Grid.Row="1"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    Margin="0,0,24,24"/>
    </Grid>
</UserControl>
