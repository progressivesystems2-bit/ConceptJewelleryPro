<Window x:Class="ConceptJewelleryPro.WPF.Views.Gstr3BExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
        Title="Generate GSTR-3B JSON - Concept Jewellery Pro"
        Width="820" Height="680" MinWidth="700" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="Segoe UI">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14,12"/>
        </Style>

        <Style x:Key="MiniMetricStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10,8"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 0: Header -->
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/> <!-- 2: Configuration & Parameters -->
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/> <!-- 4: Summary Cards -->
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>    <!-- 6: JSON Preview -->
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/> <!-- 8: Action Buttons -->
        </Grid.RowDefinitions>

        <!-- 0: Header -->
        <Border Grid.Row="0" Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="40" Height="40" CornerRadius="8" Background="#1E3A8A" Margin="0,0,12,0" VerticalAlignment="Center">
                    <TextBlock Text="&#xE8B7;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="20"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Generate GSTR-3B JSON" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <TextBlock Text="{Binding CompanyName}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="12"/>
                        <TextBlock Text="  •  " Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12"/>
                        <TextBlock Text="{Binding GstSourceInfo}" Foreground="#16A34A" FontWeight="Medium" FontSize="11.5"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2: Configuration & Parameters -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="1.4*"/>
                    </Grid.ColumnDefinitions>

                    <!-- GSTIN -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Taxpayer GSTIN *" FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding Gstin, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 MaxLength="15"
                                 FontSize="13"
                                 FontWeight="Bold"
                                 Height="32"
                                 Padding="6,4"
                                 VerticalContentAlignment="Center"
                                 ToolTip="15-character Goods and Services Tax Identification Number (Auto-loaded from DateRange table)"/>
                        <TextBlock Text="Loaded from DateRange" FontSize="10" Foreground="#16A34A" Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- Return Period -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Return Period (MMYYYY) *" FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding ReturnPeriod, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 MaxLength="6"
                                 FontSize="13"
                                 FontWeight="Bold"
                                 Height="32"
                                 Padding="6,4"
                                 VerticalContentAlignment="Center"
                                 ToolTip="Month and Year format: MMYYYY (e.g. 102026 for Oct 2026)"/>
                    </StackPanel>

                    <!-- Return Period Details -->
                    <StackPanel Grid.Column="4" VerticalAlignment="Center">
                        <TextBlock Text="Report Date Range" FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding PeriodDisplay}"
                                   FontSize="12.5"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- Validation Error Message -->
                <TextBlock Text="{Binding ValidationMessage}"
                           Foreground="#DC2626"
                           FontSize="11.5"
                           FontWeight="SemiBold"
                           Margin="0,8,0,0"
                           TextWrapping="Wrap"
                           Visibility="{Binding HasErrors, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
        </Border>

        <!-- 4: Summary Cards -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Table 3.1: Outward Taxable -->
            <Border Grid.Column="0" Style="{StaticResource MiniMetricStyle}" BorderBrush="#2563EB" BorderThickness="1.5">
                <StackPanel>
                    <TextBlock Text="3.1 OUTWARD TAXABLE" FontSize="10.5" FontWeight="Bold" Foreground="#2563EB"/>
                    <TextBlock Text="{Binding TotalTaxableSales, StringFormat='₹{0:N2}'}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,3,0,0"/>
                    <TextBlock Text="{Binding TotalOutwardTax, StringFormat='Tax: ₹{0:N2}'}" FontSize="11" FontWeight="SemiBold" Foreground="#2563EB" Margin="0,1,0,0"/>
                </StackPanel>
            </Border>

            <!-- Table 4: Eligible ITC -->
            <Border Grid.Column="2" Style="{StaticResource MiniMetricStyle}" BorderBrush="#16A34A" BorderThickness="1.5">
                <StackPanel>
                    <TextBlock Text="4. ELIGIBLE ITC" FontSize="10.5" FontWeight="Bold" Foreground="#16A34A"/>
                    <TextBlock Text="{Binding TotalItc, StringFormat='₹{0:N2}'}" FontSize="15" FontWeight="Bold" Foreground="#16A34A" Margin="0,3,0,0"/>
                    <TextBlock Text="{Binding ItcIgst, StringFormat='IGST: ₹{0:N2}'}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,1,0,0"/>
                </StackPanel>
            </Border>

            <!-- Table 6: Net Tax Payable -->
            <Border Grid.Column="4" Style="{StaticResource MiniMetricStyle}" BorderBrush="#DC2626" BorderThickness="1.5">
                <StackPanel>
                    <TextBlock Text="6. NET CASH PAYABLE" FontSize="10.5" FontWeight="Bold" Foreground="#DC2626"/>
                    <TextBlock Text="{Binding TotalNetCash, StringFormat='₹{0:N2}'}" FontSize="15" FontWeight="Bold" Foreground="#DC2626" Margin="0,3,0,0"/>
                    <TextBlock Text="{Binding NetCashCgst, StringFormat='CGST: ₹{0:N2}'}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,1,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 6: JSON Preview -->
        <Border Grid.Row="6" Style="{StaticResource CardStyle}" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="4,0,4,6">
                    <TextBlock Text="JSON Payload Preview (Official GSTN Schema)" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <TextBlock Text="{Binding CopyStatus}" HorizontalAlignment="Right" FontSize="11.5" FontWeight="Bold" Foreground="#16A34A"/>
                </Grid>

                <TextBox Grid.Row="1"
                         Text="{Binding JsonPreview, Mode=OneWay}"
                         IsReadOnly="True"
                         FontFamily="Cascadia Code, Consolas, Courier New"
                         FontSize="12"
                         Background="#0F172A"
                         Foreground="#38BDF8"
                         BorderThickness="0"
                         Padding="10"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         TextWrapping="NoWrap"/>
            </Grid>
        </Border>

        <!-- 8: Bottom Action Bar -->
        <Border Grid.Row="8">
            <DockPanel LastChildFill="False">
                <telerik:RadButton DockPanel.Dock="Left"
                                   Command="{Binding CopyJsonCommand}"
                                   Style="{StaticResource ToolbarButtonStyle}"
                                   Height="34"
                                   MinWidth="140">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Copy JSON"/>
                    </StackPanel>
                </telerik:RadButton>

                <telerik:RadButton DockPanel.Dock="Right"
                                   Command="{Binding CloseCommand}"
                                   Style="{StaticResource ToolbarButtonStyle}"
                                   Height="34"
                                   MinWidth="90"
                                   Margin="8,0,0,0">
                    <TextBlock Text="Close"/>
                </telerik:RadButton>

                <telerik:RadButton DockPanel.Dock="Right"
                                   Command="{Binding SaveJsonCommand}"
                                   Style="{StaticResource PrimaryToolbarButtonStyle}"
                                   Height="34"
                                   MinWidth="180">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Save GSTR-3B JSON File..."/>
                    </StackPanel>
                </telerik:RadButton>
            </DockPanel>
        </Border>
    </Grid>
</Window>
