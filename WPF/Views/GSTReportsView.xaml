<UserControl x:Class="ConceptJewelleryPro.WPF.Views.GSTReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
             xmlns:controls="clr-namespace:ConceptJewelleryPro.WPF.Controls"
             FontFamily="Segoe UI"
             TextOptions.TextFormattingMode="Display">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="ToolbarButtonStyle" TargetType="telerik:RadButton" BasedOn="{StaticResource RadButtonStyle}">
            
            <Setter Property="MinWidth" Value="85" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>

        <Style x:Key="FilterLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="Margin" Value="0,0,0,3" />
        </Style>

        <Style x:Key="MetricCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="0,0,10,0" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Header -->
            <RowDefinition Height="Auto" /> <!-- Filter Toolbar -->
            <RowDefinition Height="*" />    <!-- Tab Contents -->
            <RowDefinition Height="Auto" /> <!-- Status Bar -->
        </Grid.RowDefinitions>

        <!-- Toast Notifications Container -->
        <controls:ToastNotification x:Name="ToastNotification"
                                     Grid.Row="0"
                                     Grid.RowSpan="4"
                                     Panel.ZIndex="99"
                                     Message="{Binding ToastMessage, FallbackValue=''}"
                                     ToastType="{Binding ToastType, FallbackValue=Info}"
                                     AutoCloseDelay="4000"
                                     FontSize="14" />

        <!-- 1. Header -->
        <Border Grid.Row="0"
                Background="{DynamicResource HeaderBackgroundBrush}"
                BorderBrush="{DynamicResource HeaderBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34" Height="34" CornerRadius="6" Background="#1E3A8A">
                        <TextBlock Text="&#xE825;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="16"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="GST Reports &amp; Reconciliation" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                        <TextBlock Text="Statutory returns (GSTR-1, GSTR-3B, GSTR-2) and automated GSTR-2B purchase reconciliation" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <telerik:RadButton Content="📊 Export to CSV / Excel" Style="{StaticResource ToolbarButtonStyle}" Command="{Binding ExportCommand}" ToolTip="Export current report tab to Excel (.xlsx) or CSV" />
                    <telerik:RadButton Content="🔄 Refresh Data" Style="{StaticResource PrimaryToolbarButtonStyle}" MinWidth="110" Command="{Binding RefreshCommand}" ToolTip="Reload GST data from database" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. Filter Toolbar -->
        <Border Grid.Row="1" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource HeaderBorderBrush}" BorderThickness="0,0,0,1" Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Date Range & Quick Buttons -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="From Date" Style="{StaticResource FilterLabelStyle}" />
                        <telerik:RadDatePicker SelectedDate="{Binding FromDate, Mode=TwoWay}"  Width="120" FontSize="12" />
                    </StackPanel>

                    <StackPanel Margin="0,0,14,0">
                        <TextBlock Text="To Date" Style="{StaticResource FilterLabelStyle}" />
                        <telerik:RadDatePicker SelectedDate="{Binding ToDate, Mode=TwoWay}" Width="120" FontSize="12" />
                    </StackPanel>

                    <StackPanel VerticalAlignment="Bottom" Orientation="Horizontal" Margin="0,0,14,0">
                        <telerik:RadButton Content="This Month" Style="{StaticResource ToolbarButtonStyle}" MinWidth="75" Command="{Binding SetThisMonthCommand}" />
                        <telerik:RadButton Content="Last Month" Style="{StaticResource ToolbarButtonStyle}" MinWidth="75" Command="{Binding SetLastMonthCommand}" />
                        <telerik:RadButton Content="This Quarter" Style="{StaticResource ToolbarButtonStyle}"  MinWidth="85" Command="{Binding SetThisQuarterCommand}" />
                        <telerik:RadButton Content="This FY" Style="{StaticResource ToolbarButtonStyle}"  MinWidth="65" Command="{Binding SetThisFYCommand}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 3. Tab Contents -->
        <telerik:RadBusyIndicator Grid.Row="2" IsBusy="{Binding IsBusy}" BusyContent="Generating GST Report...">
            <telerik:RadTabControl SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}" Margin="10,8,10,6">

                <!-- ════════ TAB 1: GSTR-1 ════════ -->
                <telerik:RadTabItem Header="🧾 GSTR-1 (Outward Sales)" FontSize="12.5" FontWeight="SemiBold">
                    <Grid Margin="0,8,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /> <!-- Action Banner -->
                            <RowDefinition Height="Auto" /> <!-- Summary Metrics -->
                            <RowDefinition Height="*" />    <!-- Sub-tabs -->
                        </Grid.RowDefinitions>

                        <!-- GSTR-1 Return Filing Action Panel -->
                        <Border Grid.Row="0" Style="{StaticResource MetricCardStyle}" Margin="0,0,0,10" Padding="14,10" BorderBrush="#059669">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE825;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#059669" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBlock Text="GST Return Filing (GSTR-1 Offline JSON)" FontWeight="Bold" FontSize="13.5" Foreground="{DynamicResource PrimaryTextBrush}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="24,3,0,0">
                                        <TextBlock Text="Company: " FontSize="11.5" Foreground="{DynamicResource SecondaryTextBrush}" />
                                        <TextBlock Text="{Binding CompanyName, FallbackValue='TATTVA JEWELS'}" FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource PrimaryTextBrush}" />
                                        <TextBlock Text="  |  GSTIN: " FontSize="11.5" Foreground="{DynamicResource SecondaryTextBrush}" />
                                        <TextBlock Text="{Binding CompanyGstin, FallbackValue='21AGVPV8495M1Z5'}" FontWeight="Bold" FontSize="11.5" Foreground="#1E3A8A" />
                                        <TextBlock Text=" (Auto-detected from DateRange table)" FontStyle="Italic" FontSize="11" Foreground="#16A34A" Margin="6,0,0,0" />
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <telerik:RadButton Content="📗 Export GSTR-1 Excel"
                                                       Style="{StaticResource ToolbarButtonStyle}"
                                                       MinWidth="170"
                                                       Height="34"
                                                       Margin="0,0,8,0"
                                                       Command="{Binding ExportGstr1ExcelCommand}"
                                                       ToolTip="Export official GSTR-1 offline utility Excel (.xlsx) format with b2b, b2cl, b2cs, cdnr, hsn, docs sheets" />
                                    <telerik:RadButton Content="👁️ Preview JSON"
                                                       Style="{StaticResource ToolbarButtonStyle}"
                                                       MinWidth="130"
                                                       Height="34"
                                                       Margin="0,0,8,0"
                                                       Command="{Binding PreviewGstr1JsonCommand}"
                                                       ToolTip="Preview and inspect GSTR-1 JSON data before exporting" />
                                    <telerik:RadButton Content="📦 Generate GSTR-1 JSON"
                                                       Style="{StaticResource PrimaryToolbarButtonStyle}"
                                                       MinWidth="190"
                                                       Height="34"
                                                       Command="{Binding GenerateGstr1JsonCommand}"
                                                       ToolTip="Directly save government-compliant GSTR-1 JSON file for GST Portal" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- GSTR-1 KPI Metrics -->
                        <Grid Grid.Row="1" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource MetricCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="TOTAL INVOICES" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" />
                                    <TextBlock Text="{Binding Gstr1Report.TotalInvoiceCount}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Style="{StaticResource MetricCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="TAXABLE VALUE" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" />
                                    <TextBlock Text="{Binding Gstr1Report.TotalTaxableAmount, StringFormat='₹{0:N2}'}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Style="{StaticResource MetricCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="INTEGRATED TAX (IGST)" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" />
                                    <TextBlock Text="{Binding Gstr1Report.TotalIgstAmount, StringFormat='₹{0:N2}'}" FontSize="16" FontWeight="Bold" Foreground="#2563EB" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="3" Style="{StaticResource MetricCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="CENTRAL + STATE TAX (CGST/SGST)" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" />
                                    <TextBlock Text="{Binding Gstr1Report.TotalCgstAmount, StringFormat='₹{0:N2}'}" FontSize="16" FontWeight="Bold" Foreground="#16A34A" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="4" Style="{StaticResource MetricCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="TOTAL OUTPUT TAX" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" />
                                    <TextBlock Text="{Binding Gstr1Report.TotalTaxAmount, StringFormat='₹{0:N2}'}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- GSTR-1 Sub-Sections -->
                        <telerik:RadTabControl Grid.Row="2">
                            <!-- B2B -->
                            <telerik:RadTabItem Header="4A/4B - B2B Invoices">
                                <telerik:RadGridView ItemsSource="{Binding B2BInvoices}"
                                                     AutoGenerateColumns="False"
                                                     IsReadOnly="True"
                                                     ShowGroupPanel="True"
                                                     RowIndicatorVisibility="Collapsed">
                                    <telerik:RadGridView.Columns>
                                        <telerik:GridViewDataColumn Header="GSTIN / UIN" DataMemberBinding="{Binding Gstin}" Width="145" />
                                        <telerik:GridViewDataColumn Header="Receiver Name" DataMemberBinding="{Binding ReceiverName}" Width="200" />
                                        <telerik:GridViewDataColumn Header="Invoice No" DataMemberBinding="{Binding InvoiceNo}" Width="100" />
                                        <telerik:GridViewDataColumn Header="Invoice Date" DataMemberBinding="{Binding InvoiceDate, StringFormat='{}{0:dd/MM/yyyy}'}" Width="100" />
                                        <telerik:GridViewDataColumn Header="Invoice Value" DataMemberBinding="{Binding InvoiceValue, StringFormat='{}{0:N2}'}" TextAlignment="Right" Width="115" />
                                        <telerik:GridViewDataColumn Header="Place of Supply" DataMemberBinding="{Binding PlaceOfSupply}" Width="120" />
                                        <telerik:GridViewDataColumn Header="Rate %" DataMemberBinding="{Binding GstRate, StringFormat='{}{0:F2}%'}" TextAlignment="Right" Width="75" />
                                        <telerik:GridViewDataColumn Header="Taxable Value" DataMemberBinding="{Binding TaxableValue, StringFormat='{}{0:N2}'}" TextAlignment="Right" Width="115" />
                                        <telerik:GridViewDataColumn Header="IGST (₹)" DataMemberBinding="{Binding IgstAmount, StringFormat='{}{0:N2}'}" TextAlignment="Right" Width="100" />
                                        <telerik:GridViewDataColumn Header="CGST (₹)" DataMemberBinding="{Binding CgstAmount, StringFormat='{}{0:N2}'}" TextAlignment="Right" Width="100" />
                                        <telerik:GridViewDataColumn Header="SGST (₹)" DataMemberBinding="{Binding SgstAmount, StringFormat='{}{0:N2}'}" TextAlignment="Right" Width="100" />
                                    </telerik:RadGridView.Columns>
                                </telerik:RadGridView>
                            </telerik:RadTabItem>

                            <!-- B2C Small -->
                            <telerik:RadTabItem Header="7 - B2C Small (Retail)">
                                <telerik:RadGridView ItemsSource="{Binding B2CSmallSummaries}"
                                                     AutoGenerateColumns="False"
                                                     IsReadOnly="True"
                                                     RowIndicatorVisibility="Collapsed">
                                    <telerik:RadGridView.Columns>
                                        <telerik:GridViewDataColumn Header="Type" DataMemberBinding="{Binding Type}" Width="80" />
                                        <telerik:GridViewDataColumn Header="Place of Supply" DataMemberBinding="{Binding PlaceOfSupply}" Width="180" />
                                        <telerik:GridViewDataColumn Header="Rate %" DataMemberBinding="{Binding GstRate, StringFormat='{}{0:F2}%'}" TextAlignment="Right" Width="80" />
                                        <telerik:GridViewDataColumn Header="Taxable Value (₹)" DataMemberBinding="{Binding TaxableValue, StringFormat='{}{0:N2}'}" TextAlignment="Right" Width="140" />
                                        <telerik:GridViewDataColumn Header="IGST (₹)" DataMemberBinding="{Binding IgstAmount, StringFormat='{}{0:N2}'}" TextAlignment="Right" Width="120" />
                                        <telerik:GridViewDataColumn Header="CGST (₹)" DataMemberBinding="{Binding CgstAmount, StringFormat='{}{0:N2}'}" TextAlignment="Right" Width="120" />
                                        <telerik:GridViewDataColumn Header="SGST (₹)" DataMemberBinding="{Binding SgstAmount, StringFormat='{}{0:N2}'}" TextAlignment="Right" Width="120" />
                                        <telerik:GridViewDataColumn Header="Total Amount (₹)" DataMemberBinding="{Binding TotalAmount, StringFormat='{}{0:N2}'}" TextAlignment="Right" Width="140" />
                                    </telerik:RadGridView.Columns>
                                </telerik:RadGridView>
                            </telerik:RadTabItem>

                            <!-- 12 - HSN Summary B2B -->
                            <telerik:RadTabItem Header="12 - HSN Summary (B2B)">
                                <telerik:RadGridView ItemsSource="{Binding HsnB2BSummaries}"
                                                     AutoGenerateColumns="False"
                                                     IsReadOnly="True"
                                                     RowIndicatorVisibility="Collapsed">
                                    <telerik:RadGridView.Columns>
                                        <telerik:GridViewDataColumn Header="HSN Code" DataMemberBinding="{Binding HsnCode}" Width="110" />
                                        <telerik:GridViewDataColumn Header="Description" DataMemberBinding="{Binding Description}" Width="220" />
                                        <telerik:GridViewDataColumn Header="UQC" DataMemberBinding="{Binding Uqc}" Width="70" />
                                        <telerik:GridViewDataColumn Header="Total Qty / Wt" DataMemberBinding="{Binding TotalQuantity, StringFormat='{}{0:F3}'}" TextAlignment="Right" Width="115" />
                                        <telerik:GridViewDataColumn Header="Total Value (₹)" DataMemberBinding="{Binding TotalValue, StringFormat='{}{0:N2}'}" TextAlignment="Right" Width="130" />
                                        <telerik:GridViewDataColumn Header="Taxable Value (₹)" DataMemberBinding="{Binding TaxableValue, StringFormat='{}{0:N2}'}" TextAlignment="Right" Width="130" />
                                        <telerik:GridViewDataColumn Header="Rate %" DataMemberBinding="{Binding GstRate, StringFormat='{}{0:F2}%'}" TextAlignment="Right" Width="80" />
                                        <telerik:GridViewDataColumn Header="IGST (₹)" DataMemberBinding="{Binding IgstAmount, StringFormat='{}{0:N2}'}" TextAlignment="Right" Width="110" />
                                        <telerik:GridViewDataColumn Header="CGST (₹)" DataMemberBinding="{Binding CgstAmount, StringFormat='{}{0:N2}'}" TextAlignment="Right" Width="110" />
                                        <telerik:GridViewDataColumn Header="SGST (₹)" DataMemberBinding="{Binding SgstAmount, StringFormat='{}{0:N2}'}" TextAlignment="Right" Width="110" />
                                    </telerik:RadGridView.Columns>
                                </telerik:RadGridView>
                            </telerik:RadTabItem>

                            <!-- 12 - HSN Summary B2C -->
                            <telerik:RadTabItem Header="12 - HSN Summary (B2C)">
                                <telerik:RadGridView ItemsSource="{Binding HsnB2CSummaries}"
                                                     AutoGenerateColumns="False"
                                                     IsReadOnly="True"
                                                     RowIndicatorVisibility="Collapsed">
                                    <telerik:RadGridView.Columns>
                                        <telerik:GridViewDataColumn Header="HSN Code" DataMemberBinding="{Binding HsnCode}" Width="110" />
                                        <telerik:GridViewDataColumn Header="Description" DataMemberBinding="{Binding Description}" Width="220" />
                                        <telerik:GridViewDataColumn Header="UQC" DataMemberBinding="{Binding Uqc}" Width="70" />
                                        <telerik:GridViewDataColumn Header="Total Qty / Wt" DataMemberBinding="{Binding TotalQuantity, StringFormat='{}{0:F3}'}" TextAlignment="Right" Width="115" />
                                        <telerik:GridViewDataColumn Header="Total Value (₹)" DataMemberBinding="{Binding TotalValue, StringFormat='{}{0:N2}'}" TextAlignment="Right" Width="130" />
                                        <telerik:GridViewDataColumn Header="Taxable Value (₹)" DataMemberBinding="{Binding TaxableValue, StringFormat='{}{0:N2}'}" TextAlignment="Right" Width="130" />
                                        <telerik:GridViewDataColumn Header="Rate %" DataMemberBinding="{Binding GstRate, StringFormat='{}{0:F2}%'}" TextAlignment="Right" Width="80" />
                                        <telerik:GridViewDataColumn Header="IGST (₹)" DataMemberBinding="{Binding IgstAmount, StringFormat='{}{0:N2}'}" TextAlignment="Right" Width="110" />
                                        <telerik:GridViewDataColumn Header="CGST (₹)" DataMemberBinding="{Binding CgstAmount, StringFormat='{}{0:N2}'}" TextAlignment="Right" Width="110" />
                                        <telerik:GridViewDataColumn Header="SGST (₹)" DataMemberBinding="{Binding SgstAmount, StringFormat='{}{0:N2}'}" TextAlignment="Right" Width="110" />
                                    </telerik:RadGridView.Columns>
                                </telerik:RadGridView>
                            </telerik:RadTabItem>

                            <!-- 12 - HSN Total / Consolidated -->
                            <telerik:RadTabItem Header="12 - HSN Total">
                                <telerik:RadGridView ItemsSource="{Binding HsnSummaries}"
                                                     AutoGenerateColumns="False"
                                                     IsReadOnly="True"
                                                     RowIndicatorVisibility="Collapsed">
                                    <telerik:RadGridView.Columns>
                                        <telerik:GridViewDataColumn Header="HSN Code" DataMemberBinding="{Binding HsnCode}" Width="110" />
                                        <telerik:GridViewDataColumn Header="Description" DataMemberBinding="{Binding Description}" Width="220" />
                                        <telerik:GridViewDataColumn Header="UQC" DataMemberBinding="{Binding Uqc}" Width="70" />
                                        <telerik:GridViewDataColumn Header="Total Qty / Wt" DataMemberBinding="{Binding TotalQuantity, StringFormat='{}{0:F3}'}" TextAlignment="Right" Width="115" />
                                        <telerik:GridViewDataColumn Header="Total Value (₹)" DataMemberBinding="{Binding TotalValue, StringFormat='{}{0:N2}'}" TextAlignment="Right" Width="130" />
                                        <telerik:GridViewDataColumn Header="Taxable Value (₹)" DataMemberBinding="{Binding TaxableValue, StringFormat='{}{0:N2}'}" TextAlignment="Right" Width="130" />
                                        <telerik:GridViewDataColumn Header="Rate %" DataMemberBinding="{Binding GstRate, StringFormat='{}{0:F2}%'}" TextAlignment="Right" Width="80" />
                                        <telerik:GridViewDataColumn Header="IGST (₹)" DataMemberBinding="{Binding IgstAmount, StringFormat='{}{0:N2}'}" TextAlignment="Right" Width="110" />
                                        <telerik:GridViewDataColumn Header="CGST (₹)" DataMemberBinding="{Binding CgstAmount, StringFormat='{}{0:N2}'}" TextAlignment="Right" Width="110" />
                                        <telerik:GridViewDataColumn Header="SGST (₹)" DataMemberBinding="{Binding SgstAmount, StringFormat='{}{0:N2}'}" TextAlignment="Right" Width="110" />
                                    </telerik:RadGridView.Columns>
                                </telerik:RadGridView>
                            </telerik:RadTabItem>

                            <!-- Document Summary -->
                            <telerik:RadTabItem Header="13 - Document Summary">
                                <telerik:RadGridView ItemsSource="{Binding DocumentSummaries}"
                                                     AutoGenerateColumns="False"
                                                     IsReadOnly="True"
                                                     RowIndicatorVisibility="Collapsed">
                                    <telerik:RadGridView.Columns>
                                        <telerik:GridViewDataColumn Header="Nature of Document" DataMemberBinding="{Binding DocDescription}" Width="250" />
                                        <telerik:GridViewDataColumn Header="From Serial No" DataMemberBinding="{Binding FromSerialNo}" Width="120" />
                                        <telerik:GridViewDataColumn Header="To Serial No" DataMemberBinding="{Binding ToSerialNo}" Width="120" />
                                        <telerik:GridViewDataColumn Header="Total Number" DataMemberBinding="{Binding TotalNumber}" TextAlignment="Right" Width="110" />
                                        <telerik:GridViewDataColumn Header="Cancelled" DataMemberBinding="{Binding CancelledNumber}" TextAlignment="Right" Width="100" />
                                        <telerik:GridViewDataColumn Header="Net Issued" DataMemberBinding="{Binding NetIssuedNumber}" TextAlignment="Right" Width="110" />
                                    </telerik:RadGridView.Columns>
                                </telerik:RadGridView>
                            </telerik:RadTabItem>
                        </telerik:RadTabControl>
                    </Grid>
                </telerik:RadTabItem>

                <!-- ════════ TAB 2: GSTR-3B ════════ -->
                <telerik:RadTabItem Header="📋 GSTR-3B (Monthly Summary)" FontSize="12.5" FontWeight="SemiBold">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
                        <StackPanel Margin="0,0,0,16">

                            <!-- GSTR-3B Return Filing Action Panel -->
                            <Border Style="{StaticResource MetricCardStyle}" Margin="0,0,0,12" Padding="14,10" BorderBrush="{DynamicResource AccentBrush}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <TextBlock Text="GST Return Filing (GSTR-3B Offline JSON)" FontWeight="Bold" FontSize="13.5" Foreground="{DynamicResource PrimaryTextBrush}" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="24,3,0,0">
                                            <TextBlock Text="Company: " FontSize="11.5" Foreground="{DynamicResource SecondaryTextBrush}" />
                                            <TextBlock Text="{Binding CompanyName, FallbackValue='TATTVA JEWELS'}" FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource PrimaryTextBrush}" />
                                            <TextBlock Text="  |  GSTIN: " FontSize="11.5" Foreground="{DynamicResource SecondaryTextBrush}" />
                                            <TextBlock Text="{Binding CompanyGstin, FallbackValue='21AGVPV8495M1Z5'}" FontWeight="Bold" FontSize="11.5" Foreground="#1E3A8A" />
                                            <TextBlock Text=" (Auto-detected from DateRange table)" FontStyle="Italic" FontSize="11" Foreground="#16A34A" Margin="6,0,0,0" />
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <telerik:RadButton Content="👁️ Preview JSON"
                                                           Style="{StaticResource ToolbarButtonStyle}"
                                                           MinWidth="130"
                                                           Height="34"
                                                           Margin="0,0,8,0"
                                                           Command="{Binding PreviewGstr3BJsonCommand}"
                                                           ToolTip="Preview and inspect GSTR-3B JSON data before exporting" />
                                        <telerik:RadButton Content="📦 Generate GSTR-3B JSON"
                                                           Style="{StaticResource PrimaryToolbarButtonStyle}"
                                                           MinWidth="190"
                                                           Height="34"
                                                           Command="{Binding GenerateGstr3BJsonCommand}"
                                                           ToolTip="Directly save government-compliant GSTR-3B JSON file for GST Portal" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- 3.1 Outward Supplies -->
                            <Border Style="{StaticResource MetricCardStyle}" Margin="0,0,0,12" Padding="14">
                                <StackPanel>
                                    <TextBlock Text="3.1 Details of Outward Supplies and Inward supplies liable to reverse charge" FontSize="13" FontWeight="Bold" Foreground="#1E3A8A" Margin="0,0,0,8" />
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="3*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Headers -->
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Nature of Supply" FontWeight="Bold" FontSize="11" />
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="Total Taxable Value" FontWeight="Bold" FontSize="11" TextAlignment="Right" />
                                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Integrated Tax (IGST)" FontWeight="Bold" FontSize="11" TextAlignment="Right" />
                                        <TextBlock Grid.Row="0" Grid.Column="3" Text="Central Tax (CGST)" FontWeight="Bold" FontSize="11" TextAlignment="Right" />
                                        <TextBlock Grid.Row="0" Grid.Column="4" Text="State/UT Tax (SGST)" FontWeight="Bold" FontSize="11" TextAlignment="Right" />
                                        <TextBlock Grid.Row="0" Grid.Column="5" Text="Total Tax" FontWeight="Bold" FontSize="11" TextAlignment="Right" />

                                        <Border Grid.Row="1" Grid.ColumnSpan="6" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Margin="0,6,0,6" />

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding Gstr3BReport.OutwardTaxableSupplies.Description}" FontSize="12" Margin="0,8,0,0" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Gstr3BReport.OutwardTaxableSupplies.TotalTaxableValue, StringFormat='₹{0:N2}'}" TextAlignment="Right" FontSize="12" Margin="0,8,0,0" />
                                        <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Gstr3BReport.OutwardTaxableSupplies.IntegratedTax, StringFormat='₹{0:N2}'}" TextAlignment="Right" FontSize="12" Margin="0,8,0,0" />
                                        <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding Gstr3BReport.OutwardTaxableSupplies.CentralTax, StringFormat='₹{0:N2}'}" TextAlignment="Right" FontSize="12" Margin="0,8,0,0" />
                                        <TextBlock Grid.Row="1" Grid.Column="4" Text="{Binding Gstr3BReport.OutwardTaxableSupplies.StateTax, StringFormat='₹{0:N2}'}" TextAlignment="Right" FontSize="12" Margin="0,8,0,0" />
                                        <TextBlock Grid.Row="1" Grid.Column="5" Text="{Binding Gstr3BReport.OutwardTaxableSupplies.TotalTax, StringFormat='₹{0:N2}'}" TextAlignment="Right" FontSize="12" FontWeight="Bold" Foreground="#1E3A8A" Margin="0,8,0,0" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- 3.2 Inter-State Supplies -->
                            <Border Style="{StaticResource MetricCardStyle}" Margin="0,0,0,12" Padding="14">
                                <StackPanel>
                                    <TextBlock Text="3.2 Of the supplies shown in 3.1 (a), details of inter-State supplies made to unregistered persons" FontSize="13" FontWeight="Bold" Foreground="#1E3A8A" Margin="0,0,0,8" />
                                    <telerik:RadGridView ItemsSource="{Binding Gstr3BReport.InterStateSuppliesToUnregistered}"
                                                         AutoGenerateColumns="False"
                                                         IsReadOnly="True"
                                                         RowIndicatorVisibility="Collapsed"
                                                         ShowGroupPanel="False"
                                                         MinHeight="70">
                                        <telerik:RadGridView.Columns>
                                            <telerik:GridViewDataColumn Header="Place of Supply (State Code)" DataMemberBinding="{Binding PlaceOfSupply}" Width="250" />
                                            <telerik:GridViewDataColumn Header="Total Taxable Value (₹)" DataMemberBinding="{Binding TaxableValue, StringFormat='₹{0:N2}'}" TextAlignment="Right" Width="220" />
                                            <telerik:GridViewDataColumn Header="Amount of Integrated Tax (₹)" DataMemberBinding="{Binding IntegratedTax, StringFormat='₹{0:N2}'}" TextAlignment="Right" Width="220" />
                                        </telerik:RadGridView.Columns>
                                    </telerik:RadGridView>
                                </StackPanel>
                            </Border>

                            <!-- 4. Eligible ITC -->
                            <Border Style="{StaticResource MetricCardStyle}" Margin="0,0,0,12" Padding="14">
                                <StackPanel>
                                    <TextBlock Text="4. Eligible Input Tax Credit (ITC)" FontSize="13" FontWeight="Bold" Foreground="#16A34A" Margin="0,0,0,8" />
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="3*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Details" FontWeight="Bold" FontSize="11" />
                                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Integrated Tax (IGST)" FontWeight="Bold" FontSize="11" TextAlignment="Right" />
                                        <TextBlock Grid.Row="0" Grid.Column="3" Text="Central Tax (CGST)" FontWeight="Bold" FontSize="11" TextAlignment="Right" />
                                        <TextBlock Grid.Row="0" Grid.Column="4" Text="State/UT Tax (SGST)" FontWeight="Bold" FontSize="11" TextAlignment="Right" />
                                        <TextBlock Grid.Row="0" Grid.Column="5" Text="Total ITC Available" FontWeight="Bold" FontSize="11" TextAlignment="Right" />

                                        <Border Grid.Row="1" Grid.ColumnSpan="6" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Margin="0,6,0,6" />

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding Gstr3BReport.ItcAllOther.Description}" FontSize="12" Margin="0,6,0,0" />
                                        <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Gstr3BReport.ItcAllOther.IntegratedTax, StringFormat='₹{0:N2}'}" TextAlignment="Right" FontSize="12" Margin="0,6,0,0" />
                                        <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding Gstr3BReport.ItcAllOther.CentralTax, StringFormat='₹{0:N2}'}" TextAlignment="Right" FontSize="12" Margin="0,6,0,0" />
                                        <TextBlock Grid.Row="1" Grid.Column="4" Text="{Binding Gstr3BReport.ItcAllOther.StateTax, StringFormat='₹{0:N2}'}" TextAlignment="Right" FontSize="12" Margin="0,6,0,0" />
                                        <TextBlock Grid.Row="1" Grid.Column="5" Text="{Binding Gstr3BReport.ItcAllOther.TotalItc, StringFormat='₹{0:N2}'}" TextAlignment="Right" FontSize="12" FontWeight="Bold" Foreground="#16A34A" Margin="0,6,0,0" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- 6. Payment of Tax -->
                            <Border Style="{StaticResource MetricCardStyle}" Padding="14">
                                <StackPanel>
                                    <TextBlock Text="6. Payment of Tax (Net Tax Payable in Cash)" FontSize="13" FontWeight="Bold" Foreground="#DC2626" Margin="0,0,0,8" />
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="3*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Description" FontWeight="Bold" FontSize="11" />
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="IGST (₹)" FontWeight="Bold" FontSize="11" TextAlignment="Right" />
                                        <TextBlock Grid.Row="0" Grid.Column="2" Text="CGST (₹)" FontWeight="Bold" FontSize="11" TextAlignment="Right" />
                                        <TextBlock Grid.Row="0" Grid.Column="3" Text="SGST (₹)" FontWeight="Bold" FontSize="11" TextAlignment="Right" />
                                        <TextBlock Grid.Row="0" Grid.Column="4" Text="Total (₹)" FontWeight="Bold" FontSize="11" TextAlignment="Right" />

                                        <Border Grid.Row="1" Grid.ColumnSpan="5" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Margin="0,6,0,6" />

                                        <!-- Row 1: Output Tax -->
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Total Output Tax Liability" FontSize="12" Margin="0,6,0,0" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Gstr3BReport.TotalTaxLiability.IntegratedTax, StringFormat='₹{0:N2}'}" TextAlignment="Right" FontSize="12" Margin="0,6,0,0" />
                                        <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Gstr3BReport.TotalTaxLiability.CentralTax, StringFormat='₹{0:N2}'}" TextAlignment="Right" FontSize="12" Margin="0,6,0,0" />
                                        <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding Gstr3BReport.TotalTaxLiability.StateTax, StringFormat='₹{0:N2}'}" TextAlignment="Right" FontSize="12" Margin="0,6,0,0" />
                                        <TextBlock Grid.Row="1" Grid.Column="4" Text="{Binding Gstr3BReport.TotalTaxLiability.Total, StringFormat='₹{0:N2}'}" TextAlignment="Right" FontSize="12" FontWeight="Bold" Margin="0,6,0,0" />

                                        <!-- Row 2: Paid by ITC -->
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Less: Input Tax Credit Utilized" FontSize="12" Foreground="#16A34A" Margin="0,6,0,0" />
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Gstr3BReport.TotalItcUtilized.IntegratedTax, StringFormat='- ₹{0:N2}'}" TextAlignment="Right" FontSize="12" Foreground="#16A34A" Margin="0,6,0,0" />
                                        <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding Gstr3BReport.TotalItcUtilized.CentralTax, StringFormat='- ₹{0:N2}'}" TextAlignment="Right" FontSize="12" Foreground="#16A34A" Margin="0,6,0,0" />
                                        <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding Gstr3BReport.TotalItcUtilized.StateTax, StringFormat='- ₹{0:N2}'}" TextAlignment="Right" FontSize="12" Foreground="#16A34A" Margin="0,6,0,0" />
                                        <TextBlock Grid.Row="2" Grid.Column="4" Text="{Binding Gstr3BReport.TotalItcUtilized.Total, StringFormat='- ₹{0:N2}'}" TextAlignment="Right" FontSize="12" FontWeight="Bold" Foreground="#16A34A" Margin="0,6,0,0" />

                                        <!-- Row 3: Net Cash Payable -->
                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Net Tax Payable in Cash" FontSize="13" FontWeight="Bold" Foreground="#DC2626" Margin="0,8,0,0" />
                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Gstr3BReport.NetTaxPayableInCash.IntegratedTax, StringFormat='₹{0:N2}'}" TextAlignment="Right" FontSize="13" FontWeight="Bold" Foreground="#DC2626" Margin="0,8,0,0" />
                                        <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding Gstr3BReport.NetTaxPayableInCash.CentralTax, StringFormat='₹{0:N2}'}" TextAlignment="Right" FontSize="13" FontWeight="Bold" Foreground="#DC2626" Margin="0,8,0,0" />
                                        <TextBlock Grid.Row="3" Grid.Column="3" Text="{Binding Gstr3BReport.NetTaxPayableInCash.StateTax, StringFormat='₹{0:N2}'}" TextAlignment="Right" FontSize="13" FontWeight="Bold" Foreground="#DC2626" Margin="0,8,0,0" />
                                        <TextBlock Grid.Row="3" Grid.Column="4" Text="{Binding Gstr3BReport.NetTaxPayableInCash.Total, StringFormat='₹{0:N2}'}" TextAlignment="Right" FontSize="14" FontWeight="Bold" Foreground="#DC2626" Margin="0,8,0,0" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </telerik:RadTabItem>

                <!-- ════════ TAB 3: GSTR-2 PURCHASE REGISTER ════════ -->
                <telerik:RadTabItem Header="📥 GSTR-2 (Purchase Register)" FontSize="12.5" FontWeight="SemiBold">
                    <Grid Margin="0,8,0,0">
                        <telerik:RadGridView ItemsSource="{Binding PurchaseRegisterItems}"
                                             AutoGenerateColumns="False"
                                             IsReadOnly="True"
                                             ShowGroupPanel="True"
                                             RowIndicatorVisibility="Collapsed">
                            <telerik:RadGridView.Columns>
                                <telerik:GridViewDataColumn Header="Vou No" DataMemberBinding="{Binding VouNo}" Width="90" />
                                <telerik:GridViewDataColumn Header="Supp Bill No" DataMemberBinding="{Binding SuppBillNo}" Width="110" />
                                <telerik:GridViewDataColumn Header="Date" DataMemberBinding="{Binding BillDate, StringFormat='{}{0:dd/MM/yyyy}'}" Width="95" />
                                <telerik:GridViewDataColumn Header="Supplier Name" DataMemberBinding="{Binding SupplierName}" Width="200" />
                                <telerik:GridViewDataColumn Header="Supplier GSTIN" DataMemberBinding="{Binding SupplierGstin}" Width="145" />
                                <telerik:GridViewDataColumn Header="Voucher Type" DataMemberBinding="{Binding VoucherType}" Width="110" />
                                <telerik:GridViewDataColumn Header="Head" DataMemberBinding="{Binding Head}" Width="120" />
                                <telerik:GridViewDataColumn Header="Gross Wt" DataMemberBinding="{Binding GrossWt, StringFormat='{}{0:F3}'}" TextAlignment="Right" Width="90" />
                                <telerik:GridViewDataColumn Header="Net Wt" DataMemberBinding="{Binding NetWt, StringFormat='{}{0:F3}'}" TextAlignment="Right" Width="90" />
                                <telerik:GridViewDataColumn Header="Taxable Amt" DataMemberBinding="{Binding TaxableAmount, StringFormat='{}{0:N2}'}" TextAlignment="Right" Width="115" />
                                <telerik:GridViewDataColumn Header="Rate" DataMemberBinding="{Binding GstRate, StringFormat='{}{0:F2}%'}" TextAlignment="Right" Width="70" />
                                <telerik:GridViewDataColumn Header="IGST (₹)" DataMemberBinding="{Binding IgstAmount, StringFormat='{}{0:N2}'}" TextAlignment="Right" Width="95" />
                                <telerik:GridViewDataColumn Header="CGST (₹)" DataMemberBinding="{Binding CgstAmount, StringFormat='{}{0:N2}'}" TextAlignment="Right" Width="95" />
                                <telerik:GridViewDataColumn Header="SGST (₹)" DataMemberBinding="{Binding SgstAmount, StringFormat='{}{0:N2}'}" TextAlignment="Right" Width="95" />
                                <telerik:GridViewDataColumn Header="Total Tax (₹)" DataMemberBinding="{Binding TotalTax, StringFormat='{}{0:N2}'}" TextAlignment="Right" Width="105" />
                                <telerik:GridViewDataColumn Header="Net Amount (₹)" DataMemberBinding="{Binding NetAmount, StringFormat='{}{0:N2}'}" TextAlignment="Right" Width="115" />
                            </telerik:RadGridView.Columns>
                        </telerik:RadGridView>
                    </Grid>
                </telerik:RadTabItem>

                <!-- ════════ TAB 4: GST RECONCILIATION ════════ -->
                <telerik:RadTabItem Header="🔄 GST Reconciliation (2B vs Books)" FontSize="12.5" FontWeight="SemiBold">
                    <Grid Margin="0,8,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /> <!-- Upload Bar & Match Status Filter -->
                            <RowDefinition Height="Auto" /> <!-- KPI Summary Cards -->
                            <RowDefinition Height="*" />    <!-- Reconciled Grid -->
                        </Grid.RowDefinitions>

                        <!-- 1. Upload & Action Bar -->
                        <Border Grid.Row="0" Style="{StaticResource MetricCardStyle}" Margin="0,0,0,8" Padding="10,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <telerik:RadButton Content="📂 Upload GSTR-2B File (JSON / CSV)"
                                                       Style="{StaticResource PrimaryToolbarButtonStyle}"
                                                       
                                                       MinWidth="220"
                                                       Margin="0,0,10,0"
                                                       Command="{Binding ImportPortalFileCommand}"
                                                       ToolTip="Import downloaded GSTR-2B file from GST Portal" />

                                    <TextBlock Text="{Binding UploadedFileName, StringFormat='File: {0}'}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,16,0" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock Text="Tolerance (₹):" Style="{StaticResource FilterLabelStyle}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <telerik:RadNumericUpDown Value="{Binding ReconciliationTolerance, Mode=TwoWay}" Width="75" Margin="0,0,10,0" />

                                    <telerik:RadWatermarkTextBox Width="180" 
                                                                 Text="{Binding ReconciliationSearchText, UpdateSourceTrigger=PropertyChanged}"
                                                                 WatermarkContent="Search vendor/bill..."
                                                                 Margin="0,0,8,0" />

                                    <telerik:RadButton Content="Re-run Matching"
                                                       Style="{StaticResource ToolbarButtonStyle}"
                                                 
                                                       MinWidth="105"
                                                       Command="{Binding RunReconciliationCommand}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- 2. KPI Summary Cards -->
                        <Grid Grid.Row="1" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Matched Card -->
                            <Border Grid.Column="0" Style="{StaticResource MetricCardStyle}" BorderBrush="#16A34A" BorderThickness="1.5">
                                <StackPanel>
                                    <TextBlock Text="🟢 MATCHED ITC" FontSize="11" FontWeight="Bold" Foreground="#16A34A" />
                                    <TextBlock Text="{Binding ReconciliationSummary.MatchedTaxAmount, StringFormat='₹{0:N2}'}" FontSize="16" FontWeight="Bold" Foreground="#16A34A" Margin="0,2,0,0" />
                                    <TextBlock Text="{Binding ReconciliationSummary.MatchedCount, StringFormat='{}{0} Invoices matched perfectly'}" FontSize="10.5" Foreground="{DynamicResource SecondaryTextBrush}" />
                                </StackPanel>
                            </Border>

                            <!-- Mismatch Card -->
                            <Border Grid.Column="1" Style="{StaticResource MetricCardStyle}" BorderBrush="#D97706" BorderThickness="1.5">
                                <StackPanel>
                                    <TextBlock Text="🟡 AMOUNT / TAX MISMATCH" FontSize="11" FontWeight="Bold" Foreground="#D97706" />
                                    <TextBlock Text="{Binding ReconciliationSummary.MismatchCount, StringFormat='{}{0} Invoices'}" FontSize="16" FontWeight="Bold" Foreground="#D97706" Margin="0,2,0,0" />
                                    <TextBlock Text="Variance in taxable value / rate" FontSize="10.5" Foreground="{DynamicResource SecondaryTextBrush}" />
                                </StackPanel>
                            </Border>

                            <!-- In Books Only Card (Risk) -->
                            <Border Grid.Column="2" Style="{StaticResource MetricCardStyle}" BorderBrush="#DC2626" BorderThickness="1.5">
                                <StackPanel>
                                    <TextBlock Text="🔴 IN BOOKS ONLY (ITC RISK)" FontSize="11" FontWeight="Bold" Foreground="#DC2626" />
                                    <TextBlock Text="{Binding ReconciliationSummary.MissingIn2BTaxAmount, StringFormat='₹{0:N2}'}" FontSize="16" FontWeight="Bold" Foreground="#DC2626" Margin="0,2,0,0" />
                                    <TextBlock Text="{Binding ReconciliationSummary.MissingIn2BCount, StringFormat='{}{0} Bills missing in GSTR-2B'}" FontSize="10.5" Foreground="{DynamicResource SecondaryTextBrush}" />
                                </StackPanel>
                            </Border>

                            <!-- In 2B Only Card (Unclaimed) -->
                            <Border Grid.Column="3" Style="{StaticResource MetricCardStyle}" BorderBrush="#7C3AED" BorderThickness="1.5">
                                <StackPanel>
                                    <TextBlock Text="🟣 IN 2B ONLY (UNCLAIMED)" FontSize="11" FontWeight="Bold" Foreground="#7C3AED" />
                                    <TextBlock Text="{Binding ReconciliationSummary.MissingInBooksTaxAmount, StringFormat='₹{0:N2}'}" FontSize="16" FontWeight="Bold" Foreground="#7C3AED" Margin="0,2,0,0" />
                                    <TextBlock Text="{Binding ReconciliationSummary.MissingInBooksCount, StringFormat='{}{0} Portal bills not booked in ERP'}" FontSize="10.5" Foreground="{DynamicResource SecondaryTextBrush}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- 3. Reconciled Data Grid -->
                        <telerik:RadGridView Grid.Row="2"
                                             ItemsSource="{Binding FilteredReconciliationItems}"
                                             AutoGenerateColumns="False"
                                             IsReadOnly="True"
                                             ShowGroupPanel="True"
                                             RowIndicatorVisibility="Collapsed">
                            <telerik:RadGridView.Columns>
                                <!-- Status Badge -->
                                <telerik:GridViewDataColumn Header="Status" Width="140">
                                    <telerik:GridViewDataColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="4" Padding="6,2" Background="{Binding StatusColor}" HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding StatusText}" FontWeight="Bold" FontSize="10.5" Foreground="White" />
                                            </Border>
                                        </DataTemplate>
                                    </telerik:GridViewDataColumn.CellTemplate>
                                </telerik:GridViewDataColumn>

                                <!-- Books Details -->
                                <telerik:GridViewDataColumn Header="Books Bill No" DataMemberBinding="{Binding BooksBillNo}" Width="105" />
                                <telerik:GridViewDataColumn Header="Books Date" DataMemberBinding="{Binding BooksDate, StringFormat='{}{0:dd/MM/yyyy}'}" Width="95" />
                                <telerik:GridViewDataColumn Header="Books Supplier" DataMemberBinding="{Binding BooksSupplierName}" Width="170" />
                                <telerik:GridViewDataColumn Header="Books GSTIN" DataMemberBinding="{Binding BooksGstin}" Width="140" />
                                <telerik:GridViewDataColumn Header="Books Taxable" DataMemberBinding="{Binding BooksTaxableValue, StringFormat='{}{0:N2}'}" TextAlignment="Right" Width="105" />
                                <telerik:GridViewDataColumn Header="Books Total Tax" DataMemberBinding="{Binding BooksTotalTax, StringFormat='{}{0:N2}'}" TextAlignment="Right" Width="105" />

                                <!-- Portal Details -->
                                <telerik:GridViewDataColumn Header="Portal Bill No" DataMemberBinding="{Binding PortalBillNo}" Width="105" />
                                <telerik:GridViewDataColumn Header="Portal Date" DataMemberBinding="{Binding PortalDate, StringFormat='{}{0:dd/MM/yyyy}'}" Width="95" />
                                <telerik:GridViewDataColumn Header="Portal Supplier" DataMemberBinding="{Binding PortalSupplierName}" Width="170" />
                                <telerik:GridViewDataColumn Header="Portal GSTIN" DataMemberBinding="{Binding PortalGstin}" Width="140" />
                                <telerik:GridViewDataColumn Header="Portal Taxable" DataMemberBinding="{Binding PortalTaxableValue, StringFormat='{}{0:N2}'}" TextAlignment="Right" Width="105" />
                                <telerik:GridViewDataColumn Header="Portal Total Tax" DataMemberBinding="{Binding PortalTotalTax, StringFormat='{}{0:N2}'}" TextAlignment="Right" Width="105" />

                                <!-- Variance & Remarks -->
                                <telerik:GridViewDataColumn Header="Tax Diff (₹)" DataMemberBinding="{Binding DifferenceTax, StringFormat='{}{0:N2}'}" TextAlignment="Right" Width="95" />
                                <telerik:GridViewDataColumn Header="Remarks / Notes" DataMemberBinding="{Binding Remarks}" Width="220" />
                            </telerik:RadGridView.Columns>
                        </telerik:RadGridView>
                    </Grid>
                </telerik:RadTabItem>

            </telerik:RadTabControl>
        </telerik:RadBusyIndicator>

        <!-- 4. Status Bar -->
        <Border Grid.Row="3" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource HeaderBorderBrush}" BorderThickness="0,1,0,0" Padding="14,4">
            <TextBlock Text="{Binding StatusMessage}" FontSize="11.5" Foreground="{DynamicResource SecondaryTextBrush}" />
        </Border>
    </Grid>
</UserControl>
