<UserControl x:Class="ConceptJewelleryPro.WPF.Views.StaffCreationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
             xmlns:controls="clr-namespace:ConceptJewelleryPro.WPF.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1050"
             Background="{DynamicResource WindowBackgroundBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="FieldLabelBlock" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="MinWidth" Value="110"/>
        </Style>

        <Style x:Key="FieldLabelText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <!-- Toolbar -->
            <RowDefinition Height="Auto"/>
            <!-- Content Area -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Action Toolbar -->
        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="10,6"
                Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Action Buttons -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <telerik:RadButton x:Name="AddNewButton"
                                       Height="40"
                                       Style="{StaticResource PrimaryToolbarButtonStyle}"
                                       Command="{Binding NewCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Add New (Alt+A)" VerticalAlignment="Center"/>
                        </StackPanel>
                    </telerik:RadButton>

                    <telerik:RadButton x:Name="SaveButton"
                                       Height="40"
                                       Style="{StaticResource ToolbarButtonStyle}"
                                       Command="{Binding SaveCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Save (Alt+S)" VerticalAlignment="Center"/>
                        </StackPanel>
                    </telerik:RadButton>

                    <telerik:RadButton Style="{StaticResource ToolbarButtonStyle}"
                                       Height="40"
                                       Command="{Binding ModifyCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Modify (Alt+M)" VerticalAlignment="Center"/>
                        </StackPanel>
                    </telerik:RadButton>

                    <telerik:RadButton Style="{StaticResource DangerToolbarButtonStyle}"
                                       Height="40"
                                       Command="{Binding DeleteCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Delete (Alt+D)" VerticalAlignment="Center"/>
                        </StackPanel>
                    </telerik:RadButton>

                    <telerik:RadButton Style="{StaticResource ToolbarButtonStyle}"
                                       Height="40"
                                       Command="{Binding CancelCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Cancel (Alt+C)" VerticalAlignment="Center"/>
                        </StackPanel>
                    </telerik:RadButton>

                    <telerik:RadButton Style="{StaticResource ToolbarButtonStyle}"
                                       Height="40"
                                       Command="{Binding RefreshCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Refresh" VerticalAlignment="Center"/>
                        </StackPanel>
                    </telerik:RadButton>
                </StackPanel>

                <!-- Status Badge -->
                <Border Grid.Column="2"
                        Background="{DynamicResource PanelBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="10,4"
                        VerticalAlignment="Center">
                    <TextBlock Text="{Binding FormMode, StringFormat='Mode: {0}'}"
                               FontWeight="SemiBold"
                               FontSize="12"
                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                </Border>
            </Grid>
        </Border>

        <!-- Content Area: Left Form Card + Right Searchable Grid -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Form Input Column -->
                <ColumnDefinition Width="420"/>
                <!-- Divider -->
                <ColumnDefinition Width="14"/>
                <!-- List Column -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Staff Entry Card -->
            <Border Grid.Column="0"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="20"
                    VerticalAlignment="Top">
                <StackPanel>
                    <!-- Card Header -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <Border Width="36" Height="36" CornerRadius="6" Background="#E0F2FE" Margin="0,0,12,0">
                            <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#0284C7" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Staff Details" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock Text="Add or update staff member records" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Staff Name -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource FieldLabelBlock}">
                            <TextBlock Text="Staff Name" Style="{StaticResource FieldLabelText}"/>
                        </Border>
                        <TextBox x:Name="StaffNameTextBox"
                                 Grid.Column="1"
                                 Text="{Binding StaffName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding IsFormEnabled}"
                                 FontSize="13"
                                 Height="34"
                                 Padding="8,4"
                                 VerticalContentAlignment="Center"/>
                    </Grid>

                    <!-- Status -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource FieldLabelBlock}">
                            <TextBlock Text="Status" Style="{StaticResource FieldLabelText}"/>
                        </Border>
                        <telerik:RadComboBox Grid.Column="1"
                                             ItemsSource="{Binding StatusOptions}"
                                             SelectedItem="{Binding Status, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             IsEnabled="{Binding IsFormEnabled}"
                                             Height="34"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Right: Staff Members DataGrid -->
            <Border Grid.Column="2"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Search Bar -->
                        <RowDefinition Height="Auto"/>
                        <!-- Grid -->
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Search & Stats -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Height="32"
                                 Padding="8,4"
                                 FontSize="13"
                                 VerticalContentAlignment="Center"/>

                        <TextBlock Grid.Column="0"
                                   Text="Search staff by name or status..."
                                   Foreground="#888888"
                                   IsHitTestVisible="False"
                                   VerticalAlignment="Center"
                                   Margin="10,0,0,0"
                                   Visibility="{Binding SearchText, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"/>

                        <TextBlock Grid.Column="1"
                                   Text="{Binding FilteredStaffList.Count, StringFormat='Total Staff: {0}'}"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Margin="14,0,0,0"/>
                    </Grid>

                    <!-- Data Grid -->
                    <telerik:RadGridView Grid.Row="1"
                                         ItemsSource="{Binding FilteredStaffList}"
                                         SelectedItem="{Binding SelectedStaff, Mode=TwoWay}"
                                         AutoGenerateColumns="False"
                                         IsReadOnly="True"
                                         RowIndicatorVisibility="Collapsed"
                                         ShowGroupPanel="False"
                                         EnableRowVirtualization="True"
                                         SelectionMode="Single">
                        <telerik:RadGridView.Columns>
                            <telerik:GridViewDataColumn Header="Staff Name" DataMemberBinding="{Binding Staff}" Width="*"/>
                            <telerik:GridViewDataColumn Header="Status" DataMemberBinding="{Binding Status}" Width="110"/>
                            <telerik:GridViewDataColumn Header="Entry Date" DataMemberBinding="{Binding EntryDate, StringFormat='dd/MM/yyyy'}" Width="110"/>
                            <telerik:GridViewDataColumn Header="Entry User" DataMemberBinding="{Binding EntryUser}" Width="120"/>
                        </telerik:RadGridView.Columns>
                    </telerik:RadGridView>
                </Grid>
            </Border>
        </Grid>

        <!-- Toast Notification (Bottom Right) -->
        <controls:ToastNotification x:Name="ToastNotification"
                                    Grid.Row="1"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    Margin="0,0,24,24"/>
    </Grid>
</UserControl>
