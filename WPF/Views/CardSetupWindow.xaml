<Window x:Class="ConceptJewelleryPro.WPF.Views.CardSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
        Title="Card Setup" Width="780" Height="540" MinWidth="650" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Window.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TOP BAR -->
        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="14,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE8C7;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="{DynamicResource AccentBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Card Setup" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <TextBlock Text="Configure accepted cards, commission %, and display ordering"
                                   FontSize="11.5" Foreground="{DynamicResource SecondaryTextBrush}"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <telerik:RadButton Command="{Binding AddCardCommand}" Style="{StaticResource ToolbarButtonStyle}" Height="34" Padding="12,0" Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Add Card"/>
                        </StackPanel>
                    </telerik:RadButton>
                    <telerik:RadButton Command="{Binding DeleteCardCommand}" Style="{StaticResource DangerToolbarButtonStyle}" Height="34" Padding="12,0" Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Delete Card"/>
                        </StackPanel>
                    </telerik:RadButton>
                    <telerik:RadButton Command="{Binding MoveUpCommand}" Style="{StaticResource ToolbarButtonStyle}" Height="34" Padding="10,0" Margin="0,0,4,0" ToolTip="Move Up">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74A;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Up"/>
                        </StackPanel>
                    </telerik:RadButton>
                    <telerik:RadButton Command="{Binding MoveDownCommand}" Style="{StaticResource ToolbarButtonStyle}" Height="34" Padding="10,0" Margin="0,0,8,0" ToolTip="Move Down">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74B;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Down"/>
                        </StackPanel>
                    </telerik:RadButton>
                    <telerik:RadButton Command="{Binding SaveCommand}" Style="{StaticResource PrimaryToolbarButtonStyle}" Height="34" Padding="14,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Save"/>
                        </StackPanel>
                    </telerik:RadButton>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- MAIN GRID -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="0">
            <telerik:RadGridView x:Name="CardGrid"
                                 ItemsSource="{Binding Items}"
                                 SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                                 AutoGenerateColumns="False"
                                 CanUserInsertRows="False"
                                 CanUserDeleteRows="False"
                                 RowIndicatorVisibility="Collapsed"
                                 GridLinesVisibility="Both"
                                 ShowGroupPanel="False"
                                 IsReadOnly="False"
                                 BorderThickness="0">
                <telerik:RadGridView.Columns>
                    <!-- Order Column -->
                    <telerik:GridViewDataColumn Header="Order" DataMemberBinding="{Binding Order}" Width="75" IsReadOnly="True" TextAlignment="Center"/>

                    <!-- Card Bank Name Column -->
                    <telerik:GridViewComboBoxColumn Header="Card / Bank Name"
                                                    DataMemberBinding="{Binding CardBank, Mode=TwoWay}"
                                                    ItemsSource="{Binding DataContext.AvailableBankAccounts, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    Width="*"/>

                    <!-- Card Commission Column -->
                    <telerik:GridViewDataColumn Header="Commission %" DataMemberBinding="{Binding CardComm, Mode=TwoWay, StringFormat='{}{0:N2}'}" Width="130" TextAlignment="Right"/>

                    <!-- SBI Column -->
                    <telerik:GridViewDataColumn Header="SBI %" DataMemberBinding="{Binding Sbi, Mode=TwoWay, StringFormat='{}{0:N2}'}" Width="130" TextAlignment="Right"/>
                </telerik:RadGridView.Columns>
            </telerik:RadGridView>
        </Border>

        <!-- FOOTER / STATUS BAR -->
        <Border Grid.Row="4" Style="{StaticResource CardStyle}" Padding="12,8">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="{Binding StatusMessage}" VerticalAlignment="Center"
                           FontSize="12" Foreground="{DynamicResource PrimaryTextBrush}"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <telerik:RadButton Content="Close" Click="CloseButton_Click" Width="80" Height="30"
                                       Style="{StaticResource ToolbarButtonStyle}"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
