<UserControl x:Class="ConceptJewelleryPro.WPF.Views.AccountCreationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
             xmlns:controls="clr-namespace:ConceptJewelleryPro.WPF.Controls"
             FontFamily="Segoe UI"
             TextOptions.TextFormattingMode="Display">

    <UserControl.InputBindings>
        <KeyBinding Key="A" Modifiers="Alt" Command="{Binding AddNewCommand}" />
        <KeyBinding Key="G" Modifiers="Alt" Command="{Binding AddNewFromGstnCommand}" />
        <KeyBinding Key="M" Modifiers="Alt" Command="{Binding ModifyCommand}" />
        <KeyBinding Key="D" Modifiers="Alt" Command="{Binding DeleteCommand}" />
    </UserControl.InputBindings>

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
        </Style>

        <Style x:Key="ToolbarButtonStyle" TargetType="telerik:RadButton" BasedOn="{StaticResource RadButtonStyle}">
            <Setter Property="Height" Value="40" />
            <Setter Property="MinWidth" Value="85" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>

        
      
     
    </UserControl.Resources>

    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Header & Toolbar -->
            <RowDefinition Height="*" />    <!-- Ledger Accounts DataGrid -->
        </Grid.RowDefinitions>

        <!-- Toast Notifications Container -->
        <controls:ToastNotification x:Name="ToastNotification"
                                     Grid.Row="0"
                                     Grid.RowSpan="2"
                                     Panel.ZIndex="99"
                                     Message="{Binding ToastMessage, FallbackValue=''}"
                                     ToastType="{Binding ToastType, FallbackValue=Info}"
                                     AutoCloseDelay="6000"
                                     FontSize="14" />

        <!-- Header & Top Action Toolbar -->
        <Border Grid.Row="0"
                Background="{DynamicResource HeaderBackgroundBrush}"
                BorderBrush="{DynamicResource HeaderBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Page Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <Border Width="34" Height="34" CornerRadius="6" Background="{DynamicResource PanelBrush}">
                        <TextBlock Text="&#xE77B;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="15"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Ledger Accounts" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                        <TextBlock Text="Manage master account directory" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" />
                    </StackPanel>
                </StackPanel>

                <!-- Toolbar Action Buttons & Search Filter -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <telerik:RadButton Content="+ Add New (Alt+A)" Style="{StaticResource PrimaryToolbarButtonStyle}" Command="{Binding AddNewCommand}" ToolTip="Create new ledger account (Alt+A)" />
                    <telerik:RadButton Content="✏ Modify (Alt+M)" Style="{StaticResource ToolbarButtonStyle}" Command="{Binding ModifyCommand}" ToolTip="Modify selected account (Alt+M)" />
                    <telerik:RadButton Content="🗑 Delete (Alt+D)" Style="{StaticResource ToolbarButtonStyle}" Command="{Binding DeleteCommand}" ToolTip="Delete selected account (Alt+D)" />
                    <telerik:RadButton Content="⚡ Add From GSTIN (Alt+G)" Style="{StaticResource ToolbarButtonStyle}" Command="{Binding AddNewFromGstnCommand}" ToolTip="Fetch profile from MastersIndia GSTIN API (Alt+G)" />

                    <!-- Print Split DropDown Button -->
                    <telerik:RadDropDownButton Content="🖨 Print" Height="40" FontSize="12" FontWeight="SemiBold" Margin="0,0,6,0">
                        <telerik:RadDropDownButton.DropDownContent>
                            <Border Background="White" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="4" Padding="4">
                                <StackPanel MinWidth="170">
                                    <telerik:RadButton Content="All Accounts Summary" Height="28" Padding="8,0" HorizontalContentAlignment="Left" Command="{Binding PrintFormatCommand}" CommandParameter="All Accounts Summary" BorderThickness="0" Background="Transparent" />
                                    <telerik:RadButton Content="Sundry Debtors List" Height="28" Padding="8,0" HorizontalContentAlignment="Left" Command="{Binding PrintFormatCommand}" CommandParameter="Sundry Debtors List" BorderThickness="0" Background="Transparent" />
                                    <telerik:RadButton Content="Sundry Creditors List" Height="28" Padding="8,0" HorizontalContentAlignment="Left" Command="{Binding PrintFormatCommand}" CommandParameter="Sundry Creditors List" BorderThickness="0" Background="Transparent" />
                                    <telerik:RadButton Content="GST Directory" Height="28" Padding="8,0" HorizontalContentAlignment="Left" Command="{Binding PrintFormatCommand}" CommandParameter="GST Directory" BorderThickness="0" Background="Transparent" />
                                </StackPanel>
                            </Border>
                        </telerik:RadDropDownButton.DropDownContent>
                    </telerik:RadDropDownButton>

                    <telerik:RadButton Content="📊 Export To Excel" Style="{StaticResource ToolbarButtonStyle}" Command="{Binding ExportToExcelCommand}" ToolTip="Export current list to CSV/Excel" />

                    <!-- Column Chooser DropDown Button -->
                    <telerik:RadDropDownButton x:Name="ColumnChooserButton"
                                               Content="⚙ Columns"
                                               Height="40"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Margin="0,0,6,0"
                                               ToolTip="Choose visible columns and save grid layout"
                                               IsTabStop="False"
                                               DropDownOpened="ColumnChooserButton_DropDownOpened">
                        <telerik:RadDropDownButton.DropDownContent>
                            <Border Background="{DynamicResource CardBackgroundBrush}"
                                    BorderBrush="{DynamicResource CardBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    MinWidth="240"
                                    MaxWidth="290">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.25" Color="#000000" />
                                </Border.Effect>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Header / Title -->
                                    <Border Grid.Row="0"
                                            Background="{DynamicResource HeaderBackgroundBrush}"
                                            BorderBrush="{DynamicResource CardBorderBrush}"
                                            BorderThickness="0,0,0,1"
                                            CornerRadius="5,5,0,0"
                                            Padding="12,8">
                                        <Grid>
                                            <TextBlock Text="Column Chooser"
                                                       FontWeight="Bold"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Text="Reset Default"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AccentBrush}"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Center"
                                                       Cursor="Hand"
                                                       MouseLeftButtonUp="ResetColumns_Click"
                                                       ToolTip="Reset to default columns" />
                                        </Grid>
                                    </Border>

                                    <!-- Scrollable Checkboxes List -->
                                    <ScrollViewer Grid.Row="1"
                                                  MaxHeight="320"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  Padding="10,6">
                                        <ItemsControl x:Name="ColumnChooserList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <CheckBox Content="{Binding Header}"
                                                              IsChecked="{Binding IsVisible, Mode=TwoWay}"
                                                              Foreground="{DynamicResource PrimaryTextBrush}"
                                                              FontSize="12"
                                                              Margin="4,4"
                                                              Cursor="Hand" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>

                                    <!-- Actions Footer -->
                                    <Border Grid.Row="2"
                                            Background="{DynamicResource HeaderBackgroundBrush}"
                                            BorderBrush="{DynamicResource CardBorderBrush}"
                                            BorderThickness="0,1,0,0"
                                            CornerRadius="0,0,5,5"
                                            Padding="8,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <telerik:RadButton Content="Select All"
                                                               Grid.Column="0"
                                                               Height="28"
                                                               FontSize="11"
                                                               Margin="0,0,4,0"
                                                               Click="SelectAllColumns_Click"
                                                               Cursor="Hand" />
                                            <telerik:RadButton x:Name="SaveSettingsOptionButton"
                                                               Content="Save Layout"
                                                               Grid.Column="1"
                                                               Height="28"
                                                               FontWeight="SemiBold"
                                                               FontSize="11"
                                                               Background="{DynamicResource AccentBrush}"
                                                               Foreground="White"
                                                               BorderThickness="0"
                                                               Margin="4,0,0,0"
                                                               Click="SaveSettingsOption_Click"
                                                               ToolTip="Save current column visibility and layout"
                                                               Cursor="Hand" />
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>
                        </telerik:RadDropDownButton.DropDownContent>
                    </telerik:RadDropDownButton>

                    <Border Width="1" Background="{DynamicResource SeparatorBrush}" Margin="4,4,10,4" />

                    <!-- Contains Search Filter Box -->
                    <telerik:RadWatermarkTextBox x:Name="SearchBox"
                                                 Width="240"
                                                 Height="40"
                                                 WatermarkContent="Search accounts (contains)... Alt+X"
                                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                                 Padding="8,0"
                                                 FontSize="12"
                                                 VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Body DataGrid -->
        <telerik:RadBusyIndicator Grid.Row="1" IsBusy="{Binding IsBusy}" BusyContent="Loading accounts...">
            <Grid Margin="16">
                <Border Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Header Info & Item Count -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <TextBlock Text="Ledger Accounts Directory" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding FilteredAccounts.Count, StringFormat='Showing {0} Accounts (Double-click row to modify)'}"
                                       FontSize="11.5"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <!-- DataGrid with Contains Filtering -->
                        <telerik:RadGridView Grid.Row="1"
                                  x:Name="AccountsGrid"
                                  ItemsSource="{Binding FilteredAccounts}"
                                  SelectedItem="{Binding SelectedAccount, Mode=TwoWay}"
                                  IsSynchronizedWithCurrentItem="False"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#E5E5E5"
                                  RowHeight="40"
                                  FontSize="14"
                                  BorderThickness="1"
                                  MouseDoubleClick="Grid_MouseDoubleClick">
                            <telerik:RadGridView.Columns>
                                <telerik:GridViewDataColumn Header="Party Code" DataMemberBinding="{Binding PartyCode}" Width="200" />
                                <telerik:GridViewDataColumn Header="Account Name" DataMemberBinding="{Binding AccountName}" Width="*" />
                                <telerik:GridViewDataColumn Header="Head Category" DataMemberBinding="{Binding HeadCategory}" Width="150" />
                                <telerik:GridViewDataColumn Header="Sub Category" DataMemberBinding="{Binding SubCategory}" Width="130" />
                                <telerik:GridViewDataColumn Header="City" DataMemberBinding="{Binding City}" Width="150" />
                                <telerik:GridViewDataColumn Header="State" DataMemberBinding="{Binding State}" Width="150" />
                                <telerik:GridViewDataColumn Header="Mobile" DataMemberBinding="{Binding Mobile}" Width="150" />
                                <telerik:GridViewDataColumn Header="GSTIN / VatNo" DataMemberBinding="{Binding VatNo}" Width="200" />
                                <telerik:GridViewDataColumn Header="Opening Amt" DataMemberBinding="{Binding OpAmt1, StringFormat=N2}" Width="150" />
                                <telerik:GridViewDataColumn Header="Opening Gold Wt" DataMemberBinding="{Binding OpGoldWeight, StringFormat=N3}" Width="140" IsVisible="False" />
                                <telerik:GridViewDataColumn Header="Credit Limit" DataMemberBinding="{Binding CreditLimit, StringFormat=N2}" Width="130" IsVisible="False" />
                                <telerik:GridViewDataColumn Header="Credit Days" DataMemberBinding="{Binding CreditDays, StringFormat=N0}" Width="110" IsVisible="False" />
                                <telerik:GridViewDataColumn Header="Interest (%)" DataMemberBinding="{Binding Interest, StringFormat=N2}" Width="110" IsVisible="False" />
                                <telerik:GridViewDataColumn Header="Email" DataMemberBinding="{Binding Email}" Width="180" IsVisible="False" />
                                <telerik:GridViewDataColumn Header="Bank A/c" DataMemberBinding="{Binding BankAc}" Width="160" IsVisible="False" />
                                <telerik:GridViewDataColumn Header="Address" DataMemberBinding="{Binding Address}" Width="200" IsVisible="False" />
                                <telerik:GridViewDataColumn Header="Address 2" DataMemberBinding="{Binding Address2}" Width="180" IsVisible="False" />
                                <telerik:GridViewDataColumn Header="Pin Code" DataMemberBinding="{Binding PinCode}" Width="100" IsVisible="False" />
                                <telerik:GridViewDataColumn Header="Phone No" DataMemberBinding="{Binding PhoneNo}" Width="140" IsVisible="False" />
                                <telerik:GridViewDataColumn Header="STD Code" DataMemberBinding="{Binding StdCode}" Width="90" IsVisible="False" />
                                <telerik:GridViewDataColumn Header="GST Type" DataMemberBinding="{Binding VatType}" Width="110" IsVisible="False" />
                                <telerik:GridViewDataColumn Header="In/Out" DataMemberBinding="{Binding InOut}" Width="90" IsVisible="False" />
                                <telerik:GridViewDataColumn Header="Ref Name" DataMemberBinding="{Binding RefName}" Width="140" IsVisible="False" />
                                <telerik:GridViewDataColumn Header="PAN No" DataMemberBinding="{Binding PanNo}" Width="130" IsVisible="False" />
                                <telerik:GridViewDataColumn Header="Status" DataMemberBinding="{Binding Status}" Width="100" IsVisible="False" />
                            </telerik:RadGridView.Columns>
                        </telerik:RadGridView>
                    </Grid>
                </Border>
            </Grid>
        </telerik:RadBusyIndicator>
    </Grid>
</UserControl>