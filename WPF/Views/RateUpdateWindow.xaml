<Window x:Class="ConceptJewelleryPro.WPF.Views.RateUpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
        xmlns:controls="clr-namespace:ConceptJewelleryPro.WPF.Controls"
        Title="{Binding Title}"
        Width="780"
        Height="580"
        MinHeight="450"
        MinWidth="650"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display"
        Background="{DynamicResource WindowBackgroundBrush}">

    <Window.InputBindings>
        <KeyBinding Modifiers="Alt" Key="S" Command="{Binding SaveCommand}" />
        <KeyBinding Key="F10" Command="{Binding SaveCommand}" />
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
    </Window.InputBindings>

    <Window.Resources>

        <Style TargetType="{x:Type telerik:RadWatermarkTextBox}" BasedOn="{StaticResource RadWatermarkTextBoxStyle}">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style TargetType="{x:Type telerik:RadNumericUpDown}" BasedOn="{StaticResource RadNumericUpDownStyle}">
            <Setter Property="Height" Value="34"/>
        </Style>

        <Style TargetType="{x:Type telerik:RadComboBox}" BasedOn="{StaticResource RadComboBoxStyle}">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="8,0,4,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Toast Notification -->
        <controls:ToastNotification Grid.Row="0"
                                    Grid.RowSpan="4"
                                    Panel.ZIndex="99"
                                    Message="{Binding ToastMessage}"
                                    ToastType="{Binding ToastType}" />

        <!-- Header -->
        <Border Grid.Row="0"
                Background="{DynamicResource HeaderBackgroundBrush}"
                BorderBrush="{DynamicResource HeaderBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="38" Height="38" CornerRadius="8" Background="{DynamicResource PanelBrush}">
                        <TextBlock Text="&#xEC05;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="18"
                                   Foreground="DarkGoldenrod"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" />
                        <TextBlock Text="Update current metal rates per gram • Changes are recorded in RateMaster log &amp; Purity table" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" />
                    </StackPanel>
                </StackPanel>

                <!-- Date & Time Badge -->
                <Border Grid.Column="1"
                        Background="{DynamicResource PanelBrush}"
                        BorderBrush="{DynamicResource HeaderBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12,6"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding EffectiveDate, StringFormat='{}{0:dd/MM/yyyy}'}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" />
                        <TextBlock Text=" • " Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding EffectiveTimeString}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Filter & Quick Adjust Toolbar -->
        <Border Grid.Row="1"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource HeaderBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Category Filter -->
                <TextBlock Grid.Column="0" Text="Category:" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,8,0" />
                <telerik:RadComboBox Grid.Column="1"
                                     ItemsSource="{Binding ItemHeads}"
                                     SelectedItem="{Binding SelectedItemHead, UpdateSourceTrigger=PropertyChanged}"
                                     IsEditable="False" />

                <!-- Search -->
                <TextBlock Grid.Column="3" Text="Search:" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,8,0" />
                <telerik:RadWatermarkTextBox Grid.Column="4"
                                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                             WatermarkContent="Filter purity..." />

                <!-- Quick Offset Adjust -->
                <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Quick Adjust:" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,6,0" />
                    <telerik:RadNumericUpDown Value="{Binding QuickOffsetAmount, UpdateSourceTrigger=PropertyChanged}"
                                              CustomUnit="₹"
                                              NumberDecimalDigits="2"
                                              Width="110"
                                              Height="34"
                                              Margin="0,0,6,0" />
                    <telerik:RadButton Content="Apply"
                                       Command="{Binding ApplyQuickOffsetCommand}"
                                       Height="34"
                                       Padding="10,0"
                                       FontSize="12" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Purities Rate Grid -->
        <telerik:RadBusyIndicator Grid.Row="2" IsBusy="{Binding IsBusy, Mode=OneWay}" BusyContent="Updating rates...">
            <telerik:RadGridView ItemsSource="{Binding Rows}"
                                 AutoGenerateColumns="False"
                                 CanUserSortColumns="True"
                                 IsFilteringAllowed="False"
                                 CanUserInsertRows="False"
                                 CanUserDeleteRows="False"
                                 ShowGroupPanel="False"
                                 RowIndicatorVisibility="Collapsed"
                                 SelectionMode="Single"
                                 BorderThickness="0"
                                 FontSize="13"
                                 RowHeight="38">
                <telerik:RadGridView.Columns>
                    <!-- Purity Name -->
                    <telerik:GridViewColumn Header="Purity" Width="160">
                        <telerik:GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Purity}" FontWeight="Bold" VerticalAlignment="Center" Margin="4,0" />
                            </DataTemplate>
                        </telerik:GridViewColumn.CellTemplate>
                    </telerik:GridViewColumn>

                    <!-- Item Head -->
                    <telerik:GridViewDataColumn Header="Item Head"
                                                DataMemberBinding="{Binding ItemHead}"
                                                IsReadOnly="True"
                                                Width="120" />

                    <!-- Item Type -->
                    <telerik:GridViewDataColumn Header="Item Type"
                                                DataMemberBinding="{Binding ItemType}"
                                                IsReadOnly="True"
                                                Width="*" />

                    <!-- Current Rate -->
                    <telerik:GridViewColumn Header="Current Rate (₹/g)" Width="140">
                        <telerik:GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding CurrentRate, StringFormat='₹ {0:N2}'}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           Margin="4,0" />
                            </DataTemplate>
                        </telerik:GridViewColumn.CellTemplate>
                    </telerik:GridViewColumn>

                    <!-- New Rate (Editable) -->
                    <telerik:GridViewColumn Header="New Rate (₹/g)" Width="150">
                        <telerik:GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <telerik:RadNumericUpDown Value="{Binding NewRate, UpdateSourceTrigger=PropertyChanged}"
                                                          CustomUnit="₹"
                                                          NumberDecimalDigits="2"
                                                          Minimum="0"
                                                          Maximum="1000000"
                                                          HorizontalAlignment="Stretch"
                                                          Margin="2" />
                            </DataTemplate>
                        </telerik:GridViewColumn.CellTemplate>
                    </telerik:GridViewColumn>

                    <!-- Difference -->
                    <telerik:GridViewColumn Header="Change" Width="100">
                        <telerik:GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="4"
                                        Padding="6,2"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPositiveDifference}" Value="True">
                                                    <Setter Property="Background" Value="#1A28A745" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsNegativeDifference}" Value="True">
                                                    <Setter Property="Background" Value="#1ADC3545" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding DifferenceText}"
                                               FontWeight="SemiBold"
                                               FontSize="12">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPositiveDifference}" Value="True">
                                                        <Setter Property="Foreground" Value="#28A745" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsNegativeDifference}" Value="True">
                                                        <Setter Property="Foreground" Value="#DC3545" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </telerik:GridViewColumn.CellTemplate>
                    </telerik:GridViewColumn>
                </telerik:RadGridView.Columns>
            </telerik:RadGridView>
        </telerik:RadBusyIndicator>

        <!-- Footer Actions -->
        <Border Grid.Row="3"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource HeaderBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Status Info -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusMessage}"
                               FontSize="12.5"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- Action Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <telerik:RadButton Content="Reset Changes"
                                       Width="110"
                                       Height="36"
                                       Margin="0,0,10,0"
                                       Command="{Binding ResetCommand}"
                                       IsTabStop="False" />
                    <telerik:RadButton Content="Cancel (Esc)"
                                       Width="95"
                                       Height="36"
                                       Margin="0,0,10,0"
                                       Command="{Binding CancelCommand}"
                                       IsTabStop="False" />
                    <telerik:RadButton Content="Save Rates (Alt+S)"
                                       Width="140"
                                       Height="36"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       Background="CadetBlue"
                                       Command="{Binding SaveCommand}"
                                       IsTabStop="True" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
