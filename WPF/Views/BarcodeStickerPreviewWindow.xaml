<Window x:Class="ConceptJewelleryPro.WPF.Views.BarcodeStickerPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
        Title="Barcode Sticker Print Preview"
        Width="680"
        Height="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="Segoe UI">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12,10"
                Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="HeaderTitleText"
                               Text="Barcode Sticker Preview"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}" />
                    <TextBlock x:Name="HeaderSubtitleText"
                               Text="Format: StickerWt | Printer: Godex EZ520"
                               FontSize="11.5"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Margin="0,2,0,0" />
                </StackPanel>
                <Border Grid.Column="1"
                        Background="#EBF3FC"
                        BorderBrush="#BAD3F7"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="8,4"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="EngineBadgeText"
                               Text="FRX"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="#185ABD" />
                </Border>
            </Grid>
        </Border>

        <!-- Preview Area -->
        <Border Grid.Row="1"
                Background="#2D3748"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="16">
            <Grid>
                <!-- FRX Image Preview -->
                <Border x:Name="FrxImagePanel"
                        Background="White"
                        BorderBrush="Black"
                        BorderThickness="1"
                        Padding="6"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="Collapsed">
                    <Image x:Name="FrxPreviewImage"
                           Stretch="Uniform"
                           MaxWidth="580"
                           MaxHeight="200"
                           RenderOptions.BitmapScalingMode="NearestNeighbor" />
                </Border>

                <!-- PRN Visual + ZPL Preview -->
                <Grid x:Name="PrnPreviewPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Visual Sticker Mockup -->
                    <Border Grid.Row="0"
                            Background="White"
                            BorderBrush="Black"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="12,8"
                            Width="460"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="1" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Left Flap -->
                            <StackPanel Grid.Column="0" Margin="0,0,10,0" VerticalAlignment="Center">
                                <TextBlock x:Name="PrnLeftLine1" FontSize="12" FontWeight="Bold" Foreground="Black" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="PrnLeftLine2" FontSize="11" FontWeight="SemiBold" Foreground="Black" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="PrnLeftLine3" FontSize="10.5" Foreground="#222" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="PrnLeftLine4" FontSize="10" Foreground="#333" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <Border Grid.Column="1" Background="#CBD5E1" Margin="0,2" />

                            <!-- Right Flap -->
                            <StackPanel Grid.Column="2" Margin="10,0,0,0" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="TATTVA JEWELS" FontSize="10.5" FontWeight="Bold" Foreground="Black" HorizontalAlignment="Center" />
                                <Image x:Name="PrnBarcodeImage" Height="34" Margin="0,3" Stretch="Uniform" />
                                <TextBlock x:Name="PrnBarcodeText" FontSize="10.5" FontWeight="Bold" Foreground="Black" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Raw PRN / ZPL Commands -->
                    <TextBox x:Name="PrnRawCommandBox"
                             Grid.Row="1"
                             IsReadOnly="True"
                             FontFamily="Consolas"
                             FontSize="11"
                             Background="#1E293B"
                             Foreground="#E2E8F0"
                             BorderThickness="0"
                             Padding="8"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto" />
                </Grid>
            </Grid>
        </Border>

        <!-- Footer Buttons -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,14,0,0">
            <telerik:RadButton Content="Cancel (Esc)"
                               MinWidth="100"
                               Height="34"
                               Margin="0,0,10,0"
                               Click="CancelButton_Click" />
            <telerik:RadButton Content="Print Sticker (F10)"
                               MinWidth="140"
                               Height="34"
                               Background="{DynamicResource AccentBrush}"
                               Foreground="{DynamicResource AccentTextBrush}"
                               FontWeight="SemiBold"
                               Click="PrintButton_Click" />
        </StackPanel>
    </Grid>
</Window>
