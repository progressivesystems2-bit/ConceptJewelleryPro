<UserControl x:Class="ConceptJewelleryPro.WPF.Views.LedgerGroupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
             xmlns:controls="clr-namespace:ConceptJewelleryPro.WPF.Controls"
             xmlns:vm="clr-namespace:ConceptJewelleryPro.WPF.ViewModels"
             FontFamily="Segoe UI"
             TextOptions.TextFormattingMode="Display">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12,8"/>
        </Style>

        <Style x:Key="KpiCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <!-- Toast Notification -->
        <controls:ToastNotification x:Name="ToastNotification"
                                     Panel.ZIndex="99"
                                     Message="{Binding ToastMessage, FallbackValue=''}"
                                     ToastType="{Binding ToastType, FallbackValue=Info}"
                                     AutoCloseDelay="4000"
                                     FontSize="13"
                                     HorizontalAlignment="Right"
                                     VerticalAlignment="Top"
                                     Margin="0,16,24,0"/>

        <Grid Margin="12,8">
            <Grid.RowDefinitions>
                <!-- 0: KPI Summary Metric Cards -->
                <RowDefinition Height="Auto"/>
                <!-- 1: Filter & Action Bar -->
                <RowDefinition Height="Auto"/>
                <!-- 2: Main Group Accounts Summary Grid -->
                <RowDefinition Height="*"/>
                <!-- 3: Selected Account Detailed Transactions Drawer -->
                <RowDefinition Height="185"/>
            </Grid.RowDefinitions>

            <!-- 0: KPI Metric Cards -->
            <Grid Grid.Row="0" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="1.3*"/>
                    <ColumnDefinition Width="1.3*"/>
                </Grid.ColumnDefinitions>

                <!-- Accounts Count -->
                <Border Grid.Column="0" Style="{StaticResource KpiCardStyle}">
                    <StackPanel>
                        <TextBlock Text="GROUP ACCOUNTS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <TextBlock Text="{Binding TotalAccountsCount}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,2,0,0"/>
                        <TextBlock Text="{Binding SelectedHeadCategory, StringFormat='Category: {0}'}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                    </StackPanel>
                </Border>

                <!-- Opening Balance -->
                <Border Grid.Column="1" Style="{StaticResource KpiCardStyle}">
                    <StackPanel>
                        <TextBlock Text="TOTAL OPENING BALANCE" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock Text="{Binding TotalOpeningDebit, StringFormat=N2}" FontSize="18" FontWeight="Bold" Foreground="RoyalBlue"/>
                            <TextBlock Text=" Dr" FontSize="13" FontWeight="Bold" Foreground="RoyalBlue" VerticalAlignment="Bottom" Margin="2,0,8,1"/>
                            <TextBlock Text="{Binding TotalOpeningCredit, StringFormat=N2}" FontSize="18" FontWeight="Bold" Foreground="DarkOrange"/>
                            <TextBlock Text=" Cr" FontSize="13" FontWeight="Bold" Foreground="DarkOrange" VerticalAlignment="Bottom" Margin="2,0,0,1"/>
                        </StackPanel>
                        <TextBlock Text="{Binding UnitLabel, StringFormat='Unit: {0}'}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                    </StackPanel>
                </Border>

                <!-- Period Debits / Credits -->
                <Border Grid.Column="2" Style="{StaticResource KpiCardStyle}">
                    <StackPanel>
                        <TextBlock Text="PERIOD TURNOVER" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock Text="{Binding TotalPeriodDebit, StringFormat=N2}" FontSize="18" FontWeight="Bold" Foreground="RoyalBlue"/>
                            <TextBlock Text=" Dr" FontSize="13" FontWeight="Bold" Foreground="RoyalBlue" VerticalAlignment="Bottom" Margin="2,0,8,1"/>
                            <TextBlock Text="{Binding TotalPeriodCredit, StringFormat=N2}" FontSize="18" FontWeight="Bold" Foreground="DarkOrange"/>
                            <TextBlock Text=" Cr" FontSize="13" FontWeight="Bold" Foreground="DarkOrange" VerticalAlignment="Bottom" Margin="2,0,0,1"/>
                        </StackPanel>
                        <TextBlock Text="Total transactions in range" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                    </StackPanel>
                </Border>

                <!-- Net Group Closing Balance -->
                <Border Grid.Column="3" Style="{StaticResource KpiCardStyle}" Margin="0">
                    <StackPanel>
                        <TextBlock Text="NET GROUP CLOSING BALANCE" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock Text="{Binding NetClosingBalance, StringFormat=N2}" FontSize="22" FontWeight="Bold" Foreground="ForestGreen"/>
                            <TextBlock Text="{Binding NetClosingType, StringFormat=' {0}'}" FontSize="16" FontWeight="Bold" Foreground="ForestGreen" VerticalAlignment="Bottom" Margin="2,0,0,2"/>
                        </StackPanel>
                        <TextBlock Text="Net outstanding for group" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 1: Filter & Action Bar -->
            <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Head Category & Unit Toggle -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Head Group:" VerticalAlignment="Center" FontWeight="Bold" FontSize="12" Margin="0,0,6,0"/>
                        <telerik:RadComboBox x:Name="HeadGroupComboBox"
                                             ItemsSource="{Binding HeadCategories}"
                                             SelectedItem="{Binding SelectedHeadCategory, Mode=TwoWay}"
                                             Text="{Binding SelectedHeadCategory, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                             IsEditable="True"
                                             IsFilteringEnabled="True"
                                             TextSearchMode="Contains"
                                             IsTextSearchEnabled="True"
                                             OpenDropDownOnFocus="True"
                                             StaysOpenOnEdit="True"
                                             CanAutocompleteSelectItems="False"
                                             ClearSelectionButtonVisibility="Collapsed"
                                             Width="200" Height="30" Margin="0,0,12,0"
                                             KeyDown="HeadGroupComboBox_KeyDown">
                            <telerik:RadComboBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel VirtualizationMode="Recycling" />
                                </ItemsPanelTemplate>
                            </telerik:RadComboBox.ItemsPanel>
                        </telerik:RadComboBox>

                        <!-- Mode Toggle -->
                        <Border Background="{DynamicResource WindowBackgroundBrush}" CornerRadius="4" Padding="2" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Content="Rupees (₹)" IsChecked="{Binding IsRupeesMode, Mode=TwoWay}"
                                             GroupName="LedgerUnit" Margin="4,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                <RadioButton Content="Weight (g)" IsChecked="{Binding IsWeightMode, Mode=TwoWay}"
                                             GroupName="LedgerUnit" Margin="4,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Center: Dates & Quick Presets & Search -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0">
                        <TextBlock Text="From:" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12" Margin="0,0,4,0"/>
                        <DatePicker SelectedDate="{Binding FromDate, Mode=TwoWay}" Width="110" Height="30" Margin="0,0,8,0"/>

                        <TextBlock Text="To:" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12" Margin="0,0,4,0"/>
                        <DatePicker SelectedDate="{Binding ToDate, Mode=TwoWay}" Width="110" Height="30" Margin="0,0,8,0"/>

                        <telerik:RadButton Content="FY" Command="{Binding SetThisFYCommand}" Height="28" Padding="6,0" Margin="0,0,4,0" ToolTip="Current Financial Year"/>
                        <telerik:RadButton Content="Month" Command="{Binding SetThisMonthCommand}" Height="28" Padding="6,0" Margin="0,0,4,0" ToolTip="This Month"/>
                        <telerik:RadButton Content="Today" Command="{Binding SetTodayCommand}" Height="28" Padding="6,0" Margin="0,0,12,0" ToolTip="Today"/>

                        <CheckBox Content="Hide 0 Bal" IsChecked="{Binding HideZeroBalances, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,12,0" FontWeight="SemiBold"/>

                        <telerik:RadWatermarkTextBox Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     WatermarkContent="Search Account, City, Phone..."
                                                     Width="200" Height="30"/>
                    </StackPanel>

                    <!-- Right: Action Buttons -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <telerik:RadButton Content="&#xE72C;" FontFamily="Segoe MDL2 Assets"
                                           Command="{Binding RefreshCommand}"
                                           ToolTip="Refresh Report"
                                           Height="30" Width="32" Margin="0,0,4,0"/>
                        <telerik:RadButton Content="Export Excel" Command="{Binding ExportToExcelCommand}" Height="30" Padding="10,0" Margin="0,0,4,0"/>
                        <telerik:RadButton Content="Print Statement" Command="{Binding PrintCommand}" Height="30" Padding="10,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2: Main Group Accounts Summary Grid -->
            <Grid Grid.Row="2" Margin="0,0,0,8">
                <!-- Rupees Mode Main Grid -->
                <Border Style="{StaticResource CardStyle}" Padding="6"
                        Visibility="{Binding IsRupeesMode, Converter={StaticResource BoolToVis}}">
                    <telerik:RadGridView ItemsSource="{Binding DisplayedSummaries}"
                                         SelectedItem="{Binding SelectedAccountItem, Mode=TwoWay}"
                                         AutoGenerateColumns="False"
                                         CanUserSortColumns="True"
                                         IsReadOnly="True"
                                         RowIndicatorVisibility="Collapsed"
                                         ShowGroupPanel="False"
                                         VirtualizingPanel.IsVirtualizing="True"
                                         VirtualizingPanel.VirtualizationMode="Recycling">
                        <telerik:RadGridView.Columns>
                            <!-- Account Name -->
                            <telerik:GridViewDataColumn Header="Account Name" DataMemberBinding="{Binding AccountName}" Width="220"/>

                            <!-- Head Category -->
                            <telerik:GridViewDataColumn Header="Head Category" DataMemberBinding="{Binding HeadCategory}" Width="140"/>

                            <!-- City -->
                            <telerik:GridViewDataColumn Header="City" DataMemberBinding="{Binding City}" Width="100"/>

                            <!-- Phone -->
                            <telerik:GridViewDataColumn Header="Phone" DataMemberBinding="{Binding PhoneNo}" Width="110"/>

                            <!-- Opening Balance (Rupees Mode) -->
                            <telerik:GridViewDataColumn Header="Opening Bal"
                                                        DataMemberBinding="{Binding OpeningAmount}"
                                                        SortMemberPath="OpeningAmount"
                                                        Width="120">
                                <telerik:GridViewDataColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold">
                                            <Run Text="{Binding OpeningAmount, StringFormat=N2}"/>
                                            <Run Text=" "/>
                                            <Run Text="{Binding OpeningType}" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                        </TextBlock>
                                    </DataTemplate>
                                </telerik:GridViewDataColumn.CellTemplate>
                            </telerik:GridViewDataColumn>

                            <!-- Total Debits -->
                            <telerik:GridViewDataColumn Header="Debits (₹)" DataMemberBinding="{Binding TotalDebits, StringFormat=N2}" Width="110" TextAlignment="Right"/>

                            <!-- Total Credits -->
                            <telerik:GridViewDataColumn Header="Credits (₹)" DataMemberBinding="{Binding TotalCredits, StringFormat=N2}" Width="110" TextAlignment="Right"/>

                            <!-- Closing Balance (Rupees Mode) -->
                            <telerik:GridViewDataColumn Header="Closing Bal"
                                                        DataMemberBinding="{Binding ClosingBalance}"
                                                        SortMemberPath="ClosingBalance"
                                                        Width="130">
                                <telerik:GridViewDataColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="Bold">
                                            <Run Text="{Binding ClosingBalance, StringFormat=N2}"/>
                                            <Run Text=" "/>
                                            <Run Text="{Binding ClosingType}" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                        </TextBlock>
                                    </DataTemplate>
                                </telerik:GridViewDataColumn.CellTemplate>
                            </telerik:GridViewDataColumn>

                            <!-- Actions -->
                            <telerik:GridViewColumn Header="Actions" Width="110" IsSortable="False">
                                <telerik:GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <telerik:RadButton Content="View Ledger"
                                                           Height="24" Padding="8,0"
                                                           FontWeight="SemiBold"
                                                           Background="{DynamicResource SuccessBrush}"
                                                           Command="{Binding DataContext.OpenSingleAccountLedgerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                           CommandParameter="{Binding}"
                                                           ToolTip="Open full individual account ledger"/>
                                    </DataTemplate>
                                </telerik:GridViewColumn.CellTemplate>
                            </telerik:GridViewColumn>
                        </telerik:RadGridView.Columns>
                    </telerik:RadGridView>
                </Border>

                <!-- Weight Mode Main Grid -->
                <Border Style="{StaticResource CardStyle}" Padding="6"
                        Visibility="{Binding IsWeightMode, Converter={StaticResource BoolToVis}}">
                    <telerik:RadGridView ItemsSource="{Binding DisplayedSummaries}"
                                         SelectedItem="{Binding SelectedAccountItem, Mode=TwoWay}"
                                         AutoGenerateColumns="False"
                                         CanUserSortColumns="True"
                                         IsReadOnly="True"
                                         RowIndicatorVisibility="Collapsed"
                                         ShowGroupPanel="False"
                                         VirtualizingPanel.IsVirtualizing="True"
                                         VirtualizingPanel.VirtualizationMode="Recycling">
                        <telerik:RadGridView.Columns>
                            <!-- Account Name -->
                            <telerik:GridViewDataColumn Header="Account Name" DataMemberBinding="{Binding AccountName}" Width="220"/>

                            <!-- Head Category -->
                            <telerik:GridViewDataColumn Header="Head Category" DataMemberBinding="{Binding HeadCategory}" Width="140"/>

                            <!-- City -->
                            <telerik:GridViewDataColumn Header="City" DataMemberBinding="{Binding City}" Width="100"/>

                            <!-- Phone -->
                            <telerik:GridViewDataColumn Header="Phone" DataMemberBinding="{Binding PhoneNo}" Width="110"/>

                            <!-- Opening Balance (Weight Mode) -->
                            <telerik:GridViewDataColumn Header="Opening Wt (g)"
                                                        DataMemberBinding="{Binding OpeningWeight}"
                                                        SortMemberPath="OpeningWeight"
                                                        Width="120">
                                <telerik:GridViewDataColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold">
                                            <Run Text="{Binding OpeningWeight, StringFormat=N3}"/>
                                            <Run Text=" "/>
                                            <Run Text="{Binding OpeningWeightType}" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                        </TextBlock>
                                    </DataTemplate>
                                </telerik:GridViewDataColumn.CellTemplate>
                            </telerik:GridViewDataColumn>

                            <!-- Total Debits (Weight) -->
                            <telerik:GridViewDataColumn Header="Debits (g)" DataMemberBinding="{Binding TotalWeightDebit, StringFormat=N3}" Width="110" TextAlignment="Right"/>

                            <!-- Total Credits (Weight) -->
                            <telerik:GridViewDataColumn Header="Credits (g)" DataMemberBinding="{Binding TotalWeightCredit, StringFormat=N3}" Width="110" TextAlignment="Right"/>

                            <!-- Closing Balance (Weight Mode) -->
                            <telerik:GridViewDataColumn Header="Closing Wt (g)"
                                                        DataMemberBinding="{Binding ClosingWeight}"
                                                        SortMemberPath="ClosingWeight"
                                                        Width="130">
                                <telerik:GridViewDataColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="Bold">
                                            <Run Text="{Binding ClosingWeight, StringFormat=N3}"/>
                                            <Run Text=" "/>
                                            <Run Text="{Binding ClosingWeightType}" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                        </TextBlock>
                                    </DataTemplate>
                                </telerik:GridViewDataColumn.CellTemplate>
                            </telerik:GridViewDataColumn>

                            <!-- Actions -->
                            <telerik:GridViewColumn Header="Actions" Width="110" IsSortable="False">
                                <telerik:GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <telerik:RadButton Content="View Ledger"
                                                           Height="24" Padding="8,0"
                                                           FontWeight="SemiBold"
                                                           Background="{DynamicResource SuccessBrush}"
                                                           Command="{Binding DataContext.OpenSingleAccountLedgerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                           CommandParameter="{Binding}"
                                                           ToolTip="Open full individual account ledger"/>
                                    </DataTemplate>
                                </telerik:GridViewColumn.CellTemplate>
                            </telerik:GridViewColumn>
                        </telerik:RadGridView.Columns>
                    </telerik:RadGridView>
                </Border>
            </Grid>

            <!-- 3: Bottom Drawer: Selected Account Detailed Transactions -->
            <Border Grid.Row="3" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="ACCOUNT TRANSACTIONS:" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <TextBlock Text="{Binding SelectedAccountItem.AccountName, StringFormat=' {0}'}" FontWeight="Bold" FontSize="12" Foreground="CadetBlue"/>
                        <TextBlock Text="{Binding SelectedAccountItem.City, StringFormat=' ({0})'}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                    </StackPanel>

                    <!-- Rupees Mode Entries Grid -->
                    <telerik:RadGridView Grid.Row="1"
                                         ItemsSource="{Binding SelectedAccountEntries}"
                                         AutoGenerateColumns="False"
                                         IsReadOnly="True"
                                         RowIndicatorVisibility="Collapsed"
                                         ShowGroupPanel="False"
                                         CanUserSortColumns="False"
                                         Visibility="{Binding IsRupeesMode, Converter={StaticResource BoolToVis}}">
                        <telerik:RadGridView.Columns>
                            <telerik:GridViewDataColumn Header="Date" DataMemberBinding="{Binding FormattedDate}" Width="95"/>
                            <telerik:GridViewDataColumn Header="Voucher No" DataMemberBinding="{Binding VouNo}" Width="110"/>
                            <telerik:GridViewDataColumn Header="Type" DataMemberBinding="{Binding VouType}" Width="110"/>
                            <telerik:GridViewDataColumn Header="Opposite Head" DataMemberBinding="{Binding Head}" Width="150"/>
                            <telerik:GridViewDataColumn Header="Debit" DataMemberBinding="{Binding FormattedDebit}" Width="100" TextAlignment="Right"/>
                            <telerik:GridViewDataColumn Header="Credit" DataMemberBinding="{Binding FormattedCredit}" Width="100" TextAlignment="Right"/>
                            <telerik:GridViewDataColumn Header="Balance" DataMemberBinding="{Binding FormattedBalance}" Width="120" TextAlignment="Right"/>
                            <telerik:GridViewDataColumn Header="Narration" DataMemberBinding="{Binding Narration}" Width="*"/>
                        </telerik:RadGridView.Columns>
                    </telerik:RadGridView>

                    <!-- Weight Mode Entries Grid -->
                    <telerik:RadGridView Grid.Row="1"
                                         ItemsSource="{Binding SelectedAccountEntries}"
                                         AutoGenerateColumns="False"
                                         IsReadOnly="True"
                                         RowIndicatorVisibility="Collapsed"
                                         ShowGroupPanel="False"
                                         CanUserSortColumns="False"
                                         Visibility="{Binding IsWeightMode, Converter={StaticResource BoolToVis}}">
                        <telerik:RadGridView.Columns>
                            <telerik:GridViewDataColumn Header="Date" DataMemberBinding="{Binding FormattedDate}" Width="95"/>
                            <telerik:GridViewDataColumn Header="Voucher No" DataMemberBinding="{Binding VouNo}" Width="110"/>
                            <telerik:GridViewDataColumn Header="Type" DataMemberBinding="{Binding VouType}" Width="110"/>
                            <telerik:GridViewDataColumn Header="Opposite Head" DataMemberBinding="{Binding Head}" Width="150"/>
                            <telerik:GridViewDataColumn Header="Debit (g)" DataMemberBinding="{Binding FormattedWeightDebit}" Width="100" TextAlignment="Right"/>
                            <telerik:GridViewDataColumn Header="Credit (g)" DataMemberBinding="{Binding FormattedWeightCredit}" Width="100" TextAlignment="Right"/>
                            <telerik:GridViewDataColumn Header="Balance (g)" DataMemberBinding="{Binding FormattedWeightBalance}" Width="120" TextAlignment="Right"/>
                            <telerik:GridViewDataColumn Header="Narration" DataMemberBinding="{Binding Narration}" Width="*"/>
                        </telerik:RadGridView.Columns>
                    </telerik:RadGridView>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
