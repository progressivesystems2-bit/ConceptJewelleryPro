<Window x:Class="ConceptJewelleryPro.WPF.Views.InvoicePrintPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
        Title="Tax Invoice Print Preview"
        Height="850"
        Width="950"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        FontFamily="Segoe UI">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top Toolbar -->
        <Border Grid.Row="0"
                Background="{DynamicResource HeaderBackgroundBrush}"
                BorderBrush="{DynamicResource HeaderBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,10">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE749;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="18"
                               Foreground="{DynamicResource AccentBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0" />
                    <TextBlock x:Name="HeaderTitleTextBlock"
                               Text="Tax Invoice Print Preview (A4 - Dual Copy)"
                               FontSize="15"
                               FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <telerik:RadButton Content="Print (F10)"
                                       Click="Print_Click"
                                       Height="36"
                                       MinWidth="100"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource AccentTextBrush}"
                                       Background="{DynamicResource AccentBrush}"
                                       BorderThickness="0"
                                       Margin="0,0,8,0" />
                    <telerik:RadButton Content="Close (Esc)"
                                       Click="Close_Click"
                                       Height="36"
                                       MinWidth="90"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       Background="{DynamicResource PanelBrush}"
                                       BorderBrush="{DynamicResource CardBorderBrush}"
                                       BorderThickness="1" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Document Preview Canvas -->
        <Border Grid.Row="1"
                Background="#475569"
                Padding="20">
            <FlowDocumentScrollViewer x:Name="DocumentScrollViewer"
                                      Background="White"
                                      Foreground="Black"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Auto"
                                      IsSelectionEnabled="True" />
        </Border>

        <!-- Bottom Footer Note -->
        <Border Grid.Row="2"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,6">
            <Grid>
                <TextBlock x:Name="FooterNoteTextBlock"
                           Text="Pre-formatted for standard A4 (210mm x 297mm) print layout."
                           FontSize="11.5"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           VerticalAlignment="Center" />
                <TextBlock Text="Press F10 or click Print to send to printer"
                           FontSize="11.5"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource AccentBrush}"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
