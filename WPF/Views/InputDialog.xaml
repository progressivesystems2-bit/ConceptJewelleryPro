<Window x:Class="ConceptJewelleryPro.WPF.Views.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
        Title="Enter Input"
        Height="200" Width="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        FontFamily="Segoe UI">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="PromptLabel" Text="Please enter value:" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,10" />

        <telerik:RadWatermarkTextBox x:Name="InputTextBox" Grid.Row="1" Height="40" Padding="8,0" FontSize="14" VerticalAlignment="Top" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <telerik:RadButton Content="Cancel" Width="80" Height="40" Click="Cancel_Click" Margin="0,0,8,0" />
            <telerik:RadButton Content="OK" Width="80" Height="40" Background="CadetBlue" Foreground="White" FontWeight="Bold" Click="Ok_Click" IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>
