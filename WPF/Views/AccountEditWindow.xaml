<Window x:Class="ConceptJewelleryPro.WPF.Views.AccountEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
        Title="{Binding Title}"
        Height="760" Width="880"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        FontFamily="Segoe UI"
        Background="{DynamicResource WindowBackgroundBrush}">

    <Window.InputBindings>
        <KeyBinding Modifiers="Alt" Key="S" Command="{Binding SaveCommand}" />
        <KeyBinding Key="F10" Command="{Binding SaveCommand}" />
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="20,16" />
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>


        <Style TargetType="{x:Type telerik:RadWatermarkTextBox}" BasedOn="{StaticResource RadWatermarkTextBoxStyle}">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,4,8,4" />
        </Style>

        <Style TargetType="{x:Type telerik:RadComboBox}" BasedOn="{StaticResource RadComboBoxStyle}">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="0,4,8,4" />
            <Setter Property="Padding" Value="8,0,4,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
        </Style>
    </Window.Resources>

    <Grid KeyboardNavigation.TabNavigation="Cycle">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="{DynamicResource HeaderBackgroundBrush}"
                BorderBrush="{DynamicResource HeaderBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="20,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="32" Height="32" CornerRadius="6" Background="{DynamicResource PanelBrush}">
                    <TextBlock Text="&#xE77B;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="14"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                    <TextBlock Text="Fill in the account details below" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Form Body -->
        <telerik:RadBusyIndicator Grid.Row="1" IsBusy="{Binding IsBusy}" BusyContent="Saving Account...">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,16">
                <StackPanel>
                    <!-- Error Notification Banner -->
                    <Border Background="#FFEEEE" BorderBrush="#FFCCCC" BorderThickness="1" CornerRadius="4" Padding="12,8" Margin="0,0,0,12"
                            Visibility="{Binding ErrorMessage, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
                    </Border>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Account Entry Details" Style="{StaticResource SectionTitleStyle}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Left Column Fields -->
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Head Category" Style="{StaticResource FieldLabelStyle}" />
                                <telerik:RadComboBox Grid.Row="0" Grid.Column="1" IsEditable="True" ItemsSource="{Binding HeadCategories}" SelectedItem="{Binding HeadCategory, Mode=TwoWay}" Text="{Binding HeadCategory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TabIndex="1" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Sub Category" Style="{StaticResource FieldLabelStyle}" />
                                <telerik:RadWatermarkTextBox Grid.Row="1" Grid.Column="1" Text="{Binding SubCategory, UpdateSourceTrigger=PropertyChanged}" TabIndex="2" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Account Name *" Style="{StaticResource FieldLabelStyle}" />
                                <telerik:RadWatermarkTextBox Grid.Row="2" Grid.Column="1" Text="{Binding AccountName, UpdateSourceTrigger=PropertyChanged}" TabIndex="3" FontWeight="Bold" />

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Party Code *" Style="{StaticResource FieldLabelStyle}" />
                                <telerik:RadWatermarkTextBox Grid.Row="3" Grid.Column="1" Text="{Binding PartyCode, UpdateSourceTrigger=PropertyChanged}" TabIndex="4" />

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Ref Name" Style="{StaticResource FieldLabelStyle}" />
                                <telerik:RadWatermarkTextBox Grid.Row="4" Grid.Column="1" Text="{Binding RefName, UpdateSourceTrigger=PropertyChanged}" TabIndex="5" />

                                <TextBlock Grid.Row="5" Grid.Column="0" Text="Address" Style="{StaticResource FieldLabelStyle}" />
                                <telerik:RadWatermarkTextBox Grid.Row="5" Grid.Column="1" Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" TabIndex="6" />

                                <TextBlock Grid.Row="6" Grid.Column="0" Text="Address 2" Style="{StaticResource FieldLabelStyle}" />
                                <telerik:RadWatermarkTextBox Grid.Row="6" Grid.Column="1" Text="{Binding Address2, UpdateSourceTrigger=PropertyChanged}" TabIndex="7" />

                                <!-- PinCode above City -->
                                <TextBlock Grid.Row="7" Grid.Column="0" Text="Pin Code" Style="{StaticResource FieldLabelStyle}" />
                                <telerik:RadWatermarkTextBox Grid.Row="7" Grid.Column="1" Text="{Binding PinCode, UpdateSourceTrigger=PropertyChanged}" TabIndex="8" />

                                <!-- City and State in Same Row -->
                                <TextBlock Grid.Row="8" Grid.Column="0" Text="City \| State" Style="{StaticResource FieldLabelStyle}" />
                                <Grid Grid.Row="8" Grid.Column="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <telerik:RadWatermarkTextBox Grid.Column="0" Text="{Binding City, UpdateSourceTrigger=PropertyChanged}" WatermarkContent="City" TabIndex="9" Margin="0,4,4,4" />
                                    <telerik:RadWatermarkTextBox Grid.Column="1" Text="{Binding State, UpdateSourceTrigger=PropertyChanged}" WatermarkContent="State" TabIndex="10" Margin="4,4,0,4" />
                                </Grid>

                                <!-- Right Column Fields (STD Phone and Mobile at Top) -->
                                <!-- StdCode and PhoneNo in Same Row (Top of Second Data Column) -->
                                <TextBlock Grid.Row="0" Grid.Column="3" Text="STD \| Phone" Style="{StaticResource FieldLabelStyle}" />
                                <Grid Grid.Row="0" Grid.Column="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <telerik:RadWatermarkTextBox Grid.Column="0" Text="{Binding StdCode, UpdateSourceTrigger=PropertyChanged}" WatermarkContent="STD" TabIndex="11" Margin="0,4,4,4" />
                                    <telerik:RadWatermarkTextBox Grid.Column="1" Text="{Binding PhoneNo, UpdateSourceTrigger=PropertyChanged}" WatermarkContent="Phone No" TabIndex="12" Margin="4,4,0,4" />
                                </Grid>

                                <!-- Mobile (Second Row of Second Data Column) -->
                                <TextBlock Grid.Row="1" Grid.Column="3" Text="Mobile" Style="{StaticResource FieldLabelStyle}" />
                                <telerik:RadWatermarkTextBox Grid.Row="1" Grid.Column="4" Text="{Binding Mobile, UpdateSourceTrigger=PropertyChanged}" TabIndex="13" />

                                <!-- GST Type and GSTIN No in Same Row -->
                                <TextBlock Grid.Row="2" Grid.Column="3" Text="GST Type \| No" Style="{StaticResource FieldLabelStyle}" />
                                <Grid Grid.Row="2" Grid.Column="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <telerik:RadComboBox Grid.Column="0" ItemsSource="{Binding VatTypes}" SelectedItem="{Binding VatType}" TabIndex="14" Margin="0,4,4,4" />
                                    <telerik:RadWatermarkTextBox Grid.Column="1" Text="{Binding VatNo, UpdateSourceTrigger=PropertyChanged}" WatermarkContent="GSTIN / VAT No" TabIndex="15" Margin="4,4,0,4" />
                                </Grid>

                                <TextBlock Grid.Row="3" Grid.Column="3" Text="In/Out" Style="{StaticResource FieldLabelStyle}" />
                                <telerik:RadComboBox Grid.Row="3" Grid.Column="4" IsEditable="True" ItemsSource="{Binding InOutOptions}" SelectedItem="{Binding InOut, Mode=TwoWay}" Text="{Binding InOut, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TabIndex="16" />

                                <TextBlock Grid.Row="4" Grid.Column="3" Text="Opening Amt 1" Style="{StaticResource FieldLabelStyle}" />
                                <telerik:RadWatermarkTextBox Grid.Row="4" Grid.Column="4" Text="{Binding OpAmt1, Mode=TwoWay, TargetNullValue='', UpdateSourceTrigger=LostFocus, StringFormat=N2}" WatermarkContent="0.00" TabIndex="17" />

                                <TextBlock Grid.Row="5" Grid.Column="3" Text="Opening Gold Wt." Style="{StaticResource FieldLabelStyle}" />
                                <telerik:RadWatermarkTextBox Grid.Row="5" Grid.Column="4" Text="{Binding OpGoldWeight, Mode=TwoWay, TargetNullValue='', UpdateSourceTrigger=LostFocus, StringFormat=N3}" WatermarkContent="0.000" TabIndex="18" />

                                <!-- CreditLimit and CreditDays in Same Row -->
                                <TextBlock Grid.Row="6" Grid.Column="3" Text="Credit Limit/Days" Style="{StaticResource FieldLabelStyle}" />
                                <Grid Grid.Row="6" Grid.Column="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <telerik:RadWatermarkTextBox Grid.Column="0" Text="{Binding CreditLimit, Mode=TwoWay, TargetNullValue='', UpdateSourceTrigger=LostFocus, StringFormat=N2}" WatermarkContent="Credit Limit" TabIndex="19" Margin="0,4,4,4" ToolTip="Credit Limit" />
                                    <telerik:RadWatermarkTextBox Grid.Column="1" Text="{Binding CreditDays, Mode=TwoWay, TargetNullValue='', UpdateSourceTrigger=LostFocus, StringFormat=N0}" WatermarkContent="Credit Days" TabIndex="20" Margin="4,4,8,4" ToolTip="Credit Days" />
                                </Grid>

                                <TextBlock Grid.Row="7" Grid.Column="3" Text="Interest (%)" Style="{StaticResource FieldLabelStyle}" />
                                <telerik:RadWatermarkTextBox Grid.Row="7" Grid.Column="4" Text="{Binding Interest, Mode=TwoWay, TargetNullValue='', UpdateSourceTrigger=LostFocus, StringFormat=N2}" WatermarkContent="Interest (%)" TabIndex="21" />

                                <TextBlock Grid.Row="8" Grid.Column="3" Text="Email" Style="{StaticResource FieldLabelStyle}" />
                                <telerik:RadWatermarkTextBox Grid.Row="8" Grid.Column="4" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" TabIndex="22" />

                                <TextBlock Grid.Row="9" Grid.Column="3" Text="Bank A/c" Style="{StaticResource FieldLabelStyle}" />
                                <telerik:RadWatermarkTextBox Grid.Row="9" Grid.Column="4" Text="{Binding BankAc, UpdateSourceTrigger=PropertyChanged}" TabIndex="23" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </telerik:RadBusyIndicator>

        <!-- Sticky Bottom Footer -->
        <Border Grid.Row="2"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource HeaderBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="20,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <telerik:RadButton Content="Cancel"
                                   Width="90"
                                   Height="40"
                                   Margin="0,0,10,0"
                                   Command="{Binding CancelCommand}"
                                   IsTabStop="False" />
                <telerik:RadButton Content="Save Account (Alt+S)"
                                   Width="160"
                                   Height="40"
                                   FontWeight="Bold"
                                    Style="{StaticResource PrimaryToolbarButtonStyle}"
                                   Command="{Binding SaveCommand}"
                                   TabIndex="24"
                                   IsTabStop="True" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
