<Window x:Class="ConceptJewelleryPro.WPF.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
        xmlns:helpers="clr-namespace:Telerik.Windows.Controls.Theming.Helpers;assembly=Telerik.Windows.Controls"
        xmlns:vm="clr-namespace:ConceptJewelleryPro.WPF.ViewModels"
        xmlns:views="clr-namespace:ConceptJewelleryPro.WPF.Views"
        xmlns:local="clr-namespace:ConceptJewelleryPro.WPF"
        Title="Concept Jewellery Pro"
        Width="1200"
        Height="780"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.InputBindings>
        <KeyBinding Key="W" Modifiers="Control" Command="{Binding CloseCurrentDocumentCommand}" />
        <KeyBinding Key="F1" Command="{Binding SelectModuleCommand}" CommandParameter="Account Creation" />
        <KeyBinding Key="F2" Command="{Binding OpenRateUpdateCommand}" />
        <KeyBinding Key="F3" Command="{Binding SelectModuleCommand}" CommandParameter="Barcode Creation" />
        <KeyBinding Key="F4" Command="{Binding SelectModuleCommand}" CommandParameter="Journal" />
        <KeyBinding Key="F5" Command="{Binding SelectModuleCommand}" CommandParameter="Receipts" />
        <KeyBinding Key="F6" Command="{Binding SelectModuleCommand}" CommandParameter="Payments" />
        <KeyBinding Key="F7" Command="{Binding SelectModuleCommand}" CommandParameter="Invoice" />
        <KeyBinding Key="F8" Command="{Binding SelectModuleCommand}" CommandParameter="Purchases Expenses" />
        <KeyBinding Key="F9" Command="{Binding RefreshCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <DataTemplate x:Key="EmptyIconTemplate" />

        <!-- Top-level menu bar item: icon + label -->
        <DataTemplate x:Key="BarItemTemplate">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Icon}"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="14"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TopBarTextBrush}" />
                <TextBlock Text="{Binding Title}"
                           Margin="8,0,0,0"
                           FontSize="13"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TopBarTextBrush}" />
            </StackPanel>
        </DataTemplate>

        <!-- Mega menu row: icon tile + title + subtitle -->
        <DataTemplate x:Key="MegaRowTemplate">
            <Grid Width="300">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="38"
                        Height="38"
                        CornerRadius="9"
                        Background="{DynamicResource MenuTileBackgroundBrush}"
                        BorderBrush="{DynamicResource MenuTileBorderBrush}"
                        BorderThickness="1"
                        VerticalAlignment="Center">
                    <TextBlock Text="{Binding Icon}"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="17"
                               Foreground="{DynamicResource MenuIconBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}"
                               FontSize="13.5"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource MenuTextBrush}" />
                    <TextBlock Text="{Binding Subtitle}"
                               FontSize="11"
                               Foreground="{DynamicResource MenuSubTextBrush}"
                               Margin="0,2,0,0" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- Top Bar Menu Trigger Button Style (ConceptS Style) -->
        <Style x:Key="TopBarMenuButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="11,7" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Foreground" Value="{DynamicResource TopBarTextBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TopBarGlassHoverBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource TopBarGlassBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TopBarGlassHoverBrush}" />
                                <Setter TargetName="Bd" Property="Opacity" Value="0.9" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Mega Menu Item Button Style (ConceptS Style) -->
        <Style x:Key="MegaMenuItemStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource MenuHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolbarButtonStyle"
               TargetType="telerik:RadButton">
            <Setter Property="Height" Value="34" />
            <Setter Property="MinWidth" Value="88" />
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
            <Setter Property="Padding" Value="14,4" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>

        <LinearGradientBrush x:Key="GoldGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#F5BB4A" Offset="0" />
            <GradientStop Color="#D98E1B" Offset="1" />
        </LinearGradientBrush>

        <!-- High-Contrast Polished Top Bar Logout Button Style -->
        <Style x:Key="TopBarLogoutButtonStyle" TargetType="telerik:RadButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="telerik:RadButton">
                        <Border x:Name="B"
                                Background="#1AE11D48"
                                BorderBrush="#4DE11D48"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12,0">
                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Center">
                                <TextBlock x:Name="Icon"
                                           Text="&#xE7E8;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           Foreground="#E11D48"
                                           VerticalAlignment="Center" />
                                <TextBlock x:Name="Txt"
                                           Text="Log out"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="#E11D48"
                                           Margin="6,0,0,0"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#E11D48" />
                                <Setter TargetName="B" Property="BorderBrush" Value="#BE123C" />
                                <Setter TargetName="Icon" Property="Foreground" Value="White" />
                                <Setter TargetName="Txt" Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#BE123C" />
                                <Setter TargetName="Icon" Property="Foreground" Value="White" />
                                <Setter TargetName="Txt" Property="Foreground" Value="White" />
                                <Setter TargetName="B" Property="Opacity" Value="0.9" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Smooth Round Tab Close Button Style -->
        <Style x:Key="TabCloseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Width="20"
                                Height="20">
                            <TextBlock x:Name="txt"
                                       Text="&#xE711;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="9"
                                       Foreground="#666666"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E0E0E0" />
                                <Setter TargetName="txt" Property="Foreground" Value="#C0392B" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#D0D0D0" />
                                <Setter TargetName="txt" Property="Foreground" Value="#A00000" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Document content template: unwraps the module VM so implicit templates below apply -->
        <DataTemplate x:Key="DocumentContentTemplate">
            <ContentControl Content="{Binding Content}" />
        </DataTemplate>

        <!-- Tab header: icon + title + close button (DataContext = ModuleDocument) -->
        <DataTemplate x:Key="TabHeaderTemplate">
            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center">
                <TextBlock Text="{Binding Icon}"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="15"
                           Foreground="{DynamicResource OnLightPanelTextBrush}"
                           VerticalAlignment="Center" />
                <TextBlock Text="{Binding Title}"
                           Margin="7,0,8,0"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource OnLightPanelTextBrush}"
                           VerticalAlignment="Center" />
                <Button Style="{StaticResource TabCloseButtonStyle}"
                        ToolTip="Close Tab"
                        Command="{Binding DataContext.CloseDocumentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding}" />
            </StackPanel>
        </DataTemplate>

        <!-- Document content templates (resolved by ContentPresenter via resource lookup) -->
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:AccountCreationViewModel}">
            <views:AccountCreationView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:CustomerCreationViewModel}">
            <views:CustomerCreationView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ItemCreationViewModel}">
            <views:ItemCreationView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:PurityMasterViewModel}">
            <views:PurityMasterView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:SalesVouTypeMasterViewModel}">
            <views:SalesVouTypeMasterView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:InvoiceViewModel}">
            <views:InvoiceView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:PurchaseViewModel}">
            <views:PurchaseView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:PurchaseRegisterViewModel}">
            <views:PurchaseRegisterView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:UserPermissionViewModel}">
            <views:UserPermissionView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:PurchaseExpenseEntryViewModel}">
            <views:PurchaseExpenseEntryView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:NonBarcodeStockViewModel}">
            <views:NonBarcodeStockView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:BarcodeCreationViewModel}">
            <views:BarcodeCreationView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:BoxMasterViewModel}">
            <views:BoxMasterView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:CatalogueViewModel}">
            <views:CatalogueView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:GSTReportsViewModel}">
            <views:GSTReportsView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:OrderRequirementViewModel}">
            <views:OrderRequirementView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:BarcodeCreationBulkViewModel}">
            <views:BarcodeCreationBulkView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:KarigharIssueViewModel}">
            <views:KarigharIssueView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:KarigharReceiveViewModel}">
            <views:KarigharReceiveView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:HireIssueViewModel}">
            <views:HireIssueView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:HireReceiveViewModel}">
            <views:HireReceiveView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:StaffCreationViewModel}">
            <views:StaffCreationView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:SchemeCreationViewModel}">
            <views:SchemeCreationView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:GeneralSettingsViewModel}">
            <views:GeneralSettingsView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:PrinterSettingsViewModel}">
            <views:PrinterSettingsView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:BackupViewModel}">
            <views:BackupView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:VoucherEntryViewModel}">
            <views:VoucherEntryView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:SchemeReceiptViewModel}">
            <views:SchemeReceiptView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:BankReconciliationViewModel}">
            <views:BankReconciliationView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:CardAdjustmentReceiptViewModel}">
            <views:CardAdjustmentReceiptView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:SchemeDueListViewModel}">
            <views:SchemeDueListView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:CouponEngineViewModel}">
            <views:CouponEngineView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:BarcodeStockReportViewModel}">
            <views:BarcodeStockReportView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:NonBarcodeStockReportViewModel}">
            <views:NonBarcodeStockReportView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:NonBarcodeItemStockReportViewModel}">
            <views:NonBarcodeItemStockReportView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:LedgerReportViewModel}">
            <views:LedgerReportView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:LedgerGroupViewModel}">
            <views:LedgerGroupView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:TrialBalanceViewModel}">
            <views:TrialBalanceView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:TradingAccountViewModel}">
            <views:TradingAccountView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:BalanceSheetViewModel}">
            <views:BalanceSheetView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:AuditReportViewModel}">
            <views:AuditReportView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:StockTransferViewModel}">
            <views:StockTransferView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:SoftwareUpdateViewModel}">
            <views:SoftwareUpdateView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:LicenseInfoViewModel}">
            <views:LicenseInfoView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ModulePlaceholderViewModel}">
            <Border HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="520"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="40,36">
                <StackPanel>
                    <Border Width="64"
                            Height="64"
                            CornerRadius="16"
                            Background="{DynamicResource AccentBrush}"
                            HorizontalAlignment="Center">
                        <TextBlock Text="{Binding Icon}"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="28"
                                   Foreground="{DynamicResource AccentTextBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="{Binding Title}"
                               FontSize="24"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,18,0,0" />
                    <TextBlock Text="{Binding Message}"
                               FontSize="13.5"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Margin="0,8,0,0" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top glass bar: brand + menu + search + user/logout -->
        <Border Grid.Row="0"
                Background="{DynamicResource TopBarBackgroundBrush}"
                KeyboardNavigation.TabNavigation="None">
            <Grid>
                <Ellipse Width="340"
                         Height="120"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Top"
                         Margin="-50,-55,0,0">
                    <Ellipse.Fill>
                        <DynamicResource ResourceKey="TopBarGlow1Brush" />
                    </Ellipse.Fill>
                    <Ellipse.Effect>
                        <BlurEffect Radius="60" />
                    </Ellipse.Effect>
                </Ellipse>

                <Ellipse Width="300"
                         Height="120"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Top"
                         Margin="0,-45,0,0">
                    <Ellipse.Fill>
                        <DynamicResource ResourceKey="TopBarGlow2Brush" />
                    </Ellipse.Fill>
                    <Ellipse.Effect>
                        <BlurEffect Radius="65" />
                    </Ellipse.Effect>
                </Ellipse>

                <Ellipse Width="380"
                         Height="130"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Top"
                         Margin="0,-75,-40,0">
                    <Ellipse.Fill>
                        <DynamicResource ResourceKey="TopBarGlow3Brush" />
                    </Ellipse.Fill>
                    <Ellipse.Effect>
                        <BlurEffect Radius="65" />
                    </Ellipse.Effect>
                </Ellipse>

                <Border Background="Transparent"
                        BorderBrush="{DynamicResource TopBarBorderBrush}"
                        BorderThickness="0,0,0,1">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16"
                                          ShadowDepth="3"
                                          Direction="270"
                                          Opacity="0.16"
                                          Color="#33415E" />
                    </Border.Effect>
                    <Grid Margin="18,0">
                        <Rectangle IsHitTestVisible="False"
                                   Stretch="Fill">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#00FFFFFF" Offset="0" />
                                    <GradientStop Color="#2EFFFFFF" Offset="0.45" />
                                    <GradientStop Color="#00FFFFFF" Offset="0.8" />
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <Rectangle Height="1"
                                   VerticalAlignment="Top"
                                   Fill="#D9FFFFFF"
                                   IsHitTestVisible="False" />
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Border Width="32"
                                    Height="32"
                                    CornerRadius="9"
                                    Background="{StaticResource GoldGradient}">
                                <TextBlock Text="&#xE8E4;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="14"
                                           Foreground="#2A1B06"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Concept Jewellery Pro"
                                       Foreground="{DynamicResource TopBarTextBrush}"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Margin="12,0,8,0"
                                       VerticalAlignment="Center" />

                            <ItemsControl ItemsSource="{Binding TopMenus}"
                                          VerticalAlignment="Center"
                                          Margin="12,0,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="1,0">
                                            <!-- Top-Level Menu Button -->
                                            <Button Style="{StaticResource TopBarMenuButtonStyle}"
                                                    Command="{Binding DataContext.ToggleMenuCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Icon}"
                                                               FontFamily="Segoe MDL2 Assets"
                                                               FontSize="13"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource TopBarTextBrush}" />
                                                    <TextBlock Text="{Binding Title}"
                                                               FontFamily="Segoe UI"
                                                               FontSize="13"
                                                               FontWeight="SemiBold"
                                                               Margin="7,0,0,0"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource TopBarTextBrush}" />
                                                    <TextBlock Text="&#xE70D;"
                                                               FontFamily="Segoe MDL2 Assets"
                                                               FontSize="8.5"
                                                               Margin="6,2,0,0"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource TopBarTextBrush}"
                                                               Opacity="0.6" />
                                                </StackPanel>
                                            </Button>

                                            <!-- Multi-Column Mega Dropdown Popup (ConceptS Style) -->
                                            <Popup IsOpen="{Binding IsOpen, Mode=TwoWay}"
                                                   StaysOpen="True"
                                                   AllowsTransparency="True"
                                                   Placement="Bottom"
                                                   PlacementTarget="{Binding RelativeSource={RelativeSource AncestorType=Grid}}"
                                                   HorizontalOffset="-4"
                                                   VerticalOffset="8">
                                                <Border Background="{DynamicResource CardBackgroundBrush}"
                                                        BorderBrush="{DynamicResource CardBorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="10"
                                                        Padding="16,14">
                                                    <Border.Effect>
                                                        <DropShadowEffect BlurRadius="24"
                                                                          ShadowDepth="4"
                                                                          Direction="270"
                                                                          Opacity="0.30"
                                                                          Color="#000000" />
                                                    </Border.Effect>
                                                    <ItemsControl ItemsSource="{Binding Columns}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <StackPanel Orientation="Horizontal" />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Width="265"
                                                                        Margin="0,0,16,0"
                                                                        Padding="0,0,10,0"
                                                                        BorderBrush="{DynamicResource CardBorderBrush}"
                                                                        BorderThickness="0,0,1,0">
                                                                    <ItemsControl ItemsSource="{Binding Sections}">
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <StackPanel Margin="0,0,0,14">
                                                                                    <!-- Column Category Header -->
                                                                                    <StackPanel Orientation="Horizontal"
                                                                                                Margin="4,0,0,10">
                                                                                        <TextBlock Text="{Binding Icon}"
                                                                                                   FontFamily="Segoe MDL2 Assets"
                                                                                                   FontSize="13"
                                                                                                   Foreground="{DynamicResource AccentBrush}"
                                                                                                   Margin="0,0,8,0"
                                                                                                   VerticalAlignment="Center" />
                                                                                        <TextBlock Text="{Binding Title}"
                                                                                                   FontSize="12"
                                                                                                   FontWeight="Bold"
                                                                                                   Foreground="{DynamicResource AccentBrush}"
                                                                                                   VerticalAlignment="Center" />
                                                                                    </StackPanel>

                                                                                    <!-- Column Items -->
                                                                                    <ItemsControl ItemsSource="{Binding Items}">
                                                                                        <ItemsControl.ItemTemplate>
                                                                                            <DataTemplate>
                                                                                                <Button Style="{StaticResource MegaMenuItemStyle}"
                                                                                                        Command="{Binding DataContext.SelectModuleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                                        CommandParameter="{Binding Title}">
                                                                                                    <Grid Width="245">
                                                                                                        <Grid.ColumnDefinitions>
                                                                                                            <ColumnDefinition Width="Auto" />
                                                                                                            <ColumnDefinition Width="*" />
                                                                                                        </Grid.ColumnDefinitions>
                                                                                                        <Border Width="34"
                                                                                                                Height="34"
                                                                                                                CornerRadius="8"
                                                                                                                Background="{DynamicResource MenuTileBackgroundBrush}"
                                                                                                                BorderBrush="{DynamicResource MenuTileBorderBrush}"
                                                                                                                BorderThickness="1"
                                                                                                                VerticalAlignment="Center">
                                                                                                            <TextBlock Text="{Binding Icon}"
                                                                                                                       FontFamily="Segoe MDL2 Assets"
                                                                                                                       FontSize="14"
                                                                                                                       Foreground="{DynamicResource MenuIconBrush}"
                                                                                                                       HorizontalAlignment="Center"
                                                                                                                       VerticalAlignment="Center" />
                                                                                                        </Border>
                                                                                                        <StackPanel Grid.Column="1"
                                                                                                                    Margin="10,0,0,0"
                                                                                                                    VerticalAlignment="Center">
                                                                                                            <TextBlock Text="{Binding Title}"
                                                                                                                       FontSize="13"
                                                                                                                       FontWeight="SemiBold"
                                                                                                                       Foreground="{DynamicResource PrimaryTextBrush}" />
                                                                                                            <TextBlock Text="{Binding Subtitle}"
                                                                                                                       FontSize="11"
                                                                                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                                                                                       Margin="0,2,0,0" />
                                                                                                        </StackPanel>
                                                                                                    </Grid>
                                                                                                </Button>
                                                                                            </DataTemplate>
                                                                                        </ItemsControl.ItemTemplate>
                                                                                    </ItemsControl>
                                                                                </StackPanel>
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Border>
                                            </Popup>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <!-- Search Box & Dropdown Results Popup -->
                        <Grid Margin="0,0,12,0">
                            <Border x:Name="SearchBoxBorder"
                                    Width="260"
                                    Height="32"
                                    CornerRadius="8"
                                    Background="{DynamicResource TopBarSearchBgBrush}"
                                    BorderBrush="{DynamicResource TopBarSearchBorderBrush}"
                                    BorderThickness="1">
                                <Grid Margin="9,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE721;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="12"
                                               Foreground="{DynamicResource TopBarSearchIconBrush}"
                                               VerticalAlignment="Center" />
                                    <telerik:RadWatermarkTextBox x:Name="GlobalSearchTextBox"
                                                                 Grid.Column="1"
                                                                 Margin="8,0,0,0"
                                                                 MinHeight="0"
                                                                 Height="32"
                                                                 VerticalAlignment="Center"
                                                                 Padding="0"
                                                                 Background="Transparent"
                                                                 BorderBrush="Transparent"
                                                                 BorderThickness="0"
                                                                 Foreground="{DynamicResource TopBarSearchTextBrush}"
                                                                 CaretBrush="{DynamicResource TopBarSearchCaretBrush}"
                                                                 helpers:ThemeHelper.MouseOverBackgroundBrush="Transparent"
                                                                 helpers:ThemeHelper.FocusBackgroundBrush="Transparent"
                                                                 helpers:ThemeHelper.MouseOverBrush="Transparent"
                                                                 helpers:ThemeHelper.FocusBrush="Transparent"
                                                                 VerticalContentAlignment="Center"
                                                                 FontSize="12.5"
                                                                 WatermarkContent="Search menus, ledgers, customers... (Ctrl+F)"
                                                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}">
                                        <telerik:RadWatermarkTextBox.WatermarkTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}"
                                                           Height="20"
                                                           Foreground="{DynamicResource TopBarSearchPlaceholderBrush}"
                                                           FontSize="12"
                                                           VerticalAlignment="Center" />
                                            </DataTemplate>
                                        </telerik:RadWatermarkTextBox.WatermarkTemplate>
                                    </telerik:RadWatermarkTextBox>
                                </Grid>
                            </Border>

                            <Popup x:Name="GlobalSearchPopup"
                                   IsOpen="{Binding IsGlobalSearchOpen, Mode=TwoWay}"
                                   StaysOpen="False"
                                   AllowsTransparency="True"
                                   Placement="Bottom"
                                   PlacementTarget="{Binding ElementName=SearchBoxBorder}"
                                   HorizontalOffset="0"
                                   VerticalOffset="6">
                                <Border Background="{DynamicResource CardBackgroundBrush}"
                                        BorderBrush="{DynamicResource CardBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="6"
                                        Width="380"
                                        MaxHeight="360">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="22"
                                                          ShadowDepth="4"
                                                          Direction="270"
                                                          Opacity="0.28"
                                                          Color="#000000" />
                                    </Border.Effect>
                                    <ListBox x:Name="GlobalSearchResultsList"
                                             ItemsSource="{Binding GlobalSearchResults}"
                                             SelectedItem="{Binding SelectedSearchResult, Mode=TwoWay}"
                                             SelectionChanged="GlobalSearchResultsList_SelectionChanged"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Padding="2"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             HorizontalContentAlignment="Stretch">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Padding" Value="0" />
                                                <Setter Property="Margin" Value="0,1" />
                                                <Setter Property="Background" Value="Transparent" />
                                                <Setter Property="BorderThickness" Value="0" />
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListBoxItem">
                                                            <Border x:Name="Bd"
                                                                    Background="{TemplateBinding Background}"
                                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                                    CornerRadius="7"
                                                                    Padding="6,4">
                                                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PanelBrush}" />
                                                                </Trigger>
                                                                <Trigger Property="IsSelected" Value="True">
                                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Button Command="{Binding DataContext.OpenGlobalSearchResultCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Padding="4,3"
                                                        HorizontalContentAlignment="Stretch"
                                                        Cursor="Hand"
                                                        IsTabStop="False">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border x:Name="IconBorder"
                                                                Width="28"
                                                                Height="28"
                                                                CornerRadius="7"
                                                                Background="{DynamicResource PanelBrush}"
                                                                Margin="0,0,10,0"
                                                                VerticalAlignment="Center">
                                                            <TextBlock x:Name="ItemIcon"
                                                                       Text="{Binding Icon}"
                                                                       FontFamily="Segoe MDL2 Assets"
                                                                       FontSize="13"
                                                                       Foreground="{DynamicResource AccentBrush}"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center" />
                                                        </Border>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock x:Name="TitleText"
                                                                       Text="{Binding Title}"
                                                                       FontSize="12.5"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource PrimaryTextBrush}" />
                                                            <TextBlock x:Name="DetailText"
                                                                       Text="{Binding Detail}"
                                                                       FontSize="11"
                                                                       Margin="0,1,0,0"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Button>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                        <Setter TargetName="TitleText" Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                                                        <Setter TargetName="DetailText" Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                                                        <Setter TargetName="IconBorder" Property="Background" Value="#25000000" />
                                                        <Setter TargetName="ItemIcon" Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Border>
                            </Popup>
                        </Grid>

                      
                        <!-- Daily Rate Update Button -->
                        <Button Style="{StaticResource TopBarMenuButtonStyle}"
                                Command="{Binding OpenRateUpdateCommand}"
                                ToolTip="Update Daily Metal Rates (F2)"
                                Margin="0,0,8,0"
                                Height="40">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xEC05;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="15"
                                           Foreground="DarkGoldenrod"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="Daily Rates (F2)"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Margin="6,0,0,0"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Theme Selector -->
                        <telerik:RadComboBox Width="145"
                                             Height="40"
                                             Margin="0,0,16,0"
                                             VerticalAlignment="Center"
                                             FontSize="12.5"
                                             ItemsSource="{Binding ThemeSelector.Themes}"
                                             SelectedValue="{Binding ThemeSelector.SelectedThemeId, Mode=TwoWay}"
                                             SelectedValuePath="Id"
                                             DisplayMemberPath="DisplayName"
                                             Background="{DynamicResource TopBarSearchBgBrush}"
                                             BorderBrush="{DynamicResource TopBarSearchBorderBrush}"
                                             BorderThickness="1"
                                             Foreground="{DynamicResource TopBarSearchTextBrush}"
                                             helpers:ThemeHelper.CornerRadius="8"
                                             helpers:ThemeHelper.MouseOverBackgroundBrush="{DynamicResource TopBarSearchBgBrush}"
                                             helpers:ThemeHelper.FocusBackgroundBrush="{DynamicResource TopBarSearchBgBrush}"
                                             helpers:ThemeHelper.MouseOverBrush="{DynamicResource TopBarSearchBorderBrush}"
                                             helpers:ThemeHelper.FocusBrush="{DynamicResource AccentBrush}"
                                             ToolTip="Select Theme">
                            <telerik:RadComboBox.Resources>
                                <Style TargetType="telerik:RadComboBoxItem"
                                       BasedOn="{StaticResource RadComboBoxItemStyle}">
                                    <Setter Property="Foreground" Value="{DynamicResource OnLightPanelTextBrush}" />
                                    <Setter Property="FontSize" Value="12.5" />
                                    <Setter Property="Padding" Value="8,5" />
                                </Style>
                            </telerik:RadComboBox.Resources>
                        </telerik:RadComboBox>

                        <!-- User Info -->
                        <TextBlock Text="{Binding RoleName}"
                                   Foreground="{DynamicResource TopBarSubTextBrush}"
                                   FontSize="14"
                                   Margin="0,0,16,0"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="&#x25cf;"
                                   Foreground="{DynamicResource SuccessBrush}"
                                   FontSize="14"
                                   Margin="0,0,4,0"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding CurrentUser.Username}"
                                   Foreground="{DynamicResource TopBarTextBrush}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Margin="0,0,16,0"
                                   VerticalAlignment="Center" />

                        <!-- Logout Button -->
                        <telerik:RadButton Height="30"
                                           Style="{StaticResource TopBarLogoutButtonStyle}"
                                           ToolTip="Log out of system"
                                           Command="{Binding LogoutCommand}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>

        <!-- Tab document area -->
        <Border Grid.Row="1" Background="{DynamicResource WindowBackgroundBrush}">
            <telerik:RadTabControl x:Name="DocumentTabs"
                                   ItemsSource="{Binding Documents}"
                                   SelectedItem="{Binding SelectedDocument}">
                <telerik:RadTabControl.ItemContainerStyle>
                    <Style TargetType="telerik:RadTabItem"
                           BasedOn="{StaticResource RadTabItemStyle}">
                        <Setter Property="ContentTemplate"
                                Value="{StaticResource DocumentContentTemplate}" />
                        <Setter Property="HeaderTemplate"
                                Value="{StaticResource TabHeaderTemplate}" />
                    </Style>
                </telerik:RadTabControl.ItemContainerStyle>
            </telerik:RadTabControl>
        </Border>

        <!-- Status bar -->
        <Border Grid.Row="2" Background="{DynamicResource StatusBarBackgroundBrush}" Padding="16,6"
                KeyboardNavigation.TabNavigation="None">
            <Grid>
                <TextBlock Text="Ready"
                           Foreground="{DynamicResource StatusBarTextBrush}"
                           FontSize="12"
                           VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusText}"
                               Foreground="{DynamicResource StatusBarTextBrush}"
                               FontSize="12" />
                    <TextBlock Text="|"
                               Foreground="{DynamicResource StatusBarMutedBrush}"
                               Margin="12,0"
                               FontSize="12" />
                    <TextBlock Text="{Binding AppVersion}"
                               Foreground="{DynamicResource StatusBarTextBrush}"
                               FontSize="12" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
