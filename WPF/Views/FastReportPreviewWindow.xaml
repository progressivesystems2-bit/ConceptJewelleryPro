<Window x:Class="ConceptJewelleryPro.WPF.Views.FastReportPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
        Title="FastReport Print Preview"
        Height="860"
        Width="980"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        FontFamily="Segoe UI">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top Toolbar -->
        <Border Grid.Row="0"
                Background="{DynamicResource HeaderBackgroundBrush}"
                BorderBrush="{DynamicResource HeaderBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,10">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE749;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="18"
                               Foreground="{DynamicResource AccentBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0" />
                    <TextBlock x:Name="HeaderTitleTextBlock"
                               Text="Print Preview"
                               FontSize="15"
                               FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               VerticalAlignment="Center" />
                    <Border Background="{DynamicResource PanelBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="8,3"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="EngineBadgeTextBlock"
                                   Text="FASTREPORT"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBrush}" />
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <telerik:RadButton Content="-"
                                       ToolTip="Zoom Out"
                                       Click="ZoomOut_Click"
                                       Height="34"
                                       Width="34"
                                       FontWeight="Bold"
                                       Margin="0,0,4,0" />
                    <TextBlock x:Name="ZoomPercentTextBlock"
                               Text="100%"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               MinWidth="46"
                               TextAlignment="Center"
                               Margin="0,0,4,0" />
                    <telerik:RadButton Content="+"
                                       ToolTip="Zoom In"
                                       Click="ZoomIn_Click"
                                       Height="34"
                                       Width="34"
                                       FontWeight="Bold"
                                       Margin="0,0,12,0" />
                    <telerik:RadButton Content="Save PDF"
                                       Click="SavePdf_Click"
                                       Height="36"
                                       MinWidth="92"
                                       FontWeight="SemiBold"
                                       Margin="0,0,8,0" />
                    <telerik:RadButton Content="Print (F10)"
                                       Click="Print_Click"
                                       Height="36"
                                       MinWidth="105"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource AccentTextBrush}"
                                       Background="{DynamicResource AccentBrush}"
                                       BorderThickness="0"
                                       Margin="0,0,8,0" />
                    <telerik:RadButton Content="Close (Esc)"
                                       Click="Close_Click"
                                       Height="36"
                                       MinWidth="90"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       Background="{DynamicResource PanelBrush}"
                                       BorderBrush="{DynamicResource CardBorderBrush}"
                                       BorderThickness="1" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Rendered FastReport Pages -->
        <Border Grid.Row="1" Background="#475569" Padding="16">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                <ItemsControl x:Name="PagesItemsControl" HorizontalAlignment="Center">
                    <ItemsControl.LayoutTransform>
                        <ScaleTransform x:Name="PageScaleTransform" ScaleX="1" ScaleY="1" />
                    </ItemsControl.LayoutTransform>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White"
                                    Margin="0,0,0,18"
                                    Padding="0"
                                    BorderBrush="#CBD5E1"
                                    BorderThickness="1">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.35" Color="Black" />
                                </Border.Effect>
                                <Image Source="{Binding}" Stretch="Uniform" MaxWidth="920" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Bottom Status Footer -->
        <Border Grid.Row="2"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,8">
            <TextBlock x:Name="FooterStatusTextBlock"
                       Text="Ready to print via FastReport."
                       FontSize="12"
                       Foreground="{DynamicResource SecondaryTextBrush}" />
        </Border>
    </Grid>
</Window>
