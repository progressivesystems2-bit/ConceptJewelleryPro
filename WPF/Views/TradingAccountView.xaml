<UserControl x:Class="ConceptJewelleryPro.WPF.Views.TradingAccountView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
             xmlns:controls="clr-namespace:ConceptJewelleryPro.WPF.Controls"
             xmlns:viewmodels="clr-namespace:ConceptJewelleryPro.WPF.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewmodels:TradingAccountViewModel}"
             d:DesignHeight="800" d:DesignWidth="1200">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="FilterLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>

        <Style x:Key="FilterDatePickerStyle" TargetType="DatePicker">
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="KpiCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="MinHeight" Value="52"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <!-- Toast Notification Overlay -->
        <controls:ToastNotification x:Name="ToastNotification"
                                     Panel.ZIndex="99"
                                     Message="{Binding ToastMessage, FallbackValue=''}"
                                     ToastType="{Binding ToastType, FallbackValue=Info}"
                                     AutoCloseDelay="4000"
                                     FontSize="13"
                                     HorizontalAlignment="Right"
                                     VerticalAlignment="Bottom"
                                     Margin="0,0,24,24"/>

        <Grid Margin="12,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ROW 0: Header Filters & Actions -->
            <Border Grid.Row="0"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12,10"
                    Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Date Range -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                        <StackPanel Margin="0,0,6,0">
                            <TextBlock Text="From Date:" Style="{StaticResource FilterLabelStyle}"/>
                            <DatePicker SelectedDate="{Binding FromDate, Mode=TwoWay}"
                                        Width="110"
                                        Style="{StaticResource FilterDatePickerStyle}"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,6,0">
                            <TextBlock Text="To Date:" Style="{StaticResource FilterLabelStyle}"/>
                            <DatePicker SelectedDate="{Binding ToDate, Mode=TwoWay}"
                                        Width="110"
                                        Style="{StaticResource FilterDatePickerStyle}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Quick Period Buttons -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,14,14,0">
                        <telerik:RadButton Content="This FY"
                                           Command="{Binding SetThisFYCommand}"
                                           Height="28"
                                           Padding="6,0"
                                           Margin="0,0,4,0"
                                           FontSize="11"/>
                        <telerik:RadButton Content="Last FY"
                                           Command="{Binding SetLastFYCommand}"
                                           Height="28"
                                           Padding="6,0"
                                           Margin="0,0,4,0"
                                           FontSize="11"/>
                        <telerik:RadButton Content="MTD"
                                           Command="{Binding SetTodayCommand}"
                                           Height="28"
                                           Padding="6,0"
                                           Margin="0,0,4,0"
                                           FontSize="11"/>
                    </StackPanel>

                    <!-- Closing Stock Valuation Input -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="Closing Stock (₹ Valuation):" Style="{StaticResource FilterLabelStyle}"/>
                            <telerik:RadNumericUpDown Value="{Binding ManualClosingStock, Mode=TwoWay}"
                                                      CustomUnit="₹ "
                                                      NumberDecimalDigits="2"
                                                      Width="165"
                                                      Height="28"
                                                      FontSize="12"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="Closing Gold Wt (g):" Style="{StaticResource FilterLabelStyle}"/>
                            <telerik:RadNumericUpDown Value="{Binding ManualClosingGoldWeight, Mode=TwoWay}"
                                                      CustomUnit=" g"
                                                      NumberDecimalDigits="3"
                                                      Width="120"
                                                      Height="28"
                                                      FontSize="12"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Hide Zero Balance Checkbox -->
                    <CheckBox Grid.Column="3"
                              IsChecked="{Binding HideZeroBalances, Mode=TwoWay}"
                              Content="Hide Zero Balances"
                              FontWeight="SemiBold"
                              FontSize="12"
                              VerticalAlignment="Center"
                              Margin="0,14,14,0"/>

                    <!-- Action Buttons -->
                    <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,10,0,0">
                        <!-- Refresh -->
                        <telerik:RadButton Command="{Binding RefreshCommand}"
                                           ToolTip="Recalculate &amp; Refresh"
                                           Height="36"
                                           Padding="10,0"
                                           Margin="0,0,6,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="11" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBlock Text="Refresh" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </telerik:RadButton>

                        <!-- Excel Export -->
                        <telerik:RadButton Command="{Binding ExportToExcelCommand}"
                                           ToolTip="Export Trading Account to CSV / Excel"
                                           Height="36"
                                           Padding="10,0"
                                           Margin="0,0,6,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xEDE1;" FontFamily="Segoe MDL2 Assets" FontSize="11" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBlock Text="Excel" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </telerik:RadButton>

                        <!-- Print -->
                        <telerik:RadButton Command="{Binding PrintCommand}"
                                           ToolTip="Print Trading Account Statement"
                                           Height="36"
                                           Padding="12,0"
                                           Background="{DynamicResource AccentBrush}"
                                           Foreground="{DynamicResource AccentTextBrush}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE749;" FontFamily="Segoe MDL2 Assets" FontSize="11" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBlock Text="Print" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </telerik:RadButton>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ROW 1: KPI Metrics Bar -->
            <Grid Grid.Row="1" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1.2*"/>
                </Grid.ColumnDefinitions>

                <!-- Gross Sales Revenue -->
                <Border Grid.Column="0" Style="{StaticResource KpiCardStyle}">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="NET SALES REVENUE" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <TextBlock Text="{Binding Statement.FormattedTotalSales, StringFormat='₹ {0}'}" FontSize="15" FontWeight="Bold" Foreground="#0284C7" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Cost of Goods Sold -->
                <Border Grid.Column="1" Style="{StaticResource KpiCardStyle}">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="COST OF GOODS SOLD (COGS)" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <TextBlock Text="{Binding Statement.FormattedCostOfGoodsSold, StringFormat='₹ {0}'}" FontSize="15" FontWeight="Bold" Foreground="#D97706" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Gross Profit / Margin -->
                <Border Grid.Column="2" Style="{StaticResource KpiCardStyle}">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="GROSS PROFIT (MARGIN ₹)" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <TextBlock Text="{Binding Statement.FormattedGrossProfit, StringFormat='₹ {0}'}" FontSize="15" FontWeight="Bold" Foreground="#10B981" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Gross Margin % -->
                <Border Grid.Column="3" Style="{StaticResource KpiCardStyle}">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="GROSS MARGIN %" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <TextBlock Text="{Binding Statement.FormattedGrossProfitPercentage}" FontSize="15" FontWeight="Bold" Foreground="#8B5CF6" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Gold Reconciliation Status -->
                <Border Grid.Column="4" Style="{StaticResource KpiCardStyle}">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="GOLD WEIGHT RECONCILIATION" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <TextBlock Text="[OK] Physical &amp; Book Stock Tallied"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Foreground="#10B981"
                                   Margin="0,2,0,0"
                                   Visibility="{Binding Statement.GoldReconciliation.IsTallied, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="{Binding Statement.GoldReconciliation.FormattedDifference, StringFormat='Diff: {0}'}"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Foreground="#EF4444"
                                   Margin="0,2,0,0"
                                   Visibility="{Binding Statement.GoldReconciliation.IsTallied, Converter={StaticResource BoolToVis}, ConverterParameter=Inverse}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ROW 2: Trading Account Grids -->
            <telerik:RadTabControl Grid.Row="2" Background="Transparent" BorderThickness="0">

                <!-- TAB 1: Horizontal T-Format (Debits vs Credits) -->
                <telerik:RadTabItem Header="Horizontal T-Format (Debit vs Credit)">
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- LEFT SIDE: DEBITS -->
                        <Border Grid.Column="0"
                                Background="{DynamicResource CardBackgroundBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Header Bar -->
                                <Border Grid.Row="0" Background="#F1F5F9" Padding="10,8" CornerRadius="4,4,0,0" BorderBrush="#CBD5E1" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <TextBlock Text="DEBITS (PURCHASES &amp; DIRECT EXPENSES)" FontWeight="Bold" FontSize="12.5" Foreground="#0F766E"/>
                                        <TextBlock Text="{Binding Statement.FormattedTotalDebitsTFormat, StringFormat='Total: ₹ {0}'}" HorizontalAlignment="Right" FontWeight="Bold" FontSize="12" Foreground="#0F766E"/>
                                    </Grid>
                                </Border>

                                <!-- Debit RadGridView -->
                                <telerik:RadGridView Grid.Row="1"
                                                     ItemsSource="{Binding DebitItems}"
                                                     AutoGenerateColumns="False"
                                                     IsReadOnly="True"
                                                     CanUserReorderColumns="True"
                                                     ClipboardCopyMode="All"
                                                     CanUserResizeColumns="True"
                                                     SelectionMode="Extended"
                                                     ShowGroupPanel="False"
                                                     ShowGroupFooters="True"
                                                     ShowColumnFooters="True"
                                                     RowIndicatorVisibility="Collapsed"
                                                     GridLinesVisibility="Both"
                                                     FontSize="12">
                                    <telerik:RadGridView.Columns>
                                        <telerik:GridViewDataColumn Header="Particulars / Ledger Head"
                                                                    DataMemberBinding="{Binding Particulars}"
                                                                    Width="2*">
                                            <telerik:GridViewDataColumn.AggregateFunctions>
                                                <telerik:CountFunction Caption="Total Items: " ResultFormatString="{}{0}"/>
                                            </telerik:GridViewDataColumn.AggregateFunctions>
                                        </telerik:GridViewDataColumn>

                                        <telerik:GridViewDataColumn Header="Gold (g)"
                                                                    DataMemberBinding="{Binding GrossWeight}"
                                                                    DataFormatString="{}{0:N3}"
                                                                    TextAlignment="Right"
                                                                    Width="85">
                                            <telerik:GridViewDataColumn.AggregateFunctions>
                                                <telerik:SumFunction ResultFormatString="{}{0:N3} g"/>
                                            </telerik:GridViewDataColumn.AggregateFunctions>
                                        </telerik:GridViewDataColumn>

                                        <telerik:GridViewDataColumn Header="Silver (g)"
                                                                    DataMemberBinding="{Binding SilverWeight}"
                                                                    DataFormatString="{}{0:N3}"
                                                                    TextAlignment="Right"
                                                                    Width="85">
                                            <telerik:GridViewDataColumn.AggregateFunctions>
                                                <telerik:SumFunction ResultFormatString="{}{0:N3} g"/>
                                            </telerik:GridViewDataColumn.AggregateFunctions>
                                        </telerik:GridViewDataColumn>

                                        <telerik:GridViewDataColumn Header="Amount (₹)"
                                                                    DataMemberBinding="{Binding Amount}"
                                                                    DataFormatString="{}{0:N2}"
                                                                    TextAlignment="Right"
                                                                    Width="135">
                                            <telerik:GridViewDataColumn.AggregateFunctions>
                                                <telerik:SumFunction ResultFormatString="{}{0:N2}"/>
                                            </telerik:GridViewDataColumn.AggregateFunctions>
                                        </telerik:GridViewDataColumn>
                                    </telerik:RadGridView.Columns>
                                </telerik:RadGridView>
                            </Grid>
                        </Border>

                        <!-- Grid Splitter -->
                        <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent"/>

                        <!-- RIGHT SIDE: CREDITS -->
                        <Border Grid.Column="2"
                                Background="{DynamicResource CardBackgroundBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Header Bar -->
                                <Border Grid.Row="0" Background="#F1F5F9" Padding="10,8" CornerRadius="4,4,0,0" BorderBrush="#CBD5E1" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <TextBlock Text="CREDITS (SALES &amp; CLOSING STOCK)" FontWeight="Bold" FontSize="12.5" Foreground="#0284C7"/>
                                        <TextBlock Text="{Binding Statement.FormattedTotalCreditsTFormat, StringFormat='Total: ₹ {0}'}" HorizontalAlignment="Right" FontWeight="Bold" FontSize="12" Foreground="#0284C7"/>
                                    </Grid>
                                </Border>

                                <!-- Credit RadGridView -->
                                <telerik:RadGridView Grid.Row="1"
                                                     ItemsSource="{Binding CreditItems}"
                                                     AutoGenerateColumns="False"
                                                     IsReadOnly="True"
                                                     CanUserReorderColumns="True"
                                                     ClipboardCopyMode="All"
                                                     CanUserResizeColumns="True"
                                                     SelectionMode="Extended"
                                                     ShowGroupPanel="False"
                                                     ShowGroupFooters="True"
                                                     ShowColumnFooters="True"
                                                     RowIndicatorVisibility="Collapsed"
                                                     GridLinesVisibility="Both"
                                                     FontSize="12">
                                    <telerik:RadGridView.Columns>
                                        <telerik:GridViewDataColumn Header="Particulars / Ledger Head"
                                                                    DataMemberBinding="{Binding Particulars}"
                                                                    Width="2*">
                                            <telerik:GridViewDataColumn.AggregateFunctions>
                                                <telerik:CountFunction Caption="Total Items: " ResultFormatString="{}{0}"/>
                                            </telerik:GridViewDataColumn.AggregateFunctions>
                                        </telerik:GridViewDataColumn>

                                        <telerik:GridViewDataColumn Header="Gold (g)"
                                                                    DataMemberBinding="{Binding GrossWeight}"
                                                                    DataFormatString="{}{0:N3}"
                                                                    TextAlignment="Right"
                                                                    Width="85">
                                            <telerik:GridViewDataColumn.AggregateFunctions>
                                                <telerik:SumFunction ResultFormatString="{}{0:N3} g"/>
                                            </telerik:GridViewDataColumn.AggregateFunctions>
                                        </telerik:GridViewDataColumn>

                                        <telerik:GridViewDataColumn Header="Silver (g)"
                                                                    DataMemberBinding="{Binding SilverWeight}"
                                                                    DataFormatString="{}{0:N3}"
                                                                    TextAlignment="Right"
                                                                    Width="85">
                                            <telerik:GridViewDataColumn.AggregateFunctions>
                                                <telerik:SumFunction ResultFormatString="{}{0:N3} g"/>
                                            </telerik:GridViewDataColumn.AggregateFunctions>
                                        </telerik:GridViewDataColumn>

                                        <telerik:GridViewDataColumn Header="Amount (₹)"
                                                                    DataMemberBinding="{Binding Amount}"
                                                                    DataFormatString="{}{0:N2}"
                                                                    TextAlignment="Right"
                                                                    Width="135">
                                            <telerik:GridViewDataColumn.AggregateFunctions>
                                                <telerik:SumFunction ResultFormatString="{}{0:N2}"/>
                                            </telerik:GridViewDataColumn.AggregateFunctions>
                                        </telerik:GridViewDataColumn>
                                    </telerik:RadGridView.Columns>
                                </telerik:RadGridView>
                            </Grid>
                        </Border>
                    </Grid>
                </telerik:RadTabItem>

                <!-- TAB 2: Metal Weight Reconciliation -->
                <telerik:RadTabItem Header="Metal Weight Reconciliation">
                    <Border Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="16"
                            Margin="0,4,0,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel MaxWidth="900" HorizontalAlignment="Left">
                                <TextBlock Text="Physical Metal Flow &amp; Stock Reconciliation" FontSize="16" FontWeight="Bold" Foreground="#0F766E" Margin="0,0,0,12"/>

                                <!-- GOLD RECONCILIATION CARD -->
                                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock Text="1. GOLD WEIGHT RECONCILIATION (in Grams)" FontWeight="Bold" FontSize="13" Foreground="#334155" Margin="0,0,0,10"/>
                                        
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="(+) Opening Gold Stock (Gross Weight)" FontSize="12"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Statement.GoldReconciliation.FormattedOpening}" FontWeight="SemiBold" TextAlignment="Right"/>
                                        </Grid>
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="(+) Inward Gold Purchases (Bullion + Ornaments + Old Gold)" FontSize="12"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Statement.GoldReconciliation.FormattedInward}" FontWeight="SemiBold" TextAlignment="Right"/>
                                        </Grid>
                                        <Separator Margin="0,6"/>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="TOTAL GOLD INFLOW" FontWeight="Bold" FontSize="12.5"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Statement.GoldReconciliation.TotalInflow, StringFormat='{}{0:N3} g'}" FontWeight="Bold" TextAlignment="Right"/>
                                        </Grid>
                                        <Separator Margin="0,6"/>
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="(-) Gold Sales &amp; Wholesale Dispatches" FontSize="12"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Statement.GoldReconciliation.FormattedOutward}" TextAlignment="Right"/>
                                        </Grid>
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="(-) Closing Gold Stock-in-Hand" FontSize="12"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Statement.GoldReconciliation.FormattedClosing}" TextAlignment="Right"/>
                                        </Grid>
                                        <Separator Margin="0,6"/>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="= DIFFERENCE / MELTING LOSS / UNACCOUNTED" FontWeight="Bold" FontSize="12.5" Foreground="#0F766E"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Statement.GoldReconciliation.FormattedDifference}" FontWeight="Bold" FontSize="12.5" Foreground="#0F766E" TextAlignment="Right"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- SILVER RECONCILIATION CARD -->
                                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="14">
                                    <StackPanel>
                                        <TextBlock Text="2. SILVER WEIGHT RECONCILIATION (in Grams)" FontWeight="Bold" FontSize="13" Foreground="#334155" Margin="0,0,0,10"/>
                                        
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="(+) Opening Silver Stock" FontSize="12"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Statement.SilverReconciliation.FormattedOpening}" FontWeight="SemiBold" TextAlignment="Right"/>
                                        </Grid>
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="(+) Inward Silver Purchases" FontSize="12"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Statement.SilverReconciliation.FormattedInward}" FontWeight="SemiBold" TextAlignment="Right"/>
                                        </Grid>
                                        <Separator Margin="0,6"/>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="TOTAL SILVER INFLOW" FontWeight="Bold" FontSize="12.5"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Statement.SilverReconciliation.TotalInflow, StringFormat='{}{0:N3} g'}" FontWeight="Bold" TextAlignment="Right"/>
                                        </Grid>
                                        <Separator Margin="0,6"/>
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="(-) Silver Sales" FontSize="12"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Statement.SilverReconciliation.FormattedOutward}" TextAlignment="Right"/>
                                        </Grid>
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="(-) Closing Silver Stock-in-Hand" FontSize="12"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Statement.SilverReconciliation.FormattedClosing}" TextAlignment="Right"/>
                                        </Grid>
                                        <Separator Margin="0,6"/>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="= DIFFERENCE / UNACCOUNTED" FontWeight="Bold" FontSize="12.5" Foreground="#0F766E"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Statement.SilverReconciliation.FormattedDifference}" FontWeight="Bold" FontSize="12.5" Foreground="#0F766E" TextAlignment="Right"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </telerik:RadTabItem>
            </telerik:RadTabControl>
        </Grid>
    </Grid>
</UserControl>