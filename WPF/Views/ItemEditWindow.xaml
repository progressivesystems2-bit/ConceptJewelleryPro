<Window x:Class="ConceptJewelleryPro.WPF.Views.ItemEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
        Title="{Binding Title}"
        Height="720" Width="880"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        FontFamily="Segoe UI"
        Background="{DynamicResource WindowBackgroundBrush}">

    <Window.InputBindings>
        <KeyBinding Modifiers="Alt" Key="S" Command="{Binding SaveCommand}" />
        <KeyBinding Key="F10" Command="{Binding SaveCommand}" />
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="20,16" />
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>


        <Style TargetType="{x:Type telerik:RadWatermarkTextBox}" BasedOn="{StaticResource RadWatermarkTextBoxStyle}">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,4,8,4" />
        </Style>

        <Style TargetType="{x:Type telerik:RadNumericUpDown}" BasedOn="{StaticResource RadNumericUpDownStyle}">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="0,4,8,4" />
        </Style>

        <Style TargetType="{x:Type telerik:RadComboBox}" BasedOn="{StaticResource RadComboBoxStyle}">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="0,4,8,4" />
            <Setter Property="Padding" Value="8,0,4,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
        </Style>
    </Window.Resources>

    <Grid KeyboardNavigation.TabNavigation="Cycle">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="{DynamicResource HeaderBackgroundBrush}"
                BorderBrush="{DynamicResource HeaderBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="20,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="32" Height="32" CornerRadius="6" Background="{DynamicResource PanelBrush}">
                    <TextBlock Text="&#xE74C;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="14"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                    <TextBlock Text="Fill in the inventory item details below" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Form Body -->
        <telerik:RadBusyIndicator Grid.Row="1" IsBusy="{Binding IsBusy}" BusyContent="Saving Item...">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,16">
                <StackPanel>
                    <!-- Error Notification Banner -->
                    <Border Background="#FFEEEE" BorderBrush="#FFCCCC" BorderThickness="1" CornerRadius="4" Padding="12,8" Margin="0,0,0,12"
                            Visibility="{Binding ErrorMessage, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
                    </Border>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Item Entry Details" Style="{StaticResource SectionTitleStyle}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Left Column: Item Code / Item Name / Group / Sub Group / Unit / Metal Type / Purity / Standard Wt / Min-Max Wt -->

                                <!-- Row 0: Item Code -->
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Item Code *" Style="{StaticResource FieldLabelStyle}" />
                                <telerik:RadWatermarkTextBox Grid.Row="0" Grid.Column="1" Text="{Binding ItemCode, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsCodeReadOnly}" TabIndex="1" FontWeight="Bold" />

                                <!-- Row 1: Item Name -->
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Item Name *" Style="{StaticResource FieldLabelStyle}" />
                                <telerik:RadWatermarkTextBox Grid.Row="1" Grid.Column="1" Text="{Binding ItemName, UpdateSourceTrigger=PropertyChanged}" TabIndex="2" FontWeight="Bold" />

                                <!-- Row 2: Group -->
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Group" Style="{StaticResource FieldLabelStyle}" />
                                <telerik:RadComboBox Grid.Row="2" Grid.Column="1" IsEditable="True" ItemsSource="{Binding Groups}" SelectedItem="{Binding Group, Mode=TwoWay}" Text="{Binding Group, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TabIndex="3" />

                                <!-- Row 3: Sub Group -->
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Sub Group" Style="{StaticResource FieldLabelStyle}" />
                                <telerik:RadComboBox Grid.Row="3" Grid.Column="1" IsEditable="True" ItemsSource="{Binding SubGroups}" SelectedItem="{Binding SubGroup, Mode=TwoWay}" Text="{Binding SubGroup, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TabIndex="4" />

                                <!-- Row 4: Unit -->
                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Unit" Style="{StaticResource FieldLabelStyle}" />
                                <telerik:RadComboBox Grid.Row="4" Grid.Column="1" IsEditable="True" ItemsSource="{Binding Units}" SelectedItem="{Binding Unit, Mode=TwoWay}" Text="{Binding Unit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TabIndex="5" />

                                <!-- Row 5: Metal Type -->
                                <TextBlock Grid.Row="5" Grid.Column="0" Text="Metal Type" Style="{StaticResource FieldLabelStyle}" />
                                <telerik:RadComboBox Grid.Row="5" Grid.Column="1" IsEditable="True" ItemsSource="{Binding MetalTypes}" SelectedItem="{Binding MetalType, Mode=TwoWay}" Text="{Binding MetalType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TabIndex="6" />

                                <!-- Row 6: Purity & Standard Wt -->
                                <TextBlock Grid.Row="6" Grid.Column="0" Text="Purity | Std Wt" Style="{StaticResource FieldLabelStyle}" />
                                <Grid Grid.Row="6" Grid.Column="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <telerik:RadComboBox Grid.Column="0" IsEditable="True" ItemsSource="{Binding Purities}" SelectedItem="{Binding PurityText, Mode=TwoWay}" Text="{Binding PurityText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TabIndex="7" Margin="0,4,4,4" ToolTip="Purity (e.g. 916HM, 925 Silver, Silver, 22K)" />
                                    <telerik:RadNumericUpDown Grid.Column="1" Value="{Binding StandardWeight}" TabIndex="8" Margin="4,4,8,4" ToolTip="Standard Weight (g)" />
                                </Grid>

                                <!-- Row 7: Min Wt & Max Wt -->
                                <TextBlock Grid.Row="7" Grid.Column="0" Text="Min | Max Wt" Style="{StaticResource FieldLabelStyle}" />
                                <Grid Grid.Row="7" Grid.Column="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <telerik:RadNumericUpDown Grid.Column="0" Value="{Binding MinWeight}" TabIndex="9" Margin="0,4,4,4" ToolTip="Min Weight (g)" />
                                    <telerik:RadNumericUpDown Grid.Column="1" Value="{Binding MaxWeight}" TabIndex="10" Margin="4,4,8,4" ToolTip="Max Weight (g)" />
                                </Grid>

                                <!-- Row 8: Op Stock & Reorder -->
                                <TextBlock Grid.Row="8" Grid.Column="0" Text="Op Stock | Reorder" Style="{StaticResource FieldLabelStyle}" />
                                <Grid Grid.Row="8" Grid.Column="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <telerik:RadNumericUpDown Grid.Column="0" Value="{Binding OpeningStock}" TabIndex="11" Margin="0,4,4,4" ToolTip="Opening Stock" />
                                    <telerik:RadNumericUpDown Grid.Column="1" Value="{Binding ReorderLevel}" TabIndex="12" Margin="4,4,8,4" ToolTip="Reorder Level" />
                                </Grid>

                                <!-- Right Column: MRP / Sale Rate / Purchase Rate / HSN Code / GST Rate / Status / Options / Description -->

                                <!-- Row 0: MRP -->
                                <TextBlock Grid.Row="0" Grid.Column="3" Text="MRP" Style="{StaticResource FieldLabelStyle}" />
                                <telerik:RadNumericUpDown Grid.Row="0" Grid.Column="4" Value="{Binding MRP}" TabIndex="13" />

                                <!-- Row 1: Sale Rate -->
                                <TextBlock Grid.Row="1" Grid.Column="3" Text="Sale Rate" Style="{StaticResource FieldLabelStyle}" />
                                <telerik:RadNumericUpDown Grid.Row="1" Grid.Column="4" Value="{Binding SaleRate}" TabIndex="14" />

                                <!-- Row 2: Purchase Rate -->
                                <TextBlock Grid.Row="2" Grid.Column="3" Text="Purchase Rate" Style="{StaticResource FieldLabelStyle}" />
                                <telerik:RadNumericUpDown Grid.Row="2" Grid.Column="4" Value="{Binding PurchaseRate}" TabIndex="15" />

                                <!-- Row 3: HSN Code -->
                                <TextBlock Grid.Row="3" Grid.Column="3" Text="HSN Code" Style="{StaticResource FieldLabelStyle}" />
                                <telerik:RadWatermarkTextBox Grid.Row="3" Grid.Column="4" Text="{Binding HSNCode, UpdateSourceTrigger=PropertyChanged}" TabIndex="16" />

                                <!-- Row 4: GST Rate -->
                                <TextBlock Grid.Row="4" Grid.Column="3" Text="GST Rate (%)" Style="{StaticResource FieldLabelStyle}" />
                                <telerik:RadNumericUpDown Grid.Row="4" Grid.Column="4" Value="{Binding GSTRate}" TabIndex="17" />

                                <!-- Row 5: Status -->
                                <TextBlock Grid.Row="5" Grid.Column="3" Text="Status" Style="{StaticResource FieldLabelStyle}" />
                                <telerik:RadComboBox Grid.Row="5" Grid.Column="4" ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding Status}" TabIndex="18" />

                                <!-- Row 6: Options (Active & Allowed) -->
                                <TextBlock Grid.Row="6" Grid.Column="3" Text="Options" Style="{StaticResource FieldLabelStyle}" />
                                <StackPanel Grid.Row="6" Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                    <CheckBox Content="Active" IsChecked="{Binding IsActive}" VerticalAlignment="Center" Margin="0,0,20,0" TabIndex="19" />
                                    <CheckBox Content="Allowed (Sell via Name)" IsChecked="{Binding Allowed}" VerticalAlignment="Center" TabIndex="20" ToolTip="When unchecked (Allowed = 0), item must be sold via Barcode." />
                                </StackPanel>

                                <!-- Row 7-8: Description -->
                                <TextBlock Grid.Row="7" Grid.Column="3" Text="Description" Style="{StaticResource FieldLabelStyle}" />
                                <telerik:RadWatermarkTextBox Grid.Row="7" Grid.RowSpan="2" Grid.Column="4" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" TabIndex="21" AcceptsReturn="True" VerticalContentAlignment="Top" Height="86" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </telerik:RadBusyIndicator>

        <!-- Sticky Bottom Footer -->
        <Border Grid.Row="2"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource HeaderBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="20,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <telerik:RadButton Content="Cancel"
                                   Width="90"
                                   Height="40"
                                   Margin="0,0,10,0"
                                   Command="{Binding CancelCommand}"
                                   IsTabStop="False" />
                <telerik:RadButton Content="Save Item (Alt+S)"
                                   Width="160"
                                   Height="40"
                                   FontWeight="Bold"
                                   Style="{StaticResource PrimaryToolbarButtonStyle}"
                                   Command="{Binding SaveCommand}"
                                   TabIndex="22"
                                   IsTabStop="True" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
