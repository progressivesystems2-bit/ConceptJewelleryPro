<UserControl x:Class="ConceptJewelleryPro.WPF.Views.NonBarcodeItemStockReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
             xmlns:controls="clr-namespace:ConceptJewelleryPro.WPF.Controls"
             xmlns:conv="clr-namespace:ConceptJewelleryPro.WPF.Converters"
             xmlns:vm="clr-namespace:ConceptJewelleryPro.WPF.ViewModels"
             FontFamily="Segoe UI"
             TextOptions.TextFormattingMode="Display">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="HeaderFilterLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
        </Style>

        <Style x:Key="MainTabButtonStyle" TargetType="telerik:RadButton" BasedOn="{StaticResource RadButtonStyle}">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1,1,1,1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="TotalBoxStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="Height" Value="26"/>
        </Style>

        <Style x:Key="TotalTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <!-- Toast Notification Overlay -->
        <controls:ToastNotification x:Name="ToastNotification"
                                     Panel.ZIndex="99"
                                     Message="{Binding ToastMessage, FallbackValue=''}"
                                     ToastType="{Binding ToastType, FallbackValue=Info}"
                                     AutoCloseDelay="4000"
                                     FontSize="13"
                                     HorizontalAlignment="Right"
                                     VerticalAlignment="Bottom"
                                     Margin="0,0,24,24"/>

        <Grid Margin="10,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Top Filter Bar -->
                <RowDefinition Height="Auto"/> <!-- Tab Headers Area -->
                <RowDefinition Height="*"/>    <!-- Data Grid Area -->
                <RowDefinition Height="Auto"/> <!-- Footer Totals & Summary -->
            </Grid.RowDefinitions>

            <!-- ================= ROW 0: TOP FILTER BAR ================= -->
            <Border Grid.Row="0"
                    Background="{DynamicResource HeaderBackgroundBrush}"
                    BorderBrush="{DynamicResource HeaderBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="10,6"
                    Margin="0,0,0,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Filters -->
                    <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- From Date -->
                        <StackPanel Orientation="Horizontal" Margin="0,2,8,2" VerticalAlignment="Center">
                            <TextBlock Text="From Date:" Style="{StaticResource HeaderFilterLabel}"/>
                            <telerik:RadDatePicker SelectedDate="{Binding FromDate, Mode=TwoWay}"
                                                   Width="130"/>
                        </StackPanel>

                        <!-- To Date -->
                        <StackPanel Orientation="Horizontal" Margin="0,2,8,2" VerticalAlignment="Center">
                            <TextBlock Text="To Date:" Style="{StaticResource HeaderFilterLabel}"/>
                            <telerik:RadDatePicker SelectedDate="{Binding ToDate, Mode=TwoWay}"
                                                   Width="130"/>
                        </StackPanel>

                        <!-- Head Group -->
                        <StackPanel Orientation="Horizontal" Margin="0,2,8,2" VerticalAlignment="Center">
                            <TextBlock Text="Head Group:" Style="{StaticResource HeaderFilterLabel}"/>
                            <telerik:RadComboBox ItemsSource="{Binding ItemHeads}"
                                                 SelectedItem="{Binding SelectedItemHead, Mode=TwoWay}"
                                                 Width="120"
                                                 IsEditable="True"/>
                        </StackPanel>

                        <!-- Sub Group -->
                        <StackPanel Orientation="Horizontal" Margin="0,2,8,2" VerticalAlignment="Center">
                            <TextBlock Text="Sub Group:" Style="{StaticResource HeaderFilterLabel}"/>
                            <telerik:RadComboBox ItemsSource="{Binding SubGroups}"
                                                 SelectedItem="{Binding SelectedSubGroup, Mode=TwoWay}"
                                                 Width="120"
                                                 IsEditable="True"/>
                        </StackPanel>

                        <!-- Item Name -->
                        <StackPanel Orientation="Horizontal" Margin="0,2,8,2" VerticalAlignment="Center">
                            <TextBlock Text="Item:" Style="{StaticResource HeaderFilterLabel}"/>
                            <telerik:RadComboBox ItemsSource="{Binding ItemNames}"
                                                 SelectedItem="{Binding SelectedItemName, Mode=TwoWay}"
                                                 Width="140"
                                                 IsEditable="True"/>
                        </StackPanel>

                        <!-- Search -->
                        <StackPanel Orientation="Horizontal" Margin="0,2,8,2" VerticalAlignment="Center">
                            <TextBlock Text="Search:" Style="{StaticResource HeaderFilterLabel}"/>
                            <telerik:RadWatermarkTextBox Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         WatermarkContent="Type to search..."
                                                         Height="28"
                                                         Width="130"
                                                         FontSize="12"
                                                         VerticalContentAlignment="Center"
                                                         Margin="0,0,10,0"/>
                        </StackPanel>
                    </WrapPanel>

                    <!-- Right: Action Buttons -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <telerik:RadButton Command="{Binding RefreshCommand}" Margin="0,0,4,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔄" Margin="0,0,4,0"/>
                                <TextBlock Text="Refresh"/>
                            </StackPanel>
                        </telerik:RadButton>

                        <telerik:RadButton Command="{Binding ExportToExcelCommand}" Margin="0,0,4,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📊" Margin="0,0,4,0"/>
                                <TextBlock Text="Export CSV"/>
                            </StackPanel>
                        </telerik:RadButton>

                        <telerik:RadButton Command="{Binding PrintCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🖨️" Margin="0,0,4,0"/>
                                <TextBlock Text="Print"/>
                            </StackPanel>
                        </telerik:RadButton>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ================= ROW 1: TAB HEADERS AREA ================= -->
            <Border Grid.Row="1"
                    Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1,1,1,0"
                    CornerRadius="4,4,0,0"
                    Padding="6,4,6,0">
                <StackPanel Orientation="Horizontal">
                    <!-- Tab 1: Item-Wise Stock -->
                    <telerik:RadButton Command="{Binding SelectTabCommand}"
                                       Height="36"
                                       FontSize="14"
                                       CommandParameter="ItemWiseStock">
                        <telerik:RadButton.Style>
                            <Style TargetType="telerik:RadButton" BasedOn="{StaticResource MainTabButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsItemWiseActive}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                        <Setter Property="BorderThickness" Value="1,1,1,1"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </telerik:RadButton.Style>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🏷️" Margin="0,0,6,0" FontSize="13"/>
                            <TextBlock Text="Non-Barcode Stock (Item-Wise)" FontWeight="Bold"/>
                        </StackPanel>
                    </telerik:RadButton>

                    <!-- Tab 2: Transaction-Wise List -->
                    <telerik:RadButton Command="{Binding SelectTabCommand}"
                                       Height="36"
                                       FontSize="14"
                                       CommandParameter="TransactionWise">
                        <telerik:RadButton.Style>
                            <Style TargetType="telerik:RadButton" BasedOn="{StaticResource MainTabButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsTransactionWiseActive}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                        <Setter Property="BorderThickness" Value="1,1,1,1"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </telerik:RadButton.Style>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📝" Margin="0,0,6,0" FontSize="13"/>
                            <TextBlock Text="Transaction-Wise List (Tab 2)" FontWeight="Bold"/>
                        </StackPanel>
                    </telerik:RadButton>
                </StackPanel>
            </Border>

            <!-- ================= ROW 2: DATA GRIDS ================= -->
            <Border Grid.Row="2"
                    Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="0,0,4,4">
                <Grid>
                    <!-- TAB 1: ITEM-WISE STOCK GRID -->
                    <telerik:RadGridView ItemsSource="{Binding ItemStockList}"
                                         SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                                         Visibility="{Binding IsItemGridVisible, Converter={StaticResource BoolToVis}}"
                                         AutoGenerateColumns="False"
                                         IsReadOnly="True"
                                         CanUserSortColumns="True"
                                         CanUserResizeColumns="True"
                                         ShowGroupPanel="False"
                                         RowIndicatorVisibility="Collapsed"
                                         AlternationCount="2"
                                         FontSize="12"
                                         BorderThickness="0">
                        <telerik:RadGridView.Columns>
                            <telerik:GridViewDataColumn Header="Item Name"
                                                        DataMemberBinding="{Binding ItemName}"
                                                        Width="*"/>

                            <telerik:GridViewDataColumn Header="Head Group"
                                                        DataMemberBinding="{Binding HeadGroup}"
                                                        Width="110"/>

                            <telerik:GridViewDataColumn Header="Sub Group"
                                                        DataMemberBinding="{Binding SubGroup}"
                                                        Width="105"/>

                            <telerik:GridViewDataColumn Header="Purity"
                                                        DataMemberBinding="{Binding Purity}"
                                                        Width="85"
                                                        TextAlignment="Center"/>

                            <!-- Opening -->
                            <telerik:GridViewDataColumn Header="Opening Qty"
                                                        DataMemberBinding="{Binding OpeningQty, StringFormat='{}{0:#,##0}'}"
                                                        TextAlignment="Right"
                                                        Width="90"/>

                            <telerik:GridViewDataColumn Header="Opening Wt (g)"
                                                        DataMemberBinding="{Binding OpeningWt, StringFormat='{}{0:#,##0.000}'}"
                                                        TextAlignment="Right"
                                                        Width="110"/>

                            <!-- Inward -->
                            <telerik:GridViewDataColumn Header="Inward Qty"
                                                        DataMemberBinding="{Binding InwardQty, StringFormat='{}{0:#,##0}'}"
                                                        TextAlignment="Right"
                                                        Width="90"/>

                            <telerik:GridViewDataColumn Header="Inward Wt (g)"
                                                        DataMemberBinding="{Binding InwardWt, StringFormat='{}{0:#,##0.000}'}"
                                                        TextAlignment="Right"
                                                        Width="110"/>

                            <!-- Outward -->
                            <telerik:GridViewDataColumn Header="Outward Qty"
                                                        DataMemberBinding="{Binding OutwardQty, StringFormat='{}{0:#,##0}'}"
                                                        TextAlignment="Right"
                                                        Width="90"/>

                            <telerik:GridViewDataColumn Header="Outward Wt (g)"
                                                        DataMemberBinding="{Binding OutwardWt, StringFormat='{}{0:#,##0.000}'}"
                                                        TextAlignment="Right"
                                                        Width="110"/>

                            <!-- Closing -->
                            <telerik:GridViewDataColumn Header="Closing Qty"
                                                        DataMemberBinding="{Binding ClosingQty, StringFormat='{}{0:#,##0}'}"
                                                        TextAlignment="Right"
                                                        Width="95"/>

                            <telerik:GridViewDataColumn Header="Closing Wt (g)"
                                                        DataMemberBinding="{Binding ClosingWt, StringFormat='{}{0:#,##0.000}'}"
                                                        TextAlignment="Right"
                                                        Width="120"/>
                        </telerik:RadGridView.Columns>
                    </telerik:RadGridView>

                    <!-- TAB 2: TRANSACTION-WISE LIST GRID -->
                    <telerik:RadGridView ItemsSource="{Binding Transactions}"
                                         SelectedItem="{Binding SelectedTransaction, Mode=TwoWay}"
                                         Visibility="{Binding IsTransactionGridVisible, Converter={StaticResource BoolToVis}}"
                                         AutoGenerateColumns="False"
                                         IsReadOnly="True"
                                         CanUserSortColumns="True"
                                         CanUserResizeColumns="True"
                                         ShowGroupPanel="False"
                                         RowIndicatorVisibility="Collapsed"
                                         AlternationCount="2"
                                         FontSize="12"
                                         BorderThickness="0">
                        <telerik:RadGridView.Columns>
                            <telerik:GridViewDataColumn Header="Date"
                                                        DataMemberBinding="{Binding Date, StringFormat='{}{0:dd-MMM-yyyy}'}"
                                                        Width="95"
                                                        TextAlignment="Center"/>

                            <telerik:GridViewDataColumn Header="Voucher No"
                                                        DataMemberBinding="{Binding VouNo}"
                                                        Width="105"/>

                            <telerik:GridViewDataColumn Header="Type"
                                                        DataMemberBinding="{Binding TransactionType}"
                                                        Width="135"/>

                            <telerik:GridViewDataColumn Header="Party / Customer Name"
                                                        DataMemberBinding="{Binding PartyName}"
                                                        Width="150"/>

                            <telerik:GridViewDataColumn Header="Item Name"
                                                        DataMemberBinding="{Binding ItemName}"
                                                        Width="*"/>

                            <telerik:GridViewDataColumn Header="Head Group"
                                                        DataMemberBinding="{Binding HeadGroup}"
                                                        Width="100"/>

                            <telerik:GridViewDataColumn Header="Sub Group"
                                                        DataMemberBinding="{Binding SubGroup}"
                                                        Width="95"/>

                            <telerik:GridViewDataColumn Header="Purity"
                                                        DataMemberBinding="{Binding Purity}"
                                                        Width="75"
                                                        TextAlignment="Center"/>

                            <telerik:GridViewDataColumn Header="In Qty"
                                                        DataMemberBinding="{Binding InQty, StringFormat='{}{0:#,##0}'}"
                                                        TextAlignment="Right"
                                                        Width="65"/>

                            <telerik:GridViewDataColumn Header="In Wt (g)"
                                                        DataMemberBinding="{Binding InWt, StringFormat='{}{0:#,##0.000}'}"
                                                        TextAlignment="Right"
                                                        Width="85"/>

                            <telerik:GridViewDataColumn Header="Out Qty"
                                                        DataMemberBinding="{Binding OutQty, StringFormat='{}{0:#,##0}'}"
                                                        TextAlignment="Right"
                                                        Width="65"/>

                            <telerik:GridViewDataColumn Header="Out Wt (g)"
                                                        DataMemberBinding="{Binding OutWt, StringFormat='{}{0:#,##0.000}'}"
                                                        TextAlignment="Right"
                                                        Width="85"/>

                            <telerik:GridViewDataColumn Header="Net Wt (g)"
                                                        DataMemberBinding="{Binding NetWt, StringFormat='{}{0:#,##0.000}'}"
                                                        TextAlignment="Right"
                                                        Width="85"/>

                            <telerik:GridViewDataColumn Header="Rate"
                                                        DataMemberBinding="{Binding Rate, StringFormat='{}{0:#,##0.00}'}"
                                                        TextAlignment="Right"
                                                        Width="80"/>

                            <telerik:GridViewDataColumn Header="Amount"
                                                        DataMemberBinding="{Binding Amount, StringFormat='{}{0:#,##0.00}'}"
                                                        TextAlignment="Right"
                                                        Width="95"/>

                            <telerik:GridViewDataColumn Header="Remarks / Narration"
                                                        DataMemberBinding="{Binding Narration}"
                                                        Width="130"/>

                            <telerik:GridViewDataColumn Header="User"
                                                        DataMemberBinding="{Binding EntryUser}"
                                                        Width="70"/>
                        </telerik:RadGridView.Columns>
                    </telerik:RadGridView>
                </Grid>
            </Border>

            <!-- ================= ROW 3: FOOTER TOTALS & SUMMARY ================= -->
            <Border Grid.Row="3"
                    Background="{DynamicResource HeaderBackgroundBrush}"
                    BorderBrush="{DynamicResource HeaderBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="10,6"
                    Margin="0,6,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Record Count -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding RecordCountDisplay}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                    </StackPanel>

                    <!-- Right: Dynamic Totals Display -->
                    <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                               Visibility="{Binding IsStockSummaryFooterVisible, Converter={StaticResource BoolToVis}}">
                        <!-- Total Opening Wt -->
                        <StackPanel Orientation="Horizontal" Margin="4,2">
                            <TextBlock Text="Total Op Wt:" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,3,0"/>
                            <Border Style="{StaticResource TotalBoxStyle}">
                                <TextBlock Text="{Binding TotalOpeningWt, StringFormat='{}{0:#,##0.000}g'}" Style="{StaticResource TotalTextStyle}"/>
                            </Border>
                        </StackPanel>

                        <!-- Total Inward Wt -->
                        <StackPanel Orientation="Horizontal" Margin="4,2">
                            <TextBlock Text="Total In Wt:" VerticalAlignment="Center" FontSize="11" Foreground="#2E7D32" FontWeight="SemiBold" Margin="0,0,3,0"/>
                            <Border Style="{StaticResource TotalBoxStyle}">
                                <TextBlock Text="{Binding TotalInwardWt, StringFormat='{}{0:#,##0.000}g'}" Style="{StaticResource TotalTextStyle}" Foreground="#2E7D32"/>
                            </Border>
                        </StackPanel>

                        <!-- Total Outward Wt -->
                        <StackPanel Orientation="Horizontal" Margin="4,2">
                            <TextBlock Text="Total Out Wt:" VerticalAlignment="Center" FontSize="11" Foreground="#C62828" FontWeight="SemiBold" Margin="0,0,3,0"/>
                            <Border Style="{StaticResource TotalBoxStyle}">
                                <TextBlock Text="{Binding TotalOutwardWt, StringFormat='{}{0:#,##0.000}g'}" Style="{StaticResource TotalTextStyle}" Foreground="#C62828"/>
                            </Border>
                        </StackPanel>

                        <!-- Total Closing Qty -->
                        <StackPanel Orientation="Horizontal" Margin="4,2">
                            <TextBlock Text="Closing Qty:" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold" Margin="0,0,3,0"/>
                            <Border Style="{StaticResource TotalBoxStyle}">
                                <TextBlock Text="{Binding TotalClosingQty, StringFormat='{}{0:#,##0}'}" Style="{StaticResource TotalTextStyle}"/>
                            </Border>
                        </StackPanel>

                        <!-- Total Closing Wt -->
                        <StackPanel Orientation="Horizontal" Margin="4,2">
                            <TextBlock Text="Closing Net Wt:" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" Margin="0,0,3,0"/>
                            <Border Style="{StaticResource TotalBoxStyle}" BorderBrush="{DynamicResource AccentBrush}">
                                <TextBlock Text="{Binding TotalClosingWt, StringFormat='{}{0:#,##0.000}g'}" Style="{StaticResource TotalTextStyle}" Foreground="{DynamicResource AccentBrush}"/>
                            </Border>
                        </StackPanel>
                    </WrapPanel>

                    <!-- Transaction Footer -->
                    <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                               Visibility="{Binding IsTransactionFooterVisible, Converter={StaticResource BoolToVis}}">
                        <!-- Total Inward Wt -->
                        <StackPanel Orientation="Horizontal" Margin="4,2">
                            <TextBlock Text="Total In Wt:" VerticalAlignment="Center" FontSize="11" Foreground="#2E7D32" FontWeight="SemiBold" Margin="0,0,3,0"/>
                            <Border Style="{StaticResource TotalBoxStyle}">
                                <TextBlock Text="{Binding TotalInwardWt, StringFormat='{}{0:#,##0.000}g'}" Style="{StaticResource TotalTextStyle}" Foreground="#2E7D32"/>
                            </Border>
                        </StackPanel>

                        <!-- Total Outward Wt -->
                        <StackPanel Orientation="Horizontal" Margin="4,2">
                            <TextBlock Text="Total Out Wt:" VerticalAlignment="Center" FontSize="11" Foreground="#C62828" FontWeight="SemiBold" Margin="0,0,3,0"/>
                            <Border Style="{StaticResource TotalBoxStyle}">
                                <TextBlock Text="{Binding TotalOutwardWt, StringFormat='{}{0:#,##0.000}g'}" Style="{StaticResource TotalTextStyle}" Foreground="#C62828"/>
                            </Border>
                        </StackPanel>

                        <!-- Net Wt -->
                        <StackPanel Orientation="Horizontal" Margin="4,2">
                            <TextBlock Text="Net Wt:" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" Margin="0,0,3,0"/>
                            <Border Style="{StaticResource TotalBoxStyle}" BorderBrush="{DynamicResource AccentBrush}">
                                <TextBlock Text="{Binding TotalNetWt, StringFormat='{}{0:#,##0.000}g'}" Style="{StaticResource TotalTextStyle}" Foreground="{DynamicResource AccentBrush}"/>
                            </Border>
                        </StackPanel>

                        <!-- Total Amount -->
                        <StackPanel Orientation="Horizontal" Margin="4,2">
                            <TextBlock Text="Total Amount:" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold" Margin="0,0,3,0"/>
                            <Border Style="{StaticResource TotalBoxStyle}">
                                <TextBlock Text="{Binding TotalAmount, StringFormat='{}₹{0:#,##0.00}'}" Style="{StaticResource TotalTextStyle}"/>
                            </Border>
                        </StackPanel>
                    </WrapPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
