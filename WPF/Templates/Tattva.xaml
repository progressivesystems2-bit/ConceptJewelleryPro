<FlowDocument xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              PageWidth="793.7"
              PageHeight="1122.5"
              PagePadding="24,20,24,20"
              ColumnWidth="793.7"
              FontFamily="Segoe UI, Arial, sans-serif"
              FontSize="10"
              LineHeight="1.25"
              Background="White"
              Foreground="#1A1A1A">

    <!-- ========================================================================= -->
    <!-- 1. TOP HEADER BOX (3 Columns: Store Info, Logo, Invoice/Buyer Details)   -->
    <!-- ========================================================================= -->
    <Table CellSpacing="0" BorderThickness="1.5,1.5,1.5,0" BorderBrush="#4B2C1D" Margin="0,0,0,0">
        <Table.Columns>
            <TableColumn Width="235" />
            <TableColumn Width="240" />
            <TableColumn Width="270" />
        </Table.Columns>
        <TableRowGroup>
            <TableRow>
                <!-- Left: Store Address & GSTIN -->
                <TableCell BorderThickness="0,0,1.5,0" BorderBrush="#4B2C1D" Padding="8,8,6,8">
                    <Paragraph Margin="0,0,0,2" FontSize="9.5">
                        <Run Text="Osiya Tower, Haripur Rd" />
                    </Paragraph>
                    <Paragraph Margin="0,0,0,2" FontSize="9.5">
                        <Run Text="Dolamundai, Cuttack" />
                    </Paragraph>
                    <Paragraph Margin="0,0,0,2" FontSize="9.5">
                        <Run Text="www.tattvajewels.in" />
                    </Paragraph>
                    <Paragraph Margin="0,0,0,3" FontSize="9.5">
                        <Run Text="Ph: 9583237999" />
                    </Paragraph>
                    <Paragraph Margin="0" FontSize="10">
                        <Bold><Run Text="GSTIN: 21AGVPV8495M1Z5" /></Bold>
                    </Paragraph>
                </TableCell>

                <!-- Center: Tattva Logo -->
                <TableCell BorderThickness="0,0,1.5,0" BorderBrush="#4B2C1D" Padding="6,6">
                    <BlockUIContainer Margin="0">
                        <Image Source="{{LogoPath}}" Height="60" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </BlockUIContainer>
                </TableCell>

                <!-- Right: Invoice Metadata & Buyer -->
                <TableCell Padding="8,8,6,8">
                    <Table CellSpacing="0">
                        <Table.Columns>
                            <TableColumn Width="90" />
                            <TableColumn Width="170" />
                        </Table.Columns>
                        <TableRowGroup>
                            <TableRow>
                                <TableCell Padding="0,1.5"><Paragraph FontSize="9.5"><Run Text="Invoice No:" /></Paragraph></TableCell>
                                <TableCell Padding="0,1.5"><Paragraph FontSize="10"><Bold><Run Text="{{VouNo}}" /></Bold></Paragraph></TableCell>
                            </TableRow>
                            <TableRow>
                                <TableCell Padding="0,1.5"><Paragraph FontSize="9.5"><Run Text="Invoice Date:" /></Paragraph></TableCell>
                                <TableCell Padding="0,1.5"><Paragraph FontSize="10"><Bold><Run Text="{{BillDateLong}}" /></Bold></Paragraph></TableCell>
                            </TableRow>
                            <TableRow>
                                <TableCell Padding="0,1.5"><Paragraph FontSize="9.5"><Run Text="Buyer:" /></Paragraph></TableCell>
                                <TableCell Padding="0,1.5"><Paragraph FontSize="10.5"><Bold><Run Text="{{CustomerName}}" /></Bold></Paragraph></TableCell>
                            </TableRow>
                            <TableRow>
                                <TableCell Padding="0,1"><Paragraph FontSize="9"><Run Text="" /></Paragraph></TableCell>
                                <TableCell Padding="0,1"><Paragraph FontSize="9"><Run Text="{{Address}}" /><Run Text=" " /><Run Text="{{Address2}}" /></Paragraph></TableCell>
                            </TableRow>
                            <TableRow>
                                <TableCell Padding="0,1.5"><Paragraph FontSize="9.5"><Run Text="Phone:" /></Paragraph></TableCell>
                                <TableCell Padding="0,1.5"><Paragraph FontSize="9.5"><Run Text="{{Phone}}" /></Paragraph></TableCell>
                            </TableRow>
                        </TableRowGroup>
                    </Table>
                </TableCell>
            </TableRow>
        </TableRowGroup>
    </Table>

    <!-- ========================================================================= -->
    <!-- 2. SPECIALIZATION TAGLINE BANNER                                          -->
    <!-- ========================================================================= -->
    <Table CellSpacing="0" BorderThickness="1.5" BorderBrush="#4B2C1D" Background="#FDFBF9" Margin="0,0,0,6">
        <Table.Columns><TableColumn Width="745" /></Table.Columns>
        <TableRowGroup>
            <TableRow>
                <TableCell Padding="4,4">
                    <Paragraph TextAlignment="Center">
                        <Bold><Run Text="Specialists in Silver Filigree | Sterling Silver Jewellery | Gift Articles | Utencils | Puja Items"
                                   Foreground="#4B2C1D"
                                   FontSize="10" /></Bold>
                    </Paragraph>
                </TableCell>
            </TableRow>
        </TableRowGroup>
    </Table>

    <!-- ========================================================================= -->
    <!-- 3. ITEMS TABLE WITH WATERMARK & PROPORTIONAL MINROWS                      -->
    <!-- ========================================================================= -->
    <Table CellSpacing="0" BorderThickness="1.5" BorderBrush="#4B2C1D" Margin="0,0,0,6">
        <Table.Background>
            <ImageBrush ImageSource="{{WatermarkPath}}" Stretch="Uniform" Opacity="0.15" />
        </Table.Background>
        <Table.Columns>
            <TableColumn Width="32" />  <!-- S.N -->
            <TableColumn Width="250" /> <!-- ITEM NAME -->
            <TableColumn Width="45" />  <!-- HSN -->
            <TableColumn Width="145" /> <!-- QTY NT. WT -->
            <TableColumn Width="88" />  <!-- VALUE -->
            <TableColumn Width="85" />  <!-- DISCOUNT -->
            <TableColumn Width="100" /> <!-- AMOUNT -->
        </Table.Columns>

        <!-- Table Column Headers -->
        <TableRowGroup>
            <TableRow FontWeight="Bold" Foreground="#1A1A1A">
                <TableCell BorderThickness="0,0,1,1.5" BorderBrush="#4B2C1D" Padding="2,5"><Paragraph TextAlignment="Center" FontSize="9.5">S.N</Paragraph></TableCell>
                <TableCell BorderThickness="0,0,1,1.5" BorderBrush="#4B2C1D" Padding="6,5"><Paragraph TextAlignment="Left" FontSize="9.5">ITEM NAME</Paragraph></TableCell>
                <TableCell BorderThickness="0,0,1,1.5" BorderBrush="#4B2C1D" Padding="2,5"><Paragraph TextAlignment="Center" FontSize="9.5">HSN</Paragraph></TableCell>
                <TableCell BorderThickness="0,0,1,1.5" BorderBrush="#4B2C1D" Padding="4,5">
                    <Table CellSpacing="0">
                        <Table.Columns>
                            <TableColumn Width="38" />
                            <TableColumn Width="64" />
                            <TableColumn Width="38" />
                        </Table.Columns>
                        <TableRowGroup>
                            <TableRow FontWeight="Bold">
                                <TableCell Padding="0"><Paragraph TextAlignment="Center" FontSize="9.5">QTY</Paragraph></TableCell>
                                <TableCell Padding="0"><Paragraph TextAlignment="Center" FontSize="9.5">NT. WT</Paragraph></TableCell>
                                <TableCell Padding="0"><Paragraph TextAlignment="Center" FontSize="9.5"></Paragraph></TableCell>
                            </TableRow>
                        </TableRowGroup>
                    </Table>
                </TableCell>
                <TableCell BorderThickness="0,0,1,1.5" BorderBrush="#4B2C1D" Padding="4,5"><Paragraph TextAlignment="Right" FontSize="9.5">VALUE</Paragraph></TableCell>
                <TableCell BorderThickness="0,0,1,1.5" BorderBrush="#4B2C1D" Padding="4,5"><Paragraph TextAlignment="Right" FontSize="9.5">DISCOUNT</Paragraph></TableCell>
                <TableCell BorderThickness="0,0,0,1.5" BorderBrush="#4B2C1D" Padding="4,5"><Paragraph TextAlignment="Right" FontSize="9.5">AMOUNT</Paragraph></TableCell>
            </TableRow>
        </TableRowGroup>

        <!-- Dynamic Item Rows -->
        <!-- MinRows: 23 -->
        <TableRowGroup>
            <!-- <ItemsRows> -->
            <TableRow>
                <TableCell BorderThickness="0,0,1,0" BorderBrush="#4B2C1D" Padding="2,3.5"><Paragraph TextAlignment="Center" FontSize="9" LineHeight="18" LineStackingStrategy="BlockLineHeight"><Run Text="{{SNo}}" /></Paragraph></TableCell>
                <TableCell BorderThickness="0,0,1,0" BorderBrush="#4B2C1D" Padding="4,3.5">
                    <Table CellSpacing="0">
                        <Table.Columns>
                            <TableColumn Width="165" />
                            <TableColumn Width="75" />
                        </Table.Columns>
                        <TableRowGroup>
                            <TableRow>
                                <TableCell Padding="0"><Paragraph FontSize="9.5"><Bold><Run Text="{{ItemName}}" /></Bold></Paragraph></TableCell>
                                <TableCell Padding="0"><Paragraph TextAlignment="Right" FontSize="8.5"><Run Text="{{Barcode}}" /></Paragraph></TableCell>
                            </TableRow>
                        </TableRowGroup>
                    </Table>
                </TableCell>
                <TableCell BorderThickness="0,0,1,0" BorderBrush="#4B2C1D" Padding="2,3.5"><Paragraph TextAlignment="Center" FontSize="9"><Run Text="{{Hsn}}" /></Paragraph></TableCell>
                <TableCell BorderThickness="0,0,1,0" BorderBrush="#4B2C1D" Padding="4,3.5">
                    <Table CellSpacing="0">
                        <Table.Columns>
                            <TableColumn Width="38" />
                            <TableColumn Width="64" />
                            <TableColumn Width="38" />
                        </Table.Columns>
                        <TableRowGroup>
                            <TableRow>
                                <TableCell Padding="0"><Paragraph TextAlignment="Center" FontSize="9"><Run Text="{{Qty}}" /></Paragraph></TableCell>
                                <TableCell Padding="0"><Paragraph TextAlignment="Right" FontSize="9"><Run Text="{{NtWt}}" /></Paragraph></TableCell>
                                <TableCell Padding="0"><Paragraph TextAlignment="Center" FontSize="9"><Run Text="{{GrWt}}" /></Paragraph></TableCell>
                            </TableRow>
                        </TableRowGroup>
                    </Table>
                </TableCell>
                <TableCell BorderThickness="0,0,1,0" BorderBrush="#4B2C1D" Padding="4,3.5"><Paragraph TextAlignment="Right" FontSize="9.5"><Run Text="{{Value}}" /></Paragraph></TableCell>
                <TableCell BorderThickness="0,0,1,0" BorderBrush="#4B2C1D" Padding="4,3.5"><Paragraph TextAlignment="Right" FontSize="9.5"><Run Text="{{Discount}}" /></Paragraph></TableCell>
                <TableCell BorderThickness="0,0,0,0" BorderBrush="#4B2C1D" Padding="4,3.5"><Paragraph TextAlignment="Right" FontSize="9.5"><Run Text="{{Amount}}" /></Paragraph></TableCell>
            </TableRow>
            <!-- </ItemsRows> -->
        </TableRowGroup>

        <!-- Subtotal Bottom Row -->
        <TableRowGroup>
            <TableRow FontWeight="Bold">
                <TableCell BorderThickness="0,1.5,1,0" BorderBrush="#4B2C1D" Padding="0,4"><Paragraph></Paragraph></TableCell>
                <TableCell BorderThickness="0,1.5,1,0" BorderBrush="#4B2C1D" Padding="0,4"><Paragraph></Paragraph></TableCell>
                <TableCell BorderThickness="0,1.5,1,0" BorderBrush="#4B2C1D" Padding="0,4"><Paragraph></Paragraph></TableCell>
                <TableCell BorderThickness="0,1.5,1,0" BorderBrush="#4B2C1D" Padding="0,4"><Paragraph></Paragraph></TableCell>
                <TableCell BorderThickness="0,1.5,1,0" BorderBrush="#4B2C1D" Padding="4,4"><Paragraph TextAlignment="Right" FontSize="9.5"><Run Text="{{TotalValue}}" /></Paragraph></TableCell>
                <TableCell BorderThickness="0,1.5,1,0" BorderBrush="#4B2C1D" Padding="4,4"><Paragraph TextAlignment="Right" FontSize="9.5"><Run Text="{{TotalDiscount}}" /></Paragraph></TableCell>
                <TableCell BorderThickness="0,1.5,0,0" BorderBrush="#4B2C1D" Padding="4,4"><Paragraph TextAlignment="Right" FontSize="9.5"><Run Text="{{TotalAmount}}" /></Paragraph></TableCell>
            </TableRow>
        </TableRowGroup>
    </Table>

    <!-- ========================================================================= -->
    <!-- 4. TAX BREAKDOWN TABLE & NET TOTAL BOX                                    -->
    <!-- ========================================================================= -->
    <Table CellSpacing="0" Margin="0,2,0,4">
        <Table.Columns>
            <TableColumn Width="460" />
            <TableColumn Width="25" />
            <TableColumn Width="260" />
        </Table.Columns>
        <TableRowGroup>
            <TableRow>
                <!-- Left: GST Summary Box -->
                <TableCell Padding="0">
                    <Table CellSpacing="0" BorderThickness="1.5" BorderBrush="#4B2C1D">
                        <Table.Columns>
                            <TableColumn Width="72" /> <!-- Taxable -->
                            <TableColumn Width="46" /> <!-- GST% -->
                            <TableColumn Width="42" /> <!-- HSN -->
                            <TableColumn Width="48" /> <!-- Qty -->
                            <TableColumn Width="62" /> <!-- CGST -->
                            <TableColumn Width="62" /> <!-- SGST -->
                            <TableColumn Width="58" /> <!-- IGST -->
                            <TableColumn Width="65" />  <!-- Total GST -->
                        </Table.Columns>
                        <TableRowGroup>
                            <TableRow FontWeight="Bold">
                                <TableCell BorderThickness="0,0,0,1" BorderBrush="#4B2C1D" Padding="2,3.5"><Paragraph TextAlignment="Center" FontSize="8.5">Taxable</Paragraph></TableCell>
                                <TableCell BorderThickness="0,0,0,1" BorderBrush="#4B2C1D" Padding="2,3.5"><Paragraph TextAlignment="Center" FontSize="8.5">GST%</Paragraph></TableCell>
                                <TableCell BorderThickness="0,0,0,1" BorderBrush="#4B2C1D" Padding="2,3.5"><Paragraph TextAlignment="Center" FontSize="8.5">HSN</Paragraph></TableCell>
                                <TableCell BorderThickness="0,0,0,1" BorderBrush="#4B2C1D" Padding="2,3.5"><Paragraph TextAlignment="Right" FontSize="8.5">Qty</Paragraph></TableCell>
                                <TableCell BorderThickness="0,0,0,1" BorderBrush="#4B2C1D" Padding="2,3.5"><Paragraph TextAlignment="Right" FontSize="8.5">CGST</Paragraph></TableCell>
                                <TableCell BorderThickness="0,0,0,1" BorderBrush="#4B2C1D" Padding="2,3.5"><Paragraph TextAlignment="Right" FontSize="8.5">SGST</Paragraph></TableCell>
                                <TableCell BorderThickness="0,0,0,1" BorderBrush="#4B2C1D" Padding="2,3.5"><Paragraph TextAlignment="Right" FontSize="8.5">IGST</Paragraph></TableCell>
                                <TableCell BorderThickness="0,0,0,1" BorderBrush="#4B2C1D" Padding="2,3.5"><Paragraph TextAlignment="Right" FontSize="8.5">Total GST</Paragraph></TableCell>
                            </TableRow>
                            <TableRow>
                                <TableCell Padding="2,3"><Paragraph TextAlignment="Right" FontSize="8.5"><Run Text="{{TaxableBaseAmt}}" /></Paragraph></TableCell>
                                <TableCell Padding="2,3"><Paragraph TextAlignment="Center" FontSize="8.5"><Run Text="{{GstRate}}" /></Paragraph></TableCell>
                                <TableCell Padding="2,3"><Paragraph TextAlignment="Center" FontSize="8.5"><Run Text="{{Hsn}}" /></Paragraph></TableCell>
                                <TableCell Padding="2,3"><Paragraph TextAlignment="Right" FontSize="8.5"><Run Text="{{TotalQtyFormatted}}" /></Paragraph></TableCell>
                                <TableCell Padding="2,3"><Paragraph TextAlignment="Right" FontSize="8.5"><Run Text="{{CgstAmt}}" /></Paragraph></TableCell>
                                <TableCell Padding="2,3"><Paragraph TextAlignment="Right" FontSize="8.5"><Run Text="{{SgstAmt}}" /></Paragraph></TableCell>
                                <TableCell Padding="2,3"><Paragraph TextAlignment="Right" FontSize="8.5"><Run Text="{{IgstAmt}}" /></Paragraph></TableCell>
                                <TableCell Padding="2,3"><Paragraph TextAlignment="Right" FontSize="8.5"><Run Text="{{TotalGstAmt}}" /></Paragraph></TableCell>
                            </TableRow>
                            <TableRow FontWeight="Bold">
                                <TableCell Padding="2,3"><Paragraph TextAlignment="Left" FontSize="8.5">TOTALS</Paragraph></TableCell>
                                <TableCell Padding="2,3"><Paragraph FontSize="8.5"></Paragraph></TableCell>
                                <TableCell Padding="2,3"><Paragraph FontSize="8.5"></Paragraph></TableCell>
                                <TableCell Padding="2,3"><Paragraph TextAlignment="Right" FontSize="8.5"><Run Text="{{TotalQtyFormatted}}" /></Paragraph></TableCell>
                                <TableCell Padding="2,3"><Paragraph TextAlignment="Right" FontSize="8.5"><Run Text="{{CgstAmt}}" /></Paragraph></TableCell>
                                <TableCell Padding="2,3"><Paragraph TextAlignment="Right" FontSize="8.5"><Run Text="{{SgstAmt}}" /></Paragraph></TableCell>
                                <TableCell Padding="2,3"><Paragraph TextAlignment="Right" FontSize="8.5"><Run Text="{{IgstAmt}}" /></Paragraph></TableCell>
                                <TableCell Padding="2,3"><Paragraph TextAlignment="Right" FontSize="8.5"><Run Text="{{TotalGstAmt}}" /></Paragraph></TableCell>
                            </TableRow>
                        </TableRowGroup>
                    </Table>
                </TableCell>

                <!-- Spacer -->
                <TableCell><Paragraph></Paragraph></TableCell>

                <!-- Right: Net Total Box & Signatory -->
                <TableCell Padding="0">
                    <Table CellSpacing="0" BorderThickness="1.5" BorderBrush="#4B2C1D">
                        <Table.Columns>
                            <TableColumn Width="90" />
                            <TableColumn Width="165" />
                        </Table.Columns>
                        <TableRowGroup>
                            <TableRow>
                                <TableCell BorderThickness="0,0,1.5,0" BorderBrush="#4B2C1D" Padding="6,5">
                                    <Paragraph FontSize="10.5"><Bold><Run Text="Net Total :" /></Bold></Paragraph>
                                </TableCell>
                                <TableCell Padding="6,5">
                                    <Paragraph TextAlignment="Right" FontSize="12">
                                        <Bold><Run Text="₹  " /><Run Text="{{NetAmt}}" /></Bold>
                                    </Paragraph>
                                </TableCell>
                            </TableRow>
                        </TableRowGroup>
                    </Table>

                    <Paragraph Margin="0,10,0,0" TextAlignment="Right">
                        <Bold><Run Text="For  TATTVA JEWELS" FontSize="10" /></Bold>
                    </Paragraph>
                    <Paragraph Margin="0,2,0,0" TextAlignment="Right" FontSize="8.5">
                        <Run Text="This is a computer generated invoice &amp;" />
                    </Paragraph>
                    <Paragraph Margin="0,1,0,0" TextAlignment="Right" FontSize="8.5">
                        <Run Text="need not be signed" />
                    </Paragraph>
                </TableCell>
            </TableRow>
        </TableRowGroup>
    </Table>

    <!-- ========================================================================= -->
    <!-- 5. STORE POLICIES & TERMS                                                 -->
    <!-- ========================================================================= -->
    <Paragraph Margin="0,6,0,3">
        <Bold><Underline><Run Text="Store Policies &amp; Terms" FontSize="9" /></Underline></Bold>
    </Paragraph>
    <Paragraph Margin="0,0,0,2" FontSize="8.2" LineHeight="1.2">
        <Run Text="1. Check Items Before Leaving: Please inspect your items carefully before leaving the store." />
    </Paragraph>
    <Paragraph Margin="0,0,0,2" FontSize="8.2" LineHeight="1.2">
        <Run Text="2. Stone, Meena, Enamel: Items made from stone, meena, and enamel are fragile. Our store is not responsible for any damage to these materials after purchase. Please handle with care." />
    </Paragraph>
    <Paragraph Margin="0,0,0,2" FontSize="8.2" LineHeight="1.2">
        <Run Text="3. Rose Gold/Platinum Use: Rose gold and platinum items are intended for occasional use only. No guarantee on color retention." />
    </Paragraph>
    <Paragraph Margin="0,0,0,2" FontSize="8.2" LineHeight="1.2">
        <Run Text="4. Silver items are delicate and must be handled with care. Claims for breakage will not be entertained. However, we may repair the piece at prevailing service charges." />
    </Paragraph>
    <Paragraph Margin="0,0,0,2" FontSize="8.2" LineHeight="1.2">
        <Run Text="5. Exchange/Refunds: Exchange will be done only if the product is in its original condition with packaging. No returns or refunds." />
    </Paragraph>
    <Paragraph Margin="0,0,0,2" FontSize="8.2" LineHeight="1.2">
        <Run Text="6. Old Silver: The buyback of old silver will be based on prevalent market practices." />
    </Paragraph>
    <Paragraph Margin="0,0,0,2" FontSize="8.2" LineHeight="1.2">
        <Run Text="7. Silver Tarnish: Silver has a tendency to tarnish when in contact with air or due to improper storage. This does not indicate inferior quality, it is simply a natural property of silver." />
    </Paragraph>
    <Paragraph Margin="0,0,0,4" FontSize="8.2" LineHeight="1.2">
        <Run Text="8. All disputes will be resolved via mutual arbitration and governed by Cuttack jurisdiction only" />
    </Paragraph>

    <!-- ========================================================================= -->
    <!-- 6. FOOTER QR CODES BANNER                                                 -->
    <!-- ========================================================================= -->
    <BlockUIContainer Margin="0,4,0,0">
        <Border BorderThickness="1.5" BorderBrush="#4B2C1D" Padding="2,4" Background="White">
            <Image Source="{{FooterQrPath}}" Height="68" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
    </BlockUIContainer>

</FlowDocument>
