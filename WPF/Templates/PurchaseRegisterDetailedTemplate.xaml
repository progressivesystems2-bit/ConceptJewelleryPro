<FlowDocument xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              PageWidth="1050"
              PageHeight="750"
              PagePadding="24,20,24,20"
              ColumnWidth="1050"
              FontFamily="Segoe UI, Arial, sans-serif"
              FontSize="10"
              Background="White"
              Foreground="Black">

    <!-- 1. COMPANY & REPORT HEADER -->
    <Table CellSpacing="0" Margin="0,0,0,4">
        <Table.Columns>
            <TableColumn Width="400" />
            <TableColumn Width="280" />
            <TableColumn Width="320" />
        </Table.Columns>
        <TableRowGroup>
            <TableRow>
                <TableCell>
                    <Paragraph Margin="0,0,0,1">
                        <Bold><Run Text="{{CompanyName}}" FontSize="14" /></Bold>
                    </Paragraph>
                    <Paragraph Margin="0,0,0,1" FontSize="10" Foreground="#333333">
                        <Run Text="{{Address}}" />
                    </Paragraph>
                    <Paragraph Margin="0,0,0,2" FontSize="9.5" Foreground="#333333">
                        <Run Text="GSTIN: " /><Run Text="{{Gstin}}" FontWeight="SemiBold" />
                    </Paragraph>
                </TableCell>
                <TableCell>
                    <Paragraph Margin="0" TextAlignment="Center" FontSize="10.5">
                        <Run Text="From Date : " FontWeight="Bold" /><Run Text="{{FromDate}}" FontWeight="Bold" />
                        <Run Text="   To Date : " FontWeight="Bold" /><Run Text="{{ToDate}}" FontWeight="Bold" />
                    </Paragraph>
                </TableCell>
                <TableCell>
                    <Paragraph Margin="0,0,0,2" TextAlignment="Right">
                        <Bold><Run Text="PURCHASE REGISTER DETAILED" FontSize="13" TextDecorations="Underline" /></Bold>
                    </Paragraph>
                </TableCell>
            </TableRow>
        </TableRowGroup>
    </Table>

    <!-- 2. DATA TABLE -->
    <Table CellSpacing="0" Margin="0,4,0,12">
        <Table.Columns>
            <!-- 0: Date -->
            <TableColumn Width="60" />
            <!-- 1: Pur No/ Supp Bill No -->
            <TableColumn Width="100" />
            <!-- 2: Party Details -->
            <TableColumn Width="220" />
            <!-- 3: Net Weight -->
            <TableColumn Width="65" />
            <!-- 4: Rate / Gr -->
            <TableColumn Width="70" />
            <!-- 5: Taxable Amt -->
            <TableColumn Width="85" />
            <!-- 6: IGST -->
            <TableColumn Width="55" />
            <!-- 7: CGST -->
            <TableColumn Width="55" />
            <!-- 8: SGST -->
            <TableColumn Width="55" />
            <!-- 9: GST -->
            <TableColumn Width="55" />
            <!-- 10: R.Off -->
            <TableColumn Width="45" />
            <!-- 11: Net Amount -->
            <TableColumn Width="90" />
        </Table.Columns>

        <TableRowGroup>
            <!-- Header Row -->
            <TableRow>
                <TableCell BorderBrush="Black" BorderThickness="0,2.5,0,1.5" Padding="3,4,3,4">
                    <Paragraph TextAlignment="Left" FontSize="9.5" Margin="0"><Bold><Run Text="Date" /></Bold></Paragraph>
                </TableCell>
                <TableCell BorderBrush="Black" BorderThickness="0,2.5,0,1.5" Padding="3,4,3,4">
                    <Paragraph TextAlignment="Left" FontSize="9.5" Margin="0"><Bold><Run Text="Pur No/ Supp Bill No" /></Bold></Paragraph>
                </TableCell>
                <TableCell BorderBrush="Black" BorderThickness="0,2.5,0,1.5" Padding="3,4,3,4">
                    <Paragraph TextAlignment="Left" FontSize="9.5" Margin="0"><Bold><Run Text="Party" /></Bold></Paragraph>
                </TableCell>
                <TableCell BorderBrush="Black" BorderThickness="0,2.5,0,1.5" Padding="3,4,3,4">
                    <Paragraph TextAlignment="Right" FontSize="9.5" Margin="0"><Bold><Run Text="Net Weight" /></Bold></Paragraph>
                </TableCell>
                <TableCell BorderBrush="Black" BorderThickness="0,2.5,0,1.5" Padding="3,4,3,4">
                    <Paragraph TextAlignment="Right" FontSize="9.5" Margin="0"><Bold><Run Text="Rate / Gr" /></Bold></Paragraph>
                </TableCell>
                <TableCell BorderBrush="Black" BorderThickness="0,2.5,0,1.5" Padding="3,4,3,4">
                    <Paragraph TextAlignment="Right" FontSize="9.5" Margin="0"><Bold><Run Text="Taxable Amt" /></Bold></Paragraph>
                </TableCell>
                <TableCell BorderBrush="Black" BorderThickness="0,2.5,0,1.5" Padding="3,4,3,4">
                    <Paragraph TextAlignment="Right" FontSize="9.5" Margin="0"><Bold><Run Text="IGST" /></Bold></Paragraph>
                </TableCell>
                <TableCell BorderBrush="Black" BorderThickness="0,2.5,0,1.5" Padding="3,4,3,4">
                    <Paragraph TextAlignment="Right" FontSize="9.5" Margin="0"><Bold><Run Text="CGST" /></Bold></Paragraph>
                </TableCell>
                <TableCell BorderBrush="Black" BorderThickness="0,2.5,0,1.5" Padding="3,4,3,4">
                    <Paragraph TextAlignment="Right" FontSize="9.5" Margin="0"><Bold><Run Text="SGST" /></Bold></Paragraph>
                </TableCell>
                <TableCell BorderBrush="Black" BorderThickness="0,2.5,0,1.5" Padding="3,4,3,4">
                    <Paragraph TextAlignment="Right" FontSize="9.5" Margin="0"><Bold><Run Text="GST" /></Bold></Paragraph>
                </TableCell>
                <TableCell BorderBrush="Black" BorderThickness="0,2.5,0,1.5" Padding="3,4,3,4">
                    <Paragraph TextAlignment="Right" FontSize="9.5" Margin="0"><Bold><Run Text="R.Off" /></Bold></Paragraph>
                </TableCell>
                <TableCell BorderBrush="Black" BorderThickness="0,2.5,0,1.5" Padding="3,4,3,4">
                    <Paragraph TextAlignment="Right" FontSize="9.5" Margin="0"><Bold><Run Text="Net Amount" /></Bold></Paragraph>
                </TableCell>
            </TableRow>

            <!-- Dynamic Group Total Row Template (Item Total) -->
            <!-- <ItemTotalRow> -->
            <TableRow>
                <TableCell ColumnSpan="2" Padding="3,3,3,2" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
                    <Paragraph TextAlignment="Left" FontSize="9.5" Margin="0" Foreground="#C00000">
                        <Bold><Run Text="ITEM TOTAL : " /></Bold>
                    </Paragraph>
                </TableCell>
                <TableCell Padding="3,3,3,2" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
                    <Paragraph TextAlignment="Left" FontSize="9.5" Margin="0">
                        <Bold><Run Text="{{ItemGroupName}}" /></Bold>
                    </Paragraph>
                </TableCell>
                <TableCell Padding="3,3,3,2" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
                    <Paragraph TextAlignment="Right" FontSize="9.5" Margin="0" Foreground="#C00000">
                        <Bold><Run Text="{{GroupNetWeight}}" /></Bold>
                    </Paragraph>
                </TableCell>
                <TableCell Padding="3,3,3,2" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
                    <Paragraph TextAlignment="Right" FontSize="9.5" Margin="0" />
                </TableCell>
                <TableCell Padding="3,3,3,2" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
                    <Paragraph TextAlignment="Right" FontSize="9.5" Margin="0" Foreground="#C00000">
                        <Bold><Run Text="{{GroupTaxableAmt}}" /></Bold>
                    </Paragraph>
                </TableCell>
                <TableCell Padding="3,3,3,2" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
                    <Paragraph TextAlignment="Right" FontSize="9.5" Margin="0" Foreground="#C00000">
                        <Bold><Run Text="{{GroupIGST}}" /></Bold>
                    </Paragraph>
                </TableCell>
                <TableCell Padding="3,3,3,2" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
                    <Paragraph TextAlignment="Right" FontSize="9.5" Margin="0" Foreground="#C00000">
                        <Bold><Run Text="{{GroupCGST}}" /></Bold>
                    </Paragraph>
                </TableCell>
                <TableCell Padding="3,3,3,2" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
                    <Paragraph TextAlignment="Right" FontSize="9.5" Margin="0" Foreground="#C00000">
                        <Bold><Run Text="{{GroupSGST}}" /></Bold>
                    </Paragraph>
                </TableCell>
                <TableCell Padding="3,3,3,2" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
                    <Paragraph TextAlignment="Right" FontSize="9.5" Margin="0" Foreground="#C00000">
                        <Bold><Run Text="{{GroupGST}}" /></Bold>
                    </Paragraph>
                </TableCell>
                <TableCell Padding="3,3,3,2" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
                    <Paragraph TextAlignment="Right" FontSize="9.5" Margin="0" Foreground="#C00000">
                        <Bold><Run Text="{{GroupROff}}" /></Bold>
                    </Paragraph>
                </TableCell>
                <TableCell Padding="3,3,3,2" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
                    <Paragraph TextAlignment="Right" FontSize="9.5" Margin="0" Foreground="#C00000">
                        <Bold><Run Text="{{GroupNetAmount}}" /></Bold>
                    </Paragraph>
                </TableCell>
            </TableRow>
            <!-- </ItemTotalRow> -->

            <!-- Dynamic Invoice Item Detail Row Template -->
            <!-- <DataRows> -->
            <TableRow>
                <TableCell Padding="3,2,3,2" BorderBrush="#EAEAEA" BorderThickness="0,0,0,0.5">
                    <Paragraph TextAlignment="Left" FontSize="9" Margin="0"><Run Text="{{Date}}" /></Paragraph>
                </TableCell>
                <TableCell Padding="3,2,3,2" BorderBrush="#EAEAEA" BorderThickness="0,0,0,0.5">
                    <Paragraph TextAlignment="Left" FontSize="9" Margin="0"><Run Text="{{PurNo}}" /></Paragraph>
                </TableCell>
                <TableCell Padding="3,2,3,2" BorderBrush="#EAEAEA" BorderThickness="0,0,0,0.5">
                    <Paragraph TextAlignment="Left" FontSize="9" Margin="0">
                        <Run Text="{{PartyName}}" FontWeight="SemiBold" />
                    </Paragraph>
                    <Paragraph TextAlignment="Left" FontSize="8" Margin="0,1,0,0" Foreground="#444444">
                        <Run Text="{{PartyDetails}}" />
                    </Paragraph>
                </TableCell>
                <TableCell Padding="3,2,3,2" BorderBrush="#EAEAEA" BorderThickness="0,0,0,0.5">
                    <Paragraph TextAlignment="Right" FontSize="9" Margin="0"><Run Text="{{NetWeight}}" /></Paragraph>
                </TableCell>
                <TableCell Padding="3,2,3,2" BorderBrush="#EAEAEA" BorderThickness="0,0,0,0.5">
                    <Paragraph TextAlignment="Right" FontSize="9" Margin="0"><Run Text="{{RatePerGr}}" /></Paragraph>
                </TableCell>
                <TableCell Padding="3,2,3,2" BorderBrush="#EAEAEA" BorderThickness="0,0,0,0.5">
                    <Paragraph TextAlignment="Right" FontSize="9" Margin="0"><Run Text="{{TaxableAmt}}" /></Paragraph>
                </TableCell>
                <TableCell Padding="3,2,3,2" BorderBrush="#EAEAEA" BorderThickness="0,0,0,0.5">
                    <Paragraph TextAlignment="Right" FontSize="9" Margin="0"><Run Text="{{IGST}}" /></Paragraph>
                </TableCell>
                <TableCell Padding="3,2,3,2" BorderBrush="#EAEAEA" BorderThickness="0,0,0,0.5">
                    <Paragraph TextAlignment="Right" FontSize="9" Margin="0"><Run Text="{{CGST}}" /></Paragraph>
                </TableCell>
                <TableCell Padding="3,2,3,2" BorderBrush="#EAEAEA" BorderThickness="0,0,0,0.5">
                    <Paragraph TextAlignment="Right" FontSize="9" Margin="0"><Run Text="{{SGST}}" /></Paragraph>
                </TableCell>
                <TableCell Padding="3,2,3,2" BorderBrush="#EAEAEA" BorderThickness="0,0,0,0.5">
                    <Paragraph TextAlignment="Right" FontSize="9" Margin="0"><Run Text="{{GST}}" /></Paragraph>
                </TableCell>
                <TableCell Padding="3,2,3,2" BorderBrush="#EAEAEA" BorderThickness="0,0,0,0.5">
                    <Paragraph TextAlignment="Right" FontSize="9" Margin="0"><Run Text="{{ROff}}" /></Paragraph>
                </TableCell>
                <TableCell Padding="3,2,3,2" BorderBrush="#EAEAEA" BorderThickness="0,0,0,0.5">
                    <Paragraph TextAlignment="Right" FontSize="9" Margin="0"><Run Text="{{NetAmount}}" /></Paragraph>
                </TableCell>
            </TableRow>
            <!-- </DataRows> -->

            <!-- Dynamic Grand Total Row Template -->
            <!-- <GrandTotalRow> -->
            <TableRow>
                <TableCell ColumnSpan="3" BorderBrush="Black" BorderThickness="0,1.5,0,2.0" Padding="3,4,3,4">
                    <Paragraph TextAlignment="Left" FontSize="10" Margin="0"><Bold><Run Text="GRAND TOTAL" /></Bold></Paragraph>
                </TableCell>
                <TableCell BorderBrush="Black" BorderThickness="0,1.5,0,2.0" Padding="3,4,3,4">
                    <Paragraph TextAlignment="Right" FontSize="10" Margin="0"><Bold><Run Text="{{GrandNetWeight}}" /></Bold></Paragraph>
                </TableCell>
                <TableCell BorderBrush="Black" BorderThickness="0,1.5,0,2.0" Padding="3,4,3,4">
                    <Paragraph TextAlignment="Right" FontSize="10" Margin="0" />
                </TableCell>
                <TableCell BorderBrush="Black" BorderThickness="0,1.5,0,2.0" Padding="3,4,3,4">
                    <Paragraph TextAlignment="Right" FontSize="10" Margin="0"><Bold><Run Text="{{GrandTaxableAmt}}" /></Bold></Paragraph>
                </TableCell>
                <TableCell BorderBrush="Black" BorderThickness="0,1.5,0,2.0" Padding="3,4,3,4">
                    <Paragraph TextAlignment="Right" FontSize="10" Margin="0"><Bold><Run Text="{{GrandIGST}}" /></Bold></Paragraph>
                </TableCell>
                <TableCell BorderBrush="Black" BorderThickness="0,1.5,0,2.0" Padding="3,4,3,4">
                    <Paragraph TextAlignment="Right" FontSize="10" Margin="0"><Bold><Run Text="{{GrandCGST}}" /></Bold></Paragraph>
                </TableCell>
                <TableCell BorderBrush="Black" BorderThickness="0,1.5,0,2.0" Padding="3,4,3,4">
                    <Paragraph TextAlignment="Right" FontSize="10" Margin="0"><Bold><Run Text="{{GrandSGST}}" /></Bold></Paragraph>
                </TableCell>
                <TableCell BorderBrush="Black" BorderThickness="0,1.5,0,2.0" Padding="3,4,3,4">
                    <Paragraph TextAlignment="Right" FontSize="10" Margin="0"><Bold><Run Text="{{GrandGST}}" /></Bold></Paragraph>
                </TableCell>
                <TableCell BorderBrush="Black" BorderThickness="0,1.5,0,2.0" Padding="3,4,3,4">
                    <Paragraph TextAlignment="Right" FontSize="10" Margin="0"><Bold><Run Text="{{GrandROff}}" /></Bold></Paragraph>
                </TableCell>
                <TableCell BorderBrush="Black" BorderThickness="0,1.5,0,2.0" Padding="3,4,3,4">
                    <Paragraph TextAlignment="Right" FontSize="10" Margin="0"><Bold><Run Text="{{GrandNetAmount}}" /></Bold></Paragraph>
                </TableCell>
            </TableRow>
            <!-- </GrandTotalRow> -->
        </TableRowGroup>
    </Table>
</FlowDocument>
