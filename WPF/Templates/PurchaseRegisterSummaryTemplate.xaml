<FlowDocument xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              PageWidth="842"
              PageHeight="1190"
              PagePadding="30,24,30,24"
              ColumnWidth="842"
              FontFamily="Segoe UI, Arial, sans-serif"
              FontSize="10"
              Background="White"
              Foreground="Black">

    <!-- 1. COMPANY & REPORT HEADER -->
    <Table CellSpacing="0" Margin="0,0,0,6">
        <Table.Columns>
            <TableColumn Width="320" />
            <TableColumn Width="260" />
            <TableColumn Width="200" />
        </Table.Columns>
        <TableRowGroup>
            <TableRow>
                <TableCell>
                    <Paragraph Margin="0,0,0,1">
                        <Bold><Run Text="{{CompanyName}}" FontSize="14" /></Bold>
                    </Paragraph>
                    <Paragraph Margin="0,0,0,1" FontSize="10" Foreground="#333333">
                        <Run Text="{{Address}}" />
                    </Paragraph>
                    <Paragraph Margin="0,0,0,2" FontSize="9.5" Foreground="#333333">
                        <Run Text="TIN: GSTIN: " /><Run Text="{{Gstin}}" FontWeight="SemiBold" />
                    </Paragraph>
                </TableCell>
                <TableCell>
                    <Paragraph Margin="0,0,0,2" TextAlignment="Center" FontSize="10.5">
                        <Run Text="From Date :  " FontWeight="Bold" /><Run Text="{{FromDate}}" FontWeight="Bold" />
                        <Run Text="    To Date :  " FontWeight="Bold" /><Run Text="{{ToDate}}" FontWeight="Bold" />
                    </Paragraph>
                    <Paragraph Margin="0" TextAlignment="Center">
                        <Bold><Run Text="PURCHASE REGISTER SUMMARY" FontSize="12.5" TextDecorations="Underline" /></Bold>
                    </Paragraph>
                </TableCell>
                <TableCell>
                    <Paragraph Margin="0,0,0,2" TextAlignment="Right" FontSize="9.5">
                        <Run Text="Page 1 of 1" />
                    </Paragraph>
                </TableCell>
            </TableRow>
        </TableRowGroup>
    </Table>

    <!-- 2. SUMMARY DATA TABLE -->
    <Table CellSpacing="0" Margin="0,4,0,12">
        <Table.Columns>
            <!-- 0: Date -->
            <TableColumn Width="65" />
            <!-- 1: Inside/Outside -->
            <TableColumn Width="65" />
            <!-- 2: Item Name -->
            <TableColumn Width="180" />
            <!-- 3: Gr .Weight -->
            <TableColumn Width="75" />
            <!-- 4: Net Weight -->
            <TableColumn Width="75" />
            <!-- 5: Taxable Amt -->
            <TableColumn Width="85" />
            <!-- 6: Tax Amt -->
            <TableColumn Width="65" />
            <!-- 7: R.Off -->
            <TableColumn Width="50" />
            <!-- 8: Net Amount -->
            <TableColumn Width="90" />
        </Table.Columns>

        <TableRowGroup>
            <!-- Header Row -->
            <TableRow>
                <TableCell BorderBrush="Black" BorderThickness="0,2.0,0,1.5" Padding="3,4,3,4">
                    <Paragraph TextAlignment="Left" FontSize="9.5" Margin="0"><Bold><Run Text="Date" /></Bold></Paragraph>
                </TableCell>
                <TableCell BorderBrush="Black" BorderThickness="0,2.0,0,1.5" Padding="3,4,3,4">
                    <Paragraph TextAlignment="Center" FontSize="9.5" Margin="0">
                        <Bold><Run Text="Inside/" /></Bold>
                    </Paragraph>
                    <Paragraph TextAlignment="Center" FontSize="9.5" Margin="0">
                        <Bold><Run Text="Outside" /></Bold>
                    </Paragraph>
                </TableCell>
                <TableCell BorderBrush="Black" BorderThickness="0,2.0,0,1.5" Padding="3,4,3,4">
                    <Paragraph TextAlignment="Center" FontSize="9.5" Margin="0"><Bold><Run Text="Item Name" /></Bold></Paragraph>
                </TableCell>
                <TableCell BorderBrush="Black" BorderThickness="0,2.0,0,1.5" Padding="3,4,3,4">
                    <Paragraph TextAlignment="Right" FontSize="9.5" Margin="0"><Bold><Run Text="Gr .Weight" /></Bold></Paragraph>
                </TableCell>
                <TableCell BorderBrush="Black" BorderThickness="0,2.0,0,1.5" Padding="3,4,3,4">
                    <Paragraph TextAlignment="Right" FontSize="9.5" Margin="0"><Bold><Run Text="Net Weight" /></Bold></Paragraph>
                </TableCell>
                <TableCell BorderBrush="Black" BorderThickness="0,2.0,0,1.5" Padding="3,4,3,4">
                    <Paragraph TextAlignment="Right" FontSize="9.5" Margin="0"><Bold><Run Text="Taxable Amt" /></Bold></Paragraph>
                </TableCell>
                <TableCell BorderBrush="Black" BorderThickness="0,2.0,0,1.5" Padding="3,4,3,4">
                    <Paragraph TextAlignment="Right" FontSize="9.5" Margin="0"><Bold><Run Text="Tax Amt" /></Bold></Paragraph>
                </TableCell>
                <TableCell BorderBrush="Black" BorderThickness="0,2.0,0,1.5" Padding="3,4,3,4">
                    <Paragraph TextAlignment="Right" FontSize="9.5" Margin="0"><Bold><Run Text="R.Off" /></Bold></Paragraph>
                </TableCell>
                <TableCell BorderBrush="Black" BorderThickness="0,2.0,0,1.5" Padding="3,4,3,4">
                    <Paragraph TextAlignment="Right" FontSize="9.5" Margin="0"><Bold><Run Text="Net Amount" /></Bold></Paragraph>
                </TableCell>
            </TableRow>

            <!-- Dynamic Invoice Item Detail Row Template -->
            <!-- <DataRows> -->
            <TableRow>
                <TableCell Padding="3,2,3,2" BorderBrush="#EAEAEA" BorderThickness="0,0,0,0.5">
                    <Paragraph TextAlignment="Left" FontSize="9" Margin="0"><Run Text="{{Date}}" /></Paragraph>
                </TableCell>
                <TableCell Padding="3,2,3,2" BorderBrush="#EAEAEA" BorderThickness="0,0,0,0.5">
                    <Paragraph TextAlignment="Center" FontSize="9" Margin="0"><Run Text="{{InsideOutside}}" /></Paragraph>
                </TableCell>
                <TableCell Padding="3,2,3,2" BorderBrush="#EAEAEA" BorderThickness="0,0,0,0.5">
                    <Paragraph TextAlignment="Left" FontSize="9" Margin="0"><Run Text="{{ItemName}}" /></Paragraph>
                </TableCell>
                <TableCell Padding="3,2,3,2" BorderBrush="#EAEAEA" BorderThickness="0,0,0,0.5">
                    <Paragraph TextAlignment="Right" FontSize="9" Margin="0"><Run Text="{{GrWeight}}" /></Paragraph>
                </TableCell>
                <TableCell Padding="3,2,3,2" BorderBrush="#EAEAEA" BorderThickness="0,0,0,0.5">
                    <Paragraph TextAlignment="Right" FontSize="9" Margin="0"><Run Text="{{NetWeight}}" /></Paragraph>
                </TableCell>
                <TableCell Padding="3,2,3,2" BorderBrush="#EAEAEA" BorderThickness="0,0,0,0.5">
                    <Paragraph TextAlignment="Right" FontSize="9" Margin="0"><Run Text="{{TaxableAmt}}" /></Paragraph>
                </TableCell>
                <TableCell Padding="3,2,3,2" BorderBrush="#EAEAEA" BorderThickness="0,0,0,0.5">
                    <Paragraph TextAlignment="Right" FontSize="9" Margin="0"><Run Text="{{TaxAmt}}" /></Paragraph>
                </TableCell>
                <TableCell Padding="3,2,3,2" BorderBrush="#EAEAEA" BorderThickness="0,0,0,0.5">
                    <Paragraph TextAlignment="Right" FontSize="9" Margin="0"><Run Text="{{ROff}}" /></Paragraph>
                </TableCell>
                <TableCell Padding="3,2,3,2" BorderBrush="#EAEAEA" BorderThickness="0,0,0,0.5">
                    <Paragraph TextAlignment="Right" FontSize="9" Margin="0"><Run Text="{{NetAmount}}" /></Paragraph>
                </TableCell>
            </TableRow>
            <!-- </DataRows> -->

            <!-- Dynamic Group Total Row Template (Item Total) -->
            <!-- <ItemTotalRow> -->
            <TableRow>
                <TableCell ColumnSpan="3" Padding="3,3,3,2" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
                    <Paragraph TextAlignment="Left" FontSize="9.5" Margin="0" Foreground="#C00000">
                        <Bold><Run Text="ITEM TOTAL : " /></Bold>
                    </Paragraph>
                </TableCell>
                <TableCell Padding="3,3,3,2" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
                    <Paragraph TextAlignment="Right" FontSize="9.5" Margin="0" Foreground="#C00000">
                        <Bold><Run Text="{{GroupGrWeight}}" /></Bold>
                    </Paragraph>
                </TableCell>
                <TableCell Padding="3,3,3,2" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
                    <Paragraph TextAlignment="Right" FontSize="9.5" Margin="0" Foreground="#C00000">
                        <Bold><Run Text="{{GroupNetWeight}}" /></Bold>
                    </Paragraph>
                </TableCell>
                <TableCell Padding="3,3,3,2" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
                    <Paragraph TextAlignment="Right" FontSize="9.5" Margin="0" Foreground="#C00000">
                        <Bold><Run Text="{{GroupTaxableAmt}}" /></Bold>
                    </Paragraph>
                </TableCell>
                <TableCell Padding="3,3,3,2" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
                    <Paragraph TextAlignment="Right" FontSize="9.5" Margin="0" Foreground="#C00000">
                        <Bold><Run Text="{{GroupTaxAmt}}" /></Bold>
                    </Paragraph>
                </TableCell>
                <TableCell Padding="3,3,3,2" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
                    <Paragraph TextAlignment="Right" FontSize="9.5" Margin="0" Foreground="#C00000">
                        <Bold><Run Text="{{GroupROff}}" /></Bold>
                    </Paragraph>
                </TableCell>
                <TableCell Padding="3,3,3,2" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
                    <Paragraph TextAlignment="Right" FontSize="9.5" Margin="0" Foreground="#C00000">
                        <Bold><Run Text="{{GroupNetAmount}}" /></Bold>
                    </Paragraph>
                </TableCell>
            </TableRow>
            <!-- </ItemTotalRow> -->

            <!-- Dynamic Grand Total Row Template -->
            <!-- <GrandTotalRow> -->
            <TableRow>
                <TableCell ColumnSpan="3" BorderBrush="Black" BorderThickness="0,1.5,0,2.0" Padding="3,4,3,4">
                    <Paragraph TextAlignment="Left" FontSize="10" Margin="0"><Bold><Run Text="GRAND TOTAL" /></Bold></Paragraph>
                </TableCell>
                <TableCell BorderBrush="Black" BorderThickness="0,1.5,0,2.0" Padding="3,4,3,4">
                    <Paragraph TextAlignment="Right" FontSize="10" Margin="0"><Bold><Run Text="{{GrandGrWeight}}" /></Bold></Paragraph>
                </TableCell>
                <TableCell BorderBrush="Black" BorderThickness="0,1.5,0,2.0" Padding="3,4,3,4">
                    <Paragraph TextAlignment="Right" FontSize="10" Margin="0"><Bold><Run Text="{{GrandNetWeight}}" /></Bold></Paragraph>
                </TableCell>
                <TableCell BorderBrush="Black" BorderThickness="0,1.5,0,2.0" Padding="3,4,3,4">
                    <Paragraph TextAlignment="Right" FontSize="10" Margin="0"><Bold><Run Text="{{GrandTaxableAmt}}" /></Bold></Paragraph>
                </TableCell>
                <TableCell BorderBrush="Black" BorderThickness="0,1.5,0,2.0" Padding="3,4,3,4">
                    <Paragraph TextAlignment="Right" FontSize="10" Margin="0"><Bold><Run Text="{{GrandTaxAmt}}" /></Bold></Paragraph>
                </TableCell>
                <TableCell BorderBrush="Black" BorderThickness="0,1.5,0,2.0" Padding="3,4,3,4">
                    <Paragraph TextAlignment="Right" FontSize="10" Margin="0"><Bold><Run Text="{{GrandROff}}" /></Bold></Paragraph>
                </TableCell>
                <TableCell BorderBrush="Black" BorderThickness="0,1.5,0,2.0" Padding="3,4,3,4">
                    <Paragraph TextAlignment="Right" FontSize="10" Margin="0"><Bold><Run Text="{{GrandNetAmount}}" /></Bold></Paragraph>
                </TableCell>
            </TableRow>
            <!-- </GrandTotalRow> -->
        </TableRowGroup>
    </Table>
</FlowDocument>
