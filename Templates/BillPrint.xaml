                    <!-- 1. HEADER TABLE -->
                    <Table CellSpacing="0" Margin="0,0,0,8">
                        <Table.Columns>
                            <TableColumn Width="280" />
                            <TableColumn Width="140" />
                            <TableColumn Width="320" />
                        </Table.Columns>
                        <TableRowGroup>
                            <TableRow>
                                <!-- Customer Details -->
                                <TableCell>
                                    <Paragraph Margin="0,0,0,3">
                                        <Run Text="Customer Names: " FontSize="9" />
                                        <Bold><Run Text="{{CustomerName}}" FontSize="10.5" /></Bold>
                                    </Paragraph>
                                    <Paragraph Margin="0">
                                        <Run Text="Address " FontSize="9" />
                                        <Bold><Run Text="{{Address}}" FontSize="9.5" /><Run Text=" " /><Run Text="{{Address2}}" FontSize="9.5" /></Bold>
                                    </Paragraph>
                                </TableCell>
                                <!-- Mobile & City -->
                                <TableCell>
                                    <Paragraph Margin="0,0,0,3">
                                        <Bold><Run Text="{{Phone}}" FontSize="10" /></Bold>
                                    </Paragraph>
                                    <Paragraph Margin="0">
                                        <Bold><Run Text="{{City}}" FontSize="10" /></Bold>
                                    </Paragraph>
                                </TableCell>
                                <!-- GSTIN, Tax Invoice, VouNo, Date -->
                                <TableCell>
                                    <Paragraph Margin="0,0,0,3" TextAlignment="Right">
                                        <Bold><Run Text="GSTIN: " /><Run Text="{{StoreGstin}}" /><Run Text="    " /></Bold>
                                        <Bold><Run Text="TAX INVOICE" FontSize="11.5" /></Bold>
                                    </Paragraph>
                                    <Paragraph Margin="0" TextAlignment="Right">
                                        <Run Text="Invoice No : " FontSize="9.5" />
                                        <Bold><Run Text="{{VouNo}}" FontSize="10" /><Run Text="    " /></Bold>
                                        <Run Text="Invoice Date: " FontSize="9.5" />
                                        <Bold><Run Text="{{BillDate}}" FontSize="10" /></Bold>
                                    </Paragraph>
                                </TableCell>
                            </TableRow>
                        </TableRowGroup>
                    </Table>

                    <!-- 2. ITEMS TABLE (10 Rows for full proportional coverage) -->
                    <Table CellSpacing="0" Margin="0,4,0,8">
                        <Table.Columns>
                            <TableColumn Width="32" />  <!-- S.No -->
                            <TableColumn Width="62" />  <!-- BARCODE -->
                            <TableColumn Width="124" /> <!-- ITEM -->
                            <TableColumn Width="48" />  <!-- HSN -->
                            <TableColumn Width="48" />  <!-- PURITY -->
                            <TableColumn Width="32" />  <!-- QTY -->
                            <TableColumn Width="52" />  <!-- GR.WT -->
                            <TableColumn Width="52" />  <!-- NT. WT -->
                            <TableColumn Width="68" />  <!-- RATE / GR -->
                            <TableColumn Width="72" />  <!-- VALUE -->
                            <TableColumn Width="72" />  <!-- MAKING -->
                            <TableColumn Width="80" />  <!-- AMOUNT -->
                        </Table.Columns>

