<FlowDocument xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              PageWidth="793.7"
              PageHeight="1100.5"
              PagePadding="25,20,25,20"
              ColumnWidth="793.7"
              FontFamily="Segoe UI, Arial, sans-serif"
              FontSize="9.5"
              LineHeight="1.2"
              Background="White"
              Foreground="Black">

    <!-- ========================================================================= -->
    <!-- TOP HALF: ORIGINAL COPY - LOCKED TO EXACT 530px (50% A4 PORTRAIT)        -->
    <!-- ========================================================================= -->
    <BlockUIContainer Margin="0">
        <Border Height="470" Width="743.7" Margin="0,50,0,0" VerticalAlignment="Top">
            <FlowDocumentScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
