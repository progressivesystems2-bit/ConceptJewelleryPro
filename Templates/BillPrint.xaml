                    <!-- 3. LOWER SECTION (Left Notes & Signatures, Right Tax & Payments) -->
                    <Table CellSpacing="0" Margin="0,12,0,0">
                        <Table.Columns>
                            <TableColumn Width="450" />
                            <TableColumn Width="290" />
                        </Table.Columns>
                        <TableRowGroup>
                            <TableRow>
                                <!-- Left Notes & Signatures -->
                                <TableCell>
                                    <Paragraph Margin="0,0,0,5">
                                        <Bold><Run Text="NOTE : CHANGED PHONE NO : 2519343, 2519977" FontSize="8.5" /></Bold>
                                    </Paragraph>
                                    <Paragraph Margin="0,0,0,2">
                                        <Run Text="* Weight &amp; pieces verified and found correct" FontSize="8" />
                                    </Paragraph>
                                    <Paragraph Margin="0,0,0,8">
                                        <Run Text="* I hereby agree to the terms &amp; conditions stated overleaf" FontSize="8" />
                                    </Paragraph>
                                    <Paragraph Margin="0,0,0,24" TextAlignment="Center">
                                        <Bold><Run Text="E.&amp; O. E" FontSize="9" /></Bold>
                                    </Paragraph>

                                    <Table CellSpacing="0" Margin="0,12,0,0">
                                        <Table.Columns>
                                            <TableColumn Width="200" />
                                            <TableColumn Width="250" />
                                        </Table.Columns>
                                        <TableRowGroup>
                                            <TableRow>
                                                <TableCell>
                                                    <Paragraph Margin="0"><Bold><Run Text="Customer's Signature" FontSize="9.5" /></Bold></Paragraph>
                                                </TableCell>
                                                <TableCell>
                                                    <Paragraph Margin="0" TextAlignment="Right"><Bold><Run Text="For " /><Run Text="{{StoreName}}" FontSize="9.5" /></Bold></Paragraph>
                                                </TableCell>
                                            </TableRow>
                                        </TableRowGroup>
                                    </Table>
                                </TableCell>

                                <!-- Right Tax & Payment Summary -->
                                <TableCell>
                                    <Table CellSpacing="0" Margin="0">
                                        <Table.Columns>
                                            <TableColumn Width="170" />
                                            <TableColumn Width="120" />
                                        </Table.Columns>
                                        <!-- CGST & SGST -->
                                        <TableRowGroup>
                                            <TableRow>
                                                <TableCell><Paragraph Margin="0,2"><Bold><Run Text="CGST" FontSize="8.5" /></Bold></Paragraph></TableCell>
                                                <TableCell><Paragraph Margin="0,2" TextAlignment="Right"><Bold><Run Text="{{CgstAmt}}" FontSize="8.5" /></Bold></Paragraph></TableCell>
                                            </TableRow>
                                            <TableRow>
                                                <TableCell><Paragraph Margin="0,2"><Bold><Run Text="SG ST" FontSize="8.5" /></Bold></Paragraph></TableCell>
                                                <TableCell><Paragraph Margin="0,2" TextAlignment="Right"><Bold><Run Text="{{SgstAmt}}" FontSize="8.5" /></Bold></Paragraph></TableCell>
                                            </TableRow>
                                            <!-- Net Total Line -->
                                            <TableRow>
                                                <TableCell BorderThickness="0,1.5,0,1.5" BorderBrush="Black" Padding="0,3">
                                                    <Paragraph><Bold><Run Text="Net Total :" FontSize="9.5" /></Bold></Paragraph>
                                                </TableCell>
                                                <TableCell BorderThickness="0,1.5,0,1.5" BorderBrush="Black" Padding="0,3">
                                                    <Paragraph TextAlignment="Right"><Bold><Run Text="{{NetAmt}}" FontSize="9.5" /></Bold></Paragraph>
                                                </TableCell>
                                            </TableRow>
                                        </TableRowGroup>

                                        <!-- Dynamic Payments List -->
                                        <TableRowGroup>
                                            <!-- <PaymentRows> -->
                                            <TableRow>
                                                <TableCell>
                                                    <Paragraph Margin="0,2.5,0,1">
                                                        <Bold><Run Text="{{AccountName}}" FontSize="8.5" /></Bold>
                                                        <LineBreak />
                                                        <Run Text="{{DetailsSummary}}" FontSize="7.5" />
                                                    </Paragraph>
                                                </TableCell>
                                                <TableCell>
                                                    <Paragraph Margin="0,2.5,0,1" TextAlignment="Right">
                                                        <Bold><Run Text="{{Amount}}" FontSize="9" /></Bold>
                                                    </Paragraph>
                                                </TableCell>
                                            </TableRow>
                                            <!-- </PaymentRows> -->
                                        </TableRowGroup>

                                        <!-- Final Total Bottom Underline -->
                                        <TableRowGroup>
                                            <TableRow>
                                                <TableCell BorderThickness="0,1.5,0,1.5" BorderBrush="Black" Padding="0,4"><Paragraph></Paragraph></TableCell>
                                                <TableCell BorderThickness="0,1.5,0,1.5" BorderBrush="Black" Padding="0,4">
                                                    <Paragraph TextAlignment="Right"><Bold><Run Text="{{NetAmt}}" FontSize="11" /></Bold></Paragraph>
                                                </TableCell>
                                            </TableRow>
                                        </TableRowGroup>
                                    </Table>
                                </TableCell>
                            </TableRow>
                        </TableRowGroup>
                    </Table>
                </FlowDocument>
            </FlowDocumentScrollViewer>
        </Border>
    </BlockUIContainer>

    <!-- CUT SEPARATOR (Sitting at the exact 50% vertical midpoint of the A4 portrait sheet) -->
