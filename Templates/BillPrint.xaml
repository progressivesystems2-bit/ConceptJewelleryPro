                                <TableCell BorderThickness="0,1.5,0,1.5" BorderBrush="Black" Padding="0,3.5"><Paragraph TextAlignment="Center" FontSize="8.5">PURITY</Paragraph></TableCell>
                                <TableCell BorderThickness="0,1.5,0,1.5" BorderBrush="Black" Padding="0,3.5"><Paragraph TextAlignment="Right" FontSize="8.5">QTY</Paragraph></TableCell>
                                <TableCell BorderThickness="0,1.5,0,1.5" BorderBrush="Black" Padding="0,3.5"><Paragraph TextAlignment="Right" FontSize="8.5">GR.WT</Paragraph></TableCell>
                                <TableCell BorderThickness="0,1.5,0,1.5" BorderBrush="Black" Padding="0,3.5"><Paragraph TextAlignment="Right" FontSize="8.5">NT. WT</Paragraph></TableCell>
                                <TableCell BorderThickness="0,1.5,0,1.5" BorderBrush="Black" Padding="0,3.5"><Paragraph TextAlignment="Right" FontSize="8.5">RATE / GR</Paragraph></TableCell>
                                <TableCell BorderThickness="0,1.5,0,1.5" BorderBrush="Black" Padding="0,3.5"><Paragraph TextAlignment="Right" FontSize="8.5">VALUE</Paragraph></TableCell>
                                <TableCell BorderThickness="0,1.5,0,1.5" BorderBrush="Black" Padding="0,3.5"><Paragraph TextAlignment="Right" FontSize="8.5">MAKING</Paragraph></TableCell>
                                <TableCell BorderThickness="0,1.5,0,1.5" BorderBrush="Black" Padding="0,3.5"><Paragraph TextAlignment="Right" FontSize="8.5">TAXABLE VALUE</Paragraph></TableCell>
                            </TableRow>
                        </TableRowGroup>

                        <!-- Dynamic Items Row Template -->
                        <TableRowGroup>
                            <!-- <ItemsRows> -->
                            <TableRow>
                                <TableCell Padding="0,3.5"><Paragraph TextAlignment="Center" FontSize="8.5"><Run Text="{{SNo}}" /></Paragraph></TableCell>
                                <TableCell Padding="0,3.5"><Paragraph TextAlignment="Center" FontSize="8.5"><Run Text="{{Barcode}}" /></Paragraph></TableCell>
                                <TableCell Padding="0,3.5">
                                    <Paragraph Margin="1,0" FontSize="8.5">
                                        <Bold><Run Text="{{ItemName}}" /></Bold>
                                        <LineBreak />
                                        <Bold><Run Text="{{OldBarcode}}" FontSize="8" /></Bold>
                                    </Paragraph>
                                </TableCell>
                                <TableCell Padding="0,3.5"><Paragraph TextAlignment="Center" FontSize="8.5"><Run Text="{{HSN}}" /></Paragraph></TableCell>
                                <TableCell Padding="0,3.5"><Paragraph TextAlignment="Center" FontSize="8.5"><Run Text="{{Purity}}" /></Paragraph></TableCell>
                                <TableCell Padding="0,3.5"><Paragraph TextAlignment="Right" FontSize="8.5"><Run Text="{{Qty}}" /></Paragraph></TableCell>
                                <TableCell Padding="0,3.5"><Paragraph TextAlignment="Right" FontSize="8.5"><Run Text="{{GrWt}}" /></Paragraph></TableCell>
                                <TableCell Padding="0,3.5"><Paragraph TextAlignment="Right" FontSize="8.5"><Run Text="{{NtWt}}" /></Paragraph></TableCell>
                                <TableCell Padding="0,3.5"><Paragraph TextAlignment="Right" FontSize="8.5"><Run Text="{{Rate}}" /></Paragraph></TableCell>
                                <TableCell Padding="0,3.5"><Paragraph TextAlignment="Right" FontSize="8.5"><Run Text="{{MetalValue}}" /></Paragraph></TableCell>
                                <TableCell Padding="0,3.5"><Paragraph TextAlignment="Right" FontSize="8.5"><Run Text="{{Making}}" /></Paragraph></TableCell>
                                <TableCell Padding="0,3.5"><Paragraph TextAlignment="Right" FontSize="8.5"><Run Text="{{Amount}}" /></Paragraph></TableCell>
                            </TableRow>
                            <!-- </ItemsRows> -->
                        </TableRowGroup>

                        <!-- Items Subtotals Row -->
                        <TableRowGroup>
                            <TableRow FontWeight="Bold">
                                <TableCell BorderThickness="0,1.5,0,1.5" BorderBrush="Black" Padding="0,3.5"><Paragraph></Paragraph></TableCell>
                                <TableCell BorderThickness="0,1.5,0,1.5" BorderBrush="Black" Padding="0,3.5"><Paragraph></Paragraph></TableCell>
                                <TableCell BorderThickness="0,1.5,0,1.5" BorderBrush="Black" Padding="0,3.5"><Paragraph></Paragraph></TableCell>
                                <TableCell BorderThickness="0,1.5,0,1.5" BorderBrush="Black" Padding="0,3.5"><Paragraph></Paragraph></TableCell>
                                <TableCell BorderThickness="0,1.5,0,1.5" BorderBrush="Black" Padding="0,3.5"><Paragraph></Paragraph></TableCell>
                                <TableCell BorderThickness="0,1.5,0,1.5" BorderBrush="Black" Padding="0,3.5"><Paragraph TextAlignment="Right" FontSize="8.5"><Run Text="{{TotalQty}}" /></Paragraph></TableCell>
                                <TableCell BorderThickness="0,1.5,0,1.5" BorderBrush="Black" Padding="0,3.5"><Paragraph TextAlignment="Right" FontSize="8.5"><Run Text="{{TotalGrWt}}" /></Paragraph></TableCell>
